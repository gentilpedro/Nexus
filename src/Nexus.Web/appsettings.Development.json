{
  // Development only: no signing certificate exists locally and the dev container runs on Linux,
  // where DPAPI is unavailable. Production must never set this — Program.cs/AddInfrastructure
  // throws rather than writing an unencrypted Data Protection key ring to the database.
  "DataProtection": {
    "AllowUnprotectedKeys": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
