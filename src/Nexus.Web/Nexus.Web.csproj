<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Nexus_Web-6254aac6-e0b5-46e1-a78b-c5f1c4684b89</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Identificação da build, exposta em /version e no rodapé (ver Services/AppVersion.cs).

       A CI passa -p:Version, -p:SourceRevisionId e -p:BuildTimestamp; o SDK junta os dois
       primeiros em AssemblyInformationalVersion como "1.4.0+<sha>". Nenhum default é definido
       aqui de propósito: uma build local fica sem esses valores e se identifica como
       "0.0.0-local", em vez de se passar por uma release. -->
  <ItemGroup>
    <!-- Não existe atributo padrão para o horário da compilação, então vai como metadado. A
         condição evita gravar um atributo vazio na build local — e, mais importante, evita que um
         timestamp recalculado a cada avaliação do projeto invalide a build incremental. -->
    <AssemblyMetadata Include="BuildTimestamp"
                      Value="$(BuildTimestamp)"
                      Condition="'$(BuildTimestamp)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- NOT overriding AngleSharp's transitive 0.17.1 here (GHSA-pgww-w46g-26qg, moderate
         mXSS, fixed in 1.5.0) — tried it, but `dotnet restore` throws NU1608 because
         HtmlSanitizer pins AngleSharp = 0.17.1 exactly and ClosedXML's AngleSharp.Css pins
         >=0.17.0 <0.18.0. Forcing 1.5.2 would risk breaking HtmlSanitizer (the actual XSS
         defense for Doc.razor) and the .xlsx export, which is a worse outcome than this CVE
         — AngleSharp here never parses untrusted HTML (that's HtmlSanitizer's own job); it's
         only reachable via ClosedXML's CSS parsing for spreadsheet styling. Revisit once
         HtmlSanitizer/ClosedXML ship AngleSharp 1.x-compatible releases. -->
    <PackageReference Include="HtmlSanitizer" Version="9.0.967" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" />
    <!-- Backs the /health/ready endpoint's database probe (AddDbContextCheck). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexus.Domain\Nexus.Domain.csproj" />
    <ProjectReference Include="..\Nexus.Infrastructure\Nexus.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IdentityRedirectManager (and its open-redirect guard) is internal by design; exposed to
         the test project rather than made public so the fix can be pinned by tests without
         widening the app's public surface. -->
    <InternalsVisibleTo Include="Nexus.Web.Tests" />
  </ItemGroup>

</Project>
