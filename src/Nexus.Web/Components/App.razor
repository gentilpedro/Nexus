<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F7F8FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <link rel="shortcut icon" href="@Assets["IconNexus.png"]" type="image/x-icon">
    <base href="/" />
    <ResourcePreloader />
    <!-- External, not inline: the Content-Security-Policy set in Program.cs forbids inline
         script. Still loaded synchronously in <head> so the saved theme is applied before the
         first paint. -->
    <script src="@Assets["js/theme-interop.js"]"></script>
    <link rel="stylesheet" href="@Assets["lib/quill/quill.snow.css"]" />
    @* Ordem importa: tokens → base → componentes → shell → telas (por área) → landing. *@
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets["css/components.css"]" />
    <link rel="stylesheet" href="@Assets["css/shell.css"]" />
    <link rel="stylesheet" href="@Assets["css/views-home.css"]" />
    <link rel="stylesheet" href="@Assets["css/views-tasks.css"]" />
    <link rel="stylesheet" href="@Assets["css/views-workspace.css"]" />
    <link rel="stylesheet" href="@Assets["css/views-account.css"]" />
    <link rel="stylesheet" href="@Assets["css/landing.css"]" />
    <link rel="stylesheet" href="@Assets["Nexus.Web.styles.css"]" />
    @* Inline script: runs only with this response's CSP nonce (#62). *@
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["lib/sortablejs/Sortable.min.js"]"></script>
    <script src="@Assets["lib/quill/quill.js"]"></script>
    <script src="@Assets["lib/chartjs/chart.umd.min.js"]"></script>
    <script src="@Assets["js/ui-interop.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? CspNonce => HttpContext.Items[ContentSecurityPolicy.NonceItemKey] as string;

    // Visitors who aren't signed in get static SSR. The /_blazor hub requires authentication
    // (FallbackPolicy), so an interactive render for them could never connect: the browser logged
    // a redirected /_blazor/initializers, a 401 on negotiate and "Circuit host not initialized"
    // on every public page (#65). None of those pages (landing, invite, 404) needs interactivity
    // before login, and logging in reloads the page, which then renders interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() && HttpContext.User.Identity?.IsAuthenticated == true
            ? InteractiveServer
            : null;
}
