<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="@Assets["IconNexus.png"]" type="image/x-icon">
    <base href="/" />
    <ResourcePreloader />
    <!-- External, not inline: the Content-Security-Policy set in Program.cs forbids inline
         script. Still loaded synchronously in <head> so the saved theme is applied before the
         first paint. -->
    <script src="@Assets["js/theme-interop.js"]"></script>
    <link rel="stylesheet" href="@Assets["lib/quill/quill.snow.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Nexus.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["lib/sortablejs/Sortable.min.js"]"></script>
    <script src="@Assets["lib/quill/quill.js"]"></script>
    <script src="@Assets["lib/chartjs/chart.umd.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
