@using Nexus.Domain.Entities
@using Nexus.Web.Extensions
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="sprint-section @(Sprint?.Status == SprintStatus.Active ? "is-active" : "") @(Sprint is null ? "is-backlog" : "")"
         data-drop-id="@(Sprint?.Id.ToString() ?? "")" aria-labelledby="@headingId">
    <header class="sprint-section-header">
        <div class="sprint-section-heading">
            <h2 id="@headingId" class="sprint-section-title">
                @(Sprint?.Name ?? "Backlog geral")
                @if (Sprint?.Status == SprintStatus.Active)
                {
                    <span class="badge badge--accent">Em andamento</span>
                }
                else if (Sprint?.Status == SprintStatus.Planned)
                {
                    <span class="badge">Planejado</span>
                }
                <span class="tab-count">@Items.Count</span>
            </h2>
            @if (Sprint is not null)
            {
                <p class="sprint-section-dates">
                    <Icon Name="calendar" Class="icon--sm" />
                    @Sprint.StartDateUtc.ToString("d MMM", PtBr).Replace(".", "") – @Sprint.EndDateUtc.ToString("d MMM", PtBr).Replace(".", "")
                </p>
                @if (!string.IsNullOrWhiteSpace(Sprint.Goal))
                {
                    <p class="sprint-section-goal"><Icon Name="target" Class="icon--sm" /> @Sprint.Goal</p>
                }
            }
            else
            {
                <p class="sprint-section-dates">Tarefas que ainda não estão em nenhuma sprint</p>
            }
        </div>
        @if (Sprint is not null && CanManage)
        {
            <div class="button-row">
                @if (Sprint.Status == SprintStatus.Planned)
                {
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@AnotherSprintActive"
                            title="@(AnotherSprintActive ? "Finalize a sprint em andamento antes de iniciar outra" : null)"
                            @onclick="() => OnStart.InvokeAsync(Sprint.Id)">
                        <Icon Name="zap" /> Iniciar sprint
                    </button>
                }
                else if (Sprint.Status == SprintStatus.Active)
                {
                    <a class="btn btn-ghost btn-sm" href="@($"/sprints/{Sprint.Id}/burndown")"><Icon Name="trending-down" /> Burndown</a>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OnComplete.InvokeAsync(Sprint.Id)">
                        <Icon Name="check-circle" /> Finalizar sprint
                    </button>
                }
            </div>
        }
    </header>
    <div class="sprint-section-body" @ref="bodyRef">
        @foreach (var item in Items)
        {
            <div class="backlog-row @(item.Status.Category == StatusCategory.Done ? "is-done" : "")" data-workitem-id="@item.Id" @key="item.Id">
                <span class="backlog-row-grip" aria-hidden="true"><Icon Name="grip" /></span>
                <WorkItemTypeIcon Type="item.Type" />
                <button type="button" class="backlog-row-title" @onclick="() => OnCardClick.InvokeAsync(item)">@item.Title</button>
                @if (item.WorkItemLabels.Count > 0)
                {
                    <span class="backlog-row-labels">
                        @foreach (var label in item.WorkItemLabels.Select(l => l.Label))
                        {
                            <span class="label-chip label-chip--sm" style="background-color: @label.Color; color: @LabelColor.TextColorFor(label.Color);">@label.Name</span>
                        }
                    </span>
                }
                <span class="backlog-row-meta">
                    <StatusBadge Name="@item.Status.Name" Category="item.Status.Category" Color="@item.Status.Color" />
                    <PriorityBadge Priority="item.Priority" IconOnly="true" />
                    @if (item.DueDateUtc is DateTime due)
                    {
                        <span class="task-row-due @(IsOverdue(item) ? "is-overdue" : "")" title="@DueDateLabel.Describe(due, item.Status.Category == StatusCategory.Done)">
                            <span aria-hidden="true">@DueDateLabel.Format(due)</span>
                            <span class="sr-only">@DueDateLabel.Describe(due, item.Status.Category == StatusCategory.Done)</span>
                        </span>
                    }
                    @if (CommentCounts.GetValueOrDefault(item.Id) is > 0 and var commentCount)
                    {
                        <span class="backlog-row-comments" title="@($"{commentCount} comentário(s)")">
                            <Icon Name="chat" Class="icon--sm" /> @commentCount
                            <span class="sr-only">comentários</span>
                        </span>
                    }
                    <span title="@AssigneeLabel(item)">
                        @if (item.Assignee is null)
                        {
                            <span class="avatar avatar--xs avatar--empty" role="img" aria-label="Sem responsável"></span>
                        }
                        else
                        {
                            <Avatar Name="@AssigneeLabel(item)" ImageUrl="@(item.Assignee.AvatarStoragePath is null ? null : AvatarUrl(item.Assignee))" Size="xs" Decorative="false" />
                        }
                    </span>
                </span>
            </div>
        }
        @if (Items.Count == 0)
        {
            <div class="board-column-empty">@(Sprint is null ? "Nenhuma tarefa fora de sprint" : "Arraste tarefas do backlog para esta sprint")</div>
        }
    </div>
</section>

@code {
    [Parameter]
    public Sprint? Sprint { get; set; }

    [Parameter, EditorRequired]
    public List<WorkItem> Items { get; set; } = [];

    [Parameter]
    public bool CanManage { get; set; }

    /// <summary>Comentários por tarefa; tarefa ausente = nenhum comentário.</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, int> CommentCounts { get; set; } = new Dictionary<Guid, int>();

    [Parameter]
    public bool AnotherSprintActive { get; set; }

    [Parameter]
    public EventCallback<WorkItem> OnCardClick { get; set; }

    // Not an EventCallback — see BoardColumn.razor's identical OnCardMoved for why the return
    // value needs to reach the shared board-interop.js onEnd handler.
    [Parameter]
    public Func<(Guid WorkItemId, Guid? NewSprintId, int NewIndex), Task<bool>>? OnCardMoved { get; set; }

    [Parameter]
    public EventCallback<Guid> OnStart { get; set; }

    [Parameter]
    public EventCallback<Guid> OnComplete { get; set; }

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private readonly string headingId = $"sprint-{Guid.NewGuid():N}";

    private static bool IsOverdue(WorkItem item) =>
        item.DueDateUtc is not null && item.Status.Category != StatusCategory.Done && item.DueDateUtc.Value.Date < DateTime.UtcNow.Date;

    private static string AssigneeLabel(WorkItem item) =>
        item.Assignee is null
            ? "Sem responsável"
            : (string.IsNullOrEmpty(item.Assignee.DisplayName) ? item.Assignee.Email ?? "" : item.Assignee.DisplayName);

    private static string AssigneeInitial(WorkItem item)
    {
        if (item.Assignee is null)
        {
            return "?";
        }

        var name = string.IsNullOrEmpty(item.Assignee.DisplayName) ? item.Assignee.Email : item.Assignee.DisplayName;
        return string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string AvatarUrl(ApplicationUser user) =>
        $"/avatars/{user.Id}/download?v={Uri.EscapeDataString(System.IO.Path.GetFileNameWithoutExtension(user.AvatarStoragePath)!)}";

    private ElementReference bodyRef;
    private IJSObjectReference? module;
    private DotNetObjectReference<SprintSection>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/board-interop.js");
            selfRef = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("initColumn", bodyRef, selfRef, "sprint");
        }
    }

    [JSInvokable]
    public async Task<bool> OnCardDropped(Guid workItemId, string newSprintId, int newIndex)
    {
        if (OnCardMoved is null)
        {
            return true;
        }

        Guid? parsed = Guid.TryParse(newSprintId, out var id) ? id : null;
        return await OnCardMoved((workItemId, parsed, newIndex));
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("destroyColumn", bodyRef);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. page navigation/tab close) — nothing to clean up client-side.
            }
        }

        selfRef?.Dispose();
    }
}
