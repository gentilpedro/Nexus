@* Purely client-side (plain onclick + CSS driven by :root[data-theme]) — no Blazor state,
   no JS interop round-trip. Works identically on interactive pages and on static SSR pages
   (Login/Register/Manage), which have no SignalR circuit for IJSRuntime to call back through. *@
<button type="button" class="theme-switch" onclick="window.nexusToggleTheme()" aria-label="Alternar tema">
    <span class="theme-switch-label theme-switch-label--light">Light</span>

    <span class="theme-switch-track">
        <span class="theme-switch-thumb">
            <svg viewBox="0 0 24 24" class="theme-switch-moon" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" />
            </svg>
        </span>
        <span class="theme-switch-dot"></span>
        <span class="theme-switch-star theme-switch-star--1"></span>
        <span class="theme-switch-star theme-switch-star--2"></span>
        <span class="theme-switch-star theme-switch-star--3"></span>
    </span>

    <span class="theme-switch-label theme-switch-label--dark">Dark</span>
</button>
