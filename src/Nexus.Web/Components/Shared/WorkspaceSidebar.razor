@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationContextService NavContext
@inject NotificationBadgeService Badge
@implements IDisposable

@* Navegação em dois níveis:
   1. Itens globais, que levam sempre ao mesmo lugar (Início, Notificações, Chats, Busca).
   2. A árvore de workspaces. Documentos, Chat e Membros ficam DENTRO de cada workspace, em vez
      de itens globais que mudavam de destino conforme a página aberta. *@
<aside id="app-sidebar" class="app-sidebar @(IsOpen ? "is-open" : "")" aria-label="Navegação principal">
    <div class="app-sidebar-drawer-header">
        <span class="topnav-wordmark">Nexus</span>
        <button type="button" class="icon-btn icon-btn--sm" @onclick="OnClose">
            <Icon Name="x" Label="Fechar menu" />
        </button>
    </div>

    <div class="app-sidebar-scroll">
        <nav class="app-sidebar-nav" aria-label="Geral">
            <NavLink class="app-sidebar-nav-link" href="/" Match="NavLinkMatch.All">
                <Icon Name="home" />
                Início
            </NavLink>
            <NavLink class="app-sidebar-nav-link" href="/notifications">
                <Icon Name="inbox" />
                Notificações
                @if (Badge.UnreadCount > 0)
                {
                    <span class="nav-count" aria-label="@($"{Badge.UnreadCount} não lidas")">@(Badge.UnreadCount > 99 ? "99+" : Badge.UnreadCount.ToString())</span>
                }
            </NavLink>
            <NavLink class="app-sidebar-nav-link" href="/chats">
                <Icon Name="chat" />
                Chats
            </NavLink>
            <NavLink class="app-sidebar-nav-link" href="/search">
                <Icon Name="search" />
                Busca
            </NavLink>
        </nav>

        <div class="app-sidebar-section-header">
            <span id="sidebar-workspaces-heading">Workspaces</span>
            <a href="/workspaces/new" class="icon-btn icon-btn--sm app-sidebar-add-btn" data-tooltip="Novo workspace">
                <Icon Name="plus" Label="Novo workspace" />
            </a>
        </div>

        @if (workspaces is null)
        {
            <div class="app-sidebar-loading"><Skeleton Variant="text" Count="3" Label="Carregando workspaces…" /></div>
        }
        else if (workspaces.Count == 0)
        {
            <div class="app-sidebar-empty">
                Você ainda não participa de nenhum workspace.
                <br />
                <a href="/workspaces/new">Criar o primeiro</a>
            </div>
        }
        else
        {
            <ul class="app-sidebar-tree" aria-labelledby="sidebar-workspaces-heading">
                @foreach (var workspace in workspaces)
                {
                    var wsExpanded = expandedWorkspaces.Contains(workspace.Id);
                    var wsGroupId = $"sb-ws-{workspace.Id:N}";
                    <li>
                        <div class="app-sidebar-node @(IsWorkspaceHome(workspace.Id) ? "is-active" : "")">
                            <button type="button" class="app-sidebar-chevron"
                                    aria-expanded="@(wsExpanded ? "true" : "false")" aria-controls="@wsGroupId"
                                    @onclick="() => ToggleWorkspace(workspace.Id)">
                                <Icon Name="chevron-right" Label="@($"{(wsExpanded ? "Recolher" : "Expandir")} {workspace.Name}")" />
                            </button>
                            <a class="app-sidebar-workspace @(IsWorkspaceHome(workspace.Id) ? "active" : "")"
                               href="@($"/workspaces/{workspace.Id}")"
                               aria-current="@(IsWorkspaceHome(workspace.Id) ? "page" : null)">
                                <Avatar Name="@workspace.Name" Color="@workspace.Color" Size="xs" Square="true" />
                                <span class="app-sidebar-label">@workspace.Name</span>
                            </a>
                        </div>

                        @if (wsExpanded)
                        {
                            <ul id="@wsGroupId">
                                <li>
                                    <div class="app-sidebar-node app-sidebar-node--space @(IsSection(workspace.Id, "docs") ? "is-active" : "")">
                                        <span class="app-sidebar-chevron" aria-hidden="true"></span>
                                        <a class="app-sidebar-space @(IsSection(workspace.Id, "docs") ? "active" : "")" href="@($"/workspaces/{workspace.Id}/docs")">
                                            <Icon Name="doc" /><span class="app-sidebar-label">Documentos</span>
                                        </a>
                                    </div>
                                </li>
                                <li>
                                    <div class="app-sidebar-node app-sidebar-node--space @(IsSection(workspace.Id, "chat") ? "is-active" : "")">
                                        <span class="app-sidebar-chevron" aria-hidden="true"></span>
                                        <a class="app-sidebar-space @(IsSection(workspace.Id, "chat") ? "active" : "")" href="@($"/workspaces/{workspace.Id}/chat")">
                                            <Icon Name="chat" /><span class="app-sidebar-label">Chat</span>
                                        </a>
                                    </div>
                                </li>
                                <li>
                                    <div class="app-sidebar-node app-sidebar-node--space @(IsSection(workspace.Id, "members") ? "is-active" : "")">
                                        <span class="app-sidebar-chevron" aria-hidden="true"></span>
                                        <a class="app-sidebar-space @(IsSection(workspace.Id, "members") ? "active" : "")" href="@($"/workspaces/{workspace.Id}/members")">
                                            <Icon Name="team" /><span class="app-sidebar-label">Membros</span>
                                        </a>
                                    </div>
                                </li>

                                @foreach (var space in workspace.Spaces.OrderBy(s => s.SortOrder))
                                {
                                    var spExpanded = expandedSpaces.Contains(space.Id);
                                    var spGroupId = $"sb-sp-{space.Id:N}";
                                    var spaceActive = space.Id == NavContext.SpaceId && NavContext.ListId is null;
                                    <li>
                                        <div class="app-sidebar-node app-sidebar-node--space @(spaceActive ? "is-active" : "")">
                                            <button type="button" class="app-sidebar-chevron"
                                                    aria-expanded="@(spExpanded ? "true" : "false")" aria-controls="@spGroupId"
                                                    @onclick="() => ToggleSpace(space.Id)">
                                                <Icon Name="chevron-right" Label="@($"{(spExpanded ? "Recolher" : "Expandir")} {space.Name}")" />
                                            </button>
                                            <a class="app-sidebar-space @(spaceActive ? "active" : "")"
                                               href="@($"/workspaces/{workspace.Id}/spaces/{space.Id}")"
                                               aria-current="@(spaceActive ? "page" : null)">
                                                <Icon Name="space" /><span class="app-sidebar-label">@space.Name</span>
                                            </a>
                                        </div>

                                        @if (spExpanded)
                                        {
                                            <ul id="@spGroupId">
                                                @if (space.Lists.Count == 0)
                                                {
                                                    <li class="app-sidebar-node app-sidebar-node--list">
                                                        <span class="app-sidebar-list app-sidebar-muted">Nenhuma lista</span>
                                                    </li>
                                                }
                                                @foreach (var list in space.Lists.OrderBy(l => l.SortOrder))
                                                {
                                                    var listActive = list.Id == NavContext.ListId;
                                                    <li class="app-sidebar-node app-sidebar-node--list @(listActive ? "is-active" : "")">
                                                        <a class="app-sidebar-list @(listActive ? "active" : "")"
                                                           href="@($"/lists/{list.Id}/list")"
                                                           aria-current="@(listActive ? "page" : null)">
                                                            <Icon Name="list" /><span class="app-sidebar-label">@list.Name</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</aside>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>Fecha a gaveta (tablet/celular).</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private List<Workspace>? workspaces;
    private readonly HashSet<Guid> expandedWorkspaces = new();
    private readonly HashSet<Guid> expandedSpaces = new();

    protected override async Task OnInitializedAsync()
    {
        NavContext.Changed += OnContextChanged;
        Badge.Changed += OnBadgeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        await LoadAsync();
        EnsureActiveExpanded();
    }

    private string CurrentPath => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool IsWorkspaceHome(Guid workspaceId) =>
        string.Equals(CurrentPath, $"/workspaces/{workspaceId}", StringComparison.OrdinalIgnoreCase);

    private bool IsSection(Guid workspaceId, string section) =>
        CurrentPath.StartsWith($"/workspaces/{workspaceId}/{section}", StringComparison.OrdinalIgnoreCase)
        || (section == "docs" && (CurrentPath.StartsWith($"/workspaces/{workspaceId}/spreadsheets", StringComparison.OrdinalIgnoreCase)))
        || (section == "chat" && CurrentPath.StartsWith($"/chats/{workspaceId}", StringComparison.OrdinalIgnoreCase));

    private async void OnContextChanged()
    {
        await LoadAsync();
        EnsureActiveExpanded();
        await InvokeAsync(StateHasChanged);
    }

    private void OnBadgeChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            workspaces = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        workspaces = await db.Workspaces
            .Where(w => w.Members.Any(m => m.UserId == userId))
            .Include(w => w.Spaces).ThenInclude(s => s.Lists)
            .OrderBy(w => w.Name)
            .ToListAsync();

        // Com um workspace só, abrir a árvore dele de cara poupa um clique em toda visita.
        if (workspaces.Count == 1)
        {
            expandedWorkspaces.Add(workspaces[0].Id);
        }
    }

    private void EnsureActiveExpanded()
    {
        if (NavContext.WorkspaceId is Guid workspaceId)
        {
            expandedWorkspaces.Add(workspaceId);
        }

        if (NavContext.SpaceId is Guid spaceId)
        {
            expandedSpaces.Add(spaceId);
        }
    }

    private void ToggleWorkspace(Guid workspaceId)
    {
        if (!expandedWorkspaces.Remove(workspaceId))
        {
            expandedWorkspaces.Add(workspaceId);
        }
    }

    private void ToggleSpace(Guid spaceId)
    {
        if (!expandedSpaces.Remove(spaceId))
        {
            expandedSpaces.Add(spaceId);
        }
    }

    public void Dispose()
    {
        NavContext.Changed -= OnContextChanged;
        Badge.Changed -= OnBadgeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
