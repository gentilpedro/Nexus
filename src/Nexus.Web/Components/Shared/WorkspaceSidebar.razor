@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationContextService NavContext
@inject NavigationManager NavigationManager
@implements IDisposable

<aside class="app-sidebar @(IsOpen ? "is-open" : "")">
    <nav class="app-sidebar-nav">
        <NavLink class="app-sidebar-nav-link" href="/" Match="NavLinkMatch.All">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
            Dashboard
        </NavLink>
        <NavLink class="app-sidebar-nav-link" href="/search">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
            Tarefas
        </NavLink>
        <NavLink class="app-sidebar-nav-link" href="/chats">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
            Chat
        </NavLink>
        <NavLink class="app-sidebar-nav-link" href="@DocumentsHref" Match="NavLinkMatch.All">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><polyline points="14 2 14 8 20 8" /></svg>
            Documentos
        </NavLink>
        <NavLink class="app-sidebar-nav-link" href="@TeamHref" Match="NavLinkMatch.All">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            Equipe
        </NavLink>
    </nav>

    <div class="app-sidebar-section-header">
        <span>Workspaces</span>
        <a href="/workspaces/new" class="app-sidebar-add-btn" aria-label="Novo workspace" title="Novo workspace">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        </a>
    </div>

    @if (workspaces is null)
    {
        <p class="app-sidebar-loading">Carregando...</p>
    }
    else if (workspaces.Count == 0)
    {
        <p class="app-sidebar-loading">Nenhum workspace ainda.</p>
    }
    else
    {
        <nav class="app-sidebar-tree">
            @foreach (var workspace in workspaces)
            {
                <div class="app-sidebar-node">
                    <button type="button" class="app-sidebar-chevron"
                            @onclick="() => ToggleWorkspace(workspace.Id)"
                            aria-label="Expandir workspace">
                        @(expandedWorkspaces.Contains(workspace.Id) ? "▾" : "▸")
                    </button>
                    <a class="app-sidebar-workspace @(workspace.Id == NavContext.WorkspaceId ? "active" : "")"
                       href="@($"/workspaces/{workspace.Id}")">
                        <span class="app-sidebar-workspace-row">
                            <svg class="icon app-sidebar-workspace-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v18Z" /><path d="M2 22h20" /><path d="M9 6h1" /><path d="M9 10h1" /><path d="M9 14h1" /><path d="M14 6h1" /><path d="M14 10h1" /><path d="M14 14h1" /><path d="M9 22v-4h6v4" /></svg>
                            @workspace.Name
                        </span>
                    </a>
                </div>

                @if (expandedWorkspaces.Contains(workspace.Id))
                {
                    @foreach (var space in workspace.Spaces.OrderBy(s => s.SortOrder))
                    {
                        <div class="app-sidebar-node app-sidebar-node--indent1">
                            <button type="button" class="app-sidebar-chevron"
                                    @onclick="() => ToggleSpace(space.Id)"
                                    aria-label="Expandir space">
                                @(expandedSpaces.Contains(space.Id) ? "▾" : "▸")
                            </button>
                            <a class="app-sidebar-space @(space.Id == NavContext.SpaceId ? "active" : "")"
                               href="@($"/workspaces/{workspace.Id}/spaces/{space.Id}")">
                                @space.Name
                            </a>
                        </div>

                        @if (expandedSpaces.Contains(space.Id))
                        {
                            @foreach (var list in space.Lists.OrderBy(l => l.SortOrder))
                            {
                                <a class="app-sidebar-list @(list.Id == NavContext.ListId ? "active" : "")"
                                   href="@($"/lists/{list.Id}/list")">
                                    @list.Name
                                </a>
                            }
                        }
                    }
                }
            }
        </nav>
    }

    <div class="app-sidebar-footer">
        <form action="Account/Logout" method="post" data-enhance="false" class="app-sidebar-logout-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@NavigationManager.ToBaseRelativePath(NavigationManager.Uri)" />
            <button type="submit" class="app-sidebar-logout" title="Sair">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Sair
            </button>
        </form>
    </div>
</aside>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<Workspace>? workspaces;
    private readonly HashSet<Guid> expandedWorkspaces = new();
    private readonly HashSet<Guid> expandedSpaces = new();

    private string DocumentsHref => NavContext.WorkspaceId is Guid wsId ? $"/workspaces/{wsId}/docs" : "/workspaces";
    private string TeamHref => NavContext.WorkspaceId is Guid wsId ? $"/workspaces/{wsId}/members" : "/workspaces";

    protected override async Task OnInitializedAsync()
    {
        NavContext.Changed += OnContextChanged;
        await LoadAsync();
        EnsureActiveExpanded();
    }

    private async void OnContextChanged()
    {
        await LoadAsync();
        EnsureActiveExpanded();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            workspaces = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        workspaces = await db.Workspaces
            .Where(w => w.Members.Any(m => m.UserId == userId))
            .Include(w => w.Spaces).ThenInclude(s => s.Lists)
            .OrderBy(w => w.Name)
            .ToListAsync();
    }

    private void EnsureActiveExpanded()
    {
        if (NavContext.WorkspaceId is Guid workspaceId)
        {
            expandedWorkspaces.Add(workspaceId);
        }

        if (NavContext.SpaceId is Guid spaceId)
        {
            expandedSpaces.Add(spaceId);
        }
    }

    private void ToggleWorkspace(Guid workspaceId)
    {
        if (!expandedWorkspaces.Remove(workspaceId))
        {
            expandedWorkspaces.Add(workspaceId);
        }
    }

    private void ToggleSpace(Guid spaceId)
    {
        if (!expandedSpaces.Remove(spaceId))
        {
            expandedSpaces.Add(spaceId);
        }
    }

    public void Dispose()
    {
        NavContext.Changed -= OnContextChanged;
    }
}
