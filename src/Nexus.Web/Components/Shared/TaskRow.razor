@using Nexus.Domain.Entities

<div class="dashboard-task-row">
    <div class="dashboard-task-path">
        <a href="@($"/workspaces/{Item.TaskList.Space.WorkspaceId}")">@Item.TaskList.Space.Workspace.Name</a>
        <span>/</span>
        <a href="@($"/workspaces/{Item.TaskList.Space.WorkspaceId}/spaces/{Item.TaskList.SpaceId}")">@Item.TaskList.Space.Name</a>
        <span>/</span>
        <a href="@($"/lists/{Item.TaskListId}/list")">@Item.TaskList.Name</a>
    </div>
    <div class="task-row" @onclick="() => OnClick.InvokeAsync(Item)">
        <WorkItemTypeIcon Type="Item.Type" />
        <span class="task-row-title">@Item.Title</span>
        <StatusBadge Name="@Item.Status.Name" Category="Item.Status.Category" Color="Item.Status.Color" />
        <PriorityBadge Priority="Item.Priority" />
        @if (Item.DueDateUtc is not null)
        {
            <span class="task-row-due @(IsOverdue ? "is-overdue" : "")">@Item.DueDateUtc.Value.ToString("dd/MM")</span>
        }
        <span class="task-row-avatar" title="@AssigneeLabel">@AssigneeInitial</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public WorkItem Item { get; set; } = null!;

    [Parameter]
    public EventCallback<WorkItem> OnClick { get; set; }

    private bool IsOverdue => Item.DueDateUtc is not null && Item.DueDateUtc.Value.Date < DateTime.UtcNow.Date;

    private string AssigneeLabel =>
        Item.Assignee is null
            ? "Sem responsável"
            : (string.IsNullOrEmpty(Item.Assignee.DisplayName) ? Item.Assignee.Email ?? "" : Item.Assignee.DisplayName);

    private string AssigneeInitial
    {
        get
        {
            if (Item.Assignee is null)
            {
                return "?";
            }

            var name = string.IsNullOrEmpty(Item.Assignee.DisplayName) ? Item.Assignee.Email : Item.Assignee.DisplayName;
            return string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
        }
    }
}
