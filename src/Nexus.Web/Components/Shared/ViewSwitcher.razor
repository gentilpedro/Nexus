@using Nexus.Domain.Entities

<nav class="view-tabs" aria-label="Visões da lista">
    @foreach (var (key, label, icon) in Views)
    {
        var active = ActiveView == key;
        <a class="@(active ? "active" : "")" href="@($"/lists/{ListId}/{key}")" aria-current="@(active ? "page" : null)">
            <Icon Name="@icon" />
            @label
        </a>
    }
</nav>

@code {
    [Parameter, EditorRequired]
    public Guid ListId { get; set; }

    [Parameter, EditorRequired]
    public string ActiveView { get; set; } = "list";

    private static readonly (string Key, string Label, string Icon)[] Views =
    [
        ("list", "Lista", "list"),
        ("board", "Kanban", "board"),
        ("backlog", "Backlog", "backlog"),
        ("calendar", "Calendário", "calendar"),
        ("gantt", "Gantt", "gantt")
    ];
}
