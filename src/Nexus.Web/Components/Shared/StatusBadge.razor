@using Nexus.Domain.Entities

@* Fundo neutro + bolinha na cor do status. A cor customizada de um status (escolhida pelo
   usuário) vai só na bolinha — como texto sobre fundo tingido dela, uma cor clara como amarelo
   ficaria ilegível. *@
@if (!string.IsNullOrEmpty(Color))
{
    <span class="badge badge-status" style="--status-dot: @Color">@Name</span>
}
else
{
    <span class="badge badge-status badge-status-@Category.ToString().ToLowerInvariant()">@Name</span>
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter, EditorRequired]
    public StatusCategory Category { get; set; }

    [Parameter]
    public string? Color { get; set; }
}
