@using Nexus.Domain.Entities
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="board-column" data-drop-id="@Status.Id" style="--column-color: @(string.IsNullOrEmpty(Status.Color) ? "var(--status-todo)" : Status.Color)"
         aria-label="@($"{Status.Name}, {Items.Count} {(Items.Count == 1 ? "tarefa" : "tarefas")}")">
    <header class="board-column-header">
        @if (isRenaming)
        {
            <label class="sr-only" for="@($"rename-{Status.Id}")">Novo nome da coluna</label>
            <input id="@($"rename-{Status.Id}")" class="board-column-rename-input" value="@renameValue"
                   @oninput="@(e => renameValue = e.Value?.ToString() ?? "")" @onkeydown="HandleRenameKeyDown" @ref="renameInputRef" />
            <button type="button" class="icon-btn icon-btn--sm" @onclick="SaveRename"><Icon Name="check" Label="Salvar nome" /></button>
            <button type="button" class="icon-btn icon-btn--sm" @onclick="CancelRename"><Icon Name="x" Label="Cancelar" /></button>
        }
        else
        {
            <h2 class="board-column-title">
                <span class="board-column-dot" aria-hidden="true"></span>
                <span class="board-column-name">@Status.Name</span>
                <span class="board-column-count" aria-hidden="true">@Items.Count</span>
            </h2>
            @if (CanManage)
            {
                <div class="menu-anchor" @onkeydown="HandleMenuKey">
                    <button type="button" class="icon-btn icon-btn--sm" @onclick="ToggleMenu"
                            aria-haspopup="menu" aria-expanded="@(menuOpen ? "true" : "false")">
                        <Icon Name="more" Label="@($"Opções da coluna {Status.Name}")" />
                    </button>
                    @if (menuOpen)
                    {
                        <div class="menu-backdrop" @onclick="CloseMenu"></div>
                        <div class="menu" role="menu">
                            <button type="button" role="menuitem" @onclick="StartRename"><Icon Name="edit" /> Renomear</button>
                            <button type="button" role="menuitem" class="is-danger" @onclick="HandleDeleteClick"><Icon Name="trash" /> Excluir coluna</button>
                        </div>
                    }
                </div>
            }
        }
    </header>
    <div class="board-column-body" @ref="bodyRef">
        @foreach (var item in Items)
        {
            <TaskCard WorkItem="item" OnClick="OnCardClick" @key="item.Id" />
        }
        @if (Items.Count == 0)
        {
            <div class="board-column-empty">Solte tarefas aqui</div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public TaskStatusDefinition Status { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<WorkItem> Items { get; set; } = [];

    [Parameter]
    public EventCallback<WorkItem> OnCardClick { get; set; }

    // Not an EventCallback: the caller's result (was the move allowed?) needs to travel back
    // to the JS interop layer via OnCardDropped's return value so it can undo Sortable's DOM
    // move on rejection — EventCallback.InvokeAsync doesn't surface a return value.
    [Parameter]
    public Func<(Guid WorkItemId, Guid NewStatusId, int NewIndex), Task<bool>>? OnCardMoved { get; set; }

    [Parameter]
    public bool CanManage { get; set; }

    [Parameter]
    public EventCallback<(Guid StatusId, string NewName)> OnRename { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    private bool menuOpen;
    private bool isRenaming;
    private string renameValue = "";
    private ElementReference renameInputRef;
    private ElementReference bodyRef;
    private IJSObjectReference? module;
    private DotNetObjectReference<BoardColumn>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/board-interop.js");
            selfRef = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("initColumn", bodyRef, selfRef, "board");
        }
    }

    [JSInvokable]
    public async Task<bool> OnCardDropped(Guid workItemId, Guid newStatusId, int newIndex)
    {
        return OnCardMoved is null || await OnCardMoved((workItemId, newStatusId, newIndex));
    }

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private void HandleMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            menuOpen = false;
        }
    }

    private async Task StartRename()
    {
        menuOpen = false;
        renameValue = Status.Name;
        isRenaming = true;
        await Task.Yield();
        try
        {
            await renameInputRef.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — nothing to focus.
        }
    }

    private void CancelRename() => isRenaming = false;

    private async Task SaveRename()
    {
        isRenaming = false;
        var trimmed = renameValue.Trim();
        if (string.IsNullOrEmpty(trimmed) || trimmed == Status.Name)
        {
            return;
        }

        if (OnRename.HasDelegate)
        {
            await OnRename.InvokeAsync((Status.Id, trimmed));
        }
    }

    private async Task HandleRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveRename();
        }
        else if (e.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task HandleDeleteClick()
    {
        menuOpen = false;
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Status.Id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("destroyColumn", bodyRef);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. page navigation/tab close) — nothing to clean up client-side.
            }
        }

        selfRef?.Dispose();
    }
}
