@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject AttachmentStorageService Storage
@inject BrevoMailer Mailer
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject IJSRuntime JS
@inject ToastService Toasts

@* Painel lateral de tarefa: <dialog> nativo aberto com showModal() — foco preso dentro dele,
   Esc e clique fora fecham, o resto da página fica inerte para teclado e leitor de tela. *@
<dialog @ref="dialogRef" class="dialog sheet" aria-labelledby="task-panel-title" @oncancel="CloseAsync">
    @if (isOpen)
    {
        @if (viewMode && isEditing)
        {
            <header class="sheet-header">
                <span class="task-view-id">
                    <WorkItemTypeIcon Type="model.Type" />
                    <span>@TicketCode</span>
                </span>
                <div class="sheet-header-actions">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="EnterEditMode">
                        <Icon Name="edit" /> Editar
                    </button>
                    <button type="button" class="icon-btn icon-btn--sm" @onclick="CloseAsync">
                        <Icon Name="x" Label="Fechar painel" />
                    </button>
                </div>
            </header>

            <div class="sheet-body">
                <h2 id="task-panel-title" class="task-view-title">@model.Title</h2>

                <dl class="task-view-meta">
                    <div class="task-view-meta-row">
                        <dt>Status</dt>
                        <dd>
                            @if (CurrentStatus is not null)
                            {
                                <StatusBadge Name="@CurrentStatus.Name" Category="CurrentStatus.Category" Color="@CurrentStatus.Color" />
                            }
                        </dd>
                    </div>
                    <div class="task-view-meta-row">
                        <dt>Responsável</dt>
                        <dd class="task-view-person">
                            @if (string.IsNullOrEmpty(model.AssigneeId))
                            {
                                <span class="avatar avatar--sm avatar--empty" aria-hidden="true"></span>
                                <span class="cell-muted">Sem responsável</span>
                            }
                            else
                            {
                                <Avatar Name="@AssigneeDisplayName" Size="sm" />
                                <span>@AssigneeDisplayName</span>
                            }
                        </dd>
                    </div>
                    <div class="task-view-meta-row">
                        <dt>Prioridade</dt>
                        <dd><PriorityBadge Priority="model.Priority" /></dd>
                    </div>
                    <div class="task-view-meta-row">
                        <dt>Prazo</dt>
                        <dd>
                            @if (model.DueDate is DateTime due)
                            {
                                var overdue = CurrentStatus?.Category != StatusCategory.Done && DueDateLabel.IsOverdue(due);
                                <span class="@(overdue ? "text-danger" : "")">
                                    @due.ToString("dd/MM/yyyy")
                                    @if (overdue)
                                    {
                                        <span class="badge badge--danger">Atrasada</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="cell-muted">Sem prazo</span>
                            }
                        </dd>
                    </div>
                    @if (model.StartDate is DateTime start)
                    {
                        <div class="task-view-meta-row">
                            <dt>Início</dt>
                            <dd>@start.ToString("dd/MM/yyyy")</dd>
                        </div>
                    }
                    @if (selectedLabelIds.Count > 0)
                    {
                        <div class="task-view-meta-row">
                            <dt>Labels</dt>
                            <dd class="task-view-labels">
                                @foreach (var label in Labels.Where(l => selectedLabelIds.Contains(l.Id)))
                                {
                                    <span class="label-chip" style="background-color: @label.Color; color: @LabelColor.TextColorFor(label.Color);">@label.Name</span>
                                }
                            </dd>
                        </div>
                    }
                </dl>

                <section class="task-view-section" aria-labelledby="task-desc-title">
                    <h3 id="task-desc-title">Descrição</h3>
                    @if (!string.IsNullOrWhiteSpace(model.Description))
                    {
                        <p class="task-view-description">@model.Description</p>
                    }
                    else
                    {
                        <button type="button" class="task-view-empty-field" @onclick="EnterEditMode">Adicionar uma descrição…</button>
                    }
                </section>

                <section class="task-view-section" aria-labelledby="task-attach-title">
                    <h3 id="task-attach-title">Anexos @if (attachments.Count > 0) { <span class="tab-count">@attachments.Count</span> }</h3>
                    @AttachmentsBlock
                </section>

                <section class="task-view-section task-view-comments" aria-labelledby="task-comments-title">
                    <h3 id="task-comments-title">Comentários @if (comments is { Count: > 0 }) { <span class="tab-count">@comments.Count</span> }</h3>
                    @if (commentsTruncated)
                    {
                        <p class="field-hint">Mostrando os @MaxComments comentários mais recentes.</p>
                    }
                    @if (comments is null)
                    {
                        <Skeleton Count="2" Label="Carregando comentários…" />
                    }
                    else if (comments.Count > 0)
                    {
                        <ol class="comment-list">
                            @foreach (var comment in comments)
                            {
                                <li class="comment">
                                    <Avatar Name="@CommentAuthorLabel(comment)" Size="sm" />
                                    <div class="comment-body">
                                        <div class="comment-meta">
                                            <span class="comment-author">@CommentAuthorLabel(comment)</span>
                                            <time class="comment-time" datetime="@comment.CreatedAtUtc.ToString("o")">@comment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</time>
                                        </div>
                                        <p class="comment-content">@comment.Content</p>
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                    <div class="task-comment-compose">
                        <label for="task-new-comment" class="sr-only">Novo comentário</label>
                        <textarea id="task-new-comment" rows="2" placeholder="Escreva um comentário…" @bind="newCommentText" @bind:event="oninput" maxlength="4000"></textarea>
                        <button type="button" class="btn btn-sm @(isSavingComment ? "is-loading" : "")"
                                disabled="@(isSavingComment || string.IsNullOrWhiteSpace(newCommentText))" @onclick="HandleAddComment">
                            Comentar
                        </button>
                    </div>
                </section>

                @if (editingCreatedAtUtc is not null)
                {
                    <p class="task-view-timestamps">
                        Criada em @editingCreatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")
                        @if (editingUpdatedAtUtc is not null)
                        {
                            <text> · Atualizada em @editingUpdatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</text>
                        }
                    </p>
                }
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleSave" class="sheet-form">
                <header class="sheet-header">
                    <h2 id="task-panel-title" class="sheet-title">@(isEditing ? "Editar tarefa" : "Nova tarefa")</h2>
                    <button type="button" class="icon-btn icon-btn--sm" @onclick="CloseAsync">
                        <Icon Name="x" Label="Fechar painel" />
                    </button>
                </header>

                <div class="sheet-body">
                    <DataAnnotationsValidator />
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
                    }
                    <div class="form-field">
                        <label for="task-title" class="required">Título</label>
                        <InputText id="task-title" @bind-Value="model.Title" placeholder="O que precisa ser feito?" autofocus />
                        <ValidationMessage For="() => model.Title" />
                    </div>
                    <div class="form-field">
                        <label for="task-description">Descrição</label>
                        <InputTextArea id="task-description" @bind-Value="model.Description" rows="4" maxlength="@WorkItem.MaxDescriptionLength" placeholder="Contexto, critérios de aceite, links úteis…" />
                    </div>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="task-status">Status</label>
                            <InputSelect id="task-status" @bind-Value="model.StatusId">
                                @foreach (var s in AllowedStatuses)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </InputSelect>
                            @if (isEditing && StatusTransitions.Count > 0)
                            {
                                <span class="field-hint">Só aparecem os status permitidos pelo fluxo da lista.</span>
                            }
                        </div>
                        <div class="form-field">
                            <label for="task-assignee">Responsável</label>
                            <InputSelect id="task-assignee" @bind-Value="model.AssigneeId">
                                <option value="">Ninguém</option>
                                @foreach (var option in AssigneeOptions)
                                {
                                    <option value="@option.UserId">@option.DisplayName</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="task-type">Tipo</label>
                            <InputSelect id="task-type" @bind-Value="model.Type">
                                @foreach (var t in Enum.GetValues<WorkItemType>())
                                {
                                    <option value="@t">@t.ToDisplayLabel()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-field">
                            <label for="task-priority">Prioridade</label>
                            <InputSelect id="task-priority" @bind-Value="model.Priority">
                                @foreach (var p in Enum.GetValues<WorkItemPriority>())
                                {
                                    <option value="@p">@p.ToDisplayLabel()</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="task-start-date">Início</label>
                            <InputDate id="task-start-date" @bind-Value="model.StartDate" />
                        </div>
                        <div class="form-field">
                            <label for="task-due-date">Prazo</label>
                            <InputDate id="task-due-date" @bind-Value="model.DueDate" />
                        </div>
                    </div>
                    <div class="form-field">
                        <label for="task-epic">Epic</label>
                        <InputSelect id="task-epic" @bind-Value="model.ParentEpicId">
                            <option value="">Nenhum</option>
                            @foreach (var epic in EpicOptions.Where(e => e.Id != editingId))
                            {
                                <option value="@epic.Id">@epic.Title</option>
                            }
                        </InputSelect>
                    </div>

                    @if (Labels.Count > 0)
                    {
                        <fieldset class="form-field form-fieldset">
                            <legend class="field-label">Labels</legend>
                            <div class="label-toggle-row">
                                @foreach (var label in Labels)
                                {
                                    var selected = selectedLabelIds.Contains(label.Id);
                                    <button type="button"
                                            class="label-chip-toggle"
                                            style="@LabelToggleStyle(label)"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            @onclick="() => ToggleLabel(label.Id)">
                                        @if (selected)
                                        {
                                            <Icon Name="check" Class="icon--sm" />
                                        }
                                        @label.Name
                                    </button>
                                }
                            </div>
                        </fieldset>
                    }

                    @if (CustomFieldDefinitions.Count > 0)
                    {
                        <div class="form-section">
                            <h3 class="form-section-title">Campos da lista</h3>
                            @foreach (var field in CustomFieldDefinitions)
                            {
                                <div class="form-field">
                                    <label for="@($"custom-field-{field.Id}")" class="@(field.Required ? "required" : "")">@field.Name</label>
                                    @switch (field.Type)
                                    {
                                        case CustomFieldType.Text:
                                            <input id="@($"custom-field-{field.Id}")" type="text" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")" />
                                            break;
                                        case CustomFieldType.Number:
                                            <input id="@($"custom-field-{field.Id}")" type="number" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")" />
                                            break;
                                        case CustomFieldType.Date:
                                            <input id="@($"custom-field-{field.Id}")" type="date" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")" />
                                            break;
                                        case CustomFieldType.Select:
                                            <select id="@($"custom-field-{field.Id}")" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")">
                                                <option value="">—</option>
                                                @foreach (var option in field.Options)
                                                {
                                                    <option value="@option.Id">@option.Label</option>
                                                }
                                            </select>
                                            break;
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (isEditing)
                    {
                        <div class="form-section">
                            <h3 class="form-section-title">Anexos</h3>
                            @AttachmentsBlock
                        </div>
                    }
                    else
                    {
                        <p class="field-hint task-attachment-hint"><Icon Name="paperclip" Class="icon--sm" /> Você poderá anexar arquivos depois de criar a tarefa.</p>
                    }
                </div>

                <footer class="sheet-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HandleCancelClick">Cancelar</button>
                    <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving">
                        @(isEditing ? "Salvar alterações" : "Criar tarefa")
                    </button>
                </footer>
            </EditForm>
        }
    }
</dialog>

<ConfirmDialog @ref="confirm" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Parameter, EditorRequired]
    public Guid TaskListId { get; set; }

    [Parameter, EditorRequired]
    public List<TaskStatusDefinition> Statuses { get; set; } = [];

    [Parameter, EditorRequired]
    public List<(string UserId, string DisplayName)> AssigneeOptions { get; set; } = [];

    [Parameter]
    public List<WorkItem> EpicOptions { get; set; } = [];

    [Parameter]
    public List<CustomFieldDefinition> CustomFieldDefinitions { get; set; } = [];

    [Parameter]
    public List<StatusTransition> StatusTransitions { get; set; } = [];

    [Parameter]
    public List<Label> Labels { get; set; } = [];

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private ElementReference dialogRef;
    private ConfirmDialog? confirm;
    private bool showRequested;

    private bool isOpen;
    private bool isEditing;
    private bool viewMode;
    private bool isSaving;
    private string? errorMessage;
    private Guid? editingId;
    private Guid? originalStatusId;
    private DateTime? editingCreatedAtUtc;
    private DateTime? editingUpdatedAtUtc;
    private WorkItem? editingItem;
    private string? currentUserId;
    private bool canManageAttachments;
    private readonly WorkItemFormModel model = new();
    private readonly Dictionary<Guid, string> customFieldValues = new();
    private readonly Dictionary<Guid, string> originalCustomFieldValues = new();
    private readonly HashSet<Guid> selectedLabelIds = new();
    private readonly HashSet<Guid> originalLabelIds = new();
    private List<WorkItemAttachment> attachments = [];
    private string? uploadError;
    // Ceiling on how many comments one task's thread loads into the circuit at once.
    private const int MaxComments = 200;

    private List<WorkItemComment>? comments;
    private bool commentsTruncated;
    private string newCommentText = "";
    private bool isSavingComment;

    private string TicketCode => editingId is null ? "" : "TASK-" + editingId.Value.ToString("N")[..6].ToUpperInvariant();

    private TaskStatusDefinition? CurrentStatus => Statuses.FirstOrDefault(s => s.Id == model.StatusId);

    private string AssigneeDisplayName => string.IsNullOrEmpty(model.AssigneeId)
        ? "Sem responsável"
        : (AssigneeOptions.FirstOrDefault(o => o.UserId == model.AssigneeId).DisplayName ?? "Sem responsável");

    // Unrestricted (all Statuses) when creating, or when the list has no configured
    // transitions at all — only narrows down once editing AND rules exist for this list.
    private List<TaskStatusDefinition> AllowedStatuses
    {
        get
        {
            if (!isEditing || originalStatusId is null || StatusTransitions.Count == 0)
            {
                return Statuses;
            }

            var reachableIds = StatusTransitions
                .Where(t => t.FromStatusId == originalStatusId)
                .Select(t => t.ToStatusId)
                .ToHashSet();
            reachableIds.Add(originalStatusId.Value);

            return Statuses.Where(s => reachableIds.Contains(s.Id)).ToList();
        }
    }

    public void OpenForCreate()
    {
        isEditing = false;
        viewMode = false;
        editingId = null;
        editingItem = null;
        originalStatusId = null;
        errorMessage = null;
        model.Reset();
        model.StatusId = Statuses.FirstOrDefault(s => s.IsDefault)?.Id ?? Statuses.FirstOrDefault()?.Id ?? Guid.Empty;
        model.StartDate = DateTime.Today;
        ResetCustomFieldValues();
        selectedLabelIds.Clear();
        attachments = [];
        comments = [];
        uploadError = null;
        isOpen = true;
        showRequested = true;
        StateHasChanged();
    }

    public async Task OpenForEdit(WorkItem item)
    {
        isEditing = true;
        viewMode = true;
        editingId = item.Id;
        editingItem = item;
        originalStatusId = item.StatusId;
        editingCreatedAtUtc = item.CreatedAtUtc;
        editingUpdatedAtUtc = item.UpdatedAtUtc;
        errorMessage = null;
        PopulateModelFrom(item);

        var authState = await AuthStateTask!;
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var workspaceId = await QueryService.GetWorkspaceIdForListAsync(TaskListId);
        canManageAttachments = workspaceId is not null && (await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId.Value, new WorkspaceAccessRequirement(WorkspaceRole.Admin))).Succeeded;

        ResetCustomFieldValues();
        selectedLabelIds.Clear();
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var existingValues = await db.CustomFieldValues
                .Where(v => v.WorkItemId == item.Id)
                .ToListAsync();
            foreach (var value in existingValues)
            {
                customFieldValues[value.CustomFieldDefinitionId] = value.Value;
            }

            var existingLabelIds = await db.WorkItemLabels
                .Where(l => l.WorkItemId == item.Id)
                .Select(l => l.LabelId)
                .ToListAsync();
            foreach (var labelId in existingLabelIds)
            {
                selectedLabelIds.Add(labelId);
            }
        }

        originalCustomFieldValues.Clear();
        foreach (var (k, v) in customFieldValues)
        {
            originalCustomFieldValues[k] = v;
        }
        originalLabelIds.Clear();
        foreach (var id in selectedLabelIds)
        {
            originalLabelIds.Add(id);
        }

        uploadError = null;
        await LoadAttachmentsAsync();
        await LoadCommentsAsync();

        isOpen = true;
        showRequested = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showRequested)
        {
            showRequested = false;
            await JS.InvokeVoidAsync("nexusUi.showModal", dialogRef);
        }
    }

    private void PopulateModelFrom(WorkItem item)
    {
        model.Title = item.Title;
        model.Description = item.Description ?? "";
        model.Type = item.Type;
        model.Priority = item.Priority;
        model.StatusId = item.StatusId;
        model.AssigneeId = item.AssigneeId ?? "";
        model.StartDate = item.StartDateUtc?.Date;
        model.DueDate = item.DueDateUtc?.Date;
        model.ParentEpicId = item.ParentEpicId?.ToString() ?? "";
    }

    private void EnterEditMode()
    {
        viewMode = false;
    }

    private async Task HandleCancelClick()
    {
        if (isEditing)
        {
            if (editingItem is not null)
            {
                PopulateModelFrom(editingItem);
            }
            selectedLabelIds.Clear();
            foreach (var id in originalLabelIds)
            {
                selectedLabelIds.Add(id);
            }
            customFieldValues.Clear();
            foreach (var (k, v) in originalCustomFieldValues)
            {
                customFieldValues[k] = v;
            }
            errorMessage = null;
            viewMode = true;
        }
        else
        {
            await CloseAsync();
        }
    }

    private async Task LoadCommentsAsync()
    {
        if (editingId is null)
        {
            comments = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Capped: a long-running task can accumulate an unbounded comment thread, and this loaded
        // all of it every time the panel opened. Takes the most recent MaxComments and reverses
        // them back into chronological order, so the newest are the ones guaranteed to be shown.
        var recent = await db.WorkItemComments
            .Where(c => c.WorkItemId == editingId.Value)
            .Include(c => c.User)
            .OrderByDescending(c => c.CreatedAtUtc)
            .Take(MaxComments + 1)
            .ToListAsync();

        commentsTruncated = recent.Count > MaxComments;
        if (commentsTruncated)
        {
            recent.RemoveAt(recent.Count - 1);
        }

        recent.Reverse();
        comments = recent;
    }

    private async Task HandleAddComment()
    {
        if (string.IsNullOrWhiteSpace(newCommentText) || editingId is null)
        {
            return;
        }

        isSavingComment = true;

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.WorkItemComments.Add(new WorkItemComment
            {
                Id = Guid.NewGuid(),
                WorkItemId = editingId.Value,
                UserId = currentUserId,
                Content = newCommentText.Trim(),
                CreatedAtUtc = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
        }

        newCommentText = "";
        isSavingComment = false;
        await LoadCommentsAsync();
    }

    private static string CommentAuthorLabel(WorkItemComment comment) =>
        comment.User is null
            ? "Usuário removido"
            : (string.IsNullOrEmpty(comment.User.DisplayName) ? comment.User.Email ?? "" : comment.User.DisplayName);

    private static string CommentAuthorInitial(WorkItemComment comment)
    {
        var label = CommentAuthorLabel(comment);
        return string.IsNullOrWhiteSpace(label) || label == "Usuário removido" ? "?" : label.Trim()[0].ToString().ToUpperInvariant();
    }

    private async Task LoadAttachmentsAsync()
    {
        if (editingId is null)
        {
            attachments = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        attachments = await db.WorkItemAttachments
            .Where(a => a.WorkItemId == editingId.Value)
            .OrderByDescending(a => a.UploadedAtUtc)
            .ToListAsync();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        if (editingId is null)
        {
            return;
        }

        uploadError = null;

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > AttachmentStorageService.MaxSizeBytes)
            {
                uploadError = $"\"{file.Name}\" excede o limite de 10 MB e não foi anexado.";
                continue;
            }

            if (!AttachmentStorageService.IsAllowedContentType(file.ContentType))
            {
                uploadError = $"\"{file.Name}\" tem um tipo de arquivo não permitido.";
                continue;
            }

            var attachmentId = Guid.NewGuid();
            string storagePath;
            try
            {
                await using var stream = file.OpenReadStream(AttachmentStorageService.MaxSizeBytes);
                storagePath = await Storage.SaveAsync(editingId.Value, attachmentId, file.Name, stream, file.ContentType);
            }
            catch (InvalidDataException)
            {
                // File's actual bytes contradict the content type the browser reported.
                errorMessage = $"\"{file.Name}\" não corresponde ao tipo de arquivo informado e não foi enviado.";
                continue;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            db.WorkItemAttachments.Add(new WorkItemAttachment
            {
                Id = attachmentId,
                WorkItemId = editingId.Value,
                FileName = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                SizeBytes = file.Size,
                StoragePath = storagePath,
                UploadedByUserId = currentUserId,
                UploadedAtUtc = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
        }

        await LoadAttachmentsAsync();
    }

    private async Task HandleDeleteAttachment(Guid attachmentId, string fileName)
    {
        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("anexo", fileName, "O arquivo deixa de estar disponível para todos na tarefa.")))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var attachment = await db.WorkItemAttachments
            .Where(a => a.Id == attachmentId)
            .Select(a => new { a.StoragePath, a.UploadedByUserId })
            .FirstOrDefaultAsync();

        if (attachment is null)
        {
            return;
        }

        // Re-check server-side, not just the button's visibility — the UI hides the button for
        // other members' attachments, but that alone doesn't stop a request crafted otherwise.
        if (attachment.UploadedByUserId != currentUserId && !canManageAttachments)
        {
            return;
        }

        await db.WorkItemAttachments.Where(a => a.Id == attachmentId).ExecuteDeleteAsync();
        Storage.Delete(attachment.StoragePath);
        await LoadAttachmentsAsync();
        Toasts.Show("Anexo excluído");
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    private void ToggleLabel(Guid labelId)
    {
        if (!selectedLabelIds.Remove(labelId))
        {
            selectedLabelIds.Add(labelId);
        }
    }

    private string LabelToggleStyle(Label label)
    {
        if (selectedLabelIds.Contains(label.Id))
        {
            return $"background-color: {label.Color}; color: {LabelColor.TextColorFor(label.Color)}; border-color: {label.Color};";
        }

        return $"background-color: transparent; color: {label.Color}; border-color: {label.Color};";
    }

    private void ResetCustomFieldValues()
    {
        customFieldValues.Clear();
        foreach (var field in CustomFieldDefinitions)
        {
            customFieldValues[field.Id] = "";
        }
    }

    private async Task CloseAsync()
    {
        isOpen = false;
        try
        {
            await JS.InvokeVoidAsync("nexusUi.close", dialogRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuito encerrado: não há painel para fechar no navegador.
        }
    }

    private RenderFragment AttachmentsBlock => @<div class="attachments">
        @if (!string.IsNullOrEmpty(uploadError))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@uploadError</span></div>
        }
        @if (attachments.Count > 0)
        {
            <ul class="attachment-list">
                @foreach (var attachment in attachments)
                {
                    <li class="attachment-item">
                        <span class="attachment-icon" aria-hidden="true"><Icon Name="file" /></span>
                        <a class="attachment-name" href="@($"/attachments/{attachment.Id}/download")" target="_blank" rel="noopener">@attachment.FileName</a>
                        <span class="attachment-meta">@FormatSize(attachment.SizeBytes)</span>
                        @if (attachment.UploadedByUserId == currentUserId || canManageAttachments)
                        {
                            <button type="button" class="icon-btn icon-btn--sm is-danger" @onclick="() => HandleDeleteAttachment(attachment.Id, attachment.FileName)">
                                <Icon Name="trash" Label="@($"Excluir {attachment.FileName}")" />
                            </button>
                        }
                    </li>
                }
            </ul>
        }
        <label class="file-drop">
            <Icon Name="upload" />
            <span><strong>Escolher arquivos</strong> ou arrastar para cá</span>
            <span class="field-hint">Até 10 MB por arquivo</span>
            <InputFile OnChange="HandleFileUpload" multiple class="file-drop-input" />
        </label>
    </div>;

    // Resolves this panel's workspace from the list it is showing and asks for a fresh
    // authorization decision. WorkspaceAuthorizationHandler hits the database every call and
    // caches nothing, so the answer always reflects the user's current role.
    private async Task<bool> HasCurrentWorkspaceAccessAsync(WorkspaceRole minimumRole)
    {
        var workspaceId = await QueryService.GetWorkspaceIdForListAsync(TaskListId);
        return workspaceId is not null
            && await AccessGuard.HasAccessAsync(AuthStateTask, workspaceId.Value, minimumRole);
    }

    private async Task HandleSave()
    {
        // Re-check membership at write time. The parent page authorized once when it loaded, but
        // this panel lives inside a circuit that can stay open for hours — long enough for the
        // user to have been removed from the workspace in the meantime. See WorkspaceAccessGuard.
        if (!await HasCurrentWorkspaceAccessAsync(WorkspaceRole.Member))
        {
            errorMessage = "Você não tem mais acesso a este workspace.";
            isSaving = false;
            return;
        }

        isSaving = true;
        errorMessage = null;

        if (model.StartDate.HasValue && model.DueDate.HasValue && model.StartDate.Value > model.DueDate.Value)
        {
            errorMessage = "A data de início precisa ser antes do prazo.";
            isSaving = false;
            return;
        }

        var missingRequiredField = CustomFieldDefinitions.FirstOrDefault(f =>
            f.Required && string.IsNullOrWhiteSpace(customFieldValues.GetValueOrDefault(f.Id)));
        if (missingRequiredField is not null)
        {
            errorMessage = $"O campo \"{missingRequiredField.Name}\" é obrigatório.";
            isSaving = false;
            return;
        }

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            WorkItem workItem;
            if (isEditing && editingId is not null)
            {
                workItem = await db.WorkItems.FirstAsync(w => w.Id == editingId.Value);
            }
            else
            {
                workItem = new WorkItem { Id = Guid.NewGuid(), TaskListId = TaskListId, CreatedAtUtc = DateTime.UtcNow, CreatedByUserId = currentUserId };
                db.WorkItems.Add(workItem);
            }

            var previousAssigneeId = workItem.AssigneeId;

            if (isEditing && workItem.StatusId != model.StatusId
                && !await QueryService.IsStatusTransitionAllowedAsync(db, workItem.TaskListId, workItem.StatusId, model.StatusId))
            {
                errorMessage = "Essa mudança de status não é permitida pelo workflow da lista.";
                isSaving = false;
                return;
            }

            workItem.Title = model.Title.Trim();
            workItem.Description = string.IsNullOrWhiteSpace(model.Description) ? null : model.Description.Trim();
            workItem.Type = model.Type;
            workItem.Priority = model.Priority;
            workItem.StatusId = model.StatusId;
            workItem.AssigneeId = string.IsNullOrEmpty(model.AssigneeId) ? null : model.AssigneeId;
            workItem.StartDateUtc = model.StartDate.HasValue ? DateTime.SpecifyKind(model.StartDate.Value, DateTimeKind.Utc) : null;
            workItem.DueDateUtc = model.DueDate.HasValue ? DateTime.SpecifyKind(model.DueDate.Value, DateTimeKind.Utc) : null;
            workItem.ParentEpicId = Guid.TryParse(model.ParentEpicId, out var epicId) ? epicId : null;
            if (isEditing)
            {
                workItem.UpdatedAtUtc = DateTime.UtcNow;
            }

            // Notify the new assignee — but not for a no-op re-save of the same assignee,
            // and not when someone assigns a task to themselves.
            if (workItem.AssigneeId is not null && workItem.AssigneeId != previousAssigneeId && workItem.AssigneeId != currentUserId)
            {
                var assigner = await db.Users.Where(u => u.Id == currentUserId)
                    .Select(u => new { u.DisplayName, u.Email }).FirstOrDefaultAsync();
                var assignerName = string.IsNullOrEmpty(assigner?.DisplayName) ? (assigner?.Email ?? "Alguém") : assigner.DisplayName;

                db.Notifications.Add(new Notification
                {
                    Id = Guid.NewGuid(),
                    UserId = workItem.AssigneeId,
                    Type = NotificationType.TaskAssigned,
                    Message = Notification.TruncateMessage($"{assignerName} atribuiu \"{workItem.Title.Trim()}\" a você."),
                    WorkItemId = workItem.Id,
                    IsRead = false,
                    CreatedAtUtc = DateTime.UtcNow
                });

                var assigneeEmail = await db.Users.Where(u => u.Id == workItem.AssigneeId)
                    .Select(u => u.Email).FirstOrDefaultAsync();
                if (!string.IsNullOrEmpty(assigneeEmail))
                {
                    var taskUrl = NavigationManager.ToAbsoluteUri($"/lists/{workItem.TaskListId}/list").ToString();
                    // Display name and task title are user-controlled — encode before dropping
                    // them into an HTML email body, or a name/title like "<a href=evil>..." would
                    // render as a live link in the recipient's inbox.
                    var safeAssignerName = System.Net.WebUtility.HtmlEncode(assignerName);
                    var safeTitle = System.Net.WebUtility.HtmlEncode(workItem.Title.Trim());
                    await Mailer.SendAsync(
                        assigneeEmail,
                        $"{safeAssignerName} atribuiu uma tarefa a você no Nexus",
                        $"<p>{safeAssignerName} atribuiu a tarefa <strong>{safeTitle}</strong> a você.</p><p><a href='{taskUrl}'>Clique aqui para abrir</a>.</p>");
                }
            }

            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                errorMessage = "Essa tarefa foi alterada por outra pessoa enquanto você editava. Recarregue a página e tente novamente.";
                isSaving = false;
                return;
            }

            var existingValues = await db.CustomFieldValues
                .Where(v => v.WorkItemId == workItem.Id)
                .ToListAsync();

            foreach (var (definitionId, value) in customFieldValues)
            {
                var existing = existingValues.FirstOrDefault(v => v.CustomFieldDefinitionId == definitionId);
                if (string.IsNullOrWhiteSpace(value))
                {
                    if (existing is not null)
                    {
                        db.CustomFieldValues.Remove(existing);
                    }
                }
                else if (existing is not null)
                {
                    existing.Value = value;
                }
                else
                {
                    db.CustomFieldValues.Add(new CustomFieldValue { Id = Guid.NewGuid(), WorkItemId = workItem.Id, CustomFieldDefinitionId = definitionId, Value = value });
                }
            }

            var existingLabelLinks = await db.WorkItemLabels
                .Where(l => l.WorkItemId == workItem.Id)
                .ToListAsync();

            foreach (var link in existingLabelLinks)
            {
                if (!selectedLabelIds.Contains(link.LabelId))
                {
                    db.WorkItemLabels.Remove(link);
                }
            }

            var existingLabelIdSet = existingLabelLinks.Select(l => l.LabelId).ToHashSet();
            foreach (var labelId in selectedLabelIds)
            {
                if (!existingLabelIdSet.Contains(labelId))
                {
                    db.WorkItemLabels.Add(new WorkItemLabel { Id = Guid.NewGuid(), WorkItemId = workItem.Id, LabelId = labelId });
                }
            }

            await db.SaveChangesAsync();
        }

        isSaving = false;
        var wasEditing = isEditing;
        await CloseAsync();
        Toasts.Show(wasEditing ? "Alterações salvas" : "Tarefa criada");

        if (OnSaved.HasDelegate)
        {
            await OnSaved.InvokeAsync();
        }
    }

    private class WorkItemFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um título.")]
        [System.ComponentModel.DataAnnotations.StringLength(500, ErrorMessage = "Título muito longo.")]
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public WorkItemType Type { get; set; } = WorkItemType.Task;
        public WorkItemPriority Priority { get; set; } = WorkItemPriority.Medium;
        public Guid StatusId { get; set; }
        public string AssigneeId { get; set; } = "";
        public DateTime? StartDate { get; set; }
        public DateTime? DueDate { get; set; }
        public string ParentEpicId { get; set; } = "";

        public void Reset()
        {
            Title = "";
            Description = "";
            Type = WorkItemType.Task;
            Priority = WorkItemPriority.Medium;
            AssigneeId = "";
            StartDate = null;
            DueDate = null;
            ParentEpicId = "";
        }
    }
}
