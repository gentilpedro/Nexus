@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AttachmentStorageService Storage

@if (isOpen)
{
    <div class="panel-overlay" @onclick="Close">
        <div class="panel" @onclick:stopPropagation="true">
            @if (viewMode && isEditing)
            {
                <div class="panel-header">
                    <span class="task-view-id">
                        <WorkItemTypeIcon Type="model.Type" />
                        @TicketCode
                    </span>
                    <div class="task-view-header-actions">
                        <button type="button" class="btn-link" title="Editar" @onclick="EnterEditMode">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /></svg>
                        </button>
                        <button type="button" class="btn-link" title="Fechar" @onclick="Close">✕</button>
                    </div>
                </div>

                <h2 class="task-view-title">@model.Title</h2>

                @if (!string.IsNullOrWhiteSpace(model.Description))
                {
                    <div class="task-view-section">
                        <h3>Descrição</h3>
                        <p class="task-view-description">@model.Description</p>
                    </div>
                }

                <div class="task-view-meta">
                    <div class="task-view-meta-row">
                        <span class="task-view-meta-label">Responsável</span>
                        <span>@AssigneeDisplayName</span>
                    </div>
                    <div class="task-view-meta-row">
                        <span class="task-view-meta-label">Status</span>
                        @if (CurrentStatus is not null)
                        {
                            <StatusBadge Name="@CurrentStatus.Name" Category="CurrentStatus.Category" />
                        }
                    </div>
                    <div class="task-view-meta-row">
                        <span class="task-view-meta-label">Prazo</span>
                        <span>@(model.DueDate?.ToString("dd/MM/yyyy") ?? "Sem prazo")</span>
                    </div>
                    <div class="task-view-meta-row">
                        <span class="task-view-meta-label">Prioridade</span>
                        <PriorityBadge Priority="model.Priority" />
                    </div>
                    @if (selectedLabelIds.Count > 0)
                    {
                        <div class="task-view-meta-row">
                            <span class="task-view-meta-label">Etiquetas</span>
                            <span>
                                @foreach (var label in Labels.Where(l => selectedLabelIds.Contains(l.Id)))
                                {
                                    <span class="label-chip label-chip--sm" style="background-color: @label.Color; color: @LabelColor.TextColorFor(label.Color);">@label.Name</span>
                                }
                            </span>
                        </div>
                    }
                </div>

                @if (editingCreatedAtUtc is not null)
                {
                    <p class="topnav-user" style="margin-top:1rem;">
                        Criado em @editingCreatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")
                        @if (editingUpdatedAtUtc is not null)
                        {
                            <text> · Atualizado em @editingUpdatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text>
                        }
                    </p>
                }

                <div class="task-view-comments">
                    <h3>Comentários (@(comments?.Count ?? 0))</h3>
                    @if (comments is null)
                    {
                        <p class="topnav-user">Carregando...</p>
                    }
                    else
                    {
                        @foreach (var comment in comments)
                        {
                            <div class="chat-message">
                                <span class="chat-message-avatar">@CommentAuthorInitial(comment)</span>
                                <div class="chat-message-body">
                                    <div class="chat-message-meta">
                                        <span class="chat-message-author">@CommentAuthorLabel(comment)</span>
                                        <span class="chat-message-time">@comment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="chat-message-content">@comment.Content</div>
                                </div>
                            </div>
                        }
                    }
                    <div class="task-comment-compose">
                        <textarea rows="2" placeholder="Escreva um comentário..." @bind="newCommentText"></textarea>
                        <button type="button" class="btn" disabled="@isSavingComment" @onclick="HandleAddComment">Comentar</button>
                    </div>
                </div>
            }
            else
            {
                <div class="panel-header">
                    <h2>@(isEditing ? "Editar task" : "Nova task")</h2>
                    <button class="btn-link" type="button" @onclick="Close">✕</button>
                </div>

                <EditForm Model="model" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    <div class="form-field">
                        <label for="task-title">Título</label>
                        <InputText id="task-title" @bind-Value="model.Title" />
                        <ValidationMessage For="() => model.Title" />
                    </div>
                    <div class="form-field">
                        <label for="task-description">Descrição</label>
                        <InputTextArea id="task-description" @bind-Value="model.Description" rows="4" />
                    </div>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="task-type">Tipo</label>
                            <InputSelect id="task-type" @bind-Value="model.Type">
                                @foreach (var t in Enum.GetValues<WorkItemType>())
                                {
                                    <option value="@t">@t.ToDisplayLabel()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-field">
                            <label for="task-priority">Prioridade</label>
                            <InputSelect id="task-priority" @bind-Value="model.Priority">
                                @foreach (var p in Enum.GetValues<WorkItemPriority>())
                                {
                                    <option value="@p">@p.ToDisplayLabel()</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="task-status">Status</label>
                            <InputSelect id="task-status" @bind-Value="model.StatusId">
                                @foreach (var s in AllowedStatuses)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-field">
                            <label for="task-assignee">Responsável</label>
                            <InputSelect id="task-assignee" @bind-Value="model.AssigneeId">
                                <option value="">Ninguém</option>
                                @foreach (var option in AssigneeOptions)
                                {
                                    <option value="@option.UserId">@option.DisplayName</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="task-start-date">Data de início</label>
                            <InputDate id="task-start-date" @bind-Value="model.StartDate" />
                        </div>
                        <div class="form-field">
                            <label for="task-due-date">Prazo</label>
                            <InputDate id="task-due-date" @bind-Value="model.DueDate" />
                        </div>
                    </div>
                    <div class="form-field">
                        <label for="task-epic">Epic</label>
                        <InputSelect id="task-epic" @bind-Value="model.ParentEpicId">
                            <option value="">Nenhum</option>
                            @foreach (var epic in EpicOptions.Where(e => e.Id != editingId))
                            {
                                <option value="@epic.Id">@epic.Title</option>
                            }
                        </InputSelect>
                    </div>

                    @if (Labels.Count > 0)
                    {
                        <div class="form-field">
                            <label>Labels</label>
                            <div class="label-toggle-row">
                                @foreach (var label in Labels)
                                {
                                    <button type="button"
                                            class="label-chip label-chip-toggle"
                                            style="@LabelToggleStyle(label)"
                                            @onclick="() => ToggleLabel(label.Id)">
                                        @label.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (CustomFieldDefinitions.Count > 0)
                    {
                        <hr />
                        @foreach (var field in CustomFieldDefinitions)
                        {
                            <div class="form-field">
                                <label for="@($"custom-field-{field.Id}")">@field.Name@(field.Required ? " *" : "")</label>
                                @switch (field.Type)
                                {
                                    case CustomFieldType.Text:
                                        <input id="@($"custom-field-{field.Id}")" type="text" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")" />
                                        break;
                                    case CustomFieldType.Number:
                                        <input id="@($"custom-field-{field.Id}")" type="number" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")" />
                                        break;
                                    case CustomFieldType.Date:
                                        <input id="@($"custom-field-{field.Id}")" type="date" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")" />
                                        break;
                                    case CustomFieldType.Select:
                                        <select id="@($"custom-field-{field.Id}")" value="@customFieldValues[field.Id]" @onchange="@(e => customFieldValues[field.Id] = e.Value?.ToString() ?? "")">
                                            <option value="">—</option>
                                            @foreach (var option in field.Options)
                                            {
                                                <option value="@option.Id">@option.Label</option>
                                            }
                                        </select>
                                        break;
                                }
                            </div>
                        }
                    }

                    <div class="form-actions">
                        <button type="submit" class="btn" disabled="@isSaving">Salvar</button>
                        <button type="button" class="btn btn-secondary" @onclick="HandleCancelClick">Cancelar</button>
                    </div>
                </EditForm>
            }

            @if (isEditing)
            {
                <div class="panel-attachments">
                    <h3>Anexos</h3>
                    <InputFile OnChange="HandleFileUpload" multiple />
                    @if (!string.IsNullOrEmpty(uploadError))
                    {
                        <div class="alert alert-danger">@uploadError</div>
                    }
                    @if (attachments.Count > 0)
                    {
                        <div class="attachment-list">
                            @foreach (var attachment in attachments)
                            {
                                <div class="attachment-item">
                                    <a href="@($"/attachments/{attachment.Id}/download")" target="_blank">@attachment.FileName</a>
                                    <span class="attachment-meta">@FormatSize(attachment.SizeBytes)</span>
                                    <button type="button" class="btn-link" @onclick="() => HandleDeleteAttachment(attachment.Id)">Excluir</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="attachment-hint">Anexos ficam disponíveis depois de salvar a task pela primeira vez.</p>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Parameter, EditorRequired]
    public Guid TaskListId { get; set; }

    [Parameter, EditorRequired]
    public List<TaskStatusDefinition> Statuses { get; set; } = [];

    [Parameter, EditorRequired]
    public List<(string UserId, string DisplayName)> AssigneeOptions { get; set; } = [];

    [Parameter]
    public List<WorkItem> EpicOptions { get; set; } = [];

    [Parameter]
    public List<CustomFieldDefinition> CustomFieldDefinitions { get; set; } = [];

    [Parameter]
    public List<StatusTransition> StatusTransitions { get; set; } = [];

    [Parameter]
    public List<Label> Labels { get; set; } = [];

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private bool isOpen;
    private bool isEditing;
    private bool viewMode;
    private bool isSaving;
    private string? errorMessage;
    private Guid? editingId;
    private Guid? originalStatusId;
    private DateTime? editingCreatedAtUtc;
    private DateTime? editingUpdatedAtUtc;
    private WorkItem? editingItem;
    private readonly WorkItemFormModel model = new();
    private readonly Dictionary<Guid, string> customFieldValues = new();
    private readonly Dictionary<Guid, string> originalCustomFieldValues = new();
    private readonly HashSet<Guid> selectedLabelIds = new();
    private readonly HashSet<Guid> originalLabelIds = new();
    private List<WorkItemAttachment> attachments = [];
    private string? uploadError;
    private List<WorkItemComment>? comments;
    private string newCommentText = "";
    private bool isSavingComment;

    private string TicketCode => editingId is null ? "" : "TASK-" + editingId.Value.ToString("N")[..6].ToUpperInvariant();

    private TaskStatusDefinition? CurrentStatus => Statuses.FirstOrDefault(s => s.Id == model.StatusId);

    private string AssigneeDisplayName => string.IsNullOrEmpty(model.AssigneeId)
        ? "Sem responsável"
        : (AssigneeOptions.FirstOrDefault(o => o.UserId == model.AssigneeId).DisplayName ?? "Sem responsável");

    // Unrestricted (all Statuses) when creating, or when the list has no configured
    // transitions at all — only narrows down once editing AND rules exist for this list.
    private List<TaskStatusDefinition> AllowedStatuses
    {
        get
        {
            if (!isEditing || originalStatusId is null || StatusTransitions.Count == 0)
            {
                return Statuses;
            }

            var reachableIds = StatusTransitions
                .Where(t => t.FromStatusId == originalStatusId)
                .Select(t => t.ToStatusId)
                .ToHashSet();
            reachableIds.Add(originalStatusId.Value);

            return Statuses.Where(s => reachableIds.Contains(s.Id)).ToList();
        }
    }

    public void OpenForCreate()
    {
        isEditing = false;
        viewMode = false;
        editingId = null;
        editingItem = null;
        originalStatusId = null;
        errorMessage = null;
        model.Reset();
        model.StatusId = Statuses.FirstOrDefault(s => s.IsDefault)?.Id ?? Statuses.FirstOrDefault()?.Id ?? Guid.Empty;
        model.StartDate = DateTime.Today;
        ResetCustomFieldValues();
        selectedLabelIds.Clear();
        attachments = [];
        comments = [];
        uploadError = null;
        isOpen = true;
        StateHasChanged();
    }

    public async Task OpenForEdit(WorkItem item)
    {
        isEditing = true;
        viewMode = true;
        editingId = item.Id;
        editingItem = item;
        originalStatusId = item.StatusId;
        editingCreatedAtUtc = item.CreatedAtUtc;
        editingUpdatedAtUtc = item.UpdatedAtUtc;
        errorMessage = null;
        PopulateModelFrom(item);

        ResetCustomFieldValues();
        selectedLabelIds.Clear();
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var existingValues = await db.CustomFieldValues
                .Where(v => v.WorkItemId == item.Id)
                .ToListAsync();
            foreach (var value in existingValues)
            {
                customFieldValues[value.CustomFieldDefinitionId] = value.Value;
            }

            var existingLabelIds = await db.WorkItemLabels
                .Where(l => l.WorkItemId == item.Id)
                .Select(l => l.LabelId)
                .ToListAsync();
            foreach (var labelId in existingLabelIds)
            {
                selectedLabelIds.Add(labelId);
            }
        }

        originalCustomFieldValues.Clear();
        foreach (var (k, v) in customFieldValues)
        {
            originalCustomFieldValues[k] = v;
        }
        originalLabelIds.Clear();
        foreach (var id in selectedLabelIds)
        {
            originalLabelIds.Add(id);
        }

        uploadError = null;
        await LoadAttachmentsAsync();
        await LoadCommentsAsync();

        isOpen = true;
        StateHasChanged();
    }

    private void PopulateModelFrom(WorkItem item)
    {
        model.Title = item.Title;
        model.Description = item.Description ?? "";
        model.Type = item.Type;
        model.Priority = item.Priority;
        model.StatusId = item.StatusId;
        model.AssigneeId = item.AssigneeId ?? "";
        model.StartDate = item.StartDateUtc?.Date;
        model.DueDate = item.DueDateUtc?.Date;
        model.ParentEpicId = item.ParentEpicId?.ToString() ?? "";
    }

    private void EnterEditMode()
    {
        viewMode = false;
    }

    private void HandleCancelClick()
    {
        if (isEditing)
        {
            if (editingItem is not null)
            {
                PopulateModelFrom(editingItem);
            }
            selectedLabelIds.Clear();
            foreach (var id in originalLabelIds)
            {
                selectedLabelIds.Add(id);
            }
            customFieldValues.Clear();
            foreach (var (k, v) in originalCustomFieldValues)
            {
                customFieldValues[k] = v;
            }
            errorMessage = null;
            viewMode = true;
        }
        else
        {
            Close();
        }
    }

    private async Task LoadCommentsAsync()
    {
        if (editingId is null)
        {
            comments = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        comments = await db.WorkItemComments
            .Where(c => c.WorkItemId == editingId.Value)
            .Include(c => c.User)
            .OrderBy(c => c.CreatedAtUtc)
            .ToListAsync();
    }

    private async Task HandleAddComment()
    {
        if (string.IsNullOrWhiteSpace(newCommentText) || editingId is null)
        {
            return;
        }

        isSavingComment = true;

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.WorkItemComments.Add(new WorkItemComment
            {
                Id = Guid.NewGuid(),
                WorkItemId = editingId.Value,
                UserId = currentUserId,
                Content = newCommentText.Trim(),
                CreatedAtUtc = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
        }

        newCommentText = "";
        isSavingComment = false;
        await LoadCommentsAsync();
    }

    private static string CommentAuthorLabel(WorkItemComment comment) =>
        comment.User is null
            ? "Usuário removido"
            : (string.IsNullOrEmpty(comment.User.DisplayName) ? comment.User.Email ?? "" : comment.User.DisplayName);

    private static string CommentAuthorInitial(WorkItemComment comment)
    {
        var label = CommentAuthorLabel(comment);
        return string.IsNullOrWhiteSpace(label) || label == "Usuário removido" ? "?" : label.Trim()[0].ToString().ToUpperInvariant();
    }

    private async Task LoadAttachmentsAsync()
    {
        if (editingId is null)
        {
            attachments = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        attachments = await db.WorkItemAttachments
            .Where(a => a.WorkItemId == editingId.Value)
            .OrderByDescending(a => a.UploadedAtUtc)
            .ToListAsync();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        if (editingId is null)
        {
            return;
        }

        uploadError = null;

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > AttachmentStorageService.MaxSizeBytes)
            {
                uploadError = $"\"{file.Name}\" excede o limite de 10 MB e não foi anexado.";
                continue;
            }

            var attachmentId = Guid.NewGuid();
            string storagePath;
            await using (var stream = file.OpenReadStream(AttachmentStorageService.MaxSizeBytes))
            {
                storagePath = await Storage.SaveAsync(editingId.Value, attachmentId, file.Name, stream);
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            db.WorkItemAttachments.Add(new WorkItemAttachment
            {
                Id = attachmentId,
                WorkItemId = editingId.Value,
                FileName = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                SizeBytes = file.Size,
                StoragePath = storagePath,
                UploadedByUserId = currentUserId,
                UploadedAtUtc = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
        }

        await LoadAttachmentsAsync();
    }

    private async Task HandleDeleteAttachment(Guid attachmentId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var storagePath = await db.WorkItemAttachments
            .Where(a => a.Id == attachmentId)
            .Select(a => a.StoragePath)
            .FirstOrDefaultAsync();

        if (storagePath is null)
        {
            return;
        }

        await db.WorkItemAttachments.Where(a => a.Id == attachmentId).ExecuteDeleteAsync();
        Storage.Delete(storagePath);
        await LoadAttachmentsAsync();
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    private void ToggleLabel(Guid labelId)
    {
        if (!selectedLabelIds.Remove(labelId))
        {
            selectedLabelIds.Add(labelId);
        }
    }

    private string LabelToggleStyle(Label label)
    {
        if (selectedLabelIds.Contains(label.Id))
        {
            return $"background-color: {label.Color}; color: {LabelColor.TextColorFor(label.Color)}; border-color: {label.Color};";
        }

        return $"background-color: transparent; color: {label.Color}; border-color: {label.Color};";
    }

    private void ResetCustomFieldValues()
    {
        customFieldValues.Clear();
        foreach (var field in CustomFieldDefinitions)
        {
            customFieldValues[field.Id] = "";
        }
    }

    private void Close()
    {
        isOpen = false;
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = null;

        if (model.StartDate.HasValue && model.DueDate.HasValue && model.StartDate.Value > model.DueDate.Value)
        {
            errorMessage = "A data de início precisa ser antes do prazo.";
            isSaving = false;
            return;
        }

        var missingRequiredField = CustomFieldDefinitions.FirstOrDefault(f =>
            f.Required && string.IsNullOrWhiteSpace(customFieldValues.GetValueOrDefault(f.Id)));
        if (missingRequiredField is not null)
        {
            errorMessage = $"O campo \"{missingRequiredField.Name}\" é obrigatório.";
            isSaving = false;
            return;
        }

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            WorkItem workItem;
            if (isEditing && editingId is not null)
            {
                workItem = await db.WorkItems.FirstAsync(w => w.Id == editingId.Value);
            }
            else
            {
                workItem = new WorkItem { Id = Guid.NewGuid(), TaskListId = TaskListId, CreatedAtUtc = DateTime.UtcNow, CreatedByUserId = currentUserId };
                db.WorkItems.Add(workItem);
            }

            var previousAssigneeId = workItem.AssigneeId;

            if (isEditing && workItem.StatusId != model.StatusId)
            {
                var hasRules = await db.StatusTransitions.AnyAsync(t => t.FromStatusId == workItem.StatusId);
                if (hasRules)
                {
                    var allowed = await db.StatusTransitions.AnyAsync(
                        t => t.FromStatusId == workItem.StatusId && t.ToStatusId == model.StatusId);
                    if (!allowed)
                    {
                        errorMessage = "Essa mudança de status não é permitida pelo workflow da lista.";
                        isSaving = false;
                        return;
                    }
                }
            }

            workItem.Title = model.Title.Trim();
            workItem.Description = string.IsNullOrWhiteSpace(model.Description) ? null : model.Description.Trim();
            workItem.Type = model.Type;
            workItem.Priority = model.Priority;
            workItem.StatusId = model.StatusId;
            workItem.AssigneeId = string.IsNullOrEmpty(model.AssigneeId) ? null : model.AssigneeId;
            workItem.StartDateUtc = model.StartDate.HasValue ? DateTime.SpecifyKind(model.StartDate.Value, DateTimeKind.Utc) : null;
            workItem.DueDateUtc = model.DueDate.HasValue ? DateTime.SpecifyKind(model.DueDate.Value, DateTimeKind.Utc) : null;
            workItem.ParentEpicId = Guid.TryParse(model.ParentEpicId, out var epicId) ? epicId : null;
            if (isEditing)
            {
                workItem.UpdatedAtUtc = DateTime.UtcNow;
            }

            // Notify the new assignee — but not for a no-op re-save of the same assignee,
            // and not when someone assigns a task to themselves.
            if (workItem.AssigneeId is not null && workItem.AssigneeId != previousAssigneeId && workItem.AssigneeId != currentUserId)
            {
                var assigner = await db.Users.Where(u => u.Id == currentUserId)
                    .Select(u => new { u.DisplayName, u.Email }).FirstOrDefaultAsync();
                var assignerName = string.IsNullOrEmpty(assigner?.DisplayName) ? (assigner?.Email ?? "Alguém") : assigner.DisplayName;

                db.Notifications.Add(new Notification
                {
                    Id = Guid.NewGuid(),
                    UserId = workItem.AssigneeId,
                    Type = NotificationType.TaskAssigned,
                    Message = $"{assignerName} atribuiu \"{workItem.Title.Trim()}\" a você.",
                    WorkItemId = workItem.Id,
                    IsRead = false,
                    CreatedAtUtc = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();

            var existingValues = await db.CustomFieldValues
                .Where(v => v.WorkItemId == workItem.Id)
                .ToListAsync();

            foreach (var (definitionId, value) in customFieldValues)
            {
                var existing = existingValues.FirstOrDefault(v => v.CustomFieldDefinitionId == definitionId);
                if (string.IsNullOrWhiteSpace(value))
                {
                    if (existing is not null)
                    {
                        db.CustomFieldValues.Remove(existing);
                    }
                }
                else if (existing is not null)
                {
                    existing.Value = value;
                }
                else
                {
                    db.CustomFieldValues.Add(new CustomFieldValue { Id = Guid.NewGuid(), WorkItemId = workItem.Id, CustomFieldDefinitionId = definitionId, Value = value });
                }
            }

            var existingLabelLinks = await db.WorkItemLabels
                .Where(l => l.WorkItemId == workItem.Id)
                .ToListAsync();

            foreach (var link in existingLabelLinks)
            {
                if (!selectedLabelIds.Contains(link.LabelId))
                {
                    db.WorkItemLabels.Remove(link);
                }
            }

            var existingLabelIdSet = existingLabelLinks.Select(l => l.LabelId).ToHashSet();
            foreach (var labelId in selectedLabelIds)
            {
                if (!existingLabelIdSet.Contains(labelId))
                {
                    db.WorkItemLabels.Add(new WorkItemLabel { Id = Guid.NewGuid(), WorkItemId = workItem.Id, LabelId = labelId });
                }
            }

            await db.SaveChangesAsync();
        }

        isSaving = false;
        isOpen = false;

        if (OnSaved.HasDelegate)
        {
            await OnSaved.InvokeAsync();
        }
    }

    private class WorkItemFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um título.")]
        [System.ComponentModel.DataAnnotations.StringLength(500, ErrorMessage = "Título muito longo.")]
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public WorkItemType Type { get; set; } = WorkItemType.Task;
        public WorkItemPriority Priority { get; set; } = WorkItemPriority.Medium;
        public Guid StatusId { get; set; }
        public string AssigneeId { get; set; } = "";
        public DateTime? StartDate { get; set; }
        public DateTime? DueDate { get; set; }
        public string ParentEpicId { get; set; } = "";

        public void Reset()
        {
            Title = "";
            Description = "";
            Type = WorkItemType.Task;
            Priority = WorkItemPriority.Medium;
            AssigneeId = "";
            StartDate = null;
            DueDate = null;
            ParentEpicId = "";
        }
    }
}
