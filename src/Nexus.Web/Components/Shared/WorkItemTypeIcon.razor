@using Nexus.Domain.Entities
@using Nexus.Web.Extensions

<span class="type-icon type-icon-@Type.ToString().ToLowerInvariant()" title="@Type.ToDisplayLabel()">
    <Icon Name="@IconName" />
    <span class="sr-only">@Type.ToDisplayLabel()</span>
</span>

@code {
    [Parameter, EditorRequired]
    public WorkItemType Type { get; set; }

    private string IconName => Type switch
    {
        WorkItemType.Bug => "type-bug",
        WorkItemType.Story => "type-story",
        WorkItemType.Epic => "type-epic",
        _ => "type-task"
    };
}
