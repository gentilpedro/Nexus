<StatusMessage Message="@StatusMessage" />
<h3>Códigos de recuperação</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Guarde esses códigos em um lugar seguro.</strong>
    </p>
    <p>
        Se você perder o dispositivo e não tiver os códigos de recuperação, vai perder o acesso à sua conta.
    </p>
</div>
<div class="card narrow-form">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <div><code>@recoveryCode</code></div>
    }
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
