@page "/Account/ForgotPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Verifique seu email</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Verifique seu email</h1>
        <p class="auth-subtitle" role="alert">
            Se existir uma conta com esse email, enviamos um link para redefinir sua senha.
        </p>
        <div class="auth-links">
            <a href="Account/Login">Voltar para o login</a>
        </div>
    </div>
</div>
