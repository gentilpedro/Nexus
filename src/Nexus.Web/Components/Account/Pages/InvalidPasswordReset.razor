@page "/Account/InvalidPasswordReset"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Link inválido</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Link inválido</h1>
        <p class="auth-subtitle" role="alert">O link de redefinição de senha é inválido ou expirou.</p>
        <div class="auth-links">
            <a href="Account/ForgotPassword">Solicitar um novo link</a>
        </div>
    </div>
</div>
