@page "/Account/ResetPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Senha redefinida</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Senha redefinida</h1>
        <p class="auth-subtitle" role="alert">Sua senha foi alterada com sucesso.</p>
        <div class="auth-links">
            <a href="Account/Login">Entrar agora</a>
        </div>
    </div>
</div>
