@page "/Account/Login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("auth")]
@layout AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Nexus.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject Nexus.Web.Services.ActiveDirectory.DirectoryLoginService DirectoryLogin

<PageTitle>Entrar · Nexus</PageTitle>

<AuthShell Title="Bem-vindo de volta" Subtitle="Entre para ver as tarefas e conversas do seu time." ActiveTab="login"
           RegisterHref="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
    <StatusMessage Message="@errorMessage" />

    <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login" class="auth-form">
        <DataAnnotationsValidator />

        <div class="form-field">
            <label for="Input.Email">E-mail</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder="nome@empresa.com.br" />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <div class="form-field">
            <div class="field-label-row">
                <label for="Input.Password">Senha</label>
                <a href="Account/ForgotPassword" class="field-label-link">Esqueci a senha</a>
            </div>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" autocomplete="current-password" aria-required="true" placeholder="Sua senha" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <label class="checkbox-field">
            <InputCheckbox @bind-Value="Input.RememberMe" />
            Manter conectado neste dispositivo
        </label>

        <button type="submit" class="btn btn-lg btn-block">Entrar</button>
    </EditForm>

    <p class="auth-alt">
        Ainda não tem conta?
        <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))" data-enhance-nav="false">Criar conta grátis</a>
    </p>
</AuthShell>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        editContext = new EditContext(Input);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        if (!editContext.Validate())
        {
            return;
        }

        // Login pelo Active Directory (#70): e-mail de um domínio configurado é conferido por bind
        // LDAP, e a senha do Nexus nem é consultada. O bloqueio por tentativas vale igual.
        if (await DirectoryLogin.HandlesAsync(Input.Email, HttpContext.RequestAborted))
        {
            await LoginWithDirectoryAsync();
            return;
        }

        // lockoutOnFailure: true — Identity's lockout (5 tentativas, ~5min por padrão) só conta
        // tentativas quando esse flag está ligado. Com false, um ataque de força bruta contra
        // uma conta nunca era bloqueado; a UI de "Account/Lockout" abaixo já existia e nunca era
        // alcançada por causa disso.
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");

            var user = await UserManager.FindByEmailAsync(Input.Email);
            var lockoutEnd = user is null ? null : await UserManager.GetLockoutEndDateAsync(user);
            var minutesRemaining = lockoutEnd is null
                ? (int?)null
                : Math.Max(1, (int)Math.Ceiling((lockoutEnd.Value - DateTimeOffset.UtcNow).TotalMinutes));

            RedirectManager.RedirectTo("Account/Lockout", new() { ["minutes"] = minutesRemaining });
        }
        else
        {
            errorMessage = "Erro: e-mail ou senha incorretos.";
        }
    }

    private async Task LoginWithDirectoryAsync()
    {
        var existing = await UserManager.FindByEmailAsync(Input.Email);
        if (existing is not null && await UserManager.IsLockedOutAsync(existing))
        {
            await RedirectToLockoutAsync(existing);
            return;
        }

        var outcome = await DirectoryLogin.LoginAsync(Input.Email, Input.Password, HttpContext.RequestAborted);
        switch (outcome.Status)
        {
            case Nexus.Web.Services.ActiveDirectory.DirectoryLoginStatus.Success:
                await UserManager.ResetAccessFailedCountAsync(outcome.User!);
                var signIn = await ((Nexus.Web.Services.Licensing.LicenseAwareSignInManager)SignInManager).DirectorySignInAsync(outcome.User!, Input.RememberMe);
                if (signIn.RequiresTwoFactor)
                {
                    RedirectManager.RedirectTo("Account/LoginWith2fa", new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
                    return;
                }

                Logger.LogInformation("User logged in through the directory{Created}.", outcome.Created ? " (account created)" : "");
                RedirectManager.RedirectTo(ReturnUrl);
                return;
            case Nexus.Web.Services.ActiveDirectory.DirectoryLoginStatus.Disabled:
                errorMessage = "Erro: esta conta está desabilitada no Active Directory. Fale com a TI da sua empresa.";
                return;
            case Nexus.Web.Services.ActiveDirectory.DirectoryLoginStatus.AccountRefused:
                errorMessage = "Erro: o Active Directory aceitou, mas o Nexus não pôde criar a sua conta. " + outcome.Detail;
                return;
            case Nexus.Web.Services.ActiveDirectory.DirectoryLoginStatus.Unavailable:
                errorMessage = "Erro: o servidor da sua empresa não respondeu. Tente de novo em instantes ou avise a TI.";
                return;
            default:
                if (existing is not null)
                {
                    await UserManager.AccessFailedAsync(existing);
                    if (await UserManager.IsLockedOutAsync(existing))
                    {
                        await RedirectToLockoutAsync(existing);
                        return;
                    }
                }

                errorMessage = "Erro: e-mail ou senha incorretos.";
                return;
        }
    }

    private async Task RedirectToLockoutAsync(ApplicationUser user)
    {
        Logger.LogWarning("User account locked out.");
        var lockoutEnd = await UserManager.GetLockoutEndDateAsync(user);
        var minutesRemaining = lockoutEnd is null ? (int?)null : Math.Max(1, (int)Math.Ceiling((lockoutEnd.Value - DateTimeOffset.UtcNow).TotalMinutes));
        RedirectManager.RedirectTo("Account/Lockout", new() { ["minutes"] = minutesRemaining });
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Esse e-mail não parece válido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Informe sua senha.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Manter conectado")]
        public bool RememberMe { get; set; }
    }
}
