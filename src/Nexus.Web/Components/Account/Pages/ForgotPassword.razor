@page "/Account/ForgotPassword"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("auth")]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Nexus.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject Nexus.Web.Services.PublicUrlBuilder PublicUrl
@inject IdentityRedirectManager RedirectManager

<PageTitle>Esqueceu sua senha?</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Esqueceu sua senha?</h1>
        <p class="auth-subtitle">Informe seu email para receber o link de redefinição.</p>

        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" role="alert" />

            <div class="form-field">
                <label for="Input.Email">Email</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                <ValidationMessage For="() => Input.Email" />
            </div>
            <button type="submit" class="btn">Enviar link de redefinição</button>
        </EditForm>

        <div class="auth-links">
            <a href="Account/Login">Voltar para o login</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Don't reveal that the user does not exist.
            //
            // Note: unlike the scaffolded default, this does NOT also require IsEmailConfirmedAsync.
            // Sign-in now does require a confirmed address, but gating password reset on it too
            // would strand anyone who registered and lost access before confirming; completing a
            // reset already proves control of the mailbox, so it is safe to allow and it keeps the
            // response identical for every input, which is what prevents account enumeration here.
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

        // Built from the configured PUBLIC_BASE_URL, never from NavigationManager.ToAbsoluteUri:
        // the latter takes its base from the request's Host header, so an attacker sending
        // "Host: evil.com" here would make Nexus mail the victim a valid reset token pointing at
        // the attacker's domain. See PublicUrlBuilder for the full write-up.
        var callbackUrl = PublicUrl.BuildUrl(
            "Account/ResetPassword",
            new Dictionary<string, object?> { ["code"] = code });

        await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
