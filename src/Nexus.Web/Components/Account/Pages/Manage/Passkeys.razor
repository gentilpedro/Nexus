@page "/Account/Manage/Passkeys"

@using Nexus.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using System.Buffers.Text

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Chaves de acesso · Nexus</PageTitle>

<AccountSection Title="Chaves de acesso" Description="Entre com a digital, o rosto ou o PIN do seu dispositivo, sem digitar a senha.">
    <StatusMessage />

    <div class="card card--flush">
        @if (currentPasskeys is { Count: > 0 })
        {
            <ul class="row-list settings-rows">
                @foreach (var passkey in currentPasskeys)
                {
                    var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                    <li class="settings-row">
                        <span class="doc-type-icon" aria-hidden="true"><Icon Name="key" /></span>
                        <div class="settings-row-main">
                            <span class="settings-row-title">@(passkey.Name ?? "Chave sem nome")</span>
                        </div>
                        <form @formname="@($"update-passkey-{credentialId}")" @onsubmit="UpdatePasskey" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="CredentialId" value="@credentialId" />
                            <div class="button-row">
                                <button type="submit" name="Action" value="rename" class="btn btn-ghost btn-sm">Renomear</button>
                                <button type="submit" name="Action" value="delete" class="btn btn-danger-ghost btn-sm">Excluir</button>
                            </div>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <EmptyState Compact="true" Title="Nenhuma chave de acesso cadastrada"
                        Description="Adicione uma chave neste dispositivo para entrar mais rápido da próxima vez." />
        }
        <form @formname="add-passkey" @onsubmit="AddPasskey" method="post" class="settings-card-footer">
            <AntiforgeryToken />
            @if (currentPasskeys is { Count: >= MaxPasskeyCount })
            {
                <p class="field-hint">Você atingiu o limite de chaves. Exclua uma antes de adicionar outra.</p>
            }
            else
            {
                <PasskeySubmit Operation="PasskeyOperation.Create" Name="Input" class="btn">Adicionar chave neste dispositivo</PasskeySubmit>
            }
        </form>
    </div>
</AccountSection>

@code {
    private const int MaxPasskeyCount = 100;

    private ApplicationUser? user;
    private IList<UserPasskeyInfo>? currentPasskeys;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private string? Action { get; set; }

    [SupplyParameterFromForm]
    private string? CredentialId { get; set; }

    [SupplyParameterFromForm(FormName = "add-passkey")]
    private PasskeyInputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        currentPasskeys = await UserManager.GetPasskeysAsync(user);
    }

    private async Task AddPasskey()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (!string.IsNullOrEmpty(Input.Error))
        {
            RedirectManager.RedirectToCurrentPageWithStatus($"Erro: {Input.Error}", HttpContext);
            return;
        }

        if (string.IsNullOrEmpty(Input.CredentialJson))
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Erro: o navegador não forneceu uma chave de acesso.", HttpContext);
            return;
        }

        if (currentPasskeys!.Count >= MaxPasskeyCount)
        {
            RedirectManager.RedirectToCurrentPageWithStatus($"Erro: você atingiu o número máximo de chaves permitidas.", HttpContext);
            return;
        }

        var attestationResult = await SignInManager.PerformPasskeyAttestationAsync(Input.CredentialJson);
        if (!attestationResult.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus($"Erro: não foi possível adicionar a chave: {attestationResult.Failure.Message}", HttpContext);
            return;
        }

        var addPasskeyResult = await UserManager.AddOrUpdatePasskeyAsync(user, attestationResult.Passkey);
        if (!addPasskeyResult.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Erro: a chave não pôde ser adicionada à sua conta.", HttpContext);
            return;
        }

        // Immediately prompt the user to enter a name for the credential
        var credentialIdBase64Url = Base64Url.EncodeToString(attestationResult.Passkey.CredentialId);
        RedirectManager.RedirectTo($"Account/Manage/RenamePasskey/{credentialIdBase64Url}");
    }

    private async Task UpdatePasskey()
    {
        switch (Action)
        {
            case "rename":
                RedirectManager.RedirectTo($"Account/Manage/RenamePasskey/{CredentialId}");
                break;
            case "delete":
                await DeletePasskey();
                break;
            default:
                RedirectManager.RedirectToCurrentPageWithStatus($"Erro: ação '{Action}' desconhecida.", HttpContext);
                break;
        }
    }

    private async Task DeletePasskey()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(CredentialId);
        }
        catch (FormatException)
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Erro: o ID da chave informado tem um formato inválido.", HttpContext);
            return;
        }

        var result = await UserManager.RemovePasskeyAsync(user, credentialId);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Erro: não foi possível excluir a chave.", HttpContext);
            return;
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Chave excluída com sucesso.", HttpContext);
    }
}
