@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using Nexus.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Redefinir chave do autenticador · Nexus</PageTitle>

<AccountSection Title="Redefinir chave do autenticador" Description="Gera uma chave nova; o aplicativo atual para de funcionar até ser configurado de novo.">
    <StatusMessage />
    <div class="alert alert-warning" role="status">
        <Icon Name="alert" />
        <span><strong>A verificação em duas etapas fica desativada até você configurar o aplicativo com a nova chave.</strong> Se não terminar essa configuração, pode perder o acesso à conta.</span>
    </div>
    <div class="button-row">
        <a href="Account/Manage/TwoFactorAuthentication" class="btn btn-ghost">Cancelar</a>
        <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">Redefinir chave</button>
        </form>
    </div>
</AccountSection>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

        await SignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "A chave do app autenticador foi redefinida. Configure o app de novo com a nova chave.",
            HttpContext);
    }
}
