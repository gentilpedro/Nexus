@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Nexus.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject Nexus.Web.Services.AttachmentStorageService Storage
@inject Nexus.Web.Services.AuditLogService AuditLog
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Excluir dados pessoais</PageTitle>

<h2>Excluir dados pessoais</h2>
<StatusMessage Message="@message" />

<div class="alert alert-warning" role="alert">
    <strong>Isso encerra sua conta e apaga seus dados de identificação (nome, e-mail, foto) permanentemente. Não pode ser desfeito.</strong>
    <p>
        Tarefas, comentários, documentos e mensagens que você criou continuam visíveis para o
        restante da equipe do workspace (são dados do workspace, não só seus), mas deixam de
        exibir seu nome ou e-mail — aparecerão como autor "Usuário removido". Sua conta é
        bloqueada e não pode mais ser usada para entrar.
    </p>
</div>

<EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post" class="card">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-errors" role="alert" />
    @if (requirePassword)
    {
        <div class="form-field">
            <label for="Input.Password">Senha</label>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" autocomplete="current-password" aria-required="true" />
            <ValidationMessage For="() => Input.Password" />
        </div>
    }
    <button class="btn btn-danger" type="submit">Excluir dados e encerrar minha conta</button>
</EditForm>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "Error: Incorrect password.";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);

        // Anonymize instead of hard-deleting the AspNetUsers row. WorkItem.CreatedByUserId,
        // DocPage.CreatedByUserId/UpdatedByUserId and WorkItemAttachment.UploadedByUserId are
        // all DeleteBehavior.Restrict (SQL Server rejects a second SetNull/Cascade path to the
        // same table alongside the existing Assignee/Workspace path — see those configs), so
        // UserManager.DeleteAsync would throw a FK violation for any user who ever authored
        // content. Anonymizing satisfies LGPD art. 12 §3 (anonymized data stops being personal
        // data) while leaving the team's shared work items/docs/attachments intact.
        if (requirePassword)
        {
            await UserManager.RemovePasswordAsync(user);
        }
        await UserManager.SetLockoutEnabledAsync(user, true);
        await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.MaxValue);

        var anonymizedHandle = $"deleted-{userId}@removed.nexus.local";
        await UserManager.SetEmailAsync(user, anonymizedHandle);
        await UserManager.SetUserNameAsync(user, anonymizedHandle);

        if (!string.IsNullOrEmpty(user.AvatarStoragePath))
        {
            Storage.Delete(user.AvatarStoragePath);
        }

        user.DisplayName = "Usuário removido";
        user.AvatarStoragePath = null;
        user.AvatarContentType = null;
        user.EmailConfirmed = false;
        user.PhoneNumber = null;
        user.PhoneNumberConfirmed = false;

        var result = await UserManager.UpdateAsync(user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred anonymizing user.");
        }

        await SignInManager.SignOutAsync();

        Logger.LogInformation("User with ID '{UserId}' anonymized their personal data and ended their account.", userId);
        await AuditLog.LogAsync(userId, AuditAction.PersonalDataAnonymized, targetId: userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
