@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Nexus.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Dados pessoais</PageTitle>

<h2>Dados pessoais</h2>
<StatusMessage />

<div class="card">
    <p>Sua conta contém dados pessoais que você nos forneceu. Esta página permite baixar ou excluir esses dados.</p>
    <p><strong>Excluir apaga permanentemente seus dados de identificação (nome, e-mail, foto) e bloqueia sua conta. Conteúdo que você criou em workspaces compartilhados (tarefas, comentários, documentos) permanece, mas sem seu nome associado.</strong></p>
    <div class="form-actions">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn" type="submit">Baixar</button>
        </form>
        <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Excluir</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
