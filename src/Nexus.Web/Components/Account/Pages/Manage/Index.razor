@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Nexus.Domain.Entities
@using Nexus.Web.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject AttachmentStorageService Storage

<PageTitle>Perfil · Nexus</PageTitle>

<AccountSection Title="Perfil" Description="Como você aparece para o time: nas tarefas, nos comentários, no chat e nos convites.">
    <StatusMessage />

    <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post" enctype="multipart/form-data" class="card form-card">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-errors" role="alert" />

        <div class="profile-photo-row">
            @if (avatarUrl is not null)
            {
                <img class="avatar avatar--xl" src="@avatarUrl" alt="Sua foto de perfil" />
            }
            else
            {
                <Avatar Name="@(string.IsNullOrWhiteSpace(Input.Name) ? avatarInitial : Input.Name)" Size="xl" />
            }
            <div class="profile-photo-actions">
                <span class="field-label">Foto de perfil</span>
                <div class="button-row">
                    <input type="file" id="AvatarFile" name="AvatarFile" accept="image/png,image/jpeg,image/webp" class="sr-only file-trigger" data-file-label="avatar-file-name" />
                    <label for="AvatarFile" class="btn btn-secondary btn-sm"><Icon Name="upload" /> Escolher foto</label>
                    <span id="avatar-file-name" class="field-hint" aria-live="polite">Nenhuma foto nova selecionada</span>
                </div>
                <span class="field-hint">JPG, PNG ou WEBP, até 5 MB. A foto nova vale depois de salvar.</span>
                @if (avatarUrl is not null)
                {
                    <label class="checkbox-field">
                        <InputCheckbox @bind-Value="Input.RemoveAvatar" />
                        Remover a foto atual
                    </label>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(avatarErrorMessage))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@avatarErrorMessage</span></div>
        }

        <div class="form-section">
            <div class="form-field">
                <label for="Input.Name">Nome</label>
                <InputText @bind-Value="Input.Name" id="Input.Name" autocomplete="name" placeholder="Como o time vai te chamar" />
                <ValidationMessage For="() => Input.Name" />
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="username">E-mail de acesso</label>
                    <input type="text" value="@username" id="username" disabled aria-describedby="username-hint" />
                    <span id="username-hint" class="field-hint">Para trocar, vá em <a href="Account/Manage/Email">E-mail</a>.</span>
                </div>
                <div class="form-field">
                    <label for="Input.PhoneNumber">Telefone <span class="field-hint">(opcional)</span></label>
                    <InputText @bind-Value="Input.PhoneNumber" id="Input.PhoneNumber" type="tel" autocomplete="tel" placeholder="(11) 91234-5678" />
                    <ValidationMessage For="() => Input.PhoneNumber" />
                </div>
            </div>
        </div>

        <div class="form-actions form-actions--end">
            <button type="submit" class="btn">Salvar perfil</button>
        </div>
    </EditForm>
</AccountSection>

@code {
    private const long MaxAvatarSizeBytes = 5 * 1024 * 1024;

    private ApplicationUser? user;
    private string? username;
    private string? phoneNumber;
    private string? avatarUrl;
    private string avatarInitial = "?";
    private string? avatarErrorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromForm]
    private IFormFile? AvatarFile { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);

        Input.PhoneNumber ??= phoneNumber;
        Input.Name ??= user.DisplayName;

        RefreshAvatarState();
    }

    private void RefreshAvatarState()
    {
        var name = user!.DisplayName;
        avatarInitial = string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
        avatarUrl = user.AvatarStoragePath is null
            ? null
            : $"/avatars/{user.Id}/download?v={Uri.EscapeDataString(Path.GetFileNameWithoutExtension(user.AvatarStoragePath))}";
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (Input.PhoneNumber != phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Erro: não foi possível salvar o telefone.", HttpContext);
                return;
            }
        }

        var newName = (Input.Name ?? "").Trim();
        if (newName != user.DisplayName)
        {
            user.DisplayName = newName;
            var updateResult = await UserManager.UpdateAsync(user);
            if (!updateResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Erro: não foi possível salvar o nome.", HttpContext);
                return;
            }
        }

        if (AvatarFile is not null)
        {
            if (AvatarFile.Length > MaxAvatarSizeBytes)
            {
                avatarErrorMessage = "A foto excede o limite de 5 MB.";
                RefreshAvatarState();
                return;
            }

            if (AvatarFile.ContentType is not ("image/png" or "image/jpeg" or "image/webp"))
            {
                avatarErrorMessage = "Envie uma imagem JPG, PNG ou WEBP.";
                RefreshAvatarState();
                return;
            }

            var oldPath = user.AvatarStoragePath;
            try
            {
                await using var stream = AvatarFile.OpenReadStream();
                user.AvatarStoragePath = await Storage.SaveAsync(
                    Guid.Parse(user.Id), Guid.NewGuid(), AvatarFile.FileName, stream, AvatarFile.ContentType);
            }
            catch (InvalidDataException)
            {
                // Avatars are the one upload served back inline rather than as an attachment, so
                // the bytes must actually be the image type the browser claimed.
                avatarErrorMessage = "O arquivo enviado não é uma imagem JPG, PNG ou WEBP válida.";
                RefreshAvatarState();
                return;
            }
            user.AvatarContentType = AvatarFile.ContentType;
            await UserManager.UpdateAsync(user);

            if (oldPath is not null)
            {
                Storage.Delete(oldPath);
            }
        }
        else if (Input.RemoveAvatar && user.AvatarStoragePath is not null)
        {
            Storage.Delete(user.AvatarStoragePath);
            user.AvatarStoragePath = null;
            user.AvatarContentType = null;
            await UserManager.UpdateAsync(user);
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Perfil atualizado.", HttpContext);
    }

    private sealed class InputModel
    {
        [StringLength(200, ErrorMessage = "Nome muito longo.")]
        [Display(Name = "Nome")]
        public string? Name { get; set; }

        public bool RemoveAvatar { get; set; }

        [Phone]
        [Display(Name = "Phone number")]
        public string? PhoneNumber
        {
            get => _phoneNumber;
            // [Phone]'s regex rejects an empty string outright — normalize "leave it
            // blank" to null (not required) here, before DataAnnotationsValidator runs.
            set => _phoneNumber = string.IsNullOrWhiteSpace(value) ? null : value;
        }

        private string? _phoneNumber;
    }
}
