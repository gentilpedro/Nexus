@page "/"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Globalization
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Components.Shared
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized>
        <PageTitle>Início · Nexus</PageTitle>

        <div class="page-container page-container--wide dashboard">
            <PageHeader Title="@HeaderTitle" Description="@today" />

            @* Métricas como atalhos: cada número leva à lista que ele conta. *@
            <nav class="stat-grid" aria-label="Resumo">
                <a class="stat-card @(overdue.Count > 0 ? "is-danger" : "")" href="#atrasadas" @onclick="ShowTodo">
                    <span class="stat-card-label"><span class="stat-dot" style="--dot: var(--color-danger)"></span>Atrasadas</span>
                    <span class="stat-card-value">@(todoItems is null ? "–" : overdue.Count.ToString())</span>
                </a>
                <a class="stat-card" href="#proximos-dias" @onclick="ShowTodo">
                    <span class="stat-card-label"><span class="stat-dot" style="--dot: var(--color-warning)"></span>Vencem em 7 dias</span>
                    <span class="stat-card-value">@(todoItems is null ? "–" : thisWeek.Count.ToString())</span>
                </a>
                <a class="stat-card" href="#minhas-tarefas" @onclick="ShowDone">
                    <span class="stat-card-label"><span class="stat-dot" style="--dot: var(--color-success)"></span>Concluídas recentemente</span>
                    <span class="stat-card-value">@(doneItems?.Count.ToString() ?? "–")</span>
                </a>
                <div class="stat-card">
                    <span class="stat-card-label"><span class="stat-dot"></span>Sprints ativos</span>
                    <span class="stat-card-value">@activeSprintCount</span>
                </div>
            </nav>

            <div class="dashboard-layout">
                <section class="card card--flush dashboard-tasks" id="minhas-tarefas" aria-labelledby="minhas-tarefas-title">
                    <div class="dashboard-tasks-header">
                        <h2 id="minhas-tarefas-title" class="card-title">Minhas tarefas</h2>
                        <div class="pill-tabs" role="tablist" aria-label="Filtrar tarefas">
                            <button type="button" role="tab" aria-selected="@(activeTab == "todo" ? "true" : "false")" class="@(activeTab == "todo" ? "active" : "")" @onclick="ShowTodo">
                                A fazer <span class="tab-count">@(todoItems?.Count ?? 0)</span>
                            </button>
                            <button type="button" role="tab" aria-selected="@(activeTab == "done" ? "true" : "false")" class="@(activeTab == "done" ? "active" : "")" @onclick="ShowDone">
                                Concluídas
                            </button>
                            <button type="button" role="tab" aria-selected="@(activeTab == "delegated" ? "true" : "false")" class="@(activeTab == "delegated" ? "active" : "")" @onclick="ShowDelegated">
                                Delegadas <span class="tab-count">@(delegatedItems?.Count ?? 0)</span>
                            </button>
                        </div>
                    </div>

                    <div class="dashboard-tasks-body" role="tabpanel">
                        @if (activeTab == "todo")
                        {
                            @if (todoItems is null)
                            {
                                <Skeleton Count="5" Label="Carregando suas tarefas…" />
                            }
                            else if (todoItems.Count == 0)
                            {
                                <EmptyState Icon="check-circle" Title="Nada atribuído a você agora"
                                            Description="Quando alguém te atribuir uma tarefa — ou você se atribuir uma — ela aparece aqui, organizada por prazo." />
                            }
                            else
                            {
                                @if (overdue.Count > 0)
                                {
                                    <div class="task-group" id="atrasadas">
                                        <h3 class="task-group-title is-danger">
                                            <Icon Name="alert" Class="icon--sm" /> Atrasadas <span class="tab-count">@overdue.Count</span>
                                        </h3>
                                        <ul class="task-list">
                                            @foreach (var item in overdue)
                                            {
                                                <TaskRow Item="item" OnClick="OpenTask" @key="item.Id" />
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (thisWeek.Count > 0)
                                {
                                    <div class="task-group" id="proximos-dias">
                                        <h3 class="task-group-title">
                                            Próximos 7 dias <span class="tab-count">@thisWeek.Count</span>
                                        </h3>
                                        <ul class="task-list">
                                            @foreach (var item in thisWeek)
                                            {
                                                <TaskRow Item="item" OnClick="OpenTask" @key="item.Id" />
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (later.Count > 0)
                                {
                                    <div class="task-group">
                                        <h3 class="task-group-title">
                                            Depois ou sem prazo <span class="tab-count">@later.Count</span>
                                        </h3>
                                        <ul class="task-list">
                                            @foreach (var item in later)
                                            {
                                                <TaskRow Item="item" OnClick="OpenTask" @key="item.Id" />
                                            }
                                        </ul>
                                    </div>
                                }
                            }
                        }
                        else if (activeTab == "done")
                        {
                            @if (doneItems is null)
                            {
                                <Skeleton Count="4" />
                            }
                            else if (doneItems.Count == 0)
                            {
                                <EmptyState Icon="check-circle" Title="Nenhuma tarefa concluída recentemente"
                                            Description="As últimas 30 tarefas que você concluir aparecem aqui." />
                            }
                            else
                            {
                                <ul class="task-list">
                                    @foreach (var item in doneItems)
                                    {
                                        <TaskRow Item="item" OnClick="OpenTask" @key="item.Id" />
                                    }
                                </ul>
                            }
                        }
                        else
                        {
                            @if (delegatedItems is null)
                            {
                                <Skeleton Count="4" />
                            }
                            else if (delegatedItems.Count == 0)
                            {
                                <EmptyState Icon="user-plus" Title="Nenhuma tarefa delegada"
                                            Description="Tarefas que você criou e atribuiu a outra pessoa aparecem aqui, para você acompanhar sem precisar procurar." />
                            }
                            else
                            {
                                <ul class="task-list">
                                    @foreach (var item in delegatedItems)
                                    {
                                        <TaskRow Item="item" OnClick="OpenTask" ShowAssignee="true" @key="item.Id" />
                                    }
                                </ul>
                            }
                        }
                    </div>
                </section>

                <aside class="dashboard-rail" aria-label="Visão geral">
                    <section class="card">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">Ritmo da semana</h2>
                                <p class="card-subtitle">Tarefas concluídas nos seus workspaces, por dia</p>
                            </div>
                        </div>
                        <div class="dashboard-chart">
                            <canvas id="productivity-chart" role="img" aria-label="@ChartSummary"></canvas>
                        </div>
                    </section>

                    <section class="card">
                        <div class="card-header">
                            <h2 class="card-title">Workspaces</h2>
                            <a class="btn btn-ghost btn-sm" href="/workspaces/new"><Icon Name="plus" /> Novo</a>
                        </div>
                        @if (workspaces is null)
                        {
                            <Skeleton Variant="text" Count="3" />
                        }
                        else if (workspaces.Count == 0)
                        {
                            <EmptyState Compact="true" Title="Você ainda não está em nenhum workspace"
                                        Description="Crie um para começar a organizar o trabalho do time.">
                                <a class="btn btn-sm" href="/workspaces/new">Criar workspace</a>
                            </EmptyState>
                        }
                        else
                        {
                            <ul class="workspace-progress-list">
                                @foreach (var membership in workspaces)
                                {
                                    var progress = workspaceProgress?.FirstOrDefault(p => p.WorkspaceId == membership.WorkspaceId);
                                    <li>
                                        <a class="workspace-progress-item" href="@($"/workspaces/{membership.WorkspaceId}")">
                                            <Avatar Name="@membership.Workspace.Name" Color="@membership.Workspace.Color" Size="md" Square="true" />
                                            <span class="workspace-progress-body">
                                                <span class="workspace-progress-top">
                                                    <span class="workspace-progress-name">@membership.Workspace.Name</span>
                                                    <span class="workspace-progress-pct">@(progress is null ? membership.Role.ToDisplayLabel() : $"{progress.Percent}%")</span>
                                                </span>
                                                @if (progress is not null)
                                                {
                                                    <span class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.Percent" aria-label="@($"{progress.Percent}% das tarefas concluídas")">
                                                        <span class="progress-fill" style="width:@(progress.Percent)%"></span>
                                                    </span>
                                                }
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </aside>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <PageTitle>Nexus · Gestão de projetos para equipes brasileiras</PageTitle>
        <Landing />
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string displayName = "";
    private string today = "";
    private List<WorkspaceMember>? workspaces;

    private string activeTab = "todo";

    private List<WorkItem>? todoItems;
    private List<WorkItem> overdue = [];
    private List<WorkItem> thisWeek = [];
    private List<WorkItem> later = [];

    private List<WorkItem>? doneItems;
    private List<WorkItem>? delegatedItems;

    private int activeSprintCount;
    private List<WorkspaceProgress>? workspaceProgress;
    private List<string> weeklyLabels = [];
    private List<int> weeklyValues = [];
    private IJSObjectReference? chartModule;

    private record WorkspaceProgress(Guid WorkspaceId, string Name, int Percent);

    private string FirstName => string.IsNullOrWhiteSpace(displayName) ? "" : displayName.Trim().Split(' ')[0];

    private string HeaderTitle => string.IsNullOrEmpty(FirstName) ? Greeting : $"{Greeting}, {FirstName}";

    private string ChartSummary => weeklyValues.Count == 0
        ? "Gráfico de tarefas concluídas nos últimos 7 dias"
        : $"Tarefas concluídas nos últimos 7 dias: {string.Join(", ", weeklyLabels.Zip(weeklyValues, (l, v) => $"{l} {v}"))}";

    private void ShowTodo() => activeTab = "todo";

    private void ShowDone() => activeTab = "done";

    private void ShowDelegated() => activeTab = "delegated";

    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Bom dia",
        < 18 => "Boa tarde",
        _ => "Boa noite"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            return;
        }

        var culture = new CultureInfo("pt-BR");
        var rawDate = DateTime.Now.ToString("dddd, d 'de' MMMM", culture);
        today = char.ToUpper(rawDate[0], culture) + rawDate[1..];

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var user = await db.Users
                .Where(u => u.Id == userId)
                .Select(u => new { u.DisplayName, u.Email })
                .FirstOrDefaultAsync();
            displayName = string.IsNullOrEmpty(user?.DisplayName) ? (user?.Email?.Split('@')[0] ?? "") : user.DisplayName;

            workspaces = await db.WorkspaceMembers
                .Include(m => m.Workspace)
                .Where(m => m.UserId == userId)
                .OrderBy(m => m.Workspace.Name)
                .ToListAsync();

            var workspaceIds = workspaces.Select(w => w.WorkspaceId).ToList();

            activeSprintCount = await db.Sprints
                .CountAsync(s => s.Status == SprintStatus.Active && workspaceIds.Contains(s.TaskList.Space.WorkspaceId));

            var progressRaw = await db.WorkItems
                .Where(wi => workspaceIds.Contains(wi.TaskList.Space.WorkspaceId))
                .GroupBy(wi => wi.TaskList.Space.WorkspaceId)
                .Select(g => new
                {
                    WorkspaceId = g.Key,
                    Total = g.Count(),
                    Done = g.Count(wi => wi.Status.Category == StatusCategory.Done)
                })
                .ToListAsync();

            workspaceProgress = workspaces
                .Where(w => progressRaw.Any(p => p.WorkspaceId == w.WorkspaceId && p.Total > 0))
                .Select(w =>
                {
                    var p = progressRaw.First(p => p.WorkspaceId == w.WorkspaceId);
                    return new WorkspaceProgress(w.WorkspaceId, w.Workspace.Name, (int)Math.Round(p.Done * 100.0 / p.Total));
                })
                .ToList();

            var sevenDaysAgo = DateTime.UtcNow.Date.AddDays(-6);
            var completedDates = await db.WorkItems
                .Where(wi => workspaceIds.Contains(wi.TaskList.Space.WorkspaceId)
                    && wi.Status.Category == StatusCategory.Done
                    && wi.UpdatedAtUtc != null
                    && wi.UpdatedAtUtc.Value.Date >= sevenDaysAgo)
                .Select(wi => wi.UpdatedAtUtc!.Value.Date)
                .ToListAsync();

            var ptBr = new CultureInfo("pt-BR");
            weeklyLabels = Enumerable.Range(0, 7).Select(i => ptBr.TextInfo.ToTitleCase(sevenDaysAgo.AddDays(i).ToString("ddd", ptBr))).ToList();
            weeklyValues = Enumerable.Range(0, 7).Select(i => completedDates.Count(d => d == sevenDaysAgo.AddDays(i))).ToList();
        }

        todoItems = await QueryService.GetAssignedWorkItemsAsync(userId);
        var todayDate = DateTime.UtcNow.Date;
        var weekAhead = todayDate.AddDays(7);
        overdue = todoItems.Where(i => i.DueDateUtc is not null && i.DueDateUtc.Value.Date < todayDate).ToList();
        thisWeek = todoItems.Where(i => i.DueDateUtc is not null && i.DueDateUtc.Value.Date >= todayDate && i.DueDateUtc.Value.Date <= weekAhead).ToList();
        later = todoItems.Except(overdue).Except(thisWeek).ToList();

        doneItems = await QueryService.GetRecentlyCompletedByUserAsync(userId);
        delegatedItems = await QueryService.GetDelegatedByUserAsync(userId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && weeklyLabels.Count > 0)
        {
            chartModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/productivity-chart-interop.js");
            await chartModule.InvokeVoidAsync("render", "productivity-chart", weeklyLabels, weeklyValues);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (chartModule is not null)
        {
            try
            {
                await chartModule.InvokeVoidAsync("destroy", "productivity-chart");
                await chartModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to clean up client-side.
            }
        }
    }

    // Abre a lista já com o painel da tarefa aberto (ListView lê ?tarefa=).
    private void OpenTask(WorkItem item) => NavigationManager.NavigateTo($"/lists/{item.TaskListId}/list?tarefa={item.Id}");
}
