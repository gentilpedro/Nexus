@page "/"
@using System.Globalization
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Components.Shared
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject NavigationManager NavigationManager

<PageTitle>Nexus</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-container page-container--wide">
            <div class="dashboard-greeting">
                <div class="dashboard-greeting-title">@Greeting, @displayName!</div>
                <div class="dashboard-greeting-date">@today</div>
            </div>

            <div class="form-actions" style="margin-bottom: 1.25rem;">
                <a class="btn btn-secondary" href="/chats">Chats</a>
            </div>

            @if (workspaces is not null && workspaces.Count > 0)
            {
                <div class="dashboard-workspace-grid">
                    @foreach (var membership in workspaces)
                    {
                        <a class="dashboard-workspace-card" href="@($"/workspaces/{membership.WorkspaceId}")">
                            <span class="dashboard-workspace-avatar">@Initial(membership.Workspace.Name)</span>
                            <span class="dashboard-workspace-name">@membership.Workspace.Name</span>
                            <span class="dashboard-workspace-role">@membership.Role.ToDisplayLabel()</span>
                        </a>
                    }
                </div>
            }

            <div class="view-tabs">
                <button type="button" class="@(activeTab == "todo" ? "active" : "")" @onclick='() => activeTab = "todo"'>A Fazer</button>
                <button type="button" class="@(activeTab == "done" ? "active" : "")" @onclick='() => activeTab = "done"'>Concluídas</button>
                <button type="button" class="@(activeTab == "delegated" ? "active" : "")" @onclick='() => activeTab = "delegated"'>Delegadas</button>
            </div>

            @if (activeTab == "todo")
            {
                @if (todoItems is null)
                {
                    <p>Carregando...</p>
                }
                else if (todoItems.Count == 0)
                {
                    <div class="empty-state">
                        <p>Nenhuma tarefa atribuída a você.</p>
                    </div>
                }
                else
                {
                    @if (overdue.Count > 0)
                    {
                        <h2>Atrasadas</h2>
                        <div class="dashboard-task-list">
                            @foreach (var item in overdue)
                            {
                                <TaskRow Item="item" OnClick="OpenTask" />
                            }
                        </div>
                    }
                    @if (thisWeek.Count > 0)
                    {
                        <h2>Esta semana</h2>
                        <div class="dashboard-task-list">
                            @foreach (var item in thisWeek)
                            {
                                <TaskRow Item="item" OnClick="OpenTask" />
                            }
                        </div>
                    }
                    @if (later.Count > 0)
                    {
                        <h2>Depois / sem prazo</h2>
                        <div class="dashboard-task-list">
                            @foreach (var item in later)
                            {
                                <TaskRow Item="item" OnClick="OpenTask" />
                            }
                        </div>
                    }
                }
            }
            else if (activeTab == "done")
            {
                @if (doneItems is null)
                {
                    <p>Carregando...</p>
                }
                else if (doneItems.Count == 0)
                {
                    <div class="empty-state">
                        <p>Nenhuma tarefa concluída recentemente.</p>
                    </div>
                }
                else
                {
                    <div class="dashboard-task-list">
                        @foreach (var item in doneItems)
                        {
                            <TaskRow Item="item" OnClick="OpenTask" />
                        }
                    </div>
                }
            }
            else
            {
                @if (delegatedItems is null)
                {
                    <p>Carregando...</p>
                }
                else if (delegatedItems.Count == 0)
                {
                    <div class="empty-state">
                        <p>Nenhuma tarefa delegada.</p>
                    </div>
                }
                else
                {
                    <div class="dashboard-task-list">
                        @foreach (var item in delegatedItems)
                        {
                            <TaskRow Item="item" OnClick="OpenTask" />
                        }
                    </div>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="page-container">
            <div class="empty-state">
                <h1>Nexus</h1>
                <p>Gerencie seus projetos combinando o melhor do Jira e do ClickUp.</p>
                <a class="btn" href="Account/Register" data-enhance-nav="false">Criar conta</a>
                <a class="btn btn-secondary" href="Account/Login" data-enhance-nav="false">Entrar</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string displayName = "";
    private string today = "";
    private List<WorkspaceMember>? workspaces;

    private string activeTab = "todo";

    private List<WorkItem>? todoItems;
    private List<WorkItem> overdue = [];
    private List<WorkItem> thisWeek = [];
    private List<WorkItem> later = [];

    private List<WorkItem>? doneItems;
    private List<WorkItem>? delegatedItems;

    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Bom dia",
        < 18 => "Boa tarde",
        _ => "Boa noite"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            return;
        }

        var culture = new CultureInfo("pt-BR");
        var rawDate = DateTime.Now.ToString("dddd, d 'de' MMMM", culture);
        today = char.ToUpper(rawDate[0], culture) + rawDate[1..];

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var user = await db.Users
                .Where(u => u.Id == userId)
                .Select(u => new { u.DisplayName, u.Email })
                .FirstOrDefaultAsync();
            displayName = string.IsNullOrEmpty(user?.DisplayName) ? (user?.Email?.Split('@')[0] ?? "") : user.DisplayName;

            workspaces = await db.WorkspaceMembers
                .Include(m => m.Workspace)
                .Where(m => m.UserId == userId)
                .OrderBy(m => m.Workspace.Name)
                .ToListAsync();
        }

        todoItems = await QueryService.GetAssignedWorkItemsAsync(userId);
        var todayDate = DateTime.UtcNow.Date;
        var weekAhead = todayDate.AddDays(7);
        overdue = todoItems.Where(i => i.DueDateUtc is not null && i.DueDateUtc.Value.Date < todayDate).ToList();
        thisWeek = todoItems.Where(i => i.DueDateUtc is not null && i.DueDateUtc.Value.Date >= todayDate && i.DueDateUtc.Value.Date <= weekAhead).ToList();
        later = todoItems.Except(overdue).Except(thisWeek).ToList();

        doneItems = await QueryService.GetRecentlyCompletedByUserAsync(userId);
        delegatedItems = await QueryService.GetDelegatedByUserAsync(userId);
    }

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private void OpenTask(WorkItem item) => NavigationManager.NavigateTo($"/lists/{item.TaskListId}/list");
}
