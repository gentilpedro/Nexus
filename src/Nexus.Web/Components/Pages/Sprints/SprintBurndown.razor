@page "/sprints/{SprintId:guid}/burndown"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>Burndown · @(sprint?.Name ?? "Sprint") · Nexus</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <EmptyState Icon="trending-down" Title="Sprint não encontrada"
                    Description="Ela pode ter sido excluída, ou você não tem mais acesso ao workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (sprint is null)
    {
        <Skeleton Variant="card" Count="2" Label="Carregando sprint…" />
    }
    else
    {
        var total = sprint.WorkItems.Count;
        var done = sprint.WorkItems.Count(w => w.Status.Category == StatusCategory.Done);
        var pct = total == 0 ? 0 : done * 100 / total;
        var daysLeft = (sprint.EndDateUtc.Date - DateTime.UtcNow.Date).Days;

        <PageHeader Title="@sprint.Name">
            <Breadcrumbs>
                <a href="@($"/workspaces/{sprint.TaskList.Space.WorkspaceId}")">@sprint.TaskList.Space.Workspace.Name</a>
                <span class="breadcrumb-sep" aria-hidden="true">/</span>
                <a href="@($"/lists/{sprint.TaskListId}/backlog")">@sprint.TaskList.Name — Backlog</a>
            </Breadcrumbs>
            <Details>
                <span class="badge @(sprint.Status == SprintStatus.Active ? "badge--accent" : sprint.Status == SprintStatus.Completed ? "badge--success" : "")">@statusLabel</span>
                <span><Icon Name="calendar" Class="icon--sm" /> @sprint.StartDateUtc.ToString("dd/MM/yyyy") a @sprint.EndDateUtc.ToString("dd/MM/yyyy")</span>
            </Details>
            <Actions>
                <a class="btn btn-secondary" href="@($"/lists/{sprint.TaskListId}/backlog")"><Icon Name="arrow-left" /> Voltar ao backlog</a>
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrWhiteSpace(sprint.Goal))
        {
            <p class="sprint-goal-callout"><Icon Name="target" /> <span><strong>Meta:</strong> @sprint.Goal</span></p>
        }

        <div class="stat-grid">
            <div class="stat-card">
                <span class="stat-card-label">Tarefas na sprint</span>
                <span class="stat-card-value">@total</span>
            </div>
            <div class="stat-card">
                <span class="stat-card-label"><span class="stat-dot" style="--dot: var(--color-success)"></span>Entregues</span>
                <span class="stat-card-value">@done <small class="stat-card-of">(@pct%)</small></span>
            </div>
            <div class="stat-card">
                <span class="stat-card-label">Restantes</span>
                <span class="stat-card-value">@(total - done)</span>
            </div>
            <div class="stat-card">
                <span class="stat-card-label">@(sprint.Status == SprintStatus.Completed ? "Situação" : daysLeft >= 0 ? "Dias restantes" : "Prazo")</span>
                <span class="stat-card-value @(daysLeft < 0 && sprint.Status == SprintStatus.Active ? "text-danger" : "")">
                    @(sprint.Status == SprintStatus.Completed ? "Encerrada" : daysLeft >= 0 ? daysLeft.ToString() : $"{-daysLeft}d de atraso")
                </span>
            </div>
        </div>

        <section class="card" aria-labelledby="burndown-title">
            <div class="card-header">
                <div>
                    <h2 id="burndown-title" class="card-title">Burndown</h2>
                    <p class="card-subtitle">Quantas tarefas ainda faltavam em cada dia, comparado a um ritmo constante até o fim da sprint.</p>
                </div>
            </div>
            <BurndownChart Sprint="sprint" Snapshots="snapshots ?? []" />
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid SprintId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Sprint? sprint;
    private List<SprintBurndownSnapshot>? snapshots;
    private bool notFound;
    private Guid? loadedSprintId;

    private string statusLabel => sprint?.Status switch
    {
        SprintStatus.Planned => "Planejada",
        SprintStatus.Active => "Ativa",
        SprintStatus.Completed => "Concluída",
        _ => ""
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedSprintId == SprintId) return;
        loadedSprintId = SprintId;

        notFound = false;
        sprint = null;
        snapshots = null;

        Guid? workspaceId;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspaceId = await db.Sprints
                .Where(s => s.Id == SprintId)
                .Select(s => (Guid?)s.TaskList.Space.WorkspaceId)
                .FirstOrDefaultAsync();
        }

        if (workspaceId is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId.Value, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            sprint = await db.Sprints
                .Include(s => s.TaskList)
                .ThenInclude(l => l.Space)
                .ThenInclude(sp => sp.Workspace)
                .Include(s => s.WorkItems)
                .ThenInclude(w => w.Status)
                .FirstOrDefaultAsync(s => s.Id == SprintId);
            snapshots = await db.SprintBurndownSnapshots
                .Where(sn => sn.SprintId == SprintId)
                .OrderBy(sn => sn.SnapshotDateUtc)
                .ToListAsync();
        }

        if (sprint is null)
        {
            notFound = true;
            return;
        }

        var space = sprint.TaskList.Space;
        NavContext.SetList(space.WorkspaceId, space.Workspace.Name, space.Id, sprint.TaskListId);
    }
}
