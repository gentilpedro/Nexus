@page "/sprints/{SprintId:guid}/burndown"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>@(sprint?.Name ?? "Burndown")</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Sprint não encontrado ou você não tem acesso a ele.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (sprint is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="@($"/lists/{sprint.TaskListId}/backlog")">Voltar pro backlog</a>
        </div>
        <div class="page-header">
            <h1>@sprint.Name</h1>
        </div>
        @if (!string.IsNullOrWhiteSpace(sprint.Goal))
        {
            <p class="topnav-user">@sprint.Goal</p>
        }
        <p class="topnav-user">
            @sprint.StartDateUtc.ToString("dd/MM/yyyy") a @sprint.EndDateUtc.ToString("dd/MM/yyyy") · @statusLabel
        </p>

        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-card-body">
                    <span class="stat-card-label">Tarefas na sprint</span>
                    <span class="stat-card-value">@sprint.WorkItems.Count</span>
                </div>
                <span class="stat-card-icon">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                </span>
            </div>
            <div class="stat-card">
                <div class="stat-card-body">
                    <span class="stat-card-label">Entregues</span>
                    <span class="stat-card-value">@sprint.WorkItems.Count(w => w.Status.Category == StatusCategory.Done)</span>
                </div>
                <span class="stat-card-icon is-success">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </span>
            </div>
            <div class="stat-card">
                <div class="stat-card-body">
                    <span class="stat-card-label">Status</span>
                    <span class="stat-card-value" style="font-size:1.1rem;">@statusLabel</span>
                </div>
                <span class="stat-card-icon">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                </span>
            </div>
        </div>

        <BurndownChart Sprint="sprint" Snapshots="snapshots ?? []" />
    }
</div>

@code {
    [Parameter]
    public Guid SprintId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Sprint? sprint;
    private List<SprintBurndownSnapshot>? snapshots;
    private bool notFound;
    private Guid? loadedSprintId;

    private string statusLabel => sprint?.Status switch
    {
        SprintStatus.Planned => "Planejada",
        SprintStatus.Active => "Ativa",
        SprintStatus.Completed => "Concluída",
        _ => ""
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedSprintId == SprintId) return;
        loadedSprintId = SprintId;

        notFound = false;
        sprint = null;
        snapshots = null;

        Guid? workspaceId;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspaceId = await db.Sprints
                .Where(s => s.Id == SprintId)
                .Select(s => (Guid?)s.TaskList.Space.WorkspaceId)
                .FirstOrDefaultAsync();
        }

        if (workspaceId is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId.Value, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            sprint = await db.Sprints
                .Include(s => s.TaskList)
                .ThenInclude(l => l.Space)
                .ThenInclude(sp => sp.Workspace)
                .Include(s => s.WorkItems)
                .ThenInclude(w => w.Status)
                .FirstOrDefaultAsync(s => s.Id == SprintId);
            snapshots = await db.SprintBurndownSnapshots
                .Where(sn => sn.SprintId == SprintId)
                .OrderBy(sn => sn.SnapshotDateUtc)
                .ToListAsync();
        }

        if (sprint is null)
        {
            notFound = true;
            return;
        }

        var space = sprint.TaskList.Space;
        NavContext.SetList(space.WorkspaceId, space.Workspace.Name, space.Id, sprint.TaskListId);
    }
}
