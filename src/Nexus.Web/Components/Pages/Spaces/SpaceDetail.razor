@page "/workspaces/{WorkspaceId:guid}/spaces/{SpaceId:guid}"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Data.Common
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext
@inject WorkspaceAccessGuard AccessGuard
@inject ToastService Toasts

<PageTitle>@(space?.Name ?? "Space") · Nexus</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Space não encontrado"
                    Description="Ele pode ter sido excluído, ou você não tem mais acesso ao workspace dele.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (space is null)
    {
        <Skeleton Variant="card" Count="3" Label="Carregando space…" />
    }
    else
    {
        @if (isRenaming)
        {
            <nav class="breadcrumbs" aria-label="Você está em">
                <a href="/workspaces">Workspaces</a>
                <span class="breadcrumb-sep" aria-hidden="true">/</span>
                <a href="@($"/workspaces/{WorkspaceId}")">@workspace!.Name</a>
            </nav>
            <EditForm Model="renameModel" OnValidSubmit="HandleRename" class="card inline-form rename-form">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="space-name" class="required">Nome do space</label>
                    <InputText id="space-name" @bind-Value="renameModel.Name" autofocus />
                    <ValidationMessage For="() => renameModel.Name" />
                </div>
                <div class="form-actions form-actions--end">
                    <button type="button" class="btn btn-ghost" @onclick="() => isRenaming = false">Cancelar</button>
                    <button type="submit" class="btn">Salvar nome</button>
                </div>
            </EditForm>
        }
        else
        {
            <PageHeader Title="@space.Name">
                <Breadcrumbs>
                    <a href="/workspaces">Workspaces</a>
                    <span class="breadcrumb-sep" aria-hidden="true">/</span>
                    <a href="@($"/workspaces/{WorkspaceId}")">@workspace!.Name</a>
                </Breadcrumbs>
                <Details>
                    <span>@(taskLists?.Count ?? 0) lista@(taskLists?.Count == 1 ? "" : "s")</span>
                    <span>@taskTotal tarefa@(taskTotal == 1 ? "" : "s")</span>
                    @if (taskTotal > 0)
                    {
                        <span>@taskDonePercent% concluído</span>
                    }
                </Details>
                <Actions>
                    @if (canManageSpace)
                    {
                        <div class="menu-anchor" @onkeydown="HandleMenuKey">
                            <button type="button" class="icon-btn icon-btn--bordered" @onclick="() => menuOpen = !menuOpen"
                                    aria-haspopup="menu" aria-expanded="@(menuOpen ? "true" : "false")">
                                <Icon Name="more" Label="Mais opções do space" />
                            </button>
                            @if (menuOpen)
                            {
                                <div class="menu-backdrop" @onclick="() => menuOpen = false"></div>
                                <div class="menu" role="menu">
                                    <button type="button" role="menuitem" @onclick="StartRename"><Icon Name="edit" /> Renomear</button>
                                    <div class="menu-separator" role="separator"></div>
                                    <button type="button" role="menuitem" class="is-danger" @onclick="HandleDelete"><Icon Name="trash" /> Excluir space</button>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn" @onclick="ToggleCreateListForm"><Icon Name="plus" /> Nova lista</button>
                    }
                </Actions>
            </PageHeader>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
        }

        @if (showCreateListForm)
        {
            <EditForm Model="createListModel" OnValidSubmit="HandleCreateList" class="card inline-form">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="list-name" class="required">Nome da lista</label>
                    <InputText id="list-name" @bind-Value="createListModel.Name" placeholder="Ex.: Lançamento do site, Suporte, Sprint atual" autofocus />
                    <ValidationMessage For="() => createListModel.Name" />
                    <span class="field-hint">A lista já vem com três status: A Fazer, Em Andamento e Concluído. Dá para mudar depois.</span>
                </div>
                <div class="form-actions form-actions--end">
                    <button type="button" class="btn btn-ghost" @onclick="ToggleCreateListForm">Cancelar</button>
                    <button type="submit" class="btn @(isSavingList ? "is-loading" : "")" disabled="@isSavingList">Criar lista</button>
                </div>
            </EditForm>
        }

        @if (taskLists is null)
        {
            <Skeleton Variant="card" Count="4" />
        }
        else if (taskLists.Count == 0)
        {
            <div class="card">
                <EmptyState Icon="list" Title="Nenhuma lista neste space"
                            Description="@(canManageSpace ? "Listas guardam as tarefas. Crie uma por projeto, fluxo ou entrega." : "Quando um administrador criar uma lista, ela aparece aqui.")">
                    @if (canManageSpace && !showCreateListForm)
                    {
                        <button type="button" class="btn" @onclick="ToggleCreateListForm"><Icon Name="plus" /> Criar a primeira lista</button>
                    }
                </EmptyState>
            </div>
        }
        else
        {
            <ul class="space-list">
                @foreach (var list in taskLists)
                {
                    var progress = listProgress.TryGetValue(list.Id, out var p) ? p : (Done: 0, Total: 0);
                    var pct = progress.Total == 0 ? 0 : progress.Done * 100 / progress.Total;
                    <li>
                        <a class="space-item" href="@($"/lists/{list.Id}/list")">
                            <span class="space-item-icon" aria-hidden="true"><Icon Name="list" /></span>
                            <span class="space-item-body">
                                <span class="space-item-name">@list.Name</span>
                                <span class="space-item-meta">
                                    @if (progress.Total > 0)
                                    {
                                        @($"{progress.Done} de {progress.Total} tarefas concluídas")
                                    }
                                    else
                                    {
                                        @("Nenhuma tarefa ainda")
                                    }
                                </span>
                            </span>
                            @if (progress.Total > 0)
                            {
                                <span class="space-item-progress">
                                    <span class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct" aria-label="@($"{pct}% concluído")">
                                        <span class="progress-fill" style="width:@(pct)%"></span>
                                    </span>
                                    <span class="space-item-pct">@pct%</span>
                                </span>
                            }
                            <Icon Name="chevron-right" Class="space-item-chevron" />
                        </a>
                    </li>
                }
            </ul>
        }

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public Guid SpaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Workspace? workspace;
    private Space? space;
    private List<TaskList>? taskLists;
    private bool notFound;
    private bool canManageSpace;
    private bool isRenaming;
    private bool showCreateListForm;
    private bool isSavingList;
    private string? errorMessage;
    private readonly RenameSpaceModel renameModel = new();
    private readonly CreateListModel createListModel = new();
    private Guid? loadedSpaceId;
    private int taskTotal;
    private int taskDonePercent;
    private Dictionary<Guid, (int Done, int Total)> listProgress = new();
    private ConfirmDialog? confirm;
    private bool menuOpen;

    private void HandleMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            menuOpen = false;
        }
    }

    // As ações abaixo só aparecem para admins, mas a interface não é a barreira: cada escrita
    // confere de novo o papel atual no servidor (ver WorkspaceAccessGuard).
    private async Task<bool> EnsureAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        errorMessage = "Você não tem mais permissão para alterar este space.";
        canManageSpace = false;
        return false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedSpaceId == SpaceId) return;
        loadedSpaceId = SpaceId;

        notFound = false;
        workspace = null;
        space = null;
        taskLists = null;
        isRenaming = false;
        showCreateListForm = false;
        errorMessage = null;

        var authState = await AuthStateTask!;

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManageSpace = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
            space = await db.Spaces.FirstOrDefaultAsync(s => s.Id == SpaceId && s.WorkspaceId == WorkspaceId);
        }

        if (workspace is null || space is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetSpace(WorkspaceId, workspace.Name, SpaceId);

        await LoadTaskListsAsync();
    }

    private async Task LoadTaskListsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        taskLists = await db.TaskLists
            .Where(l => l.SpaceId == SpaceId)
            .OrderBy(l => l.SortOrder)
            .ThenBy(l => l.Name)
            .ToListAsync();

        var workItems = await db.WorkItems
            .Where(wi => wi.TaskList.SpaceId == SpaceId)
            .Select(wi => new { wi.TaskListId, wi.Status.Category })
            .ToListAsync();

        taskTotal = workItems.Count;
        taskDonePercent = taskTotal == 0 ? 0 : (int)Math.Round(workItems.Count(c => c.Category == StatusCategory.Done) * 100.0 / taskTotal);

        listProgress = workItems
            .GroupBy(wi => wi.TaskListId)
            .ToDictionary(g => g.Key, g => (Done: g.Count(wi => wi.Category == StatusCategory.Done), Total: g.Count()));
    }

    private void ToggleCreateListForm()
    {
        showCreateListForm = !showCreateListForm;
        createListModel.Name = "";
    }

    private async Task HandleCreateList()
    {
        if (!await EnsureAdminAsync())
        {
            showCreateListForm = false;
            return;
        }

        isSavingList = true;

        var maxSortOrder = taskLists!.Count == 0 ? -1 : taskLists.Max(l => l.SortOrder);

        var taskList = new TaskList
        {
            Id = Guid.NewGuid(),
            SpaceId = SpaceId,
            Name = createListModel.Name.Trim(),
            SortOrder = maxSortOrder + 1
        };

        taskList.Statuses.Add(new TaskStatusDefinition { Id = Guid.NewGuid(), TaskListId = taskList.Id, Name = "A Fazer", SortOrder = 0, Category = StatusCategory.ToDo, IsDefault = true });
        taskList.Statuses.Add(new TaskStatusDefinition { Id = Guid.NewGuid(), TaskListId = taskList.Id, Name = "Em Andamento", SortOrder = 1, Category = StatusCategory.InProgress });
        taskList.Statuses.Add(new TaskStatusDefinition { Id = Guid.NewGuid(), TaskListId = taskList.Id, Name = "Concluído", SortOrder = 2, Category = StatusCategory.Done });

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.TaskLists.Add(taskList);
            await db.SaveChangesAsync();
        }

        showCreateListForm = false;
        isSavingList = false;
        Toasts.Show($"Lista \"{taskList.Name}\" criada");
        await LoadTaskListsAsync();
        NavContext.Refresh();
    }

    private void StartRename()
    {
        menuOpen = false;
        renameModel.Name = space!.Name;
        isRenaming = true;
    }

    private async Task HandleRename()
    {
        if (!await EnsureAdminAsync())
        {
            isRenaming = false;
            return;
        }

        var newName = renameModel.Name.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Spaces.Where(s => s.Id == SpaceId).ExecuteUpdateAsync(s => s.SetProperty(x => x.Name, newName));
        space!.Name = newName;
        isRenaming = false;
        Toasts.Show("Nome do space atualizado");
        NavContext.Refresh();
    }

    private async Task HandleDelete()
    {
        menuOpen = false;
        var listCount = taskLists?.Count ?? 0;
        var consequence = listCount == 0 && taskTotal == 0
            ? "O space está vazio."
            : $"{listCount} {(listCount == 1 ? "lista" : "listas")} e {taskTotal} {(taskTotal == 1 ? "tarefa" : "tarefas")} — com comentários, anexos e sprints — serão excluídas junto.";

        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("space", space?.Name, consequence)))
        {
            return;
        }

        if (!await EnsureAdminAsync())
        {
            return;
        }

        try
        {
            // ExecuteDeleteAsync issues a direct SQL DELETE and lets the database resolve the
            // cascade (Space -> TaskList -> WorkItems/Statuses) as a single set-based operation —
            // deliberately not Remove()+SaveChanges(), which asks EF's client-side change tracker
            // to walk the cascade in-memory and throws if other entities from this same chain are
            // tracked elsewhere. Now moot in practice since IDbContextFactory gives every operation
            // its own short-lived context, but ExecuteDeleteAsync remains the more direct approach.
            await using var db = await DbFactory.CreateDbContextAsync();
            // StatusTransition's FKs to TaskStatusDefinition are both Restrict (see
            // StatusTransitionConfiguration) — the Space -> TaskList -> TaskStatusDefinition
            // cascade below would fail on any list with configured transitions unless those
            // rows are removed first.
            await db.StatusTransitions
                .Where(t => t.FromStatus.TaskList.SpaceId == SpaceId)
                .ExecuteDeleteAsync();
            await db.Spaces.Where(s => s.Id == SpaceId).ExecuteDeleteAsync();
            Toasts.Show($"Space \"{space?.Name}\" excluído");
            NavContext.Refresh();
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}");
        }
        catch (DbException)
        {
            // ExecuteDeleteAsync issues raw SQL directly (bypassing SaveChanges), so a Restrict
            // FK violation surfaces as the provider's own exception (SqlException on SQL Server),
            // not a DbUpdateException — DbException is the provider-agnostic base type for that.
            errorMessage = "Não foi possível excluir o space.";
        }
    }

    private class RenameSpaceModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
    }

    private class CreateListModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
    }
}
