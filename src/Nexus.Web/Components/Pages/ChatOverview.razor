@page "/chats"
@page "/chats/{WorkspaceId:guid}"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Components.Pages.Workspaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Chats · Nexus</PageTitle>

<div class="page-container page-container--wide chat-page">
    <PageHeader Title="Chats" Description="Uma conversa por workspace, com todos os membros dele." />

    @if (items is null)
    {
        <Skeleton Count="5" Label="Carregando conversas…" />
    }
    else if (items.Count == 0)
    {
        <EmptyState Icon="chat" Title="Nenhuma conversa ainda"
                    Description="Cada workspace tem um chat próprio. Crie um workspace ou aceite um convite para começar a conversar.">
            <a class="btn" href="/workspaces/new"><Icon Name="plus" /> Criar workspace</a>
        </EmptyState>
    }
    else
    {
        <div class="chats-layout @(WorkspaceId is not null ? "chats-layout--chat-open" : "")">
            <nav class="chats-sidebar" aria-label="Conversas">
                <div class="chats-sidebar-search input-with-icon">
                    <Icon Name="search" />
                    <label for="chats-filter" class="sr-only">Buscar conversas</label>
                    <input id="chats-filter" type="search" placeholder="Buscar conversas" @bind="filterText" @bind:event="oninput" />
                </div>
                <ul class="chats-sidebar-list">
                    @foreach (var item in FilteredItems)
                    {
                        var active = item.WorkspaceId == WorkspaceId;
                        <li>
                            <a class="chats-sidebar-item @(active ? "active" : "")" href="@($"/chats/{item.WorkspaceId}")" aria-current="@(active ? "page" : null)">
                                <Avatar Name="@item.WorkspaceName" Color="@item.WorkspaceColor" Size="lg" Square="true" />
                                <span class="chats-sidebar-item-body">
                                    <span class="chats-sidebar-item-top">
                                        <span class="chats-sidebar-item-name">@item.WorkspaceName</span>
                                        @if (item.LastMessageAtUtc is not null)
                                        {
                                            <time class="chats-sidebar-item-time" datetime="@item.LastMessageAtUtc.Value.ToString("o")">@ShortWhen(item.LastMessageAtUtc.Value)</time>
                                        }
                                    </span>
                                    <span class="chats-sidebar-item-preview">
                                        @if (item.LastMessageContent is not null)
                                        {
                                            <span class="chats-sidebar-item-author">@item.LastMessageAuthor:</span> @item.LastMessageContent
                                        }
                                        else
                                        {
                                            <span class="cell-muted">Nenhuma mensagem ainda</span>
                                        }
                                    </span>
                                </span>
                            </a>
                        </li>
                    }
                    @if (!FilteredItems.Any())
                    {
                        <li><EmptyState Compact="true" Title="Nenhuma conversa encontrada" /></li>
                    }
                </ul>
            </nav>
            <div class="chats-main">
                @if (WorkspaceId is Guid selectedId)
                {
                    <WorkspaceChat WorkspaceId="selectedId" Embedded="true" @key="selectedId" />
                }
                else
                {
                    <div class="chats-main-empty">
                        <EmptyState Icon="chat" Title="Escolha uma conversa" Description="Selecione um workspace ao lado para ver as mensagens e conversar com o time." />
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<ChatOverviewItem>? items;
    private string filterText = "";

    private IEnumerable<ChatOverviewItem> FilteredItems => items is null
        ? []
        : items.Where(i => string.IsNullOrWhiteSpace(filterText) || i.WorkspaceName.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            items = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var raw = await db.WorkspaceMembers
            .Where(m => m.UserId == userId)
            .Select(m => new
            {
                m.WorkspaceId,
                WorkspaceName = m.Workspace.Name,
                WorkspaceColor = m.Workspace.Color,
                Last = db.ChatMessages
                    .Where(cm => cm.WorkspaceId == m.WorkspaceId)
                    .OrderByDescending(cm => cm.CreatedAtUtc)
                    .Select(cm => new
                    {
                        cm.Content,
                        cm.CreatedAtUtc,
                        AuthorName = cm.User == null ? "Usuário removido" : (cm.User.DisplayName != "" ? cm.User.DisplayName : cm.User.Email)
                    })
                    .FirstOrDefault()
            })
            .ToListAsync();

        items = raw
            .Select(x => new ChatOverviewItem
            {
                WorkspaceId = x.WorkspaceId,
                WorkspaceName = x.WorkspaceName,
                WorkspaceColor = x.WorkspaceColor,
                LastMessageContent = x.Last?.Content,
                LastMessageAuthor = x.Last?.AuthorName,
                LastMessageAtUtc = x.Last?.CreatedAtUtc
            })
            .OrderByDescending(x => x.LastMessageAtUtc ?? DateTime.MinValue)
            .ThenBy(x => x.WorkspaceName)
            .ToList();
    }

    // "14:32" hoje, "ontem", "12/09" no resto — o formato das listas de conversa.
    private static string ShortWhen(DateTime utc)
    {
        var local = utc.ToLocalTime();
        var today = DateTime.Now.Date;
        if (local.Date == today) return local.ToString("HH:mm");
        if (local.Date == today.AddDays(-1)) return "ontem";
        return local.ToString(local.Year == today.Year ? "dd/MM" : "dd/MM/yy");
    }

    private class ChatOverviewItem
    {
        public Guid WorkspaceId { get; set; }
        public string WorkspaceName { get; set; } = "";
        public string? WorkspaceColor { get; set; }
        public string? LastMessageContent { get; set; }
        public string? LastMessageAuthor { get; set; }
        public DateTime? LastMessageAtUtc { get; set; }
    }
}
