@page "/chats"
@page "/chats/{WorkspaceId:guid}"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Components.Pages.Workspaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Conversas</PageTitle>

<div class="page-container page-container--wide">
    <div class="page-header">
        <h1>Conversas</h1>
    </div>

    @if (items is null)
    {
        <p>Carregando...</p>
    }
    else if (items.Count == 0)
    {
        <div class="empty-state">
            <p>Você ainda não participa de nenhum workspace.</p>
        </div>
    }
    else
    {
        <div class="chats-layout">
            <div class="chats-sidebar">
                <div class="chats-sidebar-search">
                    <input type="search" placeholder="Buscar conversas..." @bind="filterText" @bind:event="oninput" />
                </div>
                <div class="chats-sidebar-list">
                    @foreach (var item in FilteredItems)
                    {
                        <a class="chats-sidebar-item @(item.WorkspaceId == WorkspaceId ? "active" : "")" href="@($"/chats/{item.WorkspaceId}")">
                            <span class="chat-message-avatar">@Initial(item.WorkspaceName)</span>
                            <div class="chats-sidebar-item-body">
                                <div class="chats-sidebar-item-top">
                                    <span>#@item.WorkspaceName</span>
                                    @if (item.LastMessageAtUtc is not null)
                                    {
                                        <span class="chat-message-time">@item.LastMessageAtUtc.Value.ToLocalTime().ToString("dd/MM")</span>
                                    }
                                </div>
                                @if (item.LastMessageContent is not null)
                                {
                                    <div class="chats-sidebar-item-preview"><strong>@item.LastMessageAuthor:</strong> @item.LastMessageContent</div>
                                }
                                else
                                {
                                    <div class="chats-sidebar-item-preview">Nenhuma mensagem ainda.</div>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>
            <div class="chats-main">
                @if (WorkspaceId is Guid selectedId)
                {
                    <WorkspaceChat WorkspaceId="selectedId" Embedded="true" @key="selectedId" />
                }
                else
                {
                    <div class="chats-main-empty">
                        <p>Selecione uma conversa à esquerda para começar.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<ChatOverviewItem>? items;
    private string filterText = "";

    private IEnumerable<ChatOverviewItem> FilteredItems => items is null
        ? []
        : items.Where(i => string.IsNullOrWhiteSpace(filterText) || i.WorkspaceName.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            items = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var raw = await db.WorkspaceMembers
            .Where(m => m.UserId == userId)
            .Select(m => new
            {
                m.WorkspaceId,
                WorkspaceName = m.Workspace.Name,
                Last = db.ChatMessages
                    .Where(cm => cm.WorkspaceId == m.WorkspaceId)
                    .OrderByDescending(cm => cm.CreatedAtUtc)
                    .Select(cm => new
                    {
                        cm.Content,
                        cm.CreatedAtUtc,
                        AuthorName = cm.User == null ? "Usuário removido" : (cm.User.DisplayName != "" ? cm.User.DisplayName : cm.User.Email)
                    })
                    .FirstOrDefault()
            })
            .ToListAsync();

        items = raw
            .Select(x => new ChatOverviewItem
            {
                WorkspaceId = x.WorkspaceId,
                WorkspaceName = x.WorkspaceName,
                LastMessageContent = x.Last?.Content,
                LastMessageAuthor = x.Last?.AuthorName,
                LastMessageAtUtc = x.Last?.CreatedAtUtc
            })
            .OrderByDescending(x => x.LastMessageAtUtc ?? DateTime.MinValue)
            .ThenBy(x => x.WorkspaceName)
            .ToList();
    }

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private class ChatOverviewItem
    {
        public Guid WorkspaceId { get; set; }
        public string WorkspaceName { get; set; } = "";
        public string? LastMessageContent { get; set; }
        public string? LastMessageAuthor { get; set; }
        public DateTime? LastMessageAtUtc { get; set; }
    }
}
