@page "/search"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Components.Shared
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject NavigationManager NavigationManager

<PageTitle>Busca · Nexus</PageTitle>

<div class="page-container page-container--wide">
    <PageHeader Title="Busca" Description="Encontre tarefas, documentos, planilhas e pessoas de todos os seus workspaces." />

    <form class="search-bar" role="search" @onsubmit="HandleSearch" @onsubmit:preventDefault="true">
        <div class="input-with-icon search-bar-input">
            <Icon Name="search" />
            <label for="search-q" class="sr-only">O que você procura?</label>
            <input id="search-q" type="search" placeholder="Buscar tarefas, documentos, planilhas ou pessoas" @bind="textFilter" @bind:event="oninput" autofocus />
        </div>
        <button type="button" class="btn btn-secondary" @onclick="() => showAdvancedFilters = !showAdvancedFilters"
                aria-expanded="@(showAdvancedFilters ? "true" : "false")" aria-controls="search-filters">
            <Icon Name="filter" /> <span class="label-collapsible">Filtros</span>
            @if (ActiveFilterCount > 0)
            {
                <span class="tab-count">@ActiveFilterCount</span>
            }
        </button>
        <button type="submit" class="btn">Buscar</button>
    </form>

    @if (showAdvancedFilters)
    {
        <form id="search-filters" @onsubmit="HandleSearch" @onsubmit:preventDefault="true" class="card search-filters">
            <p class="form-section-description">Os filtros valem para a aba Tarefas.</p>
            <div class="form-row form-row--3">
                <div class="form-field">
                    <label for="search-workspace">Workspace</label>
                    <select id="search-workspace" @bind="workspaceIdText" @bind:after="HandleSearch">
                        <option value="">Todos os meus</option>
                        @foreach (var ws in workspaces ?? [])
                        {
                            <option value="@ws.Id">@ws.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="search-status">Status</label>
                    <select id="search-status" @bind="statusCategoryText" @bind:after="HandleSearch">
                        <option value="">Qualquer</option>
                        <option value="ToDo">A fazer</option>
                        <option value="InProgress">Em andamento</option>
                        <option value="Done">Concluído</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="search-priority">Prioridade</label>
                    <select id="search-priority" @bind="priorityText" @bind:after="HandleSearch">
                        <option value="">Qualquer</option>
                        @foreach (var p in Enum.GetValues<WorkItemPriority>())
                        {
                            <option value="@p">@p.ToDisplayLabel()</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="search-type">Tipo</label>
                    <select id="search-type" @bind="typeText" @bind:after="HandleSearch">
                        <option value="">Qualquer</option>
                        @foreach (var t in Enum.GetValues<WorkItemType>())
                        {
                            <option value="@t">@t.ToDisplayLabel()</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="search-assignee">Responsável</label>
                    <select id="search-assignee" @bind="assigneeModeText" @bind:after="HandleSearch">
                        <option value="Any">Qualquer</option>
                        <option value="Me">Atribuídas a mim</option>
                        <option value="Unassigned">Sem responsável</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="search-due">Prazo</label>
                    <select id="search-due" @bind="dueModeText" @bind:after="HandleSearch">
                        <option value="Any">Qualquer</option>
                        <option value="Overdue">Atrasadas</option>
                        <option value="ThisWeek">Esta semana</option>
                        <option value="NoDueDate">Sem prazo</option>
                    </select>
                </div>
            </div>
        </form>
    }

    <div class="view-tabs" role="tablist" aria-label="Tipo de resultado">
        <button type="button" role="tab" aria-selected="@(tab == "all" ? "true" : "false")" class="@(tab == "all" ? "active" : "")" @onclick='() => tab = "all"'>Tudo <span class="tab-count">@TotalCount</span></button>
        <button type="button" role="tab" aria-selected="@(tab == "tasks" ? "true" : "false")" class="@(tab == "tasks" ? "active" : "")" @onclick='() => tab = "tasks"'>Tarefas <span class="tab-count">@(results?.Count ?? 0)</span></button>
        <button type="button" role="tab" aria-selected="@(tab == "docs" ? "true" : "false")" class="@(tab == "docs" ? "active" : "")" @onclick='() => tab = "docs"'>Documentos <span class="tab-count">@(docResults?.Count ?? 0)</span></button>
        <button type="button" role="tab" aria-selected="@(tab == "sheets" ? "true" : "false")" class="@(tab == "sheets" ? "active" : "")" @onclick='() => tab = "sheets"'>Planilhas <span class="tab-count">@(sheetResults?.Count ?? 0)</span></button>
        <button type="button" role="tab" aria-selected="@(tab == "people" ? "true" : "false")" class="@(tab == "people" ? "active" : "")" @onclick='() => tab = "people"'>Pessoas <span class="tab-count">@(peopleResults?.Count ?? 0)</span></button>
    </div>

    <div role="tabpanel" aria-live="polite" aria-busy="@(!HasLoaded ? "true" : "false")">
    @if (!HasLoaded)
    {
        <Skeleton Count="6" Label="Buscando…" />
    }
    else if (!string.IsNullOrWhiteSpace(textFilter) && TotalCount == 0)
    {
        <EmptyState Icon="search" Title="@($"Nada encontrado para \"{textFilter}\"")"
                    Description="Tente palavras mais gerais, confira a digitação ou limpe os filtros.">
            <button type="button" class="btn btn-secondary" @onclick="ClearSearch">Limpar busca</button>
        </EmptyState>
    }
    else if (tab == "all")
    {
        @if (TotalCount == 0)
        {
            <EmptyState Icon="search" Title="O que você procura?"
                        Description="Digite um termo acima. A busca olha títulos de tarefas, documentos e planilhas, e nomes e e-mails de pessoas." />
        }
        @if (results is { Count: > 0 })
        {
            <section class="section search-section" aria-labelledby="sr-tasks">
                <div class="section-header">
                    <h2 id="sr-tasks" class="section-title">Tarefas <span class="tab-count">@results.Count</span></h2>
                    @if (results.Count > 3)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick='() => tab = "tasks"'>Ver todas <Icon Name="arrow-right" /></button>
                    }
                </div>
                <ul class="task-list card card--flush">
                    @foreach (var item in results.Take(3))
                    {
                        <TaskRow Item="item" OnClick="OpenTask" @key="item.Id" />
                    }
                </ul>
            </section>
        }
        @if (docResults is { Count: > 0 } || sheetResults is { Count: > 0 })
        {
            var docsAndSheets = (docResults ?? []).Concat(sheetResults ?? []).ToList();
            <section class="section search-section" aria-labelledby="sr-docs">
                <div class="section-header">
                    <h2 id="sr-docs" class="section-title">Documentos e planilhas <span class="tab-count">@docsAndSheets.Count</span></h2>
                    @if (docsAndSheets.Count > 3)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick='() => tab = "docs"'>Ver todos <Icon Name="arrow-right" /></button>
                    }
                </div>
                @DocTable(docsAndSheets.Take(3))
            </section>
        }
        @if (peopleResults is { Count: > 0 })
        {
            <section class="section search-section" aria-labelledby="sr-people">
                <div class="section-header">
                    <h2 id="sr-people" class="section-title">Pessoas <span class="tab-count">@peopleResults.Count</span></h2>
                    @if (peopleResults.Count > 3)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick='() => tab = "people"'>Ver todas <Icon Name="arrow-right" /></button>
                    }
                </div>
                @PeopleGrid(peopleResults.Take(3))
            </section>
        }
    }
    else if (tab == "tasks")
    {
        @if (results is null || results.Count == 0)
        {
            <EmptyState Icon="tasks" Title="Nenhuma tarefa encontrada" Description="Ajuste o termo ou os filtros para ver mais resultados." />
        }
        else
        {
            <ul class="task-list card card--flush">
                @foreach (var item in results)
                {
                    <TaskRow Item="item" OnClick="OpenTask" @key="item.Id" />
                }
            </ul>
        }
    }
    else if (tab is "docs" or "sheets")
    {
        var list = tab == "docs" ? docResults : sheetResults;
        @if (list is null || list.Count == 0)
        {
            <EmptyState Icon="@(tab == "docs" ? "doc" : "sheet")" Title="@(tab == "docs" ? "Nenhum documento encontrado" : "Nenhuma planilha encontrada")" />
        }
        else
        {
            @DocTable(list)
        }
    }
    else
    {
        @if (peopleResults is null || peopleResults.Count == 0)
        {
            <EmptyState Icon="team" Title="Ninguém encontrado" Description="A busca olha nome e e-mail de quem participa dos seus workspaces." />
        }
        else
        {
            @PeopleGrid(peopleResults)
        }
    }
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    [Parameter]
    public string? QText { get; set; }

    private string tab = "all";
    private bool showAdvancedFilters;
    private string? userId;
    private List<Guid>? myWorkspaceIds;
    private List<Workspace>? workspaces;
    private List<WorkItem>? results;
    private List<DocPage>? docResults;
    private List<DocPage>? sheetResults;
    private List<ApplicationUser>? peopleResults;

    private string textFilter = "";
    private string workspaceIdText = "";
    private string statusCategoryText = "";
    private string priorityText = "";
    private string typeText = "";
    private string assigneeModeText = "Any";
    private string dueModeText = "Any";

    private bool HasLoaded => results is not null && docResults is not null && sheetResults is not null && peopleResults is not null;

    private int TotalCount => (results?.Count ?? 0) + (docResults?.Count ?? 0) + (sheetResults?.Count ?? 0) + (peopleResults?.Count ?? 0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            results = [];
            docResults = [];
            sheetResults = [];
            peopleResults = [];
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspaces = await db.WorkspaceMembers
                .Where(m => m.UserId == userId)
                .Select(m => m.Workspace)
                .OrderBy(w => w.Name)
                .ToListAsync();
        }
        myWorkspaceIds = workspaces.Select(w => w.Id).ToList();

        textFilter = QText ?? "";
        await HandleSearch();
    }

    private async Task HandleSearch()
    {
        await ReloadTasksAsync();
        await ReloadDocsAsync();
        await ReloadPeopleAsync();
    }

    private async Task ClearSearch()
    {
        textFilter = "";
        workspaceIdText = "";
        statusCategoryText = "";
        priorityText = "";
        typeText = "";
        assigneeModeText = "Any";
        dueModeText = "Any";
        await HandleSearch();
    }

    private async Task ReloadTasksAsync()
    {
        if (userId is null)
        {
            return;
        }

        var filters = new WorkItemSearchFilters
        {
            WorkspaceId = Guid.TryParse(workspaceIdText, out var wsId) ? wsId : null,
            Text = textFilter,
            StatusCategory = Enum.TryParse<StatusCategory>(statusCategoryText, out var cat) ? cat : null,
            Priority = Enum.TryParse<WorkItemPriority>(priorityText, out var pri) ? pri : null,
            Type = Enum.TryParse<WorkItemType>(typeText, out var typ) ? typ : null,
            AssigneeMode = Enum.TryParse<AssigneeFilterMode>(assigneeModeText, out var am) ? am : AssigneeFilterMode.Any,
            DueMode = Enum.TryParse<DueFilterMode>(dueModeText, out var dm) ? dm : DueFilterMode.Any
        };

        results = await QueryService.SearchWorkItemsAsync(userId, filters);
    }

    private async Task ReloadDocsAsync()
    {
        if (myWorkspaceIds is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.DocPages
            .Include(d => d.Workspace)
            .Where(d => myWorkspaceIds.Contains(d.WorkspaceId));

        if (!string.IsNullOrWhiteSpace(textFilter))
        {
            query = query.Where(d => d.Title.Contains(textFilter));
        }

        docResults = await query.Where(d => d.Type == DocPageType.Text).OrderByDescending(d => d.UpdatedAtUtc ?? d.CreatedAtUtc).Take(50).ToListAsync();
        sheetResults = await query.Where(d => d.Type == DocPageType.Spreadsheet).OrderByDescending(d => d.UpdatedAtUtc ?? d.CreatedAtUtc).Take(50).ToListAsync();
    }

    private async Task ReloadPeopleAsync()
    {
        if (myWorkspaceIds is null || userId is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.WorkspaceMembers
            .Where(m => myWorkspaceIds.Contains(m.WorkspaceId) && m.UserId != userId)
            .Select(m => m.User)
            .Distinct();

        if (!string.IsNullOrWhiteSpace(textFilter))
        {
            query = query.Where(u => (u.DisplayName != null && u.DisplayName.Contains(textFilter)) || (u.Email != null && u.Email.Contains(textFilter)));
        }

        peopleResults = await query.OrderBy(u => u.DisplayName).Take(50).ToListAsync();
    }

    // Abre a lista já com o painel da tarefa (ListView lê ?tarefa=).
    private void OpenTask(WorkItem item) => NavigationManager.NavigateTo($"/lists/{item.TaskListId}/list?tarefa={item.Id}");

    // Antes navegava para /docs/{id} e /spreadsheets/{id}, rotas que não existem (404): as
    // páginas de documento vivem sob o workspace. Mesma regra de DocsList.OpenDoc.
    private void OpenDoc(DocPage doc)
    {
        if (doc.Type == DocPageType.File)
        {
            NavigationManager.NavigateTo($"/doc-files/{doc.Id}/download", forceLoad: true);
            return;
        }

        var segment = doc.Type == DocPageType.Spreadsheet ? "spreadsheets" : "docs";
        NavigationManager.NavigateTo($"/workspaces/{doc.WorkspaceId}/{segment}/{doc.Id}");
    }

    private int ActiveFilterCount =>
        new[] { workspaceIdText, statusCategoryText, priorityText, typeText }.Count(v => !string.IsNullOrEmpty(v))
        + (assigneeModeText != "Any" ? 1 : 0)
        + (dueModeText != "Any" ? 1 : 0);

    private RenderFragment DocTable(IEnumerable<DocPage> docs) => @<div class="table-scroll">
        <table class="data-table docs-table">
            <thead>
                <tr><th>Nome</th><th>Workspace</th><th>Atualizado</th></tr>
            </thead>
            <tbody>
                @foreach (var doc in docs)
                {
                    <tr class="data-table-row" @onclick="() => OpenDoc(doc)">
                        <td class="cell-title">
                            <span class="doc-cell">
                                <span class="doc-type-icon doc-type-icon--@doc.Type.ToString().ToLowerInvariant()" aria-hidden="true">
                                    <Icon Name="@(doc.Type == DocPageType.Spreadsheet ? "sheet" : doc.Type == DocPageType.File ? "paperclip" : "doc")" />
                                </span>
                                <button type="button" class="row-link" @onclick="() => OpenDoc(doc)" @onclick:stopPropagation="true">@doc.Title</button>
                            </span>
                        </td>
                        <td class="cell-muted">@doc.Workspace.Name</td>
                        <td class="cell-muted tabular">@((doc.UpdatedAtUtc ?? doc.CreatedAtUtc).ToLocalTime().ToString("dd/MM/yyyy"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>;

    private RenderFragment PeopleGrid(IEnumerable<ApplicationUser> people) => @<ul class="people-grid">
        @foreach (var person in people)
        {
            var name = person.DisplayName is { Length: > 0 } dn ? dn : (person.Email ?? "");
            <li class="person-card">
                <Avatar Name="@name" Size="lg" />
                <div class="person-cell-text">
                    <span class="person-cell-name">@name</span>
                    <span class="person-cell-sub">@person.Email</span>
                </div>
            </li>
        }
    </ul>;
}
