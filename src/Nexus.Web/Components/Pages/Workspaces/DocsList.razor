@page "/workspaces/{WorkspaceId:guid}/docs"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject AttachmentStorageService Storage
@inject NavigationContextService NavContext

<PageTitle>Documentos · @(workspace?.Name ?? "Workspace") · Nexus</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Workspace não encontrado"
                    Description="Ele pode ter sido excluído, ou você não faz mais parte dele.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (workspace is null)
    {
        <Skeleton Count="6" Label="Carregando documentos…" />
    }
    else
    {
        <PageHeader Title="@workspace.Name">
            <Breadcrumbs>
                <a href="/workspaces">Workspaces</a>
            </Breadcrumbs>
        </PageHeader>

        <WorkspaceTabs WorkspaceId="WorkspaceId" Active="docs" CanManage="isAdmin" />

        <div class="list-toolbar">
            <div class="pill-tabs" role="group" aria-label="Filtrar por tipo">
                <button type="button" aria-pressed="@(typeFilter is null ? "true" : "false")" class="@(typeFilter is null ? "active" : "")" @onclick="() => typeFilter = null">Todos <span class="tab-count">@(docs?.Count ?? 0)</span></button>
                <button type="button" aria-pressed="@(typeFilter == DocPageType.Text ? "true" : "false")" class="@(typeFilter == DocPageType.Text ? "active" : "")" @onclick="() => typeFilter = DocPageType.Text">Documentos <span class="tab-count">@(docs?.Count(d => d.Type == DocPageType.Text) ?? 0)</span></button>
                <button type="button" aria-pressed="@(typeFilter == DocPageType.Spreadsheet ? "true" : "false")" class="@(typeFilter == DocPageType.Spreadsheet ? "active" : "")" @onclick="() => typeFilter = DocPageType.Spreadsheet">Planilhas <span class="tab-count">@(docs?.Count(d => d.Type == DocPageType.Spreadsheet) ?? 0)</span></button>
                <button type="button" aria-pressed="@(typeFilter == DocPageType.File ? "true" : "false")" class="@(typeFilter == DocPageType.File ? "active" : "")" @onclick="() => typeFilter = DocPageType.File">Arquivos <span class="tab-count">@(docs?.Count(d => d.Type == DocPageType.File) ?? 0)</span></button>
            </div>
            <div class="button-row">
                <label for="docs-import-input" class="btn btn-ghost @(isImporting ? "is-loading" : "")">
                    <Icon Name="upload" /> <span class="label-collapsible">Importar arquivo</span>
                </label>
                <InputFile id="docs-import-input" OnChange="HandleImportFilesSelected" multiple
                           class="sr-only" disabled="@isImporting" />
                <a class="btn btn-secondary" href="@($"/workspaces/{WorkspaceId}/spreadsheets/nova")"><Icon Name="sheet" /> Nova planilha</a>
                <a class="btn" href="@($"/workspaces/{WorkspaceId}/docs/novo")"><Icon Name="plus" /> Novo documento</a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(importError))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@importError</span></div>
        }

        @if (docs is null)
        {
            <Skeleton Count="6" />
        }
        else if (docs.Count == 0)
        {
            <EmptyState Icon="doc" Title="Nenhum documento ainda"
                        Description="Registre decisões, processos e guias do time. Crie um documento, uma planilha, ou importe arquivos que vocês já usam.">
                <a class="btn" href="@($"/workspaces/{WorkspaceId}/docs/novo")"><Icon Name="plus" /> Criar o primeiro documento</a>
            </EmptyState>
        }
        else if (!FilteredDocs.Any())
        {
            <div class="card">
                <EmptyState Compact="true" Title="Nada deste tipo por aqui ainda">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => typeFilter = null">Ver todos</button>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table docs-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Atualizado</th>
                            <th>Por</th>
                            <th><span class="sr-only">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in FilteredDocs)
                        {
                            <tr class="data-table-row" @onclick="() => OpenDoc(doc)">
                                <td class="cell-title">
                                    <span class="doc-cell">
                                        <span class="doc-type-icon doc-type-icon--@doc.Type.ToString().ToLowerInvariant()" aria-hidden="true">
                                            <Icon Name="@(doc.Type == DocPageType.Spreadsheet ? "sheet" : doc.Type == DocPageType.File ? "paperclip" : "doc")" />
                                        </span>
                                        <button type="button" class="row-link" @onclick="() => OpenDoc(doc)" @onclick:stopPropagation="true">@doc.Title</button>
                                        <span class="sr-only">(@TypeLabel(doc.Type))</span>
                                    </span>
                                </td>
                                <td class="cell-muted tabular">@((doc.UpdatedAtUtc ?? doc.CreatedAtUtc).ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                                <td><span class="cell-person"><Avatar Name="@AuthorLabel(doc)" Size="xs" /> @AuthorLabel(doc)</span></td>
                                <td class="cell-actions">
                                    @if (doc.Type == DocPageType.File && (isAdmin || doc.CreatedByUserId == currentUserId))
                                    {
                                        <button type="button" class="icon-btn icon-btn--sm is-danger" @onclick="() => HandleDeleteFile(doc)" @onclick:stopPropagation="true">
                                            <Icon Name="trash" Label="@($"Excluir {doc.Title}")" />
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private Workspace? workspace;
    private List<DocPage>? docs;
    private bool notFound;
    private Guid? loadedWorkspaceId;
    private string? currentUserId;
    private bool isAdmin;
    private bool isImporting;
    private string? importError;
    private DocPageType? typeFilter;
    private ConfirmDialog? confirm;

    private IEnumerable<DocPage> FilteredDocs => docs is null
        ? []
        : typeFilter is null ? docs : docs.Where(d => d.Type == typeFilter);

    private static string TypeLabel(DocPageType type) => type switch
    {
        DocPageType.Spreadsheet => "planilha",
        DocPageType.File => "arquivo",
        _ => "documento"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId) return;
        loadedWorkspaceId = WorkspaceId;

        notFound = false;
        workspace = null;
        docs = null;
        importError = null;

        var authState = await AuthStateTask!;
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        isAdmin = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        await LoadDocsAsync();
    }

    private async Task LoadDocsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        docs = await db.DocPages
            .Where(d => d.WorkspaceId == WorkspaceId)
            .Include(d => d.CreatedByUser)
            .Include(d => d.UpdatedByUser)
            .OrderBy(d => d.Title)
            .ToListAsync();
    }

    private static string AuthorLabel(DocPage doc)
    {
        var user = doc.UpdatedByUser ?? doc.CreatedByUser;
        if (user is null)
        {
            return "—";
        }

        return string.IsNullOrEmpty(user.DisplayName) ? user.Email ?? "—" : user.DisplayName;
    }

    private void OpenDoc(DocPage doc)
    {
        if (doc.Type == DocPageType.File)
        {
            // No editor for imported files — a click just downloads it.
            NavigationManager.NavigateTo($"/doc-files/{doc.Id}/download", forceLoad: true);
            return;
        }

        var segment = doc.Type == DocPageType.Spreadsheet ? "spreadsheets" : "docs";
        NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/{segment}/{doc.Id}");
    }

    private async Task HandleImportFilesSelected(InputFileChangeEventArgs e)
    {
        importError = null;

        // Re-checked here, not just when the page first loaded — this circuit can stay open
        // for a while, and someone removed from the workspace shouldn't still be able to add docs.
        if (!await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Member))
        {
            importError = "Você não tem mais acesso a este workspace.";
            return;
        }

        isImporting = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > AttachmentStorageService.MaxSizeBytes)
                {
                    importError = $"\"{file.Name}\" excede o limite de 10 MB e não foi importado.";
                    continue;
                }

                if (!AttachmentStorageService.IsAllowedContentType(file.ContentType))
                {
                    importError = $"\"{file.Name}\" tem um tipo de arquivo não permitido.";
                    continue;
                }

                var docId = Guid.NewGuid();
                string storagePath;
                try
                {
                    await using var stream = file.OpenReadStream(AttachmentStorageService.MaxSizeBytes);
                    storagePath = await Storage.SaveAsync(docId, docId, file.Name, stream, file.ContentType);
                }
                catch (InvalidDataException)
                {
                    // File's actual bytes contradict the content type the browser reported.
                    importError = $"\"{file.Name}\" não corresponde ao tipo de arquivo informado e não foi importado.";
                    continue;
                }

                db.DocPages.Add(new DocPage
                {
                    Id = docId,
                    WorkspaceId = WorkspaceId,
                    Title = file.Name,
                    Type = DocPageType.File,
                    FileName = file.Name,
                    FileContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    FileSizeBytes = file.Size,
                    FileStoragePath = storagePath,
                    CreatedByUserId = currentUserId,
                    CreatedAtUtc = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();
        }
        finally
        {
            isImporting = false;
        }

        await LoadDocsAsync();
    }

    private async Task HandleDeleteFile(DocPage doc)
    {
        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("arquivo", doc.Title, "Ele deixa de estar disponível para todo o workspace.")))
        {
            return;
        }

        if (doc.Type != DocPageType.File || !(isAdmin || doc.CreatedByUserId == currentUserId))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.DocPages.Where(d => d.Id == doc.Id).ExecuteDeleteAsync();

        if (doc.FileStoragePath is not null)
        {
            Storage.Delete(doc.FileStoragePath);
        }

        await LoadDocsAsync();
    }
}
