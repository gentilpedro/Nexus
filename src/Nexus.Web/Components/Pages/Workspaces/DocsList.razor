@page "/workspaces/{WorkspaceId:guid}/docs"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject AttachmentStorageService Storage
@inject NavigationContextService NavContext

<PageTitle>Docs</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Workspace não encontrado ou você não tem acesso a ele.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (workspace is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a> /
            Docs
        </div>

        <div class="page-header">
            <h1>Docs</h1>
            <div class="form-actions">
                <a class="btn btn-secondary" href="@($"/workspaces/{WorkspaceId}/docs/novo")">+ Novo documento</a>
                <a class="btn btn-secondary" href="@($"/workspaces/{WorkspaceId}/spreadsheets/nova")">+ Nova planilha</a>
                <label for="docs-import-input" class="btn btn-secondary">
                    @(isImporting ? "Importando..." : "+ Importar arquivo")
                </label>
                <InputFile id="docs-import-input" OnChange="HandleImportFilesSelected" multiple
                           class="chat-file-input-hidden" disabled="@isImporting" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(importError))
        {
            <div class="alert alert-danger">@importError</div>
        }

        @if (docs is { Count: > 0 })
        {
            <div class="stat-grid">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Documentos</span>
                        <span class="stat-card-value">@docs.Count(d => d.Type == DocPageType.Text)</span>
                    </div>
                    <span class="stat-card-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><polyline points="14 2 14 8 20 8" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Planilhas</span>
                        <span class="stat-card-value">@docs.Count(d => d.Type == DocPageType.Spreadsheet)</span>
                    </div>
                    <span class="stat-card-icon is-success">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="9" x2="9" y2="21" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Arquivos</span>
                        <span class="stat-card-value">@docs.Count(d => d.Type == DocPageType.File)</span>
                    </div>
                    <span class="stat-card-icon is-warning">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
                    </span>
                </div>
            </div>
        }

        @if (docs is null)
        {
            <p>Carregando páginas...</p>
        }
        else if (docs.Count == 0)
        {
            <div class="empty-state">
                <p>Nenhuma página ainda. Crie a primeira.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Título</th>
                            <th>Atualizado em</th>
                            <th>Por quem</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in docs)
                        {
                            <tr class="data-table-row" @onclick="() => OpenDoc(doc)">
                                <td>@(doc.Type == DocPageType.Spreadsheet ? "📊" : doc.Type == DocPageType.File ? "📎" : "📄")</td>
                                <td>@doc.Title</td>
                                <td>@((doc.UpdatedAtUtc ?? doc.CreatedAtUtc).ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>@AuthorLabel(doc)</td>
                                <td>
                                    @if (doc.Type == DocPageType.File && (isAdmin || doc.CreatedByUserId == currentUserId))
                                    {
                                        <button type="button" class="btn-link" @onclick="() => HandleDeleteFile(doc)" @onclick:stopPropagation="true">Excluir</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private Workspace? workspace;
    private List<DocPage>? docs;
    private bool notFound;
    private Guid? loadedWorkspaceId;
    private string? currentUserId;
    private bool isAdmin;
    private bool isImporting;
    private string? importError;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId) return;
        loadedWorkspaceId = WorkspaceId;

        notFound = false;
        workspace = null;
        docs = null;
        importError = null;

        var authState = await AuthStateTask!;
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        isAdmin = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        await LoadDocsAsync();
    }

    private async Task LoadDocsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        docs = await db.DocPages
            .Where(d => d.WorkspaceId == WorkspaceId)
            .Include(d => d.CreatedByUser)
            .Include(d => d.UpdatedByUser)
            .OrderBy(d => d.Title)
            .ToListAsync();
    }

    private static string AuthorLabel(DocPage doc)
    {
        var user = doc.UpdatedByUser ?? doc.CreatedByUser;
        if (user is null)
        {
            return "—";
        }

        return string.IsNullOrEmpty(user.DisplayName) ? user.Email ?? "—" : user.DisplayName;
    }

    private void OpenDoc(DocPage doc)
    {
        if (doc.Type == DocPageType.File)
        {
            // No editor for imported files — a click just downloads it.
            NavigationManager.NavigateTo($"/doc-files/{doc.Id}/download", forceLoad: true);
            return;
        }

        var segment = doc.Type == DocPageType.Spreadsheet ? "spreadsheets" : "docs";
        NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/{segment}/{doc.Id}");
    }

    private async Task HandleImportFilesSelected(InputFileChangeEventArgs e)
    {
        importError = null;

        // Re-checked here, not just when the page first loaded — this circuit can stay open
        // for a while, and someone removed from the workspace shouldn't still be able to add docs.
        if (!await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Member))
        {
            importError = "Você não tem mais acesso a este workspace.";
            return;
        }

        isImporting = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > AttachmentStorageService.MaxSizeBytes)
                {
                    importError = $"\"{file.Name}\" excede o limite de 10 MB e não foi importado.";
                    continue;
                }

                if (!AttachmentStorageService.IsAllowedContentType(file.ContentType))
                {
                    importError = $"\"{file.Name}\" tem um tipo de arquivo não permitido.";
                    continue;
                }

                var docId = Guid.NewGuid();
                string storagePath;
                try
                {
                    await using var stream = file.OpenReadStream(AttachmentStorageService.MaxSizeBytes);
                    storagePath = await Storage.SaveAsync(docId, docId, file.Name, stream, file.ContentType);
                }
                catch (InvalidDataException)
                {
                    // File's actual bytes contradict the content type the browser reported.
                    importError = $"\"{file.Name}\" não corresponde ao tipo de arquivo informado e não foi importado.";
                    continue;
                }

                db.DocPages.Add(new DocPage
                {
                    Id = docId,
                    WorkspaceId = WorkspaceId,
                    Title = file.Name,
                    Type = DocPageType.File,
                    FileName = file.Name,
                    FileContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    FileSizeBytes = file.Size,
                    FileStoragePath = storagePath,
                    CreatedByUserId = currentUserId,
                    CreatedAtUtc = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();
        }
        finally
        {
            isImporting = false;
        }

        await LoadDocsAsync();
    }

    private async Task HandleDeleteFile(DocPage doc)
    {
        if (doc.Type != DocPageType.File || !(isAdmin || doc.CreatedByUserId == currentUserId))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.DocPages.Where(d => d.Id == doc.Id).ExecuteDeleteAsync();

        if (doc.FileStoragePath is not null)
        {
            Storage.Delete(doc.FileStoragePath);
        }

        await LoadDocsAsync();
    }
}
