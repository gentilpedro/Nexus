@page "/workspaces"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationContextService NavContext
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject ToastService Toasts

<PageTitle>Workspaces · Nexus</PageTitle>

<div class="page-container page-container--wide">
    <PageHeader Title="Meus workspaces" Description="Cada workspace reúne um time, seus spaces, listas, documentos e chat.">
        <Actions>
            <a class="btn" href="/workspaces/new"><Icon Name="plus" /> Novo workspace</a>
        </Actions>
    </PageHeader>

    @if (memberships is null)
    {
        <Skeleton Variant="card" Count="6" Label="Carregando workspaces…" />
    }
    else if (memberships.Count == 0)
    {
        <EmptyState Icon="workspace" Title="Você ainda não participa de nenhum workspace"
                    Description="Crie um workspace para o seu time, ou peça a alguém um convite para entrar no workspace dele.">
            <a class="btn" href="/workspaces/new"><Icon Name="plus" /> Criar meu primeiro workspace</a>
        </EmptyState>
    }
    else
    {
        <div class="list-toolbar">
            <div class="pill-tabs" role="group" aria-label="Filtrar por situação">
                <button type="button" aria-pressed="@(statusTab == "active" ? "true" : "false")" class="@(statusTab == "active" ? "active" : "")" @onclick='() => statusTab = "active"'>Ativos <span class="tab-count">@memberships.Count(m => !m.Workspace.IsArchived)</span></button>
                <button type="button" aria-pressed="@(statusTab == "archived" ? "true" : "false")" class="@(statusTab == "archived" ? "active" : "")" @onclick='() => statusTab = "archived"'>Arquivados <span class="tab-count">@memberships.Count(m => m.Workspace.IsArchived)</span></button>
                <button type="button" aria-pressed="@(statusTab == "all" ? "true" : "false")" class="@(statusTab == "all" ? "active" : "")" @onclick='() => statusTab = "all"'>Todos <span class="tab-count">@memberships.Count</span></button>
            </div>
            <div class="input-with-icon list-toolbar-search">
                <Icon Name="search" />
                <label for="ws-filter" class="sr-only">Buscar workspaces</label>
                <input id="ws-filter" type="search" placeholder="Buscar workspaces" @bind="filterText" @bind:event="oninput" />
            </div>
        </div>

        @if (!FilteredMemberships.Any())
        {
            <div class="card">
                <EmptyState Compact="true" Title="Nenhum workspace encontrado"
                            Description="@(string.IsNullOrWhiteSpace(filterText) ? "Não há workspaces nesta aba." : $"Nada corresponde a \"{filterText}\".")" />
            </div>
        }
        else
        {
            <ul class="workspace-grid">
                @foreach (var membership in FilteredMemberships)
                {
                    var ws = membership.Workspace;
                    var canManage = membership.Role is WorkspaceRole.Owner or WorkspaceRole.Admin;
                    <li class="workspace-card @(ws.IsArchived ? "is-archived" : "")" @key="membership.WorkspaceId">
                        <div class="workspace-card-top">
                            <Avatar Name="@ws.Name" Color="@ws.Color" Size="lg" Square="true" />
                            @if (canManage)
                            {
                                <div class="menu-anchor workspace-card-menu" @onkeydown="HandleMenuKey">
                                    <button type="button" class="icon-btn icon-btn--sm" @onclick="() => ToggleMenu(membership.WorkspaceId)"
                                            aria-haspopup="menu" aria-expanded="@(openMenuId == membership.WorkspaceId ? "true" : "false")">
                                        <Icon Name="more" Label="@($"Opções de {ws.Name}")" />
                                    </button>
                                    @if (openMenuId == membership.WorkspaceId)
                                    {
                                        <div class="menu-backdrop" @onclick="() => openMenuId = null"></div>
                                        <div class="menu" role="menu">
                                            <a role="menuitem" href="@($"/workspaces/{membership.WorkspaceId}/settings")"><Icon Name="settings" /> Configurações</a>
                                            <a role="menuitem" href="@($"/workspaces/{membership.WorkspaceId}/members")"><Icon Name="team" /> Membros</a>
                                            <div class="menu-separator" role="separator"></div>
                                            <button type="button" role="menuitem" @onclick="() => HandleToggleArchive(ws)">
                                                <Icon Name="@(ws.IsArchived ? "refresh" : "inbox")" />
                                                @(ws.IsArchived ? "Desarquivar" : "Arquivar")
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <a class="workspace-card-link" href="@($"/workspaces/{membership.WorkspaceId}")">
                            <span class="workspace-card-name">@ws.Name</span>
                        </a>
                        <div class="workspace-card-meta">
                            <span class="badge @(membership.Role == WorkspaceRole.Owner ? "badge--accent" : "")">@membership.Role.ToDisplayLabel()</span>
                            @if (ws.IsArchived)
                            {
                                <span class="badge badge--outline">Arquivado</span>
                            }
                        </div>
                        <p class="workspace-card-stats">
                            <span><Icon Name="team" Class="icon--sm" /> @ws.Members.Count membro@(ws.Members.Count == 1 ? "" : "s")</span>
                            <span><Icon Name="space" Class="icon--sm" /> @ws.Spaces.Count space@(ws.Spaces.Count == 1 ? "" : "s")</span>
                        </p>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<WorkspaceMember>? memberships;
    private string filterText = "";
    private string statusTab = "active";
    private Guid? openMenuId;

    private IEnumerable<WorkspaceMember> FilteredMemberships => memberships is null
        ? []
        : memberships.Where(m =>
            (string.IsNullOrWhiteSpace(filterText) || m.Workspace.Name.Contains(filterText, StringComparison.OrdinalIgnoreCase))
            && (statusTab == "all" || (statusTab == "active") != m.Workspace.IsArchived));

    protected override async Task OnInitializedAsync()
    {
        NavContext.Clear();

        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

        await LoadAsync(userId);
    }

    private async Task LoadAsync(string userId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        memberships = await db.WorkspaceMembers
            .Include(m => m.Workspace).ThenInclude(w => w.Members)
            .Include(m => m.Workspace).ThenInclude(w => w.Spaces)
            .Where(m => m.UserId == userId)
            .OrderBy(m => m.Workspace.Name)
            .ToListAsync();
    }

    private void ToggleMenu(Guid workspaceId)
    {
        openMenuId = openMenuId == workspaceId ? null : workspaceId;
    }

    private void HandleMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            openMenuId = null;
        }
    }

    private async Task HandleToggleArchive(Workspace workspace)
    {
        openMenuId = null;
        var newValue = !workspace.IsArchived;

        // O menu só aparece para Owner/Admin, mas isso é só a interface: confere o papel atual
        // no servidor antes de gravar, como as demais escritas do app (ver WorkspaceAccessGuard).
        if (!await AccessGuard.HasAccessAsync(AuthStateTask, workspace.Id, WorkspaceRole.Admin))
        {
            Toasts.Show("Você não tem mais permissão para arquivar este workspace.", ToastKind.Error);
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Workspaces.Where(w => w.Id == workspace.Id)
                .ExecuteUpdateAsync(s => s.SetProperty(w => w.IsArchived, newValue));
        }

        workspace.IsArchived = newValue;
        Toasts.Show(newValue ? $"\"{workspace.Name}\" arquivado" : $"\"{workspace.Name}\" desarquivado");
    }
}
