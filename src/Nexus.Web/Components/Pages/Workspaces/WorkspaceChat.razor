@page "/workspaces/{WorkspaceId:guid}/chat"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext
@inject WorkspaceChatBroadcaster Broadcaster
@inject AttachmentStorageService Storage
@inject IJSRuntime JS

@if (!Embedded)
{
    <PageTitle>Chat</PageTitle>
}

<div class="@(Embedded ? "chat-embedded" : "page-container")">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Workspace não encontrado ou você não tem acesso a ele.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (workspace is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        @if (!Embedded)
        {
            <div class="breadcrumbs">
                <a href="/workspaces">Workspaces</a> /
                <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a> /
                Chat
            </div>

            <div class="page-header">
                <div>
                    <h1 style="margin-bottom:0.15rem;">#@workspace.Name</h1>
                    <span class="topnav-user">@memberCount membro@(memberCount == 1 ? "" : "s")</span>
                </div>
            </div>
        }
        else
        {
            <div class="chat-embedded-header">
                <a href="/chats" class="chat-embedded-back topnav-icon-btn" title="Voltar para conversas">←</a>
                <div>
                    <strong>#@workspace.Name</strong>
                    <span class="topnav-user">@memberCount membro@(memberCount == 1 ? "" : "s")</span>
                </div>
            </div>
        }

        <div class="chat-messages @(Embedded ? "chat-messages--embedded" : "")" @ref="messagesEl">
            @if (messages is null)
            {
                <p>Carregando mensagens...</p>
            }
            else if (messages.Count == 0)
            {
                <div class="empty-state">
                    <p>Nenhuma mensagem ainda. Comece a conversa!</p>
                </div>
            }
            else
            {
                @if (hasMoreOlderMessages)
                {
                    <div class="chat-load-older-row">
                        <button type="button" class="btn-link" @onclick="LoadOlderMessagesAsync" disabled="@isLoadingOlder">
                            @(isLoadingOlder ? "Carregando..." : "Carregar mensagens anteriores")
                        </button>
                    </div>
                }
                @for (var i = 0; i < messages.Count; i++)
                {
                    var message = messages[i];
                    var previous = i > 0 ? messages[i - 1] : null;
                    var isGrouped = previous is not null
                        && previous.UserId == message.UserId
                        && (message.CreatedAtUtc - previous.CreatedAtUtc) < TimeSpan.FromMinutes(5);

                    <div class="chat-message @(isGrouped ? "chat-message-grouped" : "")">
                        @if (isGrouped)
                        {
                            <span class="chat-message-avatar-spacer"></span>
                        }
                        else
                        {
                            <span class="chat-message-avatar">@Initial(message)</span>
                        }
                        <div class="chat-message-body">
                            @if (!isGrouped)
                            {
                                <div class="chat-message-meta">
                                    <span class="chat-message-author">@AuthorLabel(message)</span>
                                    <span class="chat-message-time">@message.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(message.Content))
                            {
                                <div class="chat-message-content">
                                    @foreach (var (text, isMention) in SplitContentForMentions(message))
                                    {
                                        @if (isMention)
                                        {
                                            <span class="chat-mention">@text</span>
                                        }
                                        else
                                        {
                                            @text
                                        }
                                    }
                                </div>
                            }
                            @if (message.ReferencedDocPage is not null)
                            {
                                <a class="chat-docref-card" href="@($"/workspaces/{WorkspaceId}/docs/{message.ReferencedDocPage.Id}")">
                                    <span class="chat-docref-icon">📄</span>
                                    <span class="chat-docref-title">@message.ReferencedDocPage.Title</span>
                                </a>
                            }
                            @if (message.Attachments.Count > 0)
                            {
                                <div class="chat-attachment-list">
                                    @foreach (var attachment in message.Attachments)
                                    {
                                        <a class="chat-attachment-item" href="@($"/chat-attachments/{attachment.Id}/download")" target="_blank">
                                            <span class="chat-attachment-icon">📎</span>
                                            <span class="chat-attachment-info">
                                                <span class="chat-attachment-name">@attachment.FileName</span>
                                                <span class="chat-attachment-size">@FormatSize(attachment.SizeBytes)</span>
                                            </span>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <EditForm Model="sendModel" OnValidSubmit="HandleSend" class="chat-compose">
            <div class="chat-compose-toolbar">
                <label for="chat-file-input" class="chat-toolbar-btn" title="Anexar arquivo">📎</label>
                <InputFile id="chat-file-input" OnChange="HandleFilesSelected" multiple class="chat-file-input-hidden" />
                <select @bind="selectedDocId" class="chat-docref-select">
                    <option value="">Referenciar doc...</option>
                    @foreach (var doc in docPages)
                    {
                        <option value="@doc.Id">@doc.Title</option>
                    }
                </select>
            </div>
            <div class="chat-compose-textarea-wrap">
                <textarea @ref="composeTextareaEl" value="@sendModel.Content" rows="2" placeholder="Escreva uma mensagem... use @@ para mencionar alguém"></textarea>
                @if (showMentionDropdown)
                {
                    <div class="chat-mention-dropdown">
                        @if (showEveryoneOption)
                        {
                            <button type="button" class="chat-mention-option chat-mention-option--everyone" @onclick="SelectEveryoneMention">
                                <span class="chat-mention-avatar chat-mention-avatar--everyone">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                </span>
                                <span class="chat-mention-name">Todos (@@everyone)</span>
                            </button>
                        }
                        @foreach (var member in mentionSuggestions)
                        {
                            <button type="button" class="chat-mention-option" @onclick="() => SelectMention(member.UserId, member.DisplayName)">
                                @if (!string.IsNullOrEmpty(member.AvatarPath))
                                {
                                    <img class="chat-mention-avatar" src="@MentionAvatarUrl(member.UserId, member.AvatarPath)" alt="" />
                                }
                                else
                                {
                                    <span class="chat-mention-avatar">@MentionInitial(member.DisplayName)</span>
                                }
                                <span class="chat-mention-name">@member.DisplayName</span>
                            </button>
                        }
                    </div>
                }
            </div>
            @if (pendingFiles.Count > 0)
            {
                <div class="chat-compose-pending">
                    @for (var i = 0; i < pendingFiles.Count; i++)
                    {
                        var index = i;
                        var file = pendingFiles[i];
                        <span class="chat-compose-pending-file">
                            @file.Name (@FormatSize(file.Size))
                            <button type="button" class="chat-compose-pending-remove" @onclick="() => RemovePendingFile(index)">✕</button>
                        </span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(sendError))
            {
                <div class="alert alert-danger">@sendError</div>
            }
            <div class="chat-compose-actions">
                <button type="submit" class="btn" disabled="@isSending">Enviar</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public bool Embedded { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const int MessagePageSize = 100;

    private Workspace? workspace;
    private int memberCount;
    private List<ChatMessage>? messages;
    private bool hasMoreOlderMessages;
    private bool isLoadingOlder;
    private List<DocPage> docPages = [];
    private List<IBrowserFile> pendingFiles = [];
    private string selectedDocId = "";
    private string? sendError;
    private bool notFound;
    private bool isSending;
    private string? currentUserId;
    private Guid? loadedWorkspaceId;
    private ElementReference messagesEl;
    private IJSObjectReference? module;
    private readonly SendMessageModel sendModel = new();

    private ElementReference composeTextareaEl;
    private DotNetObjectReference<WorkspaceChat>? selfRef;
    private List<(string UserId, string DisplayName, string? AvatarPath)> workspaceMembers = [];
    private List<(string UserId, string DisplayName, string? AvatarPath)> mentionSuggestions = [];
    private bool showMentionDropdown;
    private bool showEveryoneOption;
    private bool mentionedEveryone;
    private int mentionStartIndex;
    private readonly HashSet<string> mentionedUserIds = [];

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId)
        {
            return;
        }

        loadedWorkspaceId = WorkspaceId;
        notFound = false;
        workspace = null;
        messages = null;

        var authState = await AuthStateTask!;
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
            memberCount = await db.WorkspaceMembers.CountAsync(m => m.WorkspaceId == WorkspaceId);
            workspaceMembers = await db.WorkspaceMembers
                .Where(m => m.WorkspaceId == WorkspaceId)
                .Select(m => new ValueTuple<string, string, string?>(m.UserId, m.User.DisplayName != "" ? m.User.DisplayName : (m.User.Email ?? ""), m.User.AvatarStoragePath))
                .ToListAsync();

            // Sorted here rather than in SQL: Postgres orders by the database collation, which
            // puts accented names (Mônica, Ântonio) after plain-ASCII ones instead of alongside
            // them. Also makes the Take(6) cut of the suggestion list predictable.
            workspaceMembers = workspaceMembers
                .OrderBy(m => m.DisplayName, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        await LoadMessagesAsync();
        await LoadDocPagesAsync();

        // Unsubscribe first: if this same component instance switches to a different
        // workspace's chat (OnParametersSetAsync reruns without a full page reload — same
        // navigation-reuse behavior fixed elsewhere in this app), re-subscribing without
        // this would register OnMessagePosted twice and duplicate every future message.
        Broadcaster.MessagePosted -= OnMessagePosted;
        Broadcaster.MessagePosted += OnMessagePosted;
    }

    private async Task LoadMessagesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var recent = await db.ChatMessages
            .Where(m => m.WorkspaceId == WorkspaceId)
            .Include(m => m.User)
            .Include(m => m.ReferencedDocPage)
            .Include(m => m.Attachments)
            .Include(m => m.Mentions).ThenInclude(x => x.User)
            .OrderByDescending(m => m.CreatedAtUtc)
            .Take(MessagePageSize)
            .ToListAsync();
        hasMoreOlderMessages = recent.Count == MessagePageSize;
        recent.Reverse();
        messages = recent;
    }

    private async Task LoadOlderMessagesAsync()
    {
        if (isLoadingOlder || !hasMoreOlderMessages || messages is null || messages.Count == 0 || module is null)
        {
            return;
        }

        isLoadingOlder = true;
        var metrics = await module.InvokeAsync<ScrollMetrics?>("getScrollMetrics", messagesEl);

        var oldestLoaded = messages[0].CreatedAtUtc;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var older = await db.ChatMessages
                .Where(m => m.WorkspaceId == WorkspaceId && m.CreatedAtUtc < oldestLoaded)
                .Include(m => m.User)
                .Include(m => m.ReferencedDocPage)
                .Include(m => m.Attachments)
                .Include(m => m.Mentions).ThenInclude(x => x.User)
                .OrderByDescending(m => m.CreatedAtUtc)
                .Take(MessagePageSize)
                .ToListAsync();

            hasMoreOlderMessages = older.Count == MessagePageSize;
            older.Reverse();
            messages.InsertRange(0, older);
        }

        isLoadingOlder = false;
        StateHasChanged();

        if (metrics is not null)
        {
            await module.InvokeVoidAsync("restoreScrollAfterPrepend", messagesEl, metrics.ScrollHeight, metrics.ScrollTop);
        }
    }

    private async Task LoadDocPagesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        docPages = await db.DocPages
            .Where(d => d.WorkspaceId == WorkspaceId)
            .OrderBy(d => d.Title)
            .ToListAsync();
    }

    private void HandleFilesSelected(InputFileChangeEventArgs e)
    {
        sendError = null;
        var accepted = new List<IBrowserFile>();

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > AttachmentStorageService.MaxSizeBytes)
            {
                sendError = $"\"{file.Name}\" excede o limite de 10 MB e não foi selecionado.";
                continue;
            }

            if (!AttachmentStorageService.IsAllowedContentType(file.ContentType))
            {
                sendError = $"\"{file.Name}\" tem um tipo de arquivo não permitido.";
                continue;
            }

            accepted.Add(file);
        }

        // Append, don't replace — re-opening the file picker to add more attachments used to
        // silently discard whatever was already staged from a previous selection.
        pendingFiles.AddRange(accepted);
    }

    private void RemovePendingFile(int index)
    {
        if (index >= 0 && index < pendingFiles.Count)
        {
            pendingFiles.RemoveAt(index);
        }
    }

    private void OnMessagePosted(ChatMessage message)
    {
        if (message.WorkspaceId != WorkspaceId)
        {
            return;
        }

        // WorkspaceChatBroadcaster.Broadcast invokes subscribers synchronously on the sender's
        // own thread — everything that touches this circuit's state (including the list
        // mutation, not just the render) must be marshaled via InvokeAsync, or it races with
        // this circuit's own renderer.
        _ = InvokeAsync(async () =>
        {
            try
            {
                messages ??= [];
                messages.Add(message);
                StateHasChanged();
                await ScrollToBottomAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to update.
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/chat-interop.js");
            selfRef = DotNetObjectReference.Create(this);
            await ScrollToBottomAsync();
        }

        // The compose box only exists once the workspace has loaded, which happens after the
        // first render — binding on firstRender alone handed JS an unset ElementReference, which
        // threw and left "@" mentions dead for the rest of the page's life. initComposeMentions
        // is idempotent, so retrying on later renders costs nothing once it has taken.
        if (module is not null && selfRef is not null && workspace is not null && !notFound)
        {
            await module.InvokeVoidAsync("initComposeMentions", composeTextareaEl, selfRef);
        }
    }

    [JSInvokable]
    public void OnComposeInput(string value, int caret)
    {
        sendModel.Content = value;
        UpdateMentionState(caret);
        StateHasChanged();
    }

    private void UpdateMentionState(int caret)
    {
        var text = sendModel.Content;
        caret = Math.Clamp(caret, 0, text.Length);

        var atIndex = text.LastIndexOf('@', Math.Max(0, caret - 1));
        if (atIndex == -1 || (atIndex > 0 && !char.IsWhiteSpace(text[atIndex - 1])))
        {
            showMentionDropdown = false;
            showEveryoneOption = false;
            return;
        }

        var query = text[(atIndex + 1)..caret];
        if (query.Contains(' ') || query.Contains('\n'))
        {
            showMentionDropdown = false;
            showEveryoneOption = false;
            return;
        }

        mentionStartIndex = atIndex;
        showEveryoneOption = "everyone".Contains(query, StringComparison.OrdinalIgnoreCase);
        mentionSuggestions = workspaceMembers
            .Where(m => m.UserId != currentUserId && m.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(6)
            .ToList();
        showMentionDropdown = showEveryoneOption || mentionSuggestions.Count > 0;
    }

    private Task SelectMention(string userId, string displayName)
    {
        mentionedUserIds.Add(userId);
        return InsertMentionTokenAsync($"@{displayName} ");
    }

    private Task SelectEveryoneMention()
    {
        mentionedEveryone = true;
        return InsertMentionTokenAsync("@everyone ");
    }

    private async Task InsertMentionTokenAsync(string inserted)
    {
        if (module is null)
        {
            return;
        }

        // The caret sits right after whatever was typed following "@" — no need for a fresh JS
        // round trip, the dropdown only shows options for the query currently in sendModel.Content.
        var before = sendModel.Content[..mentionStartIndex];
        var caret = mentionStartIndex + QueryLengthAt(mentionStartIndex);
        var after = sendModel.Content[caret..];
        var newValue = before + inserted + after;
        var newCaret = before.Length + inserted.Length;

        sendModel.Content = newValue;
        showMentionDropdown = false;
        StateHasChanged();

        await module.InvokeVoidAsync("insertMentionText", composeTextareaEl, newValue, newCaret);
    }

    private int QueryLengthAt(int atIndex)
    {
        var text = sendModel.Content;
        var i = atIndex + 1;
        while (i < text.Length && !char.IsWhiteSpace(text[i]))
        {
            i++;
        }
        return i - atIndex;
    }

    private async Task ScrollToBottomAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("scrollToBottom", messagesEl);
        }
    }

    private async Task HandleSend()
    {
        var hasDocRef = Guid.TryParse(selectedDocId, out var referencedDocPageId);

        if (string.IsNullOrWhiteSpace(sendModel.Content) && pendingFiles.Count == 0 && !hasDocRef)
        {
            sendError = "Escreva algo, anexe um arquivo ou referencie um doc.";
            return;
        }

        isSending = true;
        sendError = null;
        var savedStoragePaths = new List<string>();

        try
        {
            ChatMessage message;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                // selectedDocId only ever gets set from docPages (already filtered by
                // WorkspaceId), but that's client-reported component state over the SignalR
                // circuit — re-check server-side so a tampered client can't reference (and
                // leak the title of) a doc from a workspace it isn't even a member of.
                if (hasDocRef)
                {
                    hasDocRef = await db.DocPages.AnyAsync(d => d.Id == referencedDocPageId && d.WorkspaceId == WorkspaceId);
                }

                message = new ChatMessage
                {
                    Id = Guid.NewGuid(),
                    WorkspaceId = WorkspaceId,
                    UserId = currentUserId,
                    Content = sendModel.Content?.Trim() ?? "",
                    ReferencedDocPageId = hasDocRef ? referencedDocPageId : null,
                    CreatedAtUtc = DateTime.UtcNow
                };
                db.ChatMessages.Add(message);

                // Every other workspace member — needed both to resolve "@everyone" and, later,
                // as the recipient list for the generic "new message" notification.
                var recipientIds = await db.WorkspaceMembers
                    .Where(m => m.WorkspaceId == WorkspaceId && m.UserId != currentUserId)
                    .Select(m => m.UserId)
                    .ToListAsync();

                // The dropdown always inserts a mention with a trailing space, but Content was
                // trimmed above — so a mention that ends the message ("@everyone" on its own,
                // "bom dia @Ana") loses that space and needs EndsWith too. Matching only
                // "@Name " silently dropped exactly those, the most natural way to mention
                // someone: no record, no highlight, no notification. The trailing space still
                // matters mid-text, to keep "@Ana" from matching a longer "@Anabela".
                bool StillMentioned(string token) =>
                    message.Content.Contains(token + " ", StringComparison.Ordinal)
                    || message.Content.EndsWith(token, StringComparison.Ordinal);

                // Covers picking "@everyone" from the dropdown and then deleting that text
                // before hitting Enviar.
                var mentionedEveryoneValid = mentionedEveryone && StillMentioned("@everyone");

                // Only keep mentions whose inserted text is still present — covers someone
                // picking a mention from the dropdown and then deleting that text before
                // hitting Enviar. "@everyone" makes every other member mentioned, regardless
                // of whether they were also picked individually.
                var validMentionedUserIds = mentionedEveryoneValid
                    ? recipientIds
                    : mentionedUserIds
                        .Where(id => workspaceMembers.Any(m => m.UserId == id && StillMentioned($"@{m.DisplayName}")))
                        .ToList();
                foreach (var mentionedUserId in validMentionedUserIds)
                {
                    db.ChatMessageMentions.Add(new ChatMessageMention
                    {
                        Id = Guid.NewGuid(),
                        ChatMessageId = message.Id,
                        UserId = mentionedUserId
                    });
                }

                await db.SaveChangesAsync();

                foreach (var file in pendingFiles)
                {
                    // Re-check here, not just at selection time in HandleFilesSelected — the
                    // browser-reported ContentType is client input, and pendingFiles can sit
                    // staged for a while before the user hits Enviar.
                    if (!AttachmentStorageService.IsAllowedContentType(file.ContentType))
                    {
                        sendError = $"\"{file.Name}\" tem um tipo de arquivo não permitido e não foi enviado.";
                        continue;
                    }

                    var attachmentId = Guid.NewGuid();
                    string storagePath;
                    await using (var stream = file.OpenReadStream(AttachmentStorageService.MaxSizeBytes))
                    {
                        storagePath = await Storage.SaveAsync(message.Id, attachmentId, file.Name, stream);
                    }
                    savedStoragePaths.Add(storagePath);

                    db.ChatMessageAttachments.Add(new ChatMessageAttachment
                    {
                        Id = attachmentId,
                        ChatMessageId = message.Id,
                        FileName = file.Name,
                        ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                        SizeBytes = file.Size,
                        StoragePath = storagePath
                    });
                }
                await db.SaveChangesAsync();

                // Reload with everything included so the broadcast carries a display-ready message.
                message = await db.ChatMessages
                    .Include(m => m.User)
                    .Include(m => m.ReferencedDocPage)
                    .Include(m => m.Attachments)
                    .Include(m => m.Mentions).ThenInclude(x => x.User)
                    .FirstAsync(m => m.Id == message.Id);

                // Notify every other workspace member — WorkspaceChatBroadcaster only reaches
                // circuits with this chat page currently open, so this is what tells someone who
                // isn't looking at the chat right now that a message is waiting. Mentioned
                // members get a more specific notification instead (below), not this one too.
                var senderName = string.IsNullOrEmpty(message.User!.DisplayName) ? (message.User.Email ?? "Alguém") : message.User.DisplayName;

                foreach (var recipientId in recipientIds.Except(validMentionedUserIds))
                {
                    db.Notifications.Add(new Notification
                    {
                        Id = Guid.NewGuid(),
                        UserId = recipientId,
                        Type = NotificationType.ChatMessage,
                        Message = Notification.TruncateMessage($"{senderName} enviou uma mensagem no chat de \"{workspace!.Name}\"."),
                        WorkspaceId = WorkspaceId,
                        IsRead = false,
                        CreatedAtUtc = DateTime.UtcNow
                    });
                }

                foreach (var mentionedUserId in validMentionedUserIds.Where(id => id != currentUserId))
                {
                    db.Notifications.Add(new Notification
                    {
                        Id = Guid.NewGuid(),
                        UserId = mentionedUserId,
                        Type = NotificationType.ChatMention,
                        Message = Notification.TruncateMessage($"{senderName} mencionou você no chat de \"{workspace!.Name}\"."),
                        WorkspaceId = WorkspaceId,
                        IsRead = false,
                        CreatedAtUtc = DateTime.UtcNow
                    });
                }

                await db.SaveChangesAsync();
            }

            sendModel.Content = "";
            selectedDocId = "";
            pendingFiles = [];
            mentionedUserIds.Clear();
            mentionedEveryone = false;
            Broadcaster.Broadcast(message);
        }
        catch (Exception)
        {
            sendError = "Não foi possível enviar a mensagem. Tente novamente.";

            // Best-effort cleanup of files already written to disk this attempt — a failed
            // delete here shouldn't hide the real error from the user.
            try
            {
                foreach (var path in savedStoragePaths)
                {
                    Storage.Delete(path);
                }
            }
            catch
            {
            }
        }
        finally
        {
            isSending = false;
        }
    }

    // Splits message.Content into plain-text / mention segments for rendering — never builds
    // raw HTML/MarkupString from user content (XSS risk), each segment still goes through
    // Blazor's normal @text interpolation, which escapes it automatically.
    private static List<(string Text, bool IsMention)> SplitContentForMentions(ChatMessage message)
    {
        var segments = new List<(string, bool)>();
        if (message.Mentions.Count == 0 && !message.Content.Contains("@everyone", StringComparison.Ordinal))
        {
            segments.Add((message.Content, false));
            return segments;
        }

        var mentionTokens = message.Mentions
            .Select(m => $"@{(string.IsNullOrEmpty(m.User.DisplayName) ? m.User.Email : m.User.DisplayName)}")
            .Where(t => t.Length > 1)
            .Distinct()
            .ToList();

        // "@everyone" doesn't map to any single ChatMessageMention.User, so it never shows up
        // in the list above — recognize it directly whenever it's literally in the text.
        if (message.Content.Contains("@everyone", StringComparison.Ordinal))
        {
            mentionTokens.Add("@everyone");
        }

        mentionTokens = mentionTokens.OrderByDescending(t => t.Length).ToList();

        var remaining = message.Content;
        while (remaining.Length > 0)
        {
            var earliestIndex = -1;
            string? matchedToken = null;
            foreach (var token in mentionTokens)
            {
                var idx = remaining.IndexOf(token, StringComparison.Ordinal);
                if (idx != -1 && (earliestIndex == -1 || idx < earliestIndex))
                {
                    earliestIndex = idx;
                    matchedToken = token;
                }
            }

            if (earliestIndex == -1)
            {
                segments.Add((remaining, false));
                break;
            }

            if (earliestIndex > 0)
            {
                segments.Add((remaining[..earliestIndex], false));
            }
            segments.Add((matchedToken!, true));
            remaining = remaining[(earliestIndex + matchedToken!.Length)..];
        }

        return segments;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    private static string AuthorLabel(ChatMessage message) =>
        message.User is null
            ? "Usuário removido"
            : (string.IsNullOrEmpty(message.User.DisplayName) ? message.User.Email ?? "" : message.User.DisplayName);

    private static string Initial(ChatMessage message)
    {
        var label = AuthorLabel(message);
        return string.IsNullOrWhiteSpace(label) || label == "Usuário removido" ? "?" : label.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string MentionInitial(string displayName) =>
        string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[0].ToString().ToUpperInvariant();

    private static string MentionAvatarUrl(string userId, string avatarPath) =>
        $"/avatars/{userId}/download?v={Uri.EscapeDataString(System.IO.Path.GetFileNameWithoutExtension(avatarPath))}";

    public void Dispose()
    {
        Broadcaster.MessagePosted -= OnMessagePosted;
        selfRef?.Dispose();
    }

    private class SendMessageModel
    {
        // Not [Required] — a message can be just a file and/or a doc reference, with no
        // text. HandleSend does the "must have at least one of text/file/doc" check itself.
        [StringLength(2000, ErrorMessage = "Mensagem muito longa.")]
        public string Content { get; set; } = "";
    }

    private class ScrollMetrics
    {
        public double ScrollHeight { get; set; }
        public double ScrollTop { get; set; }
    }
}
