@page "/workspaces/{WorkspaceId:guid}/chat"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject ChatConversationService Conversations

<PageTitle>Chat · @(workspace?.Name ?? "Workspace") · Nexus</PageTitle>

<div class="page-container page-container--wide chat-page">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Workspace não encontrado"
                    Description="Ele pode ter sido excluído, ou você não faz mais parte dele.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (workspace is null || conversationId is null)
    {
        <Skeleton Count="6" Label="Carregando conversa…" />
    }
    else
    {
        <PageHeader Title="@workspace.Name">
            <Breadcrumbs>
                <a href="/workspaces">Workspaces</a>
            </Breadcrumbs>
        </PageHeader>
        <WorkspaceTabs WorkspaceId="WorkspaceId" Active="chat" CanManage="isAdmin" />

        <ConversationChat ConversationId="conversationId.Value" />
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Workspace? workspace;
    private Guid? conversationId;
    private bool notFound;
    private bool isAdmin;
    private Guid? loadedWorkspaceId;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId)
        {
            return;
        }

        loadedWorkspaceId = WorkspaceId;
        notFound = false;
        workspace = null;
        conversationId = null;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        isAdmin = (await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin))).Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        conversationId = await Conversations.EnsureWorkspaceConversationAsync(WorkspaceId);
    }
}
