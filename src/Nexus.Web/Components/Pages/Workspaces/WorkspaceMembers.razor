@page "/workspaces/{WorkspaceId:guid}/members"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext
@inject IJSRuntime JS

<PageTitle>Membros</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Workspace não encontrado ou você não tem acesso a ele.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (workspace is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a> /
            Membros
        </div>

        <div class="page-header">
            <div>
                <h1 style="margin-bottom:0.15rem;">Membros do Workspace</h1>
                <span class="topnav-user">Gerencie quem tem acesso ao workspace @workspace.Name e defina os níveis de permissão.</span>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick="HandleExportCsv">Exportar CSV</button>
                @if (canManage)
                {
                    <button type="button" class="btn" @onclick="() => showAddForm = !showAddForm">+ Convidar Membro</button>
                }
            </div>
        </div>

        @if (members is not null)
        {
            <div class="stat-grid">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Total de membros</span>
                        <span class="stat-card-value">@members.Count</span>
                    </div>
                    <span class="stat-card-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Administradores</span>
                        <span class="stat-card-value">@members.Count(m => m.Role is WorkspaceRole.Admin or WorkspaceRole.Owner)</span>
                    </div>
                    <span class="stat-card-icon is-success">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /></svg>
                    </span>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (canManage && showAddForm)
        {
            <EditForm Model="addModel" OnValidSubmit="HandleAddMember" class="card" style="margin-bottom:1.5rem;">
                <DataAnnotationsValidator />
                <div class="form-row">
                    <div class="form-field">
                        <label for="member-email">E-mail</label>
                        <InputText id="member-email" @bind-Value="addModel.Email" placeholder="pessoa@exemplo.com" />
                        <ValidationMessage For="() => addModel.Email" />
                    </div>
                    <div class="form-field">
                        <label for="member-role">Cargo</label>
                        <InputSelect id="member-role" @bind-Value="addModel.Role">
                            <option value="@WorkspaceRole.Member">Membro</option>
                            <option value="@WorkspaceRole.Admin">Admin</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn" disabled="@isSaving">Adicionar</button>
                    <button type="button" class="btn btn-secondary" @onclick="() => showAddForm = false">Cancelar</button>
                </div>
            </EditForm>
        }

        @if (members is null)
        {
            <p>Carregando membros...</p>
        }
        else
        {
            <div class="form-field" style="max-width:280px;">
                <input type="search" placeholder="Buscar por nome ou e-mail..." @bind="memberFilter" @bind:event="oninput" />
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Membro</th>
                            <th>Cargo</th>
                            <th>Status</th>
                            <th>Desde</th>
                            @if (canManage)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in PagedMembers)
                        {
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:0.6rem;">
                                        <span class="chat-message-avatar">@Initial(member.User.DisplayName, member.User.Email)</span>
                                        <div>
                                            <div style="font-weight:600;">@(string.IsNullOrEmpty(member.User.DisplayName) ? "—" : member.User.DisplayName)</div>
                                            <div class="topnav-user">@(member.User.Email ?? "—")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (canManage && member.Role != WorkspaceRole.Owner)
                                    {
                                        <select @onchange="@(e => HandleRoleChange(member.Id, e.Value))">
                                            <option value="@WorkspaceRole.Member" selected="@(member.Role == WorkspaceRole.Member)">Membro</option>
                                            <option value="@WorkspaceRole.Admin" selected="@(member.Role == WorkspaceRole.Admin)">Admin</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="tab-count">@member.Role.ToDisplayLabel()</span>
                                    }
                                </td>
                                <td>
                                    <span style="display:inline-flex;align-items:center;gap:0.4rem;">
                                        <span style="width:0.5rem;height:0.5rem;border-radius:50%;background:var(--color-success);display:inline-block;"></span>
                                        Ativo
                                    </span>
                                </td>
                                <td>@member.JoinedAtUtc.ToString("dd/MM/yyyy")</td>
                                @if (canManage)
                                {
                                    <td style="position:relative;">
                                        @if (member.Role != WorkspaceRole.Owner || OwnerCount > 1)
                                        {
                                            <div class="board-column-menu">
                                                <button type="button" class="board-column-menu-btn" @onclick="() => openMenuId = openMenuId == member.Id ? null : member.Id" aria-label="Ações">⋯</button>
                                                @if (openMenuId == member.Id)
                                                {
                                                    <div class="board-column-menu-backdrop" @onclick="() => openMenuId = null"></div>
                                                    <div class="board-column-menu-dropdown">
                                                        <button type="button" @onclick="() => HandleRemove(member.Id)">Remover</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination">
                    <button type="button" disabled="@(currentPage == 1)" @onclick="() => currentPage = 1">«</button>
                    <button type="button" disabled="@(currentPage == 1)" @onclick="() => currentPage--">Anterior</button>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        var page = p;
                        <button type="button" class="@(currentPage == page ? "active" : "")" @onclick="() => currentPage = page">@(page)</button>
                    }
                    <button type="button" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++">Próxima</button>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const int PageSize = 10;

    private Workspace? workspace;
    private List<WorkspaceMember>? members;
    private bool notFound;
    private bool canManage;
    private bool isSaving;
    private bool showAddForm;
    private string? errorMessage;
    private Guid? loadedWorkspaceId;
    private readonly AddMemberModel addModel = new();
    private string memberFilter = "";
    private int currentPage = 1;
    private Guid? openMenuId;

    private int OwnerCount => members?.Count(m => m.Role == WorkspaceRole.Owner) ?? 0;

    private List<WorkspaceMember> FilteredMembers => members is null
        ? []
        : members.Where(m => string.IsNullOrWhiteSpace(memberFilter)
            || (m.User.DisplayName?.Contains(memberFilter, StringComparison.OrdinalIgnoreCase) ?? false)
            || (m.User.Email?.Contains(memberFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling(FilteredMembers.Count / (double)PageSize));

    private List<WorkspaceMember> PagedMembers
    {
        get
        {
            var filtered = FilteredMembers;
            var page = Math.Min(currentPage, Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize)));
            return filtered.Skip((page - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId)
        {
            return;
        }

        loadedWorkspaceId = WorkspaceId;
        notFound = false;
        workspace = null;
        members = null;
        errorMessage = null;

        var authState = await AuthStateTask!;

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManage = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        await LoadMembersAsync();
    }

    private async Task LoadMembersAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        members = await db.WorkspaceMembers
            .Where(m => m.WorkspaceId == WorkspaceId)
            .Include(m => m.User)
            .OrderBy(m => m.Role)
            .ThenBy(m => m.User.DisplayName)
            .ToListAsync();
    }

    private async Task HandleAddMember()
    {
        isSaving = true;
        errorMessage = null;

        var normalizedEmail = addModel.Email.Trim().ToUpperInvariant();

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var user = await db.Users.FirstOrDefaultAsync(u => u.NormalizedEmail == normalizedEmail);
            if (user is null)
            {
                errorMessage = "Nenhuma conta encontrada com esse e-mail. A pessoa precisa criar uma conta primeiro.";
                isSaving = false;
                return;
            }

            var alreadyMember = await db.WorkspaceMembers.AnyAsync(m => m.WorkspaceId == WorkspaceId && m.UserId == user.Id);
            if (alreadyMember)
            {
                errorMessage = "Essa pessoa já é membro deste workspace.";
                isSaving = false;
                return;
            }

            db.WorkspaceMembers.Add(new WorkspaceMember
            {
                Id = Guid.NewGuid(),
                WorkspaceId = WorkspaceId,
                UserId = user.Id,
                Role = addModel.Role,
                JoinedAtUtc = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
        }

        addModel.Email = "";
        addModel.Role = WorkspaceRole.Member;
        isSaving = false;
        showAddForm = false;
        await LoadMembersAsync();
    }

    private async Task HandleRoleChange(Guid memberId, object? value)
    {
        if (!Enum.TryParse<WorkspaceRole>(value?.ToString(), out var newRole))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.WorkspaceMembers
            .Where(m => m.Id == memberId && m.WorkspaceId == WorkspaceId && m.Role != WorkspaceRole.Owner)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.Role, newRole));

        await LoadMembersAsync();
    }

    private async Task HandleRemove(Guid memberId)
    {
        errorMessage = null;
        openMenuId = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var member = await db.WorkspaceMembers.FirstAsync(m => m.Id == memberId);

        if (member.Role == WorkspaceRole.Owner)
        {
            var ownerCount = await db.WorkspaceMembers.CountAsync(m => m.WorkspaceId == WorkspaceId && m.Role == WorkspaceRole.Owner);
            if (ownerCount <= 1)
            {
                errorMessage = "Não é possível remover o único dono do workspace.";
                return;
            }
        }

        await db.WorkspaceMembers.Where(m => m.Id == memberId).ExecuteDeleteAsync();
        await LoadMembersAsync();
    }

    private async Task HandleExportCsv()
    {
        if (members is null)
        {
            return;
        }

        var csv = new StringBuilder();
        csv.AppendLine("Nome,Email,Cargo,Desde");
        foreach (var m in members)
        {
            var name = (m.User.DisplayName ?? "").Replace("\"", "\"\"");
            var email = (m.User.Email ?? "").Replace("\"", "\"\"");
            csv.AppendLine($"\"{name}\",\"{email}\",{m.Role.ToDisplayLabel()},{m.JoinedAtUtc:dd/MM/yyyy}");
        }

        var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/download-interop.js");
        await module.InvokeVoidAsync("downloadFile", $"membros-{workspace!.Slug}.csv", csv.ToString(), "text/csv");
        await module.DisposeAsync();
    }

    private static string Initial(string? displayName, string? email)
    {
        var source = string.IsNullOrWhiteSpace(displayName) ? email : displayName;
        return string.IsNullOrWhiteSpace(source) ? "?" : source.Trim()[0].ToString().ToUpperInvariant();
    }

    private class AddMemberModel
    {
        [Required(ErrorMessage = "Informe um e-mail.")]
        [EmailAddress(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = "";
        public WorkspaceRole Role { get; set; } = WorkspaceRole.Member;
    }
}
