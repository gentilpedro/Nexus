@page "/workspaces/{WorkspaceId:guid}/members"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext
@inject Nexus.Web.Services.AuditLogService AuditLog
@inject WorkspaceInviteService InviteService
@inject IJSRuntime JS

<PageTitle>Membros</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Workspace não encontrado ou você não tem acesso a ele.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (workspace is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a> /
            Membros
        </div>

        <div class="page-header">
            <div>
                <h1 style="margin-bottom:0.15rem;">Membros do Workspace</h1>
                <span class="topnav-user">Gerencie quem tem acesso ao workspace @workspace.Name e defina os níveis de permissão.</span>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick="HandleExportCsv">Exportar CSV</button>
                @if (canManage)
                {
                    <button type="button" class="btn" @onclick="() => showAddForm = !showAddForm">+ Convidar Membro</button>
                }
            </div>
        </div>

        @if (members is not null)
        {
            <div class="stat-grid">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Total de membros</span>
                        <span class="stat-card-value">@members.Count</span>
                    </div>
                    <span class="stat-card-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Administradores</span>
                        <span class="stat-card-value">@members.Count(m => m.Role is WorkspaceRole.Admin or WorkspaceRole.Owner)</span>
                    </div>
                    <span class="stat-card-icon is-success">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Convites pendentes</span>
                        <span class="stat-card-value">@(pendingInvites?.Count ?? 0)</span>
                    </div>
                    <span class="stat-card-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" /><polyline points="4 6 12 13 20 6" /></svg>
                    </span>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert-success">@statusMessage</div>
        }

        @if (canManage && showAddForm)
        {
            <EditForm Model="addModel" OnValidSubmit="HandleAddMember" class="card" style="margin-bottom:1.5rem;">
                <DataAnnotationsValidator />
                <div class="form-row">
                    <div class="form-field">
                        <label for="member-email">E-mail</label>
                        <InputText id="member-email" @bind-Value="addModel.Email" placeholder="pessoa@exemplo.com" />
                        <ValidationMessage For="() => addModel.Email" />
                    </div>
                    <div class="form-field">
                        <label for="member-role">Cargo</label>
                        <InputSelect id="member-role" @bind-Value="addModel.Role">
                            <option value="@WorkspaceRole.Member">Membro</option>
                            <option value="@WorkspaceRole.Admin">Admin</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn" disabled="@isSaving">Adicionar</button>
                    <button type="button" class="btn btn-secondary" @onclick="() => showAddForm = false">Cancelar</button>
                </div>
            </EditForm>
        }

        @if (members is null)
        {
            <p>Carregando membros...</p>
        }
        else
        {
            <div class="form-field" style="max-width:280px;">
                <input type="search" placeholder="Buscar por nome ou e-mail..." @bind="memberFilter" @bind:event="oninput" />
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Membro</th>
                            <th>Cargo</th>
                            <th>Status</th>
                            <th>Desde</th>
                            @if (canManage)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in FilteredPendingInvites)
                        {
                            var expired = inv.ExpiresAtUtc <= DateTime.UtcNow;
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:0.6rem;">
                                        <span class="chat-message-avatar">@Initial(null, inv.Email)</span>
                                        <div>
                                            <div style="font-weight:600;">@inv.Email</div>
                                            <div class="topnav-user">Aguardando aceite do convite</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="tab-count">@inv.Role.ToDisplayLabel()</span></td>
                                <td>
                                    <span style="display:inline-flex;align-items:center;gap:0.4rem;">
                                        <span style="width:0.5rem;height:0.5rem;border-radius:50%;background:@(expired ? "var(--color-danger)" : "var(--color-warning)");display:inline-block;"></span>
                                        @(expired ? "Convite expirado" : "Pendente")
                                    </span>
                                </td>
                                <td>Convidado em @inv.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                @if (canManage)
                                {
                                    <td style="position:relative;">
                                        <div class="board-column-menu">
                                            <button type="button" class="board-column-menu-btn" @onclick="() => openInviteMenuId = openInviteMenuId == inv.Id ? null : inv.Id" aria-label="Ações do convite">⋯</button>
                                            @if (openInviteMenuId == inv.Id)
                                            {
                                                <div class="board-column-menu-backdrop" @onclick="() => openInviteMenuId = null"></div>
                                                <div class="board-column-menu-dropdown">
                                                    <button type="button" @onclick="() => HandleResendInvite(inv)">Reenviar convite</button>
                                                    <button type="button" @onclick="() => HandleCancelInvite(inv.Id)">Cancelar convite</button>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                        @foreach (var member in PagedMembers)
                        {
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:0.6rem;">
                                        <span class="chat-message-avatar">@Initial(member.User.DisplayName, member.User.Email)</span>
                                        <div>
                                            <div style="font-weight:600;">@(string.IsNullOrEmpty(member.User.DisplayName) ? "—" : member.User.DisplayName)</div>
                                            <div class="topnav-user">@(member.User.Email ?? "—")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (canManage && member.Role != WorkspaceRole.Owner)
                                    {
                                        <select @onchange="@(e => HandleRoleChange(member.Id, e.Value))">
                                            <option value="@WorkspaceRole.Member" selected="@(member.Role == WorkspaceRole.Member)">Membro</option>
                                            <option value="@WorkspaceRole.Admin" selected="@(member.Role == WorkspaceRole.Admin)">Admin</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="tab-count">@member.Role.ToDisplayLabel()</span>
                                    }
                                </td>
                                <td>
                                    <span style="display:inline-flex;align-items:center;gap:0.4rem;">
                                        <span style="width:0.5rem;height:0.5rem;border-radius:50%;background:var(--color-success);display:inline-block;"></span>
                                        Ativo
                                    </span>
                                </td>
                                <td>@member.JoinedAtUtc.ToString("dd/MM/yyyy")</td>
                                @if (canManage)
                                {
                                    <td style="position:relative;">
                                        @if (member.Role != WorkspaceRole.Owner || OwnerCount > 1)
                                        {
                                            <div class="board-column-menu">
                                                <button type="button" class="board-column-menu-btn" @onclick="() => openMenuId = openMenuId == member.Id ? null : member.Id" aria-label="Ações">⋯</button>
                                                @if (openMenuId == member.Id)
                                                {
                                                    <div class="board-column-menu-backdrop" @onclick="() => openMenuId = null"></div>
                                                    <div class="board-column-menu-dropdown">
                                                        <button type="button" @onclick="() => HandleRemove(member.Id)">Remover</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination">
                    <button type="button" disabled="@(currentPage == 1)" @onclick="() => currentPage = 1">«</button>
                    <button type="button" disabled="@(currentPage == 1)" @onclick="() => currentPage--">Anterior</button>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        var page = p;
                        <button type="button" class="@(currentPage == page ? "active" : "")" @onclick="() => currentPage = page">@(page)</button>
                    }
                    <button type="button" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++">Próxima</button>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const int PageSize = 10;

    private Workspace? workspace;
    private List<WorkspaceMember>? members;
    private bool notFound;
    private bool canManage;
    private bool isSaving;
    private bool showAddForm;
    private string? errorMessage;
    private string? statusMessage;
    private Guid? loadedWorkspaceId;
    private readonly AddMemberModel addModel = new();
    private string memberFilter = "";
    private int currentPage = 1;
    private Guid? openMenuId;
    private Guid? openInviteMenuId;
    private string? currentUserId;
    private List<WorkspaceInvite>? pendingInvites;

    private int OwnerCount => members?.Count(m => m.Role == WorkspaceRole.Owner) ?? 0;

    private List<WorkspaceMember> FilteredMembers => members is null
        ? []
        : members.Where(m => string.IsNullOrWhiteSpace(memberFilter)
            || (m.User.DisplayName?.Contains(memberFilter, StringComparison.OrdinalIgnoreCase) ?? false)
            || (m.User.Email?.Contains(memberFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    // Not paginated alongside members: pending invites are a short, transient list, and burying
    // them behind page 2 is exactly how an admin ends up re-inviting someone who was already
    // invited. They stay pinned to the top of the table.
    private List<WorkspaceInvite> FilteredPendingInvites => pendingInvites is null
        ? []
        : pendingInvites.Where(i => string.IsNullOrWhiteSpace(memberFilter)
            || i.Email.Contains(memberFilter, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling(FilteredMembers.Count / (double)PageSize));

    private List<WorkspaceMember> PagedMembers
    {
        get
        {
            var filtered = FilteredMembers;
            var page = Math.Min(currentPage, Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize)));
            return filtered.Skip((page - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId)
        {
            return;
        }

        loadedWorkspaceId = WorkspaceId;
        notFound = false;
        workspace = null;
        members = null;
        pendingInvites = null;
        errorMessage = null;

        var authState = await AuthStateTask!;
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManage = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        await LoadMembersAsync();
    }

    private async Task LoadMembersAsync()
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            members = await db.WorkspaceMembers
                .Where(m => m.WorkspaceId == WorkspaceId)
                .Include(m => m.User)
                .OrderBy(m => m.Role)
                .ThenBy(m => m.User.DisplayName)
                .ToListAsync();
        }

        pendingInvites = await InviteService.GetPendingAsync(WorkspaceId);
    }

    // Re-checks that the current user still holds Admin in this workspace, at the moment of the
    // write. Every mutation on this page authorized once in OnParametersSetAsync and never again,
    // but the circuit stays alive for as long as the tab is open — long enough for an Owner to
    // have demoted or removed this admin in the meantime. These are the most privileged
    // operations in the product (changing roles, removing people), so a stale decision here is
    // the most damaging kind. See WorkspaceAccessGuard.
    private async Task<bool> StillAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        errorMessage = "Você não tem mais permissão de administrador neste workspace.";
        canManage = false;
        isSaving = false;
        return false;
    }

    private async Task HandleAddMember()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        var email = addModel.Email.Trim();

        // Nobody is added straight to the workspace, not even an address that already has an
        // account: the invite stays pending until the person accepts it at /convite/{token}.
        var outcome = await InviteService.CreateAndSendAsync(WorkspaceId, workspace!.Name, email, addModel.Role, currentUserId);

        if (outcome.Status == InviteSendStatus.AlreadyMember)
        {
            errorMessage = "Essa pessoa já é membro deste workspace.";
            isSaving = false;
            return;
        }

        statusMessage = outcome.Status switch
        {
            InviteSendStatus.SentWithoutEmail => $"Convite criado para {email}, mas não conseguimos enviar o e-mail — avise a pessoa por outro canal.",
            InviteSendStatus.Resent => $"Já havia um convite pendente para {email}; reenviamos.",
            _ => $"Convite enviado para {email}.",
        };

        if (outcome.NotifiedInApp && outcome.Status != InviteSendStatus.SentWithoutEmail)
        {
            statusMessage += " A pessoa também recebeu uma notificação dentro da plataforma.";
        }

        await AuditLog.LogAsync(currentUserId, AuditAction.WorkspaceInviteSent, targetId: email, detail: $"workspace={WorkspaceId};role={addModel.Role}");

        addModel.Email = "";
        addModel.Role = WorkspaceRole.Member;
        isSaving = false;
        showAddForm = false;
        await LoadMembersAsync();
    }

    private async Task HandleResendInvite(WorkspaceInvite invite)
    {
        openInviteMenuId = null;
        errorMessage = null;
        statusMessage = null;

        if (!await StillAdminAsync())
        {
            return;
        }

        var outcome = await InviteService.CreateAndSendAsync(WorkspaceId, workspace!.Name, invite.Email, invite.Role, currentUserId);
        statusMessage = outcome.Status == InviteSendStatus.SentWithoutEmail
            ? $"Não conseguimos reenviar o e-mail para {invite.Email} — avise a pessoa por outro canal."
            : $"Convite reenviado para {invite.Email}.";

        await LoadMembersAsync();
    }

    private async Task HandleCancelInvite(Guid inviteId)
    {
        openInviteMenuId = null;
        errorMessage = null;
        statusMessage = null;

        if (!await StillAdminAsync())
        {
            return;
        }

        if (await InviteService.CancelAsync(inviteId, WorkspaceId))
        {
            statusMessage = "Convite cancelado.";
            await AuditLog.LogAsync(currentUserId, AuditAction.WorkspaceInviteCanceled, targetId: inviteId.ToString(), detail: $"workspace={WorkspaceId}");
        }

        await LoadMembersAsync();
    }

    private async Task<bool> RevalidateCanManageAsync()
    {
        var authState = await AuthStateTask!;
        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        return adminResult.Succeeded;
    }

    private async Task HandleRoleChange(Guid memberId, object? value)
    {
        if (!Enum.TryParse<WorkspaceRole>(value?.ToString(), out var newRole))
        {
            return;
        }

        // canManage only reflects permissions as of page load — re-check now in case the
        // current user was demoted since then, rather than trusting the cached flag that only
        // gates whether the UI shows these controls.
        if (!await RevalidateCanManageAsync())
        {
            errorMessage = "Você não tem mais permissão para gerenciar membros deste workspace.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var updated = await db.WorkspaceMembers
            .Where(m => m.Id == memberId && m.WorkspaceId == WorkspaceId && m.Role != WorkspaceRole.Owner)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.Role, newRole));

        if (updated > 0)
        {
            await AuditLog.LogAsync(currentUserId, AuditAction.WorkspaceMemberRoleChanged, targetId: memberId.ToString(), detail: $"workspace={WorkspaceId};newRole={newRole}");
        }

        await LoadMembersAsync();
    }

    private async Task HandleRemove(Guid memberId)
    {
        errorMessage = null;
        openMenuId = null;

        if (!await RevalidateCanManageAsync())
        {
            errorMessage = "Você não tem mais permissão para gerenciar membros deste workspace.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var member = await db.WorkspaceMembers.FirstOrDefaultAsync(m => m.Id == memberId && m.WorkspaceId == WorkspaceId);
        if (member is null)
        {
            return;
        }

        if (member.Role == WorkspaceRole.Owner)
        {
            var ownerCount = await db.WorkspaceMembers.CountAsync(m => m.WorkspaceId == WorkspaceId && m.Role == WorkspaceRole.Owner);
            if (ownerCount <= 1)
            {
                errorMessage = "Não é possível remover o único dono do workspace.";
                return;
            }
        }

        await db.WorkspaceMembers.Where(m => m.Id == memberId && m.WorkspaceId == WorkspaceId).ExecuteDeleteAsync();
        await AuditLog.LogAsync(currentUserId, AuditAction.WorkspaceMemberRemoved, targetId: memberId.ToString(), detail: $"workspace={WorkspaceId};removedUserId={member.UserId}");
        await LoadMembersAsync();
    }

    private async Task HandleExportCsv()
    {
        if (members is null)
        {
            return;
        }

        var csv = new StringBuilder();
        csv.AppendLine("Nome,Email,Cargo,Desde");
        foreach (var m in members)
        {
            var name = (m.User.DisplayName ?? "").Replace("\"", "\"\"");
            var email = (m.User.Email ?? "").Replace("\"", "\"\"");
            csv.AppendLine($"\"{name}\",\"{email}\",{m.Role.ToDisplayLabel()},{m.JoinedAtUtc:dd/MM/yyyy}");
        }

        var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/download-interop.js");
        await module.InvokeVoidAsync("downloadFile", $"membros-{workspace!.Slug}.csv", csv.ToString(), "text/csv");
        await module.DisposeAsync();
    }

    private static string Initial(string? displayName, string? email)
    {
        var source = string.IsNullOrWhiteSpace(displayName) ? email : displayName;
        return string.IsNullOrWhiteSpace(source) ? "?" : source.Trim()[0].ToString().ToUpperInvariant();
    }

    private class AddMemberModel
    {
        [Required(ErrorMessage = "Informe um e-mail.")]
        [EmailAddress(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = "";
        public WorkspaceRole Role { get; set; } = WorkspaceRole.Member;
    }
}
