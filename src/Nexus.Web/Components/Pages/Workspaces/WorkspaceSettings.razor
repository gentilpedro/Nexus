@page "/workspaces/{WorkspaceId:guid}/settings"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Nexus.Web.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext
@inject ToastService Toasts
@inject WorkspacePlanService PlanService
@inject Nexus.Web.Services.Billing.BillingService Billing
@inject WorkspaceApiKeyService ApiKeys
@inject Nexus.Web.Services.Webhooks.WebhookService Webhooks
@inject IJSRuntime JS
@using System.Security.Claims
@using Microsoft.JSInterop

<PageTitle>Configurações · @(workspace?.Name ?? "Workspace") · Nexus</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Sem acesso às configurações"
                    Description="Só administradores do workspace podem alterar as configurações dele.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (workspace is null)
    {
        <Skeleton Variant="text" Count="6" Label="Carregando configurações…" />
    }
    else
    {
        <PageHeader Title="@workspace.Name">
            <Breadcrumbs>
                <a href="/workspaces">Workspaces</a>
            </Breadcrumbs>
        </PageHeader>

        <WorkspaceTabs WorkspaceId="WorkspaceId" Active="settings" CanManage="true" />

        <div class="settings-layout">
            <nav class="settings-nav" aria-label="Seções das configurações">
                <button type="button" class="settings-nav-link @(tab == "geral" ? "active" : "")" aria-current="@(tab == "geral" ? "true" : null)" @onclick='() => tab = "geral"'><Icon Name="settings" /> Geral</button>
                <button type="button" class="settings-nav-link @(tab == "workflow" ? "active" : "")" aria-current="@(tab == "workflow" ? "true" : null)" @onclick='() => tab = "workflow"'><Icon Name="refresh" /> Fluxo de trabalho</button>
                <button type="button" class="settings-nav-link @(tab == "integracoes" ? "active" : "")" aria-current="@(tab == "integracoes" ? "true" : null)" @onclick="ShowIntegrationsTab"><Icon Name="key" /> Integrações</button>
            </nav>

            <div class="settings-content">
                @if (tab == "geral")
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
                    }

                    <EditForm Model="generalModel" OnValidSubmit="HandleSaveGeneral" class="card form-card">
                        <DataAnnotationsValidator />
                        <h2 class="form-section-title">Identidade</h2>
                        <p class="form-section-description">Nome e cor aparecem para todos os membros, na barra lateral e nos convites.</p>
                        <div class="identity-row">
                            <Avatar Name="@(string.IsNullOrWhiteSpace(generalModel.Name) ? "?" : generalModel.Name)" Color="@generalModel.Color" Size="xl" Square="true" />
                            <div class="identity-fields">
                                <div class="form-field">
                                    <label for="ws-name" class="required">Nome do workspace</label>
                                    <InputText id="ws-name" @bind-Value="generalModel.Name" @bind-Value:after="() => generalModel.Name = generalModel.Name.Trim()"
                                               @oninput="e => generalModel.Name = e.Value?.ToString() ?? string.Empty" />
                                    <ValidationMessage For="() => generalModel.Name" />
                                </div>
                                <fieldset class="form-fieldset">
                                    <legend class="field-label">Cor</legend>
                                    <div class="color-swatch-row">
                                        @foreach (var (color, colorName) in AvailableColors)
                                        {
                                            <button type="button" class="color-swatch @(generalModel.Color == color ? "is-selected" : "")"
                                                    style="background:@color;" @onclick="() => generalModel.Color = color"
                                                    aria-pressed="@(generalModel.Color == color ? "true" : "false")" aria-label="@colorName"></button>
                                        }
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                        <div class="form-actions form-actions--end">
                            <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving">Salvar alterações</button>
                        </div>
                    </EditForm>

                    @if (plan is not null)
                    {
                        <section class="card" aria-labelledby="plan-title">
                            <h2 id="plan-title" class="form-section-title">Plano <span class="badge badge--accent">@PlanName(plan.EffectivePlan)</span></h2>
                            <p class="form-section-description">
                                @if (plan.OwnedByUnlimitedAccount)
                                {
                                    @("O dono deste workspace é uma conta sem limites: todos os recursos estão liberados, sem depender de plano.")
                                }
                                else if (Billing.IsEnabled)
                                {
                                    @($"No plano Pro: membros sem limite, sprints, Gantt e burndown. {Nexus.Web.Services.Billing.BillingService.ProBasePrice} por mês com até {Nexus.Web.Services.Billing.BillingService.ProIncludedSeats} pessoas, e {Nexus.Web.Services.Billing.BillingService.ProExtraSeatPrice} por pessoa a mais.")
                                }
                                else
                                {
                                    @("Durante o lançamento, todos os recursos estão liberados. A troca de plano estará disponível em breve.")
                                }
                            </p>
                            <ul class="plan-summary">
                                <li><Icon Name="team" Class="icon--sm" /> @memberCount @(memberCount == 1 ? "membro" : "membros")@(plan.Capabilities.MaxMembers is { } max ? $" de {max} no plano" : "")</li>
                                <li><Icon Name="@(plan.Capabilities.IncludesSprintsGanttAndBurndown ? "check" : "lock")" Class="icon--sm" /> Sprints, Gantt e burndown @(plan.Capabilities.IncludesSprintsGanttAndBurndown ? "incluídos" : "no plano Pro")</li>
                            </ul>
                            @if (isOwner)
                            {
                                <div class="form-actions">
                                    <a class="btn btn-secondary" href="@($"/workspaces/{WorkspaceId}/billing")"><Icon Name="credit-card" /> Plano e cobrança</a>
                                </div>
                            }
                        </section>
                    }

                    <section class="card danger-zone" aria-labelledby="danger-zone-title">
                        <h2 id="danger-zone-title" class="form-section-title">@(workspace.IsArchived ? "Workspace arquivado" : "Arquivar workspace")</h2>
                        <div class="danger-zone-row">
                            <p class="form-section-description">
                                @if (workspace.IsArchived)
                                {
                                    @("Ele está fora da lista principal, mas nada foi apagado. Desarquive para voltar a usá-lo normalmente.")
                                }
                                else
                                {
                                    @("Arquivar tira o workspace da lista principal de todos os membros. Nada é apagado e dá para desarquivar a qualquer momento.")
                                }
                            </p>
                            <button type="button" class="btn @(workspace.IsArchived ? "btn-secondary" : "btn-danger-ghost btn-bordered-danger")" @onclick="HandleToggleArchive">
                                <Icon Name="@(workspace.IsArchived ? "refresh" : "inbox")" />
                                @(workspace.IsArchived ? "Desarquivar" : "Arquivar workspace")
                            </button>
                        </div>
                    </section>
                }
                else if (tab == "workflow")
                {
                    <p class="form-section-description">Cada lista tem suas próprias colunas de status e regras de transição. Escolha uma lista para configurar o fluxo dela.</p>

                    @if (spaces is null)
                    {
                        <Skeleton Count="4" />
                    }
                    else if (spaces.Count == 0)
                    {
                        <div class="card">
                            <EmptyState Compact="true" Title="Nenhum space criado ainda" Description="Crie um space e uma lista na visão geral do workspace." />
                        </div>
                    }
                    else
                    {
                        @foreach (var space in spaces)
                        {
                            <section class="section" aria-label="@space.Name">
                                <h3 class="section-title settings-space-title"><Icon Name="space" Class="icon--sm" /> @space.Name</h3>
                                @if (space.Lists.Count == 0)
                                {
                                    <p class="cell-muted">Nenhuma lista neste space.</p>
                                }
                                else
                                {
                                    <ul class="space-list">
                                        @foreach (var list in space.Lists.OrderBy(l => l.SortOrder))
                                        {
                                            <li>
                                                <a class="space-item space-item--compact" href="@($"/lists/{list.Id}/workflow")">
                                                    <span class="space-item-body"><span class="space-item-name">@list.Name</span></span>
                                                    <span class="space-item-meta">Configurar fluxo</span>
                                                    <Icon Name="chevron-right" Class="space-item-chevron" />
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        }
                    }
                }
                else if (tab == "integracoes")
                {
                    <section class="card" aria-labelledby="api-keys-title">
                        <h2 id="api-keys-title" class="form-section-title">Chaves de API</h2>
                        <p class="form-section-description">
                            Uma chave deixa um sistema externo, como um ERP, criar e acompanhar as tarefas deste workspace pela API.
                            Ela aparece uma única vez, na criação: guarde-a no sistema que vai usá-la.
                            A documentação está em <a href="https://docs-nexus.aamora.com.br/integracoes/api/" target="_blank" rel="noopener">docs-nexus.aamora.com.br</a>; a especificação, em <a href="/openapi/v1.json" target="_blank" rel="noopener">/openapi/v1.json</a>.
                        </p>

                        @if (newApiKeySecret is not null)
                        {
                            <div class="alert alert-success api-key-reveal" role="status">
                                <Icon Name="key" />
                                <div class="api-key-reveal-body">
                                    <span><strong>Chave "@newApiKeyName" criada.</strong> Copie agora: ela não será mostrada de novo.</span>
                                    <div class="api-key-reveal-row">
                                        <code class="api-key-secret">@newApiKeySecret</code>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CopyNewApiKey"><Icon Name="copy" /> @(apiKeyCopied ? "Copiada" : "Copiar")</button>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(apiKeyError))
                        {
                            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@apiKeyError</span></div>
                        }

                        @if (apiAccessAllowed == false)
                        {
                            <div class="alert alert-info api-key-locked" role="status">
                                <Icon Name="lock" />
                                <span>A API de integração faz parte dos planos Pro e Business. As chaves já criadas param de funcionar enquanto o workspace estiver no Starter.
                                @if (isOwner)
                                {
                                    <a href="@($"/workspaces/{WorkspaceId}/billing")">Ver plano e cobrança</a>
                                }
                                </span>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="apiKeyModel" OnValidSubmit="HandleCreateApiKey" class="api-key-form">
                                <DataAnnotationsValidator />
                                <div class="form-field">
                                    <label for="api-key-name" class="required">Nome da chave</label>
                                    <InputText id="api-key-name" @bind-Value="apiKeyModel.Name" placeholder="Ex.: ERP Protheus" maxlength="@WorkspaceApiKey.MaxNameLength" />
                                    <ValidationMessage For="() => apiKeyModel.Name" />
                                </div>
                                <fieldset class="form-fieldset">
                                    <legend class="field-label">O que a chave pode fazer</legend>
                                    <InputRadioGroup @bind-Value="apiKeyModel.Scope">
                                        <label class="radio-option"><InputRadio Value="ApiKeyScope.ReadWrite" /> <span><strong>Leitura e escrita</strong>: cria e atualiza tarefas. Para um ERP.</span></label>
                                        <label class="radio-option"><InputRadio Value="ApiKeyScope.ReadOnly" /> <span><strong>Só leitura</strong>: consulta tarefas, listas e membros. Para painéis e relatórios.</span></label>
                                    </InputRadioGroup>
                                </fieldset>
                                <div class="form-actions form-actions--end">
                                    <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving"><Icon Name="plus" /> Gerar chave</button>
                                </div>
                            </EditForm>
                        }

                        @if (apiKeys is null)
                        {
                            <Skeleton Count="3" />
                        }
                        else if (apiKeys.Count == 0)
                        {
                            <EmptyState Compact="true" Title="Nenhuma chave ainda" Description="Gere a primeira chave acima e configure-a no sistema que vai integrar." />
                        }
                        else
                        {
                            <table class="data-table api-keys-table">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Escopo</th>
                                        <th>Chave</th>
                                        <th>Criada</th>
                                        <th>Último uso</th>
                                        <th><span class="sr-only">Ações</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var key in apiKeys)
                                    {
                                        <tr class="@(key.IsActive ? "" : "is-muted")">
                                            <td class="cell-title">@key.Name @if (!key.IsActive) { <span class="badge">Revogada</span> }</td>
                                            <td>@(key.Scope == ApiKeyScope.ReadOnly ? "Só leitura" : "Leitura e escrita")</td>
                                            <td class="tabular"><code>@(key.KeyPrefix)…</code></td>
                                            <td class="cell-muted tabular">@key.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="cell-muted tabular">@(key.LastUsedAtUtc is { } used ? used.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Nunca")</td>
                                            <td class="cell-actions">
                                                @if (key.IsActive)
                                                {
                                                    <button type="button" class="btn btn-danger-ghost btn-sm" @onclick="() => HandleRevokeApiKey(key)">Revogar</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>

                    <section class="card" aria-labelledby="webhooks-title">
                        <h2 id="webhooks-title" class="form-section-title">Webhooks de saída</h2>
                        <p class="form-section-description">
                            O Nexus chama a URL do seu sistema quando uma tarefa é criada, muda, troca de status ou de responsável, ou recebe um comentário.
                            Cada chamada vai assinada com o segredo do webhook, que aparece uma única vez.
                            Formato dos eventos e validação da assinatura na <a href="https://docs-nexus.aamora.com.br/integracoes/webhooks/" target="_blank" rel="noopener">documentação</a>.
                        </p>

                        @if (newWebhookSecret is not null)
                        {
                            <div class="alert alert-success api-key-reveal" role="status">
                                <Icon Name="key" />
                                <div class="api-key-reveal-body">
                                    <span><strong>Webhook "@newWebhookName" cadastrado.</strong> Copie o segredo agora: ele não será mostrado de novo. Use-o para conferir a assinatura de cada chamada.</span>
                                    <div class="api-key-reveal-row">
                                        <code class="api-key-secret">@newWebhookSecret</code>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CopyNewWebhookSecret"><Icon Name="copy" /> @(webhookCopied ? "Copiado" : "Copiar")</button>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(webhookError))
                        {
                            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@webhookError</span></div>
                        }

                        @if (apiAccessAllowed != false)
                        {
                            <EditForm Model="webhookModel" OnValidSubmit="HandleCreateWebhook" class="api-key-form">
                                <DataAnnotationsValidator />
                                <div class="form-field">
                                    <label for="webhook-name" class="required">Nome</label>
                                    <InputText id="webhook-name" @bind-Value="webhookModel.Name" placeholder="Ex.: ERP Protheus" maxlength="@WorkspaceWebhook.MaxNameLength" />
                                    <ValidationMessage For="() => webhookModel.Name" />
                                </div>
                                <div class="form-field">
                                    <label for="webhook-url" class="required">URL (https)</label>
                                    <InputText id="webhook-url" @bind-Value="webhookModel.Url" placeholder="https://erp.suaempresa.com.br/nexus/webhook" maxlength="@WorkspaceWebhook.MaxUrlLength" />
                                    <ValidationMessage For="() => webhookModel.Url" />
                                </div>
                                <fieldset class="form-fieldset">
                                    <legend class="field-label">Eventos</legend>
                                    <label class="radio-option"><InputCheckbox @bind-Value="webhookModel.TaskCreated" /> <span><strong>Tarefa criada</strong> (<code>task.created</code>)</span></label>
                                    <label class="radio-option"><InputCheckbox @bind-Value="webhookModel.TaskStatusChanged" /> <span><strong>Status mudou</strong> (<code>task.status_changed</code>)</span></label>
                                    <label class="radio-option"><InputCheckbox @bind-Value="webhookModel.TaskAssigneeChanged" /> <span><strong>Responsável mudou</strong> (<code>task.assignee_changed</code>)</span></label>
                                    <label class="radio-option"><InputCheckbox @bind-Value="webhookModel.TaskUpdated" /> <span><strong>Outros campos mudaram</strong>: título, descrição, tipo, prioridade, datas (<code>task.updated</code>)</span></label>
                                    <label class="radio-option"><InputCheckbox @bind-Value="webhookModel.CommentCreated" /> <span><strong>Comentário novo</strong> (<code>comment.created</code>)</span></label>
                                </fieldset>
                                <div class="form-actions form-actions--end">
                                    <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving"><Icon Name="plus" /> Cadastrar webhook</button>
                                </div>
                            </EditForm>
                        }

                        @if (webhooks is null)
                        {
                            <Skeleton Count="2" />
                        }
                        else if (webhooks.Count == 0)
                        {
                            <EmptyState Compact="true" Title="Nenhum webhook ainda" Description="Cadastre a URL do sistema que deve ser avisado quando as tarefas mudarem." />
                        }
                        else
                        {
                            <table class="data-table api-keys-table">
                                <thead>
                                    <tr>
                                        <th>Nome e URL</th>
                                        <th>Eventos</th>
                                        <th>Situação</th>
                                        <th>Último envio</th>
                                        <th><span class="sr-only">Ações</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hook in webhooks)
                                    {
                                        <tr class="@(hook.IsActive ? "" : "is-muted")">
                                            <td class="cell-title">@hook.Name<br /><code class="api-key-secret">@hook.Url</code></td>
                                            <td>@EventsLabel(hook.Events)</td>
                                            <td>
                                                @if (hook.IsActive)
                                                {
                                                    <span class="badge badge--accent">Ativo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge">Pausado</span>
                                                }
                                                @if (hook.ConsecutiveFailures > 0)
                                                {
                                                    <span class="cell-muted"> · @hook.ConsecutiveFailures @(hook.ConsecutiveFailures == 1 ? "falha seguida" : "falhas seguidas")</span>
                                                }
                                            </td>
                                            <td class="cell-muted tabular">@(hook.LastDeliveryAtUtc is { } sent ? sent.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Nunca")</td>
                                            <td class="cell-actions">
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => HandleTestWebhook(hook)">Enviar teste</button>
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ToggleDeliveries(hook)">@(expandedWebhookId == hook.Id ? "Ocultar entregas" : "Entregas")</button>
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => HandleToggleWebhook(hook)">@(hook.IsActive ? "Pausar" : "Reativar")</button>
                                                <button type="button" class="btn btn-danger-ghost btn-sm" @onclick="() => HandleDeleteWebhook(hook)">Excluir</button>
                                            </td>
                                        </tr>
                                        @if (expandedWebhookId == hook.Id)
                                        {
                                            <tr>
                                                <td colspan="5">
                                                    @if (deliveries is null)
                                                    {
                                                        <Skeleton Count="2" />
                                                    }
                                                    else if (deliveries.Count == 0)
                                                    {
                                                        <p class="cell-muted">Nenhuma entrega ainda. Use "Enviar teste" para disparar um <code>ping</code>.</p>
                                                    }
                                                    else
                                                    {
                                                        <table class="data-table">
                                                            <thead><tr><th>Evento</th><th>Quando</th><th>Situação</th><th>Resposta</th><th><span class="sr-only">Ações</span></th></tr></thead>
                                                            <tbody>
                                                                @foreach (var delivery in deliveries)
                                                                {
                                                                    <tr>
                                                                        <td><code>@delivery.EventType</code></td>
                                                                        <td class="cell-muted tabular">@delivery.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                                                                        <td>@DeliveryLabel(delivery)</td>
                                                                        <td class="cell-muted">@delivery.ResponseSummary</td>
                                                                        <td class="cell-actions"><button type="button" class="btn btn-secondary btn-sm" @onclick="() => HandleResend(hook, delivery)">Reenviar</button></td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    </section>
                }
            </div>
        </div>

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (string Hex, string Name)[] AvailableColors = WorkspaceColors.Options;
    private ConfirmDialog? confirm;

    private Workspace? workspace;
    private List<Space>? spaces;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private string tab = "geral";
    private readonly GeneralModel generalModel = new();
    private Guid? loadedWorkspaceId;
    private WorkspacePlanInfo? plan;
    private int memberCount;
    private bool isOwner;

    // Aba Integrações (#66). A chave completa só existe em newApiKeySecret, até a pessoa sair da página.
    private List<WorkspaceApiKey>? apiKeys;
    private readonly ApiKeyModel apiKeyModel = new();
    private string? newApiKeySecret;
    private string? newApiKeyName;
    private bool apiKeyCopied;
    private string? apiKeyError;
    private bool? apiAccessAllowed;

    // Webhooks de saída (#75).
    private List<WorkspaceWebhook>? webhooks;
    private readonly WebhookModel webhookModel = new();
    private string? newWebhookSecret;
    private string? newWebhookName;
    private bool webhookCopied;
    private string? webhookError;
    private Guid? expandedWebhookId;
    private List<WebhookDelivery>? deliveries;

    private static string PlanName(WorkspacePlan p) => p switch
    {
        WorkspacePlan.Pro => "Pro",
        WorkspacePlan.Business => "Business",
        _ => "Starter"
    };

    private async Task ShowIntegrationsTab()
    {
        tab = "integracoes";
        apiAccessAllowed ??= await PlanService.HasApiAccessAsync(WorkspaceId);
        apiKeys ??= await ApiKeys.ListAsync(WorkspaceId);
        webhooks ??= await Webhooks.ListAsync(WorkspaceId);
    }

    private static string EventsLabel(WebhookEvents events)
    {
        var parts = new List<string>();
        if (events.HasFlag(WebhookEvents.TaskCreated)) parts.Add("criada");
        if (events.HasFlag(WebhookEvents.TaskStatusChanged)) parts.Add("status");
        if (events.HasFlag(WebhookEvents.TaskAssigneeChanged)) parts.Add("responsável");
        if (events.HasFlag(WebhookEvents.TaskUpdated)) parts.Add("outros campos");
        if (events.HasFlag(WebhookEvents.CommentCreated)) parts.Add("comentários");
        return string.Join(", ", parts);
    }

    private static string DeliveryLabel(WebhookDelivery delivery) => delivery.Status switch
    {
        WebhookDeliveryStatus.Delivered => "Entregue",
        WebhookDeliveryStatus.Failed => $"Falhou ({delivery.Attempts} tentativas)",
        _ => delivery.Attempts == 0 ? "Na fila" : $"Tentando de novo ({delivery.Attempts} de {WebhookDelivery.MaxAttempts})",
    };

    private async Task HandleCreateWebhook()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        webhookError = null;
        webhookCopied = false;

        var result = await Webhooks.CreateAsync(WorkspaceId, webhookModel.Name, webhookModel.Url, webhookModel.ToEvents(), await CurrentUserIdAsync());
        isSaving = false;

        switch (result.Status)
        {
            case Nexus.Web.Services.Webhooks.WebhookCreateStatus.Created:
                newWebhookSecret = result.Secret;
                newWebhookName = result.Webhook!.Name;
                webhookModel.Reset();
                webhooks = await Webhooks.ListAsync(WorkspaceId);
                break;
            case Nexus.Web.Services.Webhooks.WebhookCreateStatus.LimitReached:
                webhookError = $"Este workspace já tem {Nexus.Web.Services.Webhooks.WebhookService.MaxWebhooksPerWorkspace} webhooks. Exclua um para cadastrar outro.";
                break;
            case Nexus.Web.Services.Webhooks.WebhookCreateStatus.PlanDoesNotIncludeApi:
                apiAccessAllowed = false;
                break;
            default:
                webhookError = result.Error ?? "Confira o nome, a URL e os eventos.";
                break;
        }
    }

    private async Task CopyNewWebhookSecret()
    {
        if (newWebhookSecret is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", newWebhookSecret);
            webhookCopied = true;
        }
        catch (JSException)
        {
            Toasts.Show("Não deu para copiar automaticamente. Selecione o segredo e copie.", ToastKind.Error);
        }
    }

    private async Task HandleTestWebhook(WorkspaceWebhook hook)
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        if (await Webhooks.SendTestAsync(WorkspaceId, hook.Id))
        {
            Toasts.Show($"Teste enfileirado para \"{hook.Name}\". A entrega aparece em alguns segundos.");
            if (expandedWebhookId == hook.Id)
            {
                deliveries = await Webhooks.ListDeliveriesAsync(WorkspaceId, hook.Id);
            }
        }
    }

    private async Task HandleToggleWebhook(WorkspaceWebhook hook)
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        if (await Webhooks.SetActiveAsync(WorkspaceId, hook.Id, !hook.IsActive))
        {
            Toasts.Show(hook.IsActive ? $"Webhook \"{hook.Name}\" pausado." : $"Webhook \"{hook.Name}\" reativado.");
        }

        webhooks = await Webhooks.ListAsync(WorkspaceId);
    }

    private async Task HandleDeleteWebhook(WorkspaceWebhook hook)
    {
        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("webhook", hook.Name, "O sistema deixa de ser avisado e o histórico de entregas é apagado.")))
        {
            return;
        }

        if (!await StillAdminAsync())
        {
            return;
        }

        if (await Webhooks.DeleteAsync(WorkspaceId, hook.Id, await CurrentUserIdAsync()))
        {
            Toasts.Show($"Webhook \"{hook.Name}\" excluído.");
        }

        if (expandedWebhookId == hook.Id)
        {
            expandedWebhookId = null;
            deliveries = null;
        }

        webhooks = await Webhooks.ListAsync(WorkspaceId);
    }

    private async Task ToggleDeliveries(WorkspaceWebhook hook)
    {
        if (expandedWebhookId == hook.Id)
        {
            expandedWebhookId = null;
            deliveries = null;
            return;
        }

        expandedWebhookId = hook.Id;
        deliveries = null;
        deliveries = await Webhooks.ListDeliveriesAsync(WorkspaceId, hook.Id);
    }

    private async Task HandleResend(WorkspaceWebhook hook, WebhookDelivery delivery)
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        if (await Webhooks.ResendAsync(WorkspaceId, delivery.Id))
        {
            Toasts.Show("Entrega enfileirada de novo.");
            deliveries = await Webhooks.ListDeliveriesAsync(WorkspaceId, hook.Id);
        }
    }

    private sealed class WebhookModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Dê um nome ao webhook, como o sistema que vai recebê-lo.")]
        [System.ComponentModel.DataAnnotations.StringLength(WorkspaceWebhook.MaxNameLength, ErrorMessage = "O nome pode ter no máximo 80 caracteres.")]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe a URL que vai receber os eventos.")]
        [System.ComponentModel.DataAnnotations.StringLength(WorkspaceWebhook.MaxUrlLength, ErrorMessage = "A URL pode ter no máximo 500 caracteres.")]
        public string Url { get; set; } = "";

        public bool TaskCreated { get; set; } = true;
        public bool TaskUpdated { get; set; }
        public bool TaskStatusChanged { get; set; } = true;
        public bool TaskAssigneeChanged { get; set; } = true;
        public bool CommentCreated { get; set; }

        public WebhookEvents ToEvents() =>
            (TaskCreated ? WebhookEvents.TaskCreated : WebhookEvents.None)
            | (TaskUpdated ? WebhookEvents.TaskUpdated : WebhookEvents.None)
            | (TaskStatusChanged ? WebhookEvents.TaskStatusChanged : WebhookEvents.None)
            | (TaskAssigneeChanged ? WebhookEvents.TaskAssigneeChanged : WebhookEvents.None)
            | (CommentCreated ? WebhookEvents.CommentCreated : WebhookEvents.None);

        public void Reset()
        {
            Name = "";
            Url = "";
            TaskCreated = true;
            TaskUpdated = false;
            TaskStatusChanged = true;
            TaskAssigneeChanged = true;
            CommentCreated = false;
        }
    }

    private async Task HandleCreateApiKey()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        apiKeyError = null;
        apiKeyCopied = false;

        var result = await ApiKeys.CreateAsync(WorkspaceId, apiKeyModel.Name, apiKeyModel.Scope, await CurrentUserIdAsync());
        isSaving = false;

        switch (result.Status)
        {
            case ApiKeyCreateStatus.Created:
                newApiKeySecret = result.Secret;
                newApiKeyName = result.Key!.Name;
                apiKeyModel.Name = "";
                apiKeyModel.Scope = ApiKeyScope.ReadWrite;
                apiKeys = await ApiKeys.ListAsync(WorkspaceId);
                break;
            case ApiKeyCreateStatus.LimitReached:
                apiKeyError = $"Este workspace já tem {WorkspaceApiKeyService.MaxActiveKeysPerWorkspace} chaves ativas. Revogue uma para gerar outra.";
                break;
            case ApiKeyCreateStatus.PlanDoesNotIncludeApi:
                apiAccessAllowed = false;
                break;
            default:
                apiKeyError = "Dê um nome à chave, como o sistema que vai usá-la.";
                break;
        }
    }

    private async Task CopyNewApiKey()
    {
        if (newApiKeySecret is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", newApiKeySecret);
            apiKeyCopied = true;
        }
        catch (JSException)
        {
            // Sem permissão de clipboard (contexto não seguro, por exemplo): a chave continua na tela.
            Toasts.Show("Não deu para copiar automaticamente. Selecione a chave e copie.", ToastKind.Error);
        }
    }

    private async Task HandleRevokeApiKey(WorkspaceApiKey key)
    {
        if (confirm is null || !await confirm.AskAsync(new ConfirmRequest(
                Title: $"Revogar a chave \"{key.Name}\"?",
                Message: "O sistema que usa essa chave perde o acesso à API na hora. Essa ação não pode ser desfeita.",
                ConfirmLabel: "Revogar chave")))
        {
            return;
        }

        if (!await StillAdminAsync())
        {
            return;
        }

        if (await ApiKeys.RevokeAsync(WorkspaceId, key.Id, await CurrentUserIdAsync()))
        {
            Toasts.Show($"Chave \"{key.Name}\" revogada.");
        }

        apiKeys = await ApiKeys.ListAsync(WorkspaceId);
    }

    private async Task<string?> CurrentUserIdAsync()
    {
        var authState = await AuthStateTask!;
        return authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    private sealed class ApiKeyModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Dê um nome à chave, como o sistema que vai usá-la.")]
        [System.ComponentModel.DataAnnotations.StringLength(WorkspaceApiKey.MaxNameLength, ErrorMessage = "O nome pode ter no máximo 80 caracteres.")]
        public string Name { get; set; } = "";

        public ApiKeyScope Scope { get; set; } = ApiKeyScope.ReadWrite;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId) return;
        loadedWorkspaceId = WorkspaceId;

        notFound = false;
        workspace = null;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        generalModel.Name = workspace.Name;
        generalModel.Color = workspace.Color ?? WorkspaceColors.Default;

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        plan = await PlanService.GetAsync(WorkspaceId);
        isOwner = (await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Owner))).Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            memberCount = await db.WorkspaceMembers.CountAsync(m => m.WorkspaceId == WorkspaceId);

            spaces = await db.Spaces
                .Where(s => s.WorkspaceId == WorkspaceId)
                .Include(s => s.Lists)
                .OrderBy(s => s.SortOrder)
                .ThenBy(s => s.Name)
                .ToListAsync();
        }
    }

    // Re-checks Admin at the moment of the write instead of trusting the decision made when the
    // page loaded. This circuit stays alive for as long as the tab is open — long enough for an
    // Owner to have demoted or removed this user — and archiving a workspace hides it from
    // everyone who uses it. See WorkspaceAccessGuard.
    private async Task<bool> StillAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        notFound = true;
        return false;
    }

    private async Task HandleSaveGeneral()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        var newName = generalModel.Name.Trim();

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Workspaces.Where(w => w.Id == WorkspaceId)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(w => w.Name, newName)
                    .SetProperty(w => w.Color, generalModel.Color));
        }

        workspace!.Name = newName;
        workspace.Color = generalModel.Color;
        NavContext.SetWorkspace(WorkspaceId, newName);
        NavContext.Refresh();

        isSaving = false;
        Toasts.Show("Alterações salvas");
    }

    private async Task HandleToggleArchive()
    {
        var newValue = !workspace!.IsArchived;
        if (newValue && (confirm is null || !await confirm.AskAsync(new ConfirmRequest(
                Title: $"Arquivar \"{workspace.Name}\"?",
                Message: "Ele sai da lista principal de todos os membros. Nada é apagado, e você pode desarquivar quando quiser.",
                ConfirmLabel: "Arquivar workspace"))))
        {
            return;
        }

        if (!await StillAdminAsync())
        {
            return;
        }


        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Workspaces.Where(w => w.Id == WorkspaceId)
                .ExecuteUpdateAsync(s => s.SetProperty(w => w.IsArchived, newValue));
        }

        workspace.IsArchived = newValue;
        Toasts.Show(newValue ? "Workspace arquivado" : "Workspace desarquivado");
    }

    private class GeneralModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public string Color { get; set; } = WorkspaceColors.Default;
    }
}
