@page "/workspaces/{WorkspaceId:guid}/settings"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext

<PageTitle>Configurações — @(workspace?.Name ?? "Workspace")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Workspace não encontrado ou você não tem acesso a ele.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (workspace is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a> /
            Configurações
        </div>
        <div class="page-header">
            <h1>Configurações</h1>
        </div>

        <div class="settings-layout">
            <nav class="settings-nav">
                <button type="button" class="settings-nav-link @(tab == "geral" ? "active" : "")" @onclick='() => tab = "geral"'>Geral</button>
                <button type="button" class="settings-nav-link @(tab == "workflow" ? "active" : "")" @onclick='() => tab = "workflow"'>Fluxo de Trabalho</button>
            </nav>

            <div class="settings-content" style="max-width:640px;">
                @if (tab == "geral")
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert alert-success">@statusMessage</div>
                    }

                    <EditForm Model="generalModel" OnValidSubmit="HandleSaveGeneral" class="card" style="margin-bottom:1.5rem;">
                        <DataAnnotationsValidator />
                        <div class="form-field">
                            <label for="ws-name">Nome do workspace</label>
                            <InputText id="ws-name" @bind-Value="generalModel.Name" />
                            <ValidationMessage For="() => generalModel.Name" />
                        </div>
                        <div class="form-field">
                            <label>Cor de identificação</label>
                            <div class="color-swatch-row">
                                @foreach (var color in AvailableColors)
                                {
                                    <button type="button" class="color-swatch @(generalModel.Color == color ? "is-selected" : "")"
                                            style="background:@color;" @onclick="() => generalModel.Color = color"
                                            aria-label="Selecionar cor @color"></button>
                                }
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn" disabled="@isSaving">Salvar alterações</button>
                        </div>
                    </EditForm>

                    <div class="card">
                        <h3 style="margin-top:0;">Zona de risco</h3>
                        @if (workspace.IsArchived)
                        {
                            <p style="color:var(--color-text-muted);">Este workspace está arquivado — ele fica oculto da lista principal, mas nada foi apagado.</p>
                            <button type="button" class="btn btn-secondary" @onclick="HandleToggleArchive">Desarquivar workspace</button>
                        }
                        else
                        {
                            <p style="color:var(--color-text-muted);">Arquivar oculta este workspace da lista principal sem apagar nada. Você pode desarquivar quando quiser.</p>
                            <button type="button" class="btn btn-danger" @onclick="HandleToggleArchive">Arquivar workspace</button>
                        }
                    </div>
                }
                else
                {
                    <p style="color:var(--color-text-muted); margin-top:-0.5rem;">Cada lista tem seu próprio fluxo de colunas. Escolha uma lista abaixo pra configurar o workflow dela.</p>

                    @if (spaces is null)
                    {
                        <p>Carregando...</p>
                    }
                    else if (spaces.Count == 0)
                    {
                        <div class="empty-state"><p>Nenhum space criado ainda.</p></div>
                    }
                    else
                    {
                        @foreach (var space in spaces)
                        {
                            <h4 style="margin-bottom:0.5rem;">@space.Name</h4>
                            @if (space.Lists.Count == 0)
                            {
                                <p class="topnav-user" style="margin-bottom:1rem;">Nenhuma lista neste space.</p>
                            }
                            else
                            {
                                <div class="table-scroll" style="margin-bottom:1.5rem;">
                                    <table class="data-table">
                                        <tbody>
                                            @foreach (var list in space.Lists)
                                            {
                                                <tr>
                                                    <td>@list.Name</td>
                                                    <td style="text-align:right;">
                                                        <a class="btn-link" href="@($"/lists/{list.Id}/workflow")">Configurar workflow →</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] AvailableColors = ["#2563EB", "#16A34A", "#7C3AED", "#DC2626", "#EA580C", "#0D9488"];

    private Workspace? workspace;
    private List<Space>? spaces;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private string? statusMessage;
    private string tab = "geral";
    private readonly GeneralModel generalModel = new();
    private Guid? loadedWorkspaceId;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId) return;
        loadedWorkspaceId = WorkspaceId;

        notFound = false;
        workspace = null;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        generalModel.Name = workspace.Name;
        generalModel.Color = workspace.Color ?? AvailableColors[0];

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            spaces = await db.Spaces
                .Where(s => s.WorkspaceId == WorkspaceId)
                .Include(s => s.Lists)
                .OrderBy(s => s.SortOrder)
                .ThenBy(s => s.Name)
                .ToListAsync();
        }
    }

    // Re-checks Admin at the moment of the write instead of trusting the decision made when the
    // page loaded. This circuit stays alive for as long as the tab is open — long enough for an
    // Owner to have demoted or removed this user — and archiving a workspace hides it from
    // everyone who uses it. See WorkspaceAccessGuard.
    private async Task<bool> StillAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        notFound = true;
        return false;
    }

    private async Task HandleSaveGeneral()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        var newName = generalModel.Name.Trim();

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Workspaces.Where(w => w.Id == WorkspaceId)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(w => w.Name, newName)
                    .SetProperty(w => w.Color, generalModel.Color));
        }

        workspace!.Name = newName;
        workspace.Color = generalModel.Color;
        NavContext.SetWorkspace(WorkspaceId, newName);
        NavContext.Refresh();

        isSaving = false;
        statusMessage = "Alterações salvas.";
    }

    private async Task HandleToggleArchive()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        var newValue = !workspace!.IsArchived;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Workspaces.Where(w => w.Id == WorkspaceId)
                .ExecuteUpdateAsync(s => s.SetProperty(w => w.IsArchived, newValue));
        }

        workspace.IsArchived = newValue;
        statusMessage = newValue ? "Workspace arquivado." : "Workspace desarquivado.";
    }

    private class GeneralModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public string Color { get; set; } = "#2563EB";
    }
}
