@page "/workspaces/{WorkspaceId:guid}/settings"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Nexus.Web.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext
@inject ToastService Toasts
@inject WorkspacePlanService PlanService
@inject Nexus.Web.Services.Billing.BillingService Billing

<PageTitle>Configurações · @(workspace?.Name ?? "Workspace") · Nexus</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Sem acesso às configurações"
                    Description="Só administradores do workspace podem alterar as configurações dele.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (workspace is null)
    {
        <Skeleton Variant="text" Count="6" Label="Carregando configurações…" />
    }
    else
    {
        <PageHeader Title="@workspace.Name">
            <Breadcrumbs>
                <a href="/workspaces">Workspaces</a>
            </Breadcrumbs>
        </PageHeader>

        <WorkspaceTabs WorkspaceId="WorkspaceId" Active="settings" CanManage="true" />

        <div class="settings-layout">
            <nav class="settings-nav" aria-label="Seções das configurações">
                <button type="button" class="settings-nav-link @(tab == "geral" ? "active" : "")" aria-current="@(tab == "geral" ? "true" : null)" @onclick='() => tab = "geral"'><Icon Name="settings" /> Geral</button>
                <button type="button" class="settings-nav-link @(tab == "workflow" ? "active" : "")" aria-current="@(tab == "workflow" ? "true" : null)" @onclick='() => tab = "workflow"'><Icon Name="refresh" /> Fluxo de trabalho</button>
            </nav>

            <div class="settings-content">
                @if (tab == "geral")
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
                    }

                    <EditForm Model="generalModel" OnValidSubmit="HandleSaveGeneral" class="card form-card">
                        <DataAnnotationsValidator />
                        <h2 class="form-section-title">Identidade</h2>
                        <p class="form-section-description">Nome e cor aparecem para todos os membros, na barra lateral e nos convites.</p>
                        <div class="identity-row">
                            <Avatar Name="@(string.IsNullOrWhiteSpace(generalModel.Name) ? "?" : generalModel.Name)" Color="@generalModel.Color" Size="xl" Square="true" />
                            <div class="identity-fields">
                                <div class="form-field">
                                    <label for="ws-name" class="required">Nome do workspace</label>
                                    <InputText id="ws-name" @bind-Value="generalModel.Name" @bind-Value:after="() => generalModel.Name = generalModel.Name.Trim()"
                                               @oninput="e => generalModel.Name = e.Value?.ToString() ?? string.Empty" />
                                    <ValidationMessage For="() => generalModel.Name" />
                                </div>
                                <fieldset class="form-fieldset">
                                    <legend class="field-label">Cor</legend>
                                    <div class="color-swatch-row">
                                        @foreach (var (color, colorName) in AvailableColors)
                                        {
                                            <button type="button" class="color-swatch @(generalModel.Color == color ? "is-selected" : "")"
                                                    style="background:@color;" @onclick="() => generalModel.Color = color"
                                                    aria-pressed="@(generalModel.Color == color ? "true" : "false")" aria-label="@colorName"></button>
                                        }
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                        <div class="form-actions form-actions--end">
                            <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving">Salvar alterações</button>
                        </div>
                    </EditForm>

                    @if (plan is not null)
                    {
                        <section class="card" aria-labelledby="plan-title">
                            <h2 id="plan-title" class="form-section-title">Plano <span class="badge badge--accent">@PlanName(plan.EffectivePlan)</span></h2>
                            <p class="form-section-description">
                                @if (plan.OwnedByUnlimitedAccount)
                                {
                                    @("O dono deste workspace é uma conta sem limites: todos os recursos estão liberados, sem depender de plano.")
                                }
                                else if (Billing.IsEnabled)
                                {
                                    @($"No plano Pro: membros sem limite, sprints, Gantt e burndown. {Nexus.Web.Services.Billing.BillingService.ProBasePrice} por mês com até {Nexus.Web.Services.Billing.BillingService.ProIncludedSeats} pessoas, e {Nexus.Web.Services.Billing.BillingService.ProExtraSeatPrice} por pessoa a mais.")
                                }
                                else
                                {
                                    @("Durante o lançamento, todos os recursos estão liberados. A troca de plano estará disponível em breve.")
                                }
                            </p>
                            @if (Assinatura == "ok" && plan.EffectivePlan == WorkspacePlan.Starter)
                            {
                                <div class="alert alert-info" role="status"><Icon Name="info" /> <span>Pagamento recebido. O plano Pro aparece aqui assim que o Stripe confirmar, em poucos segundos — recarregue a página se ainda não mudou.</span></div>
                            }
                            @if (!string.IsNullOrEmpty(billingError))
                            {
                                <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@billingError</span></div>
                            }
                            <ul class="plan-summary">
                                <li><Icon Name="team" Class="icon--sm" /> @memberCount @(memberCount == 1 ? "membro" : "membros")@(plan.Capabilities.MaxMembers is { } max ? $" de {max} no plano" : "")</li>
                                <li><Icon Name="@(plan.Capabilities.IncludesSprintsGanttAndBurndown ? "check" : "lock")" Class="icon--sm" /> Sprints, Gantt e burndown @(plan.Capabilities.IncludesSprintsGanttAndBurndown ? "incluídos" : "no plano Pro")</li>
                            </ul>
                            @if (CanSubscribe)
                            {
                                <div class="form-actions">
                                    <button type="button" class="btn @(isStartingCheckout ? "is-loading" : "")" disabled="@isStartingCheckout" @onclick="StartCheckoutAsync">
                                        Assinar o Pro
                                    </button>
                                </div>
                            }
                        </section>
                    }

                    <section class="card danger-zone" aria-labelledby="danger-zone-title">
                        <h2 id="danger-zone-title" class="form-section-title">@(workspace.IsArchived ? "Workspace arquivado" : "Arquivar workspace")</h2>
                        <div class="danger-zone-row">
                            <p class="form-section-description">
                                @if (workspace.IsArchived)
                                {
                                    @("Ele está fora da lista principal, mas nada foi apagado. Desarquive para voltar a usá-lo normalmente.")
                                }
                                else
                                {
                                    @("Arquivar tira o workspace da lista principal de todos os membros. Nada é apagado e dá para desarquivar a qualquer momento.")
                                }
                            </p>
                            <button type="button" class="btn @(workspace.IsArchived ? "btn-secondary" : "btn-danger-ghost btn-bordered-danger")" @onclick="HandleToggleArchive">
                                <Icon Name="@(workspace.IsArchived ? "refresh" : "inbox")" />
                                @(workspace.IsArchived ? "Desarquivar" : "Arquivar workspace")
                            </button>
                        </div>
                    </section>
                }
                else
                {
                    <p class="form-section-description">Cada lista tem suas próprias colunas de status e regras de transição. Escolha uma lista para configurar o fluxo dela.</p>

                    @if (spaces is null)
                    {
                        <Skeleton Count="4" />
                    }
                    else if (spaces.Count == 0)
                    {
                        <div class="card">
                            <EmptyState Compact="true" Title="Nenhum space criado ainda" Description="Crie um space e uma lista na visão geral do workspace." />
                        </div>
                    }
                    else
                    {
                        @foreach (var space in spaces)
                        {
                            <section class="section" aria-label="@space.Name">
                                <h3 class="section-title settings-space-title"><Icon Name="space" Class="icon--sm" /> @space.Name</h3>
                                @if (space.Lists.Count == 0)
                                {
                                    <p class="cell-muted">Nenhuma lista neste space.</p>
                                }
                                else
                                {
                                    <ul class="space-list">
                                        @foreach (var list in space.Lists.OrderBy(l => l.SortOrder))
                                        {
                                            <li>
                                                <a class="space-item space-item--compact" href="@($"/lists/{list.Id}/workflow")">
                                                    <span class="space-item-body"><span class="space-item-name">@list.Name</span></span>
                                                    <span class="space-item-meta">Configurar fluxo</span>
                                                    <Icon Name="chevron-right" Class="space-item-chevron" />
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        }
                    }
                }
            </div>
        </div>

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (string Hex, string Name)[] AvailableColors = WorkspaceColors.Options;
    private ConfirmDialog? confirm;

    private Workspace? workspace;
    private List<Space>? spaces;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private string tab = "geral";
    private readonly GeneralModel generalModel = new();
    private Guid? loadedWorkspaceId;
    private WorkspacePlanInfo? plan;
    private int memberCount;
    private bool isOwner;
    private bool isStartingCheckout;
    private string? billingError;

    // Back from Stripe Checkout (?assinatura=ok). Says nothing about the payment: the plan only
    // changes when Stripe's webhook confirms it.
    [SupplyParameterFromQuery]
    public string? Assinatura { get; set; }

    private bool CanSubscribe =>
        Billing.IsEnabled && isOwner && plan is { EffectivePlan: WorkspacePlan.Starter, OwnedByUnlimitedAccount: false };

    private async Task StartCheckoutAsync()
    {
        isStartingCheckout = true;
        billingError = null;

        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var start = userId is null
            ? new Nexus.Web.Services.Billing.CheckoutStart(null, "Entre de novo para assinar.")
            : await Billing.StartCheckoutAsync(WorkspaceId, userId);

        if (start.Url is not null)
        {
            NavigationManager.NavigateTo(start.Url, forceLoad: true);
            return;
        }

        billingError = start.Error;
        isStartingCheckout = false;
    }

    private static string PlanName(WorkspacePlan p) => p switch
    {
        WorkspacePlan.Pro => "Pro",
        WorkspacePlan.Business => "Business",
        _ => "Starter"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWorkspaceId == WorkspaceId) return;
        loadedWorkspaceId = WorkspaceId;

        notFound = false;
        workspace = null;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }

        if (workspace is null)
        {
            notFound = true;
            return;
        }

        generalModel.Name = workspace.Name;
        generalModel.Color = workspace.Color ?? WorkspaceColors.Default;

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        plan = await PlanService.GetAsync(WorkspaceId);
        isOwner = (await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Owner))).Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            memberCount = await db.WorkspaceMembers.CountAsync(m => m.WorkspaceId == WorkspaceId);

            spaces = await db.Spaces
                .Where(s => s.WorkspaceId == WorkspaceId)
                .Include(s => s.Lists)
                .OrderBy(s => s.SortOrder)
                .ThenBy(s => s.Name)
                .ToListAsync();
        }
    }

    // Re-checks Admin at the moment of the write instead of trusting the decision made when the
    // page loaded. This circuit stays alive for as long as the tab is open — long enough for an
    // Owner to have demoted or removed this user — and archiving a workspace hides it from
    // everyone who uses it. See WorkspaceAccessGuard.
    private async Task<bool> StillAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        notFound = true;
        return false;
    }

    private async Task HandleSaveGeneral()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        var newName = generalModel.Name.Trim();

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Workspaces.Where(w => w.Id == WorkspaceId)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(w => w.Name, newName)
                    .SetProperty(w => w.Color, generalModel.Color));
        }

        workspace!.Name = newName;
        workspace.Color = generalModel.Color;
        NavContext.SetWorkspace(WorkspaceId, newName);
        NavContext.Refresh();

        isSaving = false;
        Toasts.Show("Alterações salvas");
    }

    private async Task HandleToggleArchive()
    {
        var newValue = !workspace!.IsArchived;
        if (newValue && (confirm is null || !await confirm.AskAsync(new ConfirmRequest(
                Title: $"Arquivar \"{workspace.Name}\"?",
                Message: "Ele sai da lista principal de todos os membros. Nada é apagado, e você pode desarquivar quando quiser.",
                ConfirmLabel: "Arquivar workspace"))))
        {
            return;
        }

        if (!await StillAdminAsync())
        {
            return;
        }


        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.Workspaces.Where(w => w.Id == WorkspaceId)
                .ExecuteUpdateAsync(s => s.SetProperty(w => w.IsArchived, newValue));
        }

        workspace.IsArchived = newValue;
        Toasts.Show(newValue ? "Workspace arquivado" : "Workspace desarquivado");
    }

    private class GeneralModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public string Color { get; set; } = WorkspaceColors.Default;
    }
}
