@page "/workspaces/{WorkspaceId:guid}/docs/novo"
@page "/workspaces/{WorkspaceId:guid}/docs/{DocId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AttachmentStorageService Storage
@inject ToastService Toasts

<PageTitle>@(doc?.Title ?? "Novo documento") · Nexus</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="doc" Title="Documento não encontrado"
                    Description="Ele pode ter sido excluído, ou você não tem mais acesso ao workspace dele.">
            <a class="btn btn-secondary" href="@($"/workspaces/{WorkspaceId}/docs")">Ver documentos</a>
        </EmptyState>
    }
    else if (workspace is null)
    {
        <Skeleton Variant="text" Count="8" Label="Carregando documento…" />
    }
    else
    {
        <nav class="breadcrumbs" aria-label="Você está em">
            <a href="/workspaces">Workspaces</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a href="@($"/workspaces/{WorkspaceId}/docs")">Documentos</a>
        </nav>

        @if (isEditing)
        {
            <div class="doc-edit">
                <label for="doc-title" class="sr-only">Título do documento</label>
                <input id="doc-title" class="doc-title-input" type="text" @bind="titleInput" placeholder="Sem título" autofocus />
                <div id="@editorElementId" class="doc-editor"></div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
                }
                <div class="doc-edit-bar">
                    <p class="field-hint"><Icon Name="info" Class="icon--sm" /> Se outra pessoa salvar este documento enquanto você edita, a versão salva por último é a que fica.</p>
                    <div class="button-row">
                        <button type="button" class="btn btn-ghost" @onclick="HandleCancel">Cancelar</button>
                        <button type="button" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving" @onclick="HandleSave">@(isCreating ? "Criar documento" : "Salvar")</button>
                    </div>
                </div>
            </div>
        }
        else if (doc is not null)
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
            }
            <div class="doc-layout">
                <article class="doc-article">
                    <header class="doc-header">
                        <h1 class="doc-title" tabindex="-1">@doc.Title</h1>
                        <div class="doc-header-row">
                            <p class="page-meta">
                                <span><Avatar Name="@AuthorLabel(doc.UpdatedByUser ?? doc.CreatedByUser)" Size="xs" /> @LastEditedLabel()</span>
                                <span>@WordCount() palavras</span>
                            </p>
                            <div class="button-row">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="EnterEditMode"><Icon Name="edit" /> Editar</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="icon-btn icon-btn--sm is-danger" @onclick="HandleDelete">
                                        <Icon Name="trash" Label="Excluir documento" />
                                    </button>
                                }
                            </div>
                        </div>
                    </header>
                    <div class="doc-content prose" id="doc-content">
                        @((MarkupString)(doc.ContentHtml ?? ""))
                    </div>
                </article>

                <aside class="doc-aside" aria-label="Sobre o documento">
                    @{ var outline = GetOutline(); }
                    @if (outline.Count > 1)
                    {
                        <nav class="doc-outline" aria-label="Sumário">
                            <h2 class="doc-aside-title">Nesta página</h2>
                            @for (var i = 0; i < outline.Count; i++)
                            {
                                var index = i;
                                var (level, text) = outline[i];
                                <button type="button" class="doc-outline-item doc-outline-item--@level" @onclick="() => ScrollToHeading(index)">@text</button>
                            }
                        </nav>
                    }
                    <dl class="doc-facts">
                        <div><dt>Criado por</dt><dd>@AuthorLabel(doc.CreatedByUser)</dd></div>
                        <div><dt>Criado em</dt><dd>@doc.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
                        @if (doc.UpdatedAtUtc is not null)
                        {
                            <div><dt>Última edição</dt><dd>@AuthorLabel(doc.UpdatedByUser), @doc.UpdatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</dd></div>
                        }
                        <div><dt>Quem vê</dt><dd>Todos do workspace</dd></div>
                    </dl>
                </aside>
            </div>
        }

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public Guid? DocId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Workspace? workspace;
    private DocPage? doc;
    private bool notFound;
    private bool isEditing;
    private bool isSaving;
    private bool editorMounted;
    private bool canDelete;
    private string? errorMessage;
    private ConfirmDialog? confirm;

    // O HTML do documento é sanitizado e não traz ids nos títulos; o sumário rola até o
    // N-ésimo h1–h3 do conteúdo.
    private async Task ScrollToHeading(int index) =>
        await JS.InvokeVoidAsync("nexusUi.scrollToHeading", "doc-content", index);
    private string titleInput = "";
    private string? userId;
    private (Guid WorkspaceId, Guid? DocId)? loaded;
    private readonly string editorElementId = "doc-editor-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? module;

    private bool isCreating => DocId is null;

    protected override async Task OnParametersSetAsync()
    {
        if (loaded == (WorkspaceId, DocId)) return;
        loaded = (WorkspaceId, DocId);

        // Navigating away mid-edit (e.g. clicking a sidebar link instead of Cancelar/Salvar)
        // must still tear down any live Quill instance — otherwise its toolbar is orphaned
        // in the DOM (Blazor never rendered it, so its own diff never removes it either).
        await DestroyEditorIfMountedAsync();

        notFound = false;
        workspace = null;
        doc = null;
        isEditing = false;
        isSaving = false;
        canDelete = false;
        errorMessage = null;

        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));
        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        var isAdmin = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }
        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        if (DocId is null)
        {
            titleInput = "";
            isEditing = true;
            return;
        }

        await using (var db2 = await DbFactory.CreateDbContextAsync())
        {
            doc = await db2.DocPages
                .Include(d => d.CreatedByUser)
                .Include(d => d.UpdatedByUser)
                .FirstOrDefaultAsync(d => d.Id == DocId && d.WorkspaceId == WorkspaceId);
        }

        if (doc is null)
        {
            notFound = true;
            return;
        }

        if (doc.Type == DocPageType.Spreadsheet)
        {
            // Stale/direct link to a spreadsheet under the text-doc route — send it to the
            // right editor instead of rendering the wrong one.
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/spreadsheets/{doc.Id}", replace: true);
            return;
        }

        if (doc.Type == DocPageType.File)
        {
            // A File page has no editor of its own — a direct link (e.g. from the docs
            // list) just downloads the imported file instead.
            NavigationManager.NavigateTo($"/doc-files/{doc.Id}/download", forceLoad: true);
            return;
        }

        canDelete = isAdmin || doc.CreatedByUserId == userId;
        titleInput = doc.Title;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isEditing && !editorMounted)
        {
            // Set before awaiting: if another render triggers OnAfterRenderAsync again while
            // the JS calls below are still in flight, this closes the window where the guard
            // above would still see editorMounted == false and mount a second Quill toolbar.
            editorMounted = true;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/doc-editor-interop.js");
            await module.InvokeVoidAsync("initEditor", editorElementId, doc?.ContentHtml);
        }
    }

    private void EnterEditMode()
    {
        titleInput = doc!.Title;
        isEditing = true;
    }

    private async Task DestroyEditorIfMountedAsync()
    {
        if (module is not null && editorMounted)
        {
            await module.InvokeVoidAsync("destroyEditor", editorElementId);
        }
        editorMounted = false;
    }

    // Covers the case OnParametersSetAsync's own cleanup call can't: navigating away to a
    // completely different route (not just a different DocId on this same route) tears
    // down the component directly, without OnParametersSetAsync ever running again — this
    // is the other half of the orphaned-Quill-toolbar fix, mirroring BoardColumn.razor's
    // DisposeAsync pattern for the same "JS-owned DOM outside Blazor's own render tree" issue.
    public async ValueTask DisposeAsync()
    {
        try
        {
            await DestroyEditorIfMountedAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (e.g. tab close) — nothing to clean up client-side.
        }
    }

    private async Task HandleCancel()
    {
        await DestroyEditorIfMountedAsync();

        if (isCreating)
        {
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs");
            return;
        }

        isEditing = false;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(titleInput))
        {
            errorMessage = "Informe um título.";
            return;
        }

        // Re-check membership at write time: this circuit may have been open since before the
        // user was removed from (or demoted in) the workspace. See WorkspaceAccessGuard.
        if (!await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Member))
        {
            errorMessage = "Você não tem mais acesso a este workspace.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        var rawHtml = module is null ? "" : await module.InvokeAsync<string>("getContent", editorElementId);
        var sanitized = HtmlContentSanitizer.Sanitize(rawHtml);

        // Checked server-side: the editor is a contenteditable surface with no maxlength, and the
        // content arrives over the SignalR circuit, which accepts messages up to 11 MB. Without
        // this the only limit was the database column, which had none either.
        if (sanitized.Length > DocPage.MaxContentHtmlLength)
        {
            errorMessage = $"O conteúdo excede o limite de {DocPage.MaxContentHtmlLength:N0} caracteres.";
            isSaving = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (isCreating)
        {
            var newDoc = new DocPage
            {
                Id = Guid.NewGuid(),
                WorkspaceId = WorkspaceId,
                Title = titleInput.Trim(),
                ContentHtml = sanitized,
                CreatedByUserId = userId,
                CreatedAtUtc = DateTime.UtcNow
            };
            db.DocPages.Add(newDoc);
            await db.SaveChangesAsync();

            await DestroyEditorIfMountedAsync();
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs/{newDoc.Id}");
            return;
        }

        // WorkspaceId is part of the predicate as well as the Id: the authorization above is
        // scoped to this workspace, so the row being written must be too.
        await db.DocPages
            .Where(d => d.Id == doc!.Id && d.WorkspaceId == WorkspaceId)
            .ExecuteUpdateAsync(s => s
                .SetProperty(d => d.Title, titleInput.Trim())
                .SetProperty(d => d.ContentHtml, sanitized)
                .SetProperty(d => d.UpdatedByUserId, userId)
                .SetProperty(d => d.UpdatedAtUtc, DateTime.UtcNow));

        await DestroyEditorIfMountedAsync();
        isSaving = false;
        isEditing = false;

        doc = await db.DocPages
            .Include(d => d.CreatedByUser)
            .Include(d => d.UpdatedByUser)
            .FirstOrDefaultAsync(d => d.Id == doc!.Id);
    }

    private List<(string Level, string Text)> GetOutline()
    {
        if (string.IsNullOrEmpty(doc?.ContentHtml))
        {
            return [];
        }

        var results = new List<(string, string)>();
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(
            doc.ContentHtml, @"<h([1-3])[^>]*>(.*?)</h\1>", System.Text.RegularExpressions.RegexOptions.Singleline))
        {
            var text = System.Text.RegularExpressions.Regex.Replace(m.Groups[2].Value, "<[^>]+>", "").Trim();
            if (text.Length > 0)
            {
                results.Add(("h" + m.Groups[1].Value, System.Net.WebUtility.HtmlDecode(text)));
            }
        }

        return results;
    }

    private int WordCount()
    {
        if (string.IsNullOrEmpty(doc?.ContentHtml))
        {
            return 0;
        }

        var plain = System.Text.RegularExpressions.Regex.Replace(doc.ContentHtml, "<[^>]+>", " ");
        return plain.Split(' ', '\n', '\r', '\t').Count(w => w.Trim().Length > 0);
    }

    private string LastEditedLabel()
    {
        if (doc is null)
        {
            return "";
        }

        var when = doc.UpdatedAtUtc ?? doc.CreatedAtUtc;
        var who = AuthorLabel(doc.UpdatedByUser ?? doc.CreatedByUser);
        var delta = DateTime.UtcNow - when;

        var whenLabel = delta.TotalMinutes < 1 ? "agora mesmo"
            : delta.TotalMinutes < 60 ? $"há {(int)delta.TotalMinutes} min"
            : delta.TotalHours < 24 ? $"há {(int)delta.TotalHours}h"
            : $"em {when.ToLocalTime():dd/MM/yyyy}";

        return $"Editado {whenLabel} por {who}";
    }

    private static string AuthorLabel(ApplicationUser? user)
    {
        if (user is null)
        {
            return "—";
        }

        return string.IsNullOrEmpty(user.DisplayName) ? user.Email ?? "—" : user.DisplayName;
    }

    private async Task HandleDelete()
    {
        if (!canDelete || doc is null)
        {
            return;
        }

        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("documento", doc.Title,
                "O conteúdo é apagado para todo o workspace, e mensagens do chat que citam o documento perdem o link.")))
        {
            return;
        }

        // Autor pode excluir o próprio documento; os demais precisam ser admin AGORA, não só
        // quando a página abriu (ver WorkspaceAccessGuard).
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var required = doc.CreatedByUserId == userId ? WorkspaceRole.Member : WorkspaceRole.Admin;
        if (!await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, required))
        {
            errorMessage = "Você não tem mais permissão para excluir este documento.";
            canDelete = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // ReferencedDocPageId is Restrict (not SetNull, to avoid a second cascade path from
        // Workspace) — clear any chat messages pointing here first, or the delete below fails.
        await db.ChatMessages
            .Where(m => m.ReferencedDocPageId == doc.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(m => m.ReferencedDocPageId, (Guid?)null));

        await db.DocPages.Where(d => d.Id == doc.Id).ExecuteDeleteAsync();

        if (doc.Type == DocPageType.File && doc.FileStoragePath is not null)
        {
            Storage.Delete(doc.FileStoragePath);
        }

        Toasts.Show("Documento excluído");
        NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs");
    }
}
