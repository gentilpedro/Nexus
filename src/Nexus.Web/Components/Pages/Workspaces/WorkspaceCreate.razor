@page "/workspaces/new"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Services
@using Nexus.Web.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkspaceInviteService InviteService
@inject NavigationManager NavigationManager

<PageTitle>Novo workspace · Nexus</PageTitle>

<div class="page-container">
    <PageHeader Title="Novo workspace" Description="Um espaço para o seu time organizar projetos, documentos e conversas. Você pode convidar pessoas agora ou depois.">
        <Breadcrumbs>
            <a href="/workspaces">Workspaces</a>
        </Breadcrumbs>
    </PageHeader>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
    }

    <EditForm Model="model" OnSubmit="HandleSubmit" class="card form-card">
        <DataAnnotationsValidator />

        <section class="form-section">
            <h2 class="form-section-title">Identidade</h2>
            <p class="form-section-description">O nome e a cor aparecem na barra lateral de todos os membros.</p>
            <div class="identity-row">
                <Avatar Name="@(string.IsNullOrWhiteSpace(model.Name) ? "?" : model.Name)" Color="@model.Color" Size="xl" Square="true" />
                <div class="identity-fields">
                    <div class="form-field">
                        <label for="name" class="required">Nome do workspace</label>
                        <InputText id="name" @bind-Value="model.Name" @bind-Value:event="oninput" placeholder="Ex.: Agência Norte, Time de Produto" autofocus />
                        <ValidationMessage For="() => model.Name" />
                    </div>
                    <fieldset class="form-fieldset">
                        <legend class="field-label">Cor</legend>
                        <div class="color-swatch-row">
                            @foreach (var (color, colorName) in AvailableColors)
                            {
                                <button type="button" class="color-swatch @(model.Color == color ? "is-selected" : "")"
                                        style="background:@color;" @onclick="() => model.Color = color"
                                        aria-pressed="@(model.Color == color ? "true" : "false")" aria-label="@colorName"></button>
                            }
                        </div>
                    </fieldset>
                </div>
            </div>
        </section>

        <section class="form-section">
            <h2 class="form-section-title">Convidar pessoas <span class="field-hint">(opcional)</span></h2>
            <p class="form-section-description">Cada pessoa recebe um convite por e-mail. Quem já tem conta entra direto; quem não tem cria uma e já cai no workspace.</p>

            <div class="invite-input-row">
                <div class="form-field">
                    <label for="invite-email" class="sr-only">E-mail para convidar</label>
                    <input id="invite-email" type="email" placeholder="nome@empresa.com.br" autocomplete="off"
                           @bind="inviteEmail" @bind:event="oninput"
                           aria-invalid="@(inviteError is null ? null : "true")" aria-describedby="invite-email-error" />
                </div>
                <button type="button" class="btn btn-secondary" @onclick="AddInvite"><Icon Name="plus" /> Adicionar</button>
            </div>
            <p id="invite-email-error" class="validation-message" role="alert">@inviteError</p>

            @if (pendingInvites.Count > 0)
            {
                <ul class="invite-chips" aria-label="Pessoas que serão convidadas">
                    @foreach (var email in pendingInvites)
                    {
                        <li class="invite-chip">
                            <Avatar Name="@email" Size="xs" />
                            <span>@email</span>
                            <button type="button" class="icon-btn icon-btn--sm" @onclick="() => pendingInvites.Remove(email)">
                                <Icon Name="x" Label="@($"Remover {email}")" />
                            </button>
                        </li>
                    }
                </ul>
            }

            @if (suggestions is { Count: > 0 })
            {
                var remaining = suggestions.Where(p => p.Email is not null && !pendingInvites.Contains(p.Email, StringComparer.OrdinalIgnoreCase)).ToList();
                @if (remaining.Count > 0)
                {
                    <div class="invite-suggestions">
                        <p class="field-label">Pessoas com quem você já trabalha</p>
                        <div class="invite-suggestion-row">
                            @foreach (var person in remaining)
                            {
                                <button type="button" class="invite-suggestion" @onclick="() => AddSuggestion(person.Email!)">
                                    <Avatar Name="@(person.DisplayName ?? person.Email!)" Size="xs" />
                                    <span>@(person.DisplayName ?? person.Email)</span>
                                    <Icon Name="plus" Class="icon--sm" />
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </section>

        <div class="form-actions form-actions--end">
            <a class="btn btn-ghost" href="/workspaces">Cancelar</a>
            <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving">
                Criar workspace@(pendingInvites.Count > 0 ? $" e convidar {pendingInvites.Count}" : "")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (string Hex, string Name)[] AvailableColors = WorkspaceColors.Options;

    private readonly CreateWorkspaceModel model = new() { Color = AvailableColors[0].Hex };
    private string? inviteError;
    private bool isSaving;
    private string? errorMessage;
    private string inviteEmail = "";
    private readonly List<string> pendingInvites = new();
    private List<ApplicationUser>? suggestions;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var myWorkspaceIds = await db.WorkspaceMembers.Where(m => m.UserId == userId).Select(m => m.WorkspaceId).ToListAsync();

        suggestions = await db.WorkspaceMembers
            .Where(m => myWorkspaceIds.Contains(m.WorkspaceId) && m.UserId != userId)
            .Select(m => m.User)
            .Distinct()
            .Take(5)
            .ToListAsync();
    }

    private void AddInvite()
    {
        var email = inviteEmail.Trim();
        inviteError = null;
        if (string.IsNullOrEmpty(email))
        {
            return;
        }

        if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email) || !email.Contains('.'))
        {
            inviteError = "Esse e-mail não parece válido. Confira e tente de novo.";
            return;
        }

        if (pendingInvites.Contains(email, StringComparer.OrdinalIgnoreCase))
        {
            inviteError = "Essa pessoa já está na lista.";
            return;
        }

        pendingInvites.Add(email);
        inviteEmail = "";
    }

    // Enter dentro do formulário o envia. Se ainda há um e-mail digitado no campo de convite,
    // a intenção é adicioná-lo à lista — não criar o workspace sem ele.
    private async Task HandleSubmit(EditContext context)
    {
        if (!string.IsNullOrWhiteSpace(inviteEmail))
        {
            AddInvite();
            return;
        }

        if (context.Validate())
        {
            await HandleCreate();
        }
    }

    private void AddSuggestion(string email)
    {
        if (!pendingInvites.Contains(email, StringComparer.OrdinalIgnoreCase))
        {
            pendingInvites.Add(email);
        }
    }

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "Informe um nome para o workspace.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

        await using var db = await DbFactory.CreateDbContextAsync();
        var slug = await GenerateUniqueSlugAsync(db, model.Name);

        var workspace = new Workspace
        {
            Id = Guid.NewGuid(),
            Name = model.Name.Trim(),
            Slug = slug,
            Color = model.Color,
            CreatedAtUtc = DateTime.UtcNow
        };

        workspace.Members.Add(new WorkspaceMember
        {
            Id = Guid.NewGuid(),
            WorkspaceId = workspace.Id,
            UserId = currentUserId,
            Role = WorkspaceRole.Owner,
            JoinedAtUtc = DateTime.UtcNow
        });

        db.Workspaces.Add(workspace);

        // Everyone listed here gets a pending invite, whether or not the address already has an
        // account — the only member created up front is the owner above. WorkspaceInviteService
        // writes the WorkspaceMember row only when the person accepts.
        var currentUserEmail = authState.User.FindFirstValue(ClaimTypes.Email);
        var inviteEmails = pendingInvites
            .Select(e => e.Trim())
            .Where(e => e.Length > 0 && !string.Equals(e, currentUserEmail, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        try
        {
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateException)
            {
                // Lost a race: another workspace grabbed the same generated slug between our
                // uniqueness check and this save. Regenerate against the now-current state and
                // retry once instead of just showing a generic error and dropping the user back
                // to a filled-in form.
                workspace.Slug = await GenerateUniqueSlugAsync(db, model.Name);
                await db.SaveChangesAsync();
            }

            foreach (var email in inviteEmails)
            {
                await InviteService.CreateAndSendAsync(workspace.Id, workspace.Name, email, WorkspaceRole.Member, currentUserId);
            }

            NavigationManager.NavigateTo($"/workspaces/{workspace.Id}");
        }
        catch (Exception)
        {
            errorMessage = "Não foi possível criar o workspace. Tente novamente.";
            isSaving = false;
        }
    }

    private static async Task<string> GenerateUniqueSlugAsync(AppDbContext db, string name)
    {
        var baseSlug = string.Concat(name.Trim().ToLowerInvariant()
                .Select(c => char.IsLetterOrDigit(c) ? c : '-'))
            .Trim('-');

        while (baseSlug.Contains("--"))
        {
            baseSlug = baseSlug.Replace("--", "-");
        }

        if (string.IsNullOrEmpty(baseSlug))
        {
            baseSlug = "workspace";
        }

        var slug = baseSlug;
        var suffix = 1;
        while (await db.Workspaces.AnyAsync(w => w.Slug == slug))
        {
            suffix++;
            slug = $"{baseSlug}-{suffix}";
        }

        return slug;
    }


    private class CreateWorkspaceModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public string Color { get; set; } = "#5B5CEB";
    }
}
