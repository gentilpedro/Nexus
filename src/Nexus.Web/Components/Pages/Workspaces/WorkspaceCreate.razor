@page "/workspaces/new"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkspaceInviteService InviteService
@inject NavigationManager NavigationManager

<PageTitle>Novo workspace</PageTitle>

<div class="page-container page-container--wide">
    <div class="breadcrumbs"><a href="/workspaces">Workspaces</a> / Novo workspace</div>
    <div class="page-header">
        <h1>Configurar novo workspace</h1>
    </div>
    <p style="color:var(--color-text-secondary); margin-top:-0.75rem; margin-bottom:1.5rem;">Crie um ambiente colaborativo para sua equipe e convide quem já vai trabalhar com você.</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="dashboard-layout">
        <div>
            <EditForm Model="model" OnValidSubmit="HandleCreate" class="card" style="margin-bottom:1rem;">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="name">Nome do workspace</label>
                    <InputText id="name" @bind-Value="model.Name" placeholder="Ex: Minha Empresa" />
                    <ValidationMessage For="() => model.Name" />
                    <span style="font-size:0.8rem;color:var(--color-text-muted);">Esse nome aparece na barra lateral para todos os membros.</span>
                </div>

                <div class="form-field">
                    <label>Cor de identificação</label>
                    <div class="color-swatch-row">
                        @foreach (var color in AvailableColors)
                        {
                            <button type="button" class="color-swatch @(model.Color == color ? "is-selected" : "")"
                                    style="background:@color;" @onclick="() => model.Color = color"
                                    aria-label="Selecionar cor @color"></button>
                        }
                    </div>
                </div>

                <label style="font-weight:600;display:block;margin:1rem 0 0.5rem;">Convidar membros</label>
                <p style="font-size:0.85rem;color:var(--color-text-muted);margin:0 0 0.75rem;">A pessoa recebe um convite por e-mail. Se já tiver conta, entra direto; se não tiver, cria uma e já entra no workspace.</p>
                <div class="form-row">
                    <input type="email" placeholder="email@exemplo.com" @bind="inviteEmail" @bind:event="oninput" style="flex:1;padding:0.5rem 0.65rem;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface);color:var(--color-text);" />
                    <button type="button" class="btn btn-secondary" @onclick="AddInvite">+ Adicionar</button>
                </div>
                @if (pendingInvites.Count > 0)
                {
                    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.75rem;">
                        @foreach (var email in pendingInvites)
                        {
                            <span class="label-chip label-chip--sm" style="background:var(--color-hover);color:var(--color-text);">
                                @email
                                <button type="button" class="chat-compose-pending-remove" @onclick="() => pendingInvites.Remove(email)">✕</button>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state" style="padding:1rem;">Nenhum membro adicionado ainda.</div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn" disabled="@isSaving">Criar workspace agora</button>
                    <a class="btn btn-secondary" href="/workspaces">Cancelar</a>
                </div>
            </EditForm>
        </div>

        <div>
            @if (suggestions is { Count: > 0 })
            {
                <div class="side-card">
                    <h2>Pessoas com quem você já trabalha</h2>
                    @foreach (var person in suggestions)
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;gap:0.5rem;min-width:0;">
                                <span class="dashboard-workspace-avatar" style="width:1.9rem;height:1.9rem;font-size:0.75rem;">@Initial(person.DisplayName ?? person.Email)</span>
                                <div style="min-width:0;">
                                    <div style="font-size:0.85rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(person.DisplayName ?? person.Email)</div>
                                    <div style="font-size:0.75rem;color:var(--color-text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@person.Email</div>
                                </div>
                            </div>
                            <button type="button" class="btn-link" @onclick="() => AddSuggestion(person.Email!)">+</button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] AvailableColors = ["#2563EB", "#16A34A", "#7C3AED", "#DC2626", "#EA580C", "#0D9488"];

    private readonly CreateWorkspaceModel model = new() { Color = AvailableColors[0] };
    private bool isSaving;
    private string? errorMessage;
    private string inviteEmail = "";
    private readonly List<string> pendingInvites = new();
    private List<ApplicationUser>? suggestions;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var myWorkspaceIds = await db.WorkspaceMembers.Where(m => m.UserId == userId).Select(m => m.WorkspaceId).ToListAsync();

        suggestions = await db.WorkspaceMembers
            .Where(m => myWorkspaceIds.Contains(m.WorkspaceId) && m.UserId != userId)
            .Select(m => m.User)
            .Distinct()
            .Take(5)
            .ToListAsync();
    }

    private void AddInvite()
    {
        var email = inviteEmail.Trim();
        if (string.IsNullOrEmpty(email) || pendingInvites.Contains(email, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        pendingInvites.Add(email);
        inviteEmail = "";
    }

    private void AddSuggestion(string email)
    {
        if (!pendingInvites.Contains(email, StringComparer.OrdinalIgnoreCase))
        {
            pendingInvites.Add(email);
        }
    }

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "Informe um nome para o workspace.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

        await using var db = await DbFactory.CreateDbContextAsync();
        var slug = await GenerateUniqueSlugAsync(db, model.Name);

        var workspace = new Workspace
        {
            Id = Guid.NewGuid(),
            Name = model.Name.Trim(),
            Slug = slug,
            Color = model.Color,
            CreatedAtUtc = DateTime.UtcNow
        };

        workspace.Members.Add(new WorkspaceMember
        {
            Id = Guid.NewGuid(),
            WorkspaceId = workspace.Id,
            UserId = currentUserId,
            Role = WorkspaceRole.Owner,
            JoinedAtUtc = DateTime.UtcNow
        });

        db.Workspaces.Add(workspace);

        var addedDirectlyEmails = new List<string>();
        var newInviteEmails = new List<string>();

        // One query for all invited addresses instead of one per address. The loop below used to
        // issue a separate FirstOrDefaultAsync per e-mail — a round trip each, on the critical
        // path of creating a workspace.
        var normalizedEmails = pendingInvites
            .Select(e => e.Trim().ToUpperInvariant())
            .Where(e => e.Length > 0)
            .Distinct()
            .ToList();

        var existingUsers = await db.Users
            .Where(u => u.NormalizedEmail != null && normalizedEmails.Contains(u.NormalizedEmail))
            .ToDictionaryAsync(u => u.NormalizedEmail!, u => u);

        foreach (var email in pendingInvites)
        {
            var normalized = email.Trim().ToUpperInvariant();
            if (!existingUsers.TryGetValue(normalized, out var user))
            {
                newInviteEmails.Add(email.Trim());
                continue;
            }
            if (user.Id == currentUserId)
            {
                continue;
            }

            workspace.Members.Add(new WorkspaceMember
            {
                Id = Guid.NewGuid(),
                WorkspaceId = workspace.Id,
                UserId = user.Id,
                Role = WorkspaceRole.Member,
                JoinedAtUtc = DateTime.UtcNow
            });
            addedDirectlyEmails.Add(user.Email!);
        }

        try
        {
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateException)
            {
                // Lost a race: another workspace grabbed the same generated slug between our
                // uniqueness check and this save. Regenerate against the now-current state and
                // retry once instead of just showing a generic error and dropping the user back
                // to a filled-in form.
                workspace.Slug = await GenerateUniqueSlugAsync(db, model.Name);
                await db.SaveChangesAsync();
            }

            foreach (var email in addedDirectlyEmails)
            {
                await InviteService.NotifyAddedAsync(email, workspace.Name, workspace.Id);
            }
            foreach (var email in newInviteEmails)
            {
                await InviteService.CreateAndSendAsync(workspace.Id, workspace.Name, email, WorkspaceRole.Member, currentUserId);
            }

            NavigationManager.NavigateTo($"/workspaces/{workspace.Id}");
        }
        catch (Exception)
        {
            errorMessage = "Não foi possível criar o workspace. Tente novamente.";
            isSaving = false;
        }
    }

    private static async Task<string> GenerateUniqueSlugAsync(AppDbContext db, string name)
    {
        var baseSlug = string.Concat(name.Trim().ToLowerInvariant()
                .Select(c => char.IsLetterOrDigit(c) ? c : '-'))
            .Trim('-');

        while (baseSlug.Contains("--"))
        {
            baseSlug = baseSlug.Replace("--", "-");
        }

        if (string.IsNullOrEmpty(baseSlug))
        {
            baseSlug = "workspace";
        }

        var slug = baseSlug;
        var suffix = 1;
        while (await db.Workspaces.AnyAsync(w => w.Slug == slug))
        {
            suffix++;
            slug = $"{baseSlug}-{suffix}";
        }

        return slug;
    }

    private static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private class CreateWorkspaceModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public string Color { get; set; } = "#2563EB";
    }
}
