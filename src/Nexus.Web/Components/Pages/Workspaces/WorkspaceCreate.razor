@page "/workspaces/new"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Services
@using Nexus.Web.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkspaceInviteService InviteService
@inject NavigationManager NavigationManager
@inject ILogger<WorkspaceCreate> Logger

<PageTitle>Novo workspace · Nexus</PageTitle>

<div class="page-container">
    <PageHeader Title="Novo workspace" Description="Um espaço para o seu time organizar projetos, documentos e conversas. Você pode convidar pessoas agora ou depois.">
        <Breadcrumbs>
            <a href="/workspaces">Workspaces</a>
        </Breadcrumbs>
    </PageHeader>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
    }

    <EditForm Model="model" OnSubmit="HandleSubmit" class="card form-card">
        <DataAnnotationsValidator />

        <section class="form-section">
            <h2 class="form-section-title">Identidade</h2>
            <p class="form-section-description">O nome e a cor aparecem na barra lateral de todos os membros.</p>
            <div class="identity-row">
                <Avatar Name="@(string.IsNullOrWhiteSpace(model.Name) ? "?" : model.Name)" Color="@model.Color" Size="xl" Square="true" />
                <div class="identity-fields">
                    <div class="form-field">
                        <label for="name" class="required">Nome do workspace</label>
                        <InputText id="name" @bind-Value="model.Name" @bind-Value:after="() => model.Name = model.Name.Trim()"
                                   @oninput="e => model.Name = e.Value?.ToString() ?? string.Empty" placeholder="Ex.: Agência Norte, Time de Produto" autofocus />
                        <ValidationMessage For="() => model.Name" />
                    </div>
                    <fieldset class="form-fieldset">
                        <legend class="field-label">Cor</legend>
                        <div class="color-swatch-row">
                            @foreach (var (color, colorName) in AvailableColors)
                            {
                                <button type="button" class="color-swatch @(model.Color == color ? "is-selected" : "")"
                                        style="background:@color;" @onclick="() => model.Color = color"
                                        aria-pressed="@(model.Color == color ? "true" : "false")" aria-label="@colorName"></button>
                            }
                        </div>
                    </fieldset>
                </div>
            </div>
        </section>

        <section class="form-section">
            <h2 class="form-section-title">Convidar pessoas <span class="field-hint">(opcional)</span></h2>
            <p class="form-section-description">Cada pessoa recebe um convite por e-mail. Quem já tem conta entra direto; quem não tem cria uma e já cai no workspace.</p>

            <div class="invite-input-row">
                <div class="form-field">
                    <label for="invite-email" class="sr-only">E-mails para convidar</label>
                    @* type="text", não "email": com type="email" o navegador barra o envio do formulário
                       inteiro quando o campo tem mais de um endereço — e aqui a ideia é poder colar vários. *@
                    <input id="invite-email" type="text" inputmode="email" placeholder="nome@empresa.com.br, outra@empresa.com.br" autocomplete="off"
                           @bind="inviteEmail" @bind:event="oninput"
                           aria-invalid="@(inviteError is null ? null : "true")" aria-describedby="invite-email-hint invite-email-error" />
                </div>
                <button type="button" class="btn btn-secondary" @onclick="() => AddInvites()"><Icon Name="plus" /> Adicionar</button>
            </div>
            <p id="invite-email-hint" class="field-hint invite-hint">Digite ou cole vários e-mails de uma vez, separados por vírgula, espaço ou linha.</p>
            <p id="invite-email-error" class="validation-message" role="alert">@inviteError</p>

            @if (pendingInvites.Count > 0)
            {
                <ul class="invite-chips" aria-label="Pessoas que serão convidadas">
                    @foreach (var email in pendingInvites)
                    {
                        var label = LabelFor(email);
                        <li class="invite-chip" @key="email">
                            <Avatar Name="@label" Size="xs" />
                            <span title="@email">@label</span>
                            <button type="button" class="icon-btn icon-btn--sm" @onclick="() => RemoveInvite(email)">
                                <Icon Name="x" Label="@($"Remover {label}")" />
                            </button>
                        </li>
                    }
                </ul>
            }

            @if (suggestions is { Count: > 0 })
            {
                <fieldset class="invite-suggestions form-fieldset">
                    <legend class="field-label">Pessoas com quem você já trabalha</legend>
                    <div class="invite-suggestion-row">
                        @foreach (var person in suggestions)
                        {
                            var selected = IsPending(person.Email);
                            <button type="button" class="invite-suggestion @(selected ? "is-selected" : "")" @key="person.Email"
                                    aria-pressed="@(selected ? "true" : "false")" @onclick="() => ToggleSuggestion(person.Email)">
                                <Avatar Name="@person.Label" Size="xs" />
                                <span>@person.Label</span>
                                <Icon Name="@(selected ? "check" : "plus")" Class="icon--sm" />
                            </button>
                        }
                    </div>
                </fieldset>
            }
        </section>

        <div class="form-actions form-actions--end">
            <a class="btn btn-ghost" href="/workspaces">Cancelar</a>
            <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving">
                Criar workspace@(pendingInvites.Count > 0 ? $" e convidar {pendingInvites.Count}" : "")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (string Hex, string Name)[] AvailableColors = WorkspaceColors.Options;
    private static readonly char[] EmailSeparators = [',', ';', ' ', '\t', '\r', '\n'];
    private const int MaxSuggestions = 30;

    private readonly CreateWorkspaceModel model = new() { Color = AvailableColors[0].Hex };
    private string? inviteError;
    private bool isSaving;
    private string? errorMessage;
    private string inviteEmail = "";
    private readonly List<string> pendingInvites = new();
    private List<InviteSuggestion>? suggestions;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var myWorkspaceIds = await db.WorkspaceMembers.Where(m => m.UserId == userId).Select(m => m.WorkspaceId).ToListAsync();

        var people = await db.WorkspaceMembers
            .Where(m => myWorkspaceIds.Contains(m.WorkspaceId) && m.UserId != userId && m.User.Email != null)
            .Select(m => new { m.User.Email, m.User.DisplayName })
            .Distinct()
            .OrderBy(p => p.DisplayName)
            .Take(MaxSuggestions)
            .ToListAsync();

        suggestions = people
            .Select(p => new InviteSuggestion(p.Email!, string.IsNullOrWhiteSpace(p.DisplayName) ? p.Email! : p.DisplayName))
            .ToList();
    }

    // Aceita um ou vários endereços de uma vez. Os válidos entram na lista, os repetidos são
    // ignorados sem erro, e só os inválidos ficam no campo, com a mensagem dizendo quais são.
    // Devolve false quando sobrou algum inválido.
    private bool AddInvites()
    {
        inviteError = null;
        var invalid = new List<string>();

        foreach (var email in inviteEmail.Split(EmailSeparators, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email) || !email.Contains('.'))
            {
                invalid.Add(email);
            }
            else if (!IsPending(email))
            {
                pendingInvites.Add(email);
            }
        }

        inviteEmail = string.Join(", ", invalid);
        if (invalid.Count == 0)
        {
            return true;
        }

        inviteError = invalid.Count == 1
            ? $"\"{invalid[0]}\" não parece um e-mail válido. Corrija ou apague para continuar."
            : $"Estes não parecem e-mails válidos: {string.Join(", ", invalid)}. Corrija ou apague para continuar.";
        return false;
    }

    // Enter dentro do formulário o envia. O que estiver digitado no campo de convite entra na lista
    // antes de criar; só um endereço inválido segura a criação, para não perder um convite em silêncio.
    private async Task HandleSubmit(EditContext context)
    {
        if (!string.IsNullOrWhiteSpace(inviteEmail) && !AddInvites())
        {
            return;
        }

        if (context.Validate())
        {
            await HandleCreate();
        }
    }

    private bool IsPending(string email) => pendingInvites.Contains(email, StringComparer.OrdinalIgnoreCase);

    private void RemoveInvite(string email) =>
        pendingInvites.RemoveAll(e => string.Equals(e, email, StringComparison.OrdinalIgnoreCase));

    private void ToggleSuggestion(string email)
    {
        if (IsPending(email))
        {
            RemoveInvite(email);
        }
        else
        {
            pendingInvites.Add(email);
        }
    }

    // Para quem já trabalha com você, o chip mostra o nome em vez do e-mail.
    private string LabelFor(string email) =>
        suggestions?.FirstOrDefault(p => string.Equals(p.Email, email, StringComparison.OrdinalIgnoreCase))?.Label ?? email;

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "Informe um nome para o workspace.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        var authState = await AuthStateTask!;
        var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

        await using var db = await DbFactory.CreateDbContextAsync();
        var slug = await GenerateUniqueSlugAsync(db, model.Name);

        var workspace = new Workspace
        {
            Id = Guid.NewGuid(),
            Name = model.Name.Trim(),
            Slug = slug,
            Color = model.Color,
            CreatedAtUtc = DateTime.UtcNow
        };

        workspace.Members.Add(new WorkspaceMember
        {
            Id = Guid.NewGuid(),
            WorkspaceId = workspace.Id,
            UserId = currentUserId,
            Role = WorkspaceRole.Owner,
            JoinedAtUtc = DateTime.UtcNow
        });

        db.Workspaces.Add(workspace);

        // Everyone listed here gets a pending invite, whether or not the address already has an
        // account — the only member created up front is the owner above. WorkspaceInviteService
        // writes the WorkspaceMember row only when the person accepts.
        var currentUserEmail = authState.User.FindFirstValue(ClaimTypes.Email);
        var inviteEmails = pendingInvites
            .Select(e => e.Trim())
            .Where(e => e.Length > 0 && !string.Equals(e, currentUserEmail, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        try
        {
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateException)
            {
                // Lost a race: another workspace grabbed the same generated slug between our
                // uniqueness check and this save. Regenerate against the now-current state and
                // retry once instead of just showing a generic error and dropping the user back
                // to a filled-in form.
                workspace.Slug = await GenerateUniqueSlugAsync(db, model.Name);
                await db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao criar workspace");
            errorMessage = "Não foi possível criar o workspace. Tente novamente.";
            isSaving = false;
            return;
        }

        // From here on the workspace exists: a failed invite must not surface as "could not create"
        // — retrying would create a duplicate workspace. Anyone left out can be re-invited from the
        // members page.
        foreach (var email in inviteEmails)
        {
            try
            {
                await InviteService.CreateAndSendAsync(workspace.Id, workspace.Name, email, WorkspaceRole.Member, currentUserId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Falha ao convidar um e-mail para o workspace {WorkspaceId}", workspace.Id);
            }
        }

        NavigationManager.NavigateTo($"/workspaces/{workspace.Id}");
    }

    private static async Task<string> GenerateUniqueSlugAsync(AppDbContext db, string name)
    {
        var baseSlug = string.Concat(name.Trim().ToLowerInvariant()
                .Select(c => char.IsLetterOrDigit(c) ? c : '-'))
            .Trim('-');

        while (baseSlug.Contains("--"))
        {
            baseSlug = baseSlug.Replace("--", "-");
        }

        if (string.IsNullOrEmpty(baseSlug))
        {
            baseSlug = "workspace";
        }

        var slug = baseSlug;
        var suffix = 1;
        while (await db.Workspaces.AnyAsync(w => w.Slug == slug))
        {
            suffix++;
            slug = $"{baseSlug}-{suffix}";
        }

        return slug;
    }

    private sealed record InviteSuggestion(string Email, string Label);

    private class CreateWorkspaceModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public string Color { get; set; } = "#5B5CEB";
    }
}
