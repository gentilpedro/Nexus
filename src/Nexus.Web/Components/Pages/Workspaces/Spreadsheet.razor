@page "/workspaces/{WorkspaceId:guid}/spreadsheets/nova"
@page "/workspaces/{WorkspaceId:guid}/spreadsheets/{DocId:guid}"
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext
@inject NavigationManager NavigationManager

<PageTitle>@(doc?.Title ?? "Nova planilha") · Nexus</PageTitle>

<div class="page-container page-container--full">
    @if (notFound)
    {
        <EmptyState Icon="sheet" Title="Planilha não encontrada"
                    Description="Ela pode ter sido excluída, ou você não tem mais acesso ao workspace dela.">
            <a class="btn btn-secondary" href="@($"/workspaces/{WorkspaceId}/docs")">Ver documentos</a>
        </EmptyState>
    }
    else if (workspace is null)
    {
        <Skeleton Count="8" Label="Carregando planilha…" />
    }
    else
    {
        <nav class="breadcrumbs" aria-label="Você está em">
            <a href="/workspaces">Workspaces</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a href="@($"/workspaces/{WorkspaceId}/docs")">Documentos</a>
        </nav>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
        }

        @if (isEditing)
        {
            <label for="sheet-title" class="sr-only">Título da planilha</label>
            <input id="sheet-title" class="doc-title-input" type="text" @bind="titleInput" placeholder="Planilha sem título" autofocus />

            <div class="spreadsheet-toolbar" role="toolbar" aria-label="Estrutura da planilha">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="AddRow"><Icon Name="plus" /> Linha</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="AddColumn"><Icon Name="plus" /> Coluna</button>
                <span class="toolbar-separator" aria-hidden="true"></span>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="RemoveRow" disabled="@(grid.Count <= 1)">Remover última linha</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="RemoveColumn" disabled="@(grid.Count == 0 || grid[0].Count <= 1)">Remover última coluna</button>
                <span class="spreadsheet-size">@grid.Count × @(grid.Count > 0 ? grid[0].Count : 0)</span>
            </div>

            <div class="table-scroll spreadsheet-scroll">
                <table class="spreadsheet-grid">
                    <thead>
                        <tr>
                            <th class="spreadsheet-corner" aria-hidden="true"></th>
                            @for (var c = 0; c < (grid.Count > 0 ? grid[0].Count : 0); c++)
                            {
                                <th scope="col">@ColumnName(c)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var r = 0; r < grid.Count; r++)
                        {
                            var row = r;
                            <tr>
                                <th scope="row">@(row + 1)</th>
                                @for (var c = 0; c < grid[row].Count; c++)
                                {
                                    var col = c;
                                    <td>
                                        <input type="text" value="@grid[row][col]" aria-label="@($"Célula {ColumnName(col)}{row + 1}")"
                                               @onchange="@(e => grid[row][col] = e.Value?.ToString() ?? "")" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="doc-edit-bar">
                <p class="field-hint"><Icon Name="info" Class="icon--sm" /> Se outra pessoa salvar esta planilha enquanto você edita, a versão salva por último é a que fica.</p>
                <div class="button-row">
                    <button type="button" class="btn btn-ghost" @onclick="HandleCancel">Cancelar</button>
                    <button type="button" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving" @onclick="HandleSave">@(isCreating ? "Criar planilha" : "Salvar")</button>
                </div>
            </div>
        }
        else if (doc is not null)
        {
            <PageHeader Title="@doc.Title">
                <Details>
                    <span><Icon Name="sheet" Class="icon--sm" /> @grid.Count linhas × @(grid.Count > 0 ? grid[0].Count : 0) colunas</span>
                </Details>
                <Actions>
                    @if (canDelete)
                    {
                        <button type="button" class="icon-btn icon-btn--bordered is-danger" @onclick="HandleDelete">
                            <Icon Name="trash" Label="Excluir planilha" />
                        </button>
                    }
                    <a class="btn btn-ghost" href="@($"/spreadsheets/{doc.Id}/download.xlsx")"><Icon Name="download" /> <span class="label-collapsible">Baixar .xlsx</span></a>
                    <button type="button" class="btn" @onclick="EnterEditMode"><Icon Name="edit" /> Editar</button>
                </Actions>
            </PageHeader>
            <div class="table-scroll spreadsheet-scroll">
                <table class="spreadsheet-grid spreadsheet-grid--readonly">
                    <thead>
                        <tr>
                            <th class="spreadsheet-corner" aria-hidden="true"></th>
                            @for (var c = 0; c < (grid.Count > 0 ? grid[0].Count : 0); c++)
                            {
                                <th scope="col">@ColumnName(c)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var r = 0; r < grid.Count; r++)
                        {
                            <tr>
                                <th scope="row">@(r + 1)</th>
                                @foreach (var cell in grid[r])
                                {
                                    <td title="@cell">@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public Guid? DocId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const int MaxRows = 50;
    private const int MaxColumns = 20;

    private Workspace? workspace;
    private DocPage? doc;
    private bool notFound;
    private bool isEditing;
    private bool isSaving;
    private bool canDelete;
    private string? errorMessage;
    private string titleInput = "";
    private string? userId;
    private (Guid WorkspaceId, Guid? DocId)? loaded;
    private List<List<string>> grid = [];

    private bool isCreating => DocId is null;

    protected override async Task OnParametersSetAsync()
    {
        if (loaded == (WorkspaceId, DocId)) return;
        loaded = (WorkspaceId, DocId);

        notFound = false;
        workspace = null;
        doc = null;
        isEditing = false;
        isSaving = false;
        canDelete = false;
        errorMessage = null;

        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));
        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        var isAdmin = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }
        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        if (DocId is null)
        {
            titleInput = "";
            grid = NewBlankGrid();
            isEditing = true;
            return;
        }

        await using (var db2 = await DbFactory.CreateDbContextAsync())
        {
            doc = await db2.DocPages.FirstOrDefaultAsync(d => d.Id == DocId && d.WorkspaceId == WorkspaceId);
        }

        if (doc is null)
        {
            notFound = true;
            return;
        }

        if (doc.Type != DocPageType.Spreadsheet)
        {
            // Stale/direct link to a text doc under the spreadsheet route — send it to the
            // right editor instead of rendering the wrong one.
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs/{doc.Id}", replace: true);
            return;
        }

        canDelete = isAdmin || doc.CreatedByUserId == userId;
        titleInput = doc.Title;
        grid = DeserializeGrid(doc.GridDataJson);
    }

    private static List<List<string>> NewBlankGrid() =>
        Enumerable.Range(0, 5).Select(_ => Enumerable.Range(0, 4).Select(_ => "").ToList()).ToList();

    private static List<List<string>> DeserializeGrid(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return NewBlankGrid();
        }

        try
        {
            return JsonSerializer.Deserialize<List<List<string>>>(json) ?? NewBlankGrid();
        }
        catch (JsonException)
        {
            return NewBlankGrid();
        }
    }

    private void AddRow()
    {
        if (grid.Count >= MaxRows) return;
        var columns = grid.Count > 0 ? grid[0].Count : 4;
        grid.Add(Enumerable.Range(0, columns).Select(_ => "").ToList());
    }

    private ConfirmDialog? confirm;

    // A, B, …, Z, AA, AB… — o cabeçalho que qualquer pessoa reconhece de uma planilha.
    private static string ColumnName(int index)
    {
        var name = "";
        index++;
        while (index > 0)
        {
            var rem = (index - 1) % 26;
            name = (char)('A' + rem) + name;
            index = (index - 1) / 26;
        }

        return name;
    }

    private void RemoveRow()
    {
        if (grid.Count > 1)
        {
            grid.RemoveAt(grid.Count - 1);
        }
    }

    private void AddColumn()
    {
        if (grid.Count > 0 && grid[0].Count >= MaxColumns) return;
        foreach (var row in grid)
        {
            row.Add("");
        }
    }

    private void RemoveColumn()
    {
        if (grid.Count > 0 && grid[0].Count > 1)
        {
            foreach (var row in grid)
            {
                row.RemoveAt(row.Count - 1);
            }
        }
    }

    private void EnterEditMode()
    {
        titleInput = doc!.Title;
        isEditing = true;
    }

    private void HandleCancel()
    {
        if (isCreating)
        {
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs");
            return;
        }

        grid = DeserializeGrid(doc!.GridDataJson);
        isEditing = false;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(titleInput))
        {
            errorMessage = "Informe um título.";
            return;
        }

        // Re-check membership at write time: this circuit may have been open since before the
        // user was removed from (or demoted in) the workspace. See WorkspaceAccessGuard.
        if (!await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, WorkspaceRole.Member))
        {
            errorMessage = "Você não tem mais acesso a este workspace.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        var gridJson = JsonSerializer.Serialize(grid);

        // Row and column counts are already capped by the UI, but individual cell contents were
        // not bounded at all, so the serialized payload could still grow without limit.
        if (gridJson.Length > DocPage.MaxGridDataJsonLength)
        {
            errorMessage = $"A planilha excede o limite de {DocPage.MaxGridDataJsonLength:N0} caracteres.";
            isSaving = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (isCreating)
        {
            var newDoc = new DocPage
            {
                Id = Guid.NewGuid(),
                WorkspaceId = WorkspaceId,
                Title = titleInput.Trim(),
                Type = DocPageType.Spreadsheet,
                GridDataJson = gridJson,
                CreatedByUserId = userId,
                CreatedAtUtc = DateTime.UtcNow
            };
            db.DocPages.Add(newDoc);
            await db.SaveChangesAsync();

            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/spreadsheets/{newDoc.Id}");
            return;
        }

        // WorkspaceId is part of the predicate as well as the Id: the authorization above is
        // scoped to this workspace, so the row being written must be too.
        await db.DocPages
            .Where(d => d.Id == doc!.Id && d.WorkspaceId == WorkspaceId)
            .ExecuteUpdateAsync(s => s
                .SetProperty(d => d.Title, titleInput.Trim())
                .SetProperty(d => d.GridDataJson, gridJson)
                .SetProperty(d => d.UpdatedByUserId, userId)
                .SetProperty(d => d.UpdatedAtUtc, DateTime.UtcNow));

        isSaving = false;
        isEditing = false;

        doc = await db.DocPages.FirstOrDefaultAsync(d => d.Id == doc!.Id);
    }

    private async Task HandleDelete()
    {
        if (!canDelete || doc is null)
        {
            return;
        }

        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("planilha", doc.Title,
                "Os dados são apagados para todo o workspace, e mensagens do chat que citam a planilha perdem o link.")))
        {
            return;
        }

        // Autor pode excluir a própria planilha; os demais precisam ser admin agora (ver WorkspaceAccessGuard).
        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var required = doc.CreatedByUserId == userId ? WorkspaceRole.Member : WorkspaceRole.Admin;
        if (!await AccessGuard.HasAccessAsync(AuthStateTask, WorkspaceId, required))
        {
            errorMessage = "Você não tem mais permissão para excluir esta planilha.";
            canDelete = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // ReferencedDocPageId is Restrict (not SetNull, to avoid a second cascade path from
        // Workspace) — clear any chat messages pointing here first, or the delete below fails.
        // Same fix as Doc.razor.HandleDelete; a spreadsheet is a DocPage too, so it can be
        // referenced from chat the same way a text doc can.
        await db.ChatMessages
            .Where(m => m.ReferencedDocPageId == doc.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(m => m.ReferencedDocPageId, (Guid?)null));

        await db.DocPages.Where(d => d.Id == doc.Id).ExecuteDeleteAsync();
        NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs");
    }
}
