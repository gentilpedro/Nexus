@page "/workspaces/{WorkspaceId:guid}/spreadsheets/nova"
@page "/workspaces/{WorkspaceId:guid}/spreadsheets/{DocId:guid}"
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext
@inject NavigationManager NavigationManager

<PageTitle>@(doc?.Title ?? "Nova planilha")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Planilha não encontrada ou você não tem acesso a ela.</p>
            <a class="btn" href="@($"/workspaces/{WorkspaceId}/docs")">Voltar</a>
        </div>
    }
    else if (workspace is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{WorkspaceId}")">@workspace.Name</a> /
            <a href="@($"/workspaces/{WorkspaceId}/docs")">Docs</a> /
            @(isCreating ? "Nova planilha" : doc?.Title)
        </div>

        @if (isEditing)
        {
            <div class="form-field">
                <label for="sheet-title">Título</label>
                <input id="sheet-title" type="text" @bind="titleInput" placeholder="Título da planilha" />
            </div>

            <div class="spreadsheet-toolbar">
                <button type="button" class="btn btn-secondary" @onclick="AddRow">+ Linha</button>
                <button type="button" class="btn btn-secondary" @onclick="RemoveRow">Remover linha</button>
                <button type="button" class="btn btn-secondary" @onclick="AddColumn">+ Coluna</button>
                <button type="button" class="btn btn-secondary" @onclick="RemoveColumn">Remover coluna</button>
            </div>

            <div class="table-scroll">
                <table class="spreadsheet-grid">
                    <tbody>
                        @for (var r = 0; r < grid.Count; r++)
                        {
                            var row = r;
                            <tr>
                                @for (var c = 0; c < grid[row].Count; c++)
                                {
                                    var col = c;
                                    <td>
                                        <input type="text" value="@grid[row][col]" @onchange="@(e => grid[row][col] = e.Value?.ToString() ?? "")" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            <div class="form-actions">
                <button type="button" class="btn" disabled="@isSaving" @onclick="HandleSave">Salvar</button>
                <button type="button" class="btn btn-secondary" @onclick="HandleCancel">Cancelar</button>
            </div>
        }
        else if (doc is not null)
        {
            <div class="page-header">
                <h1>@doc.Title <span class="coming-soon-badge" style="opacity:1;">Apenas leitura</span></h1>
                <div class="form-actions">
                    <a class="btn" href="@($"/spreadsheets/{doc.Id}/download.xlsx")">Baixar planilha (.xlsx)</a>
                    <button type="button" class="btn btn-secondary" @onclick="EnterEditMode">Editar</button>
                    @if (canDelete)
                    {
                        <button type="button" class="btn-link" @onclick="HandleDelete">Excluir</button>
                    }
                </div>
            </div>
            <p class="topnav-user" style="margin-top:-0.5rem;">@grid.Count linhas · @(grid.Count > 0 ? grid[0].Count : 0) colunas</p>
            <div class="table-scroll">
                <table class="spreadsheet-grid spreadsheet-grid--readonly">
                    <tbody>
                        @foreach (var row in grid)
                        {
                            <tr>
                                @foreach (var cell in row)
                                {
                                    <td>@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public Guid? DocId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const int MaxRows = 50;
    private const int MaxColumns = 20;

    private Workspace? workspace;
    private DocPage? doc;
    private bool notFound;
    private bool isEditing;
    private bool isSaving;
    private bool canDelete;
    private string? errorMessage;
    private string titleInput = "";
    private string? userId;
    private (Guid WorkspaceId, Guid? DocId)? loaded;
    private List<List<string>> grid = [];

    private bool isCreating => DocId is null;

    protected override async Task OnParametersSetAsync()
    {
        if (loaded == (WorkspaceId, DocId)) return;
        loaded = (WorkspaceId, DocId);

        notFound = false;
        workspace = null;
        doc = null;
        isEditing = false;
        isSaving = false;
        canDelete = false;
        errorMessage = null;

        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));
        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, WorkspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        var isAdmin = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            workspace = await db.Workspaces.FirstOrDefaultAsync(w => w.Id == WorkspaceId);
        }
        if (workspace is null)
        {
            notFound = true;
            return;
        }

        NavContext.SetWorkspace(WorkspaceId, workspace.Name);

        if (DocId is null)
        {
            titleInput = "";
            grid = NewBlankGrid();
            isEditing = true;
            return;
        }

        await using (var db2 = await DbFactory.CreateDbContextAsync())
        {
            doc = await db2.DocPages.FirstOrDefaultAsync(d => d.Id == DocId && d.WorkspaceId == WorkspaceId);
        }

        if (doc is null)
        {
            notFound = true;
            return;
        }

        if (doc.Type != DocPageType.Spreadsheet)
        {
            // Stale/direct link to a text doc under the spreadsheet route — send it to the
            // right editor instead of rendering the wrong one.
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs/{doc.Id}", replace: true);
            return;
        }

        canDelete = isAdmin || doc.CreatedByUserId == userId;
        titleInput = doc.Title;
        grid = DeserializeGrid(doc.GridDataJson);
    }

    private static List<List<string>> NewBlankGrid() =>
        Enumerable.Range(0, 5).Select(_ => Enumerable.Range(0, 4).Select(_ => "").ToList()).ToList();

    private static List<List<string>> DeserializeGrid(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return NewBlankGrid();
        }

        try
        {
            return JsonSerializer.Deserialize<List<List<string>>>(json) ?? NewBlankGrid();
        }
        catch (JsonException)
        {
            return NewBlankGrid();
        }
    }

    private void AddRow()
    {
        if (grid.Count >= MaxRows) return;
        var columns = grid.Count > 0 ? grid[0].Count : 4;
        grid.Add(Enumerable.Range(0, columns).Select(_ => "").ToList());
    }

    private void RemoveRow()
    {
        if (grid.Count > 1)
        {
            grid.RemoveAt(grid.Count - 1);
        }
    }

    private void AddColumn()
    {
        if (grid.Count > 0 && grid[0].Count >= MaxColumns) return;
        foreach (var row in grid)
        {
            row.Add("");
        }
    }

    private void RemoveColumn()
    {
        if (grid.Count > 0 && grid[0].Count > 1)
        {
            foreach (var row in grid)
            {
                row.RemoveAt(row.Count - 1);
            }
        }
    }

    private void EnterEditMode()
    {
        titleInput = doc!.Title;
        isEditing = true;
    }

    private void HandleCancel()
    {
        if (isCreating)
        {
            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs");
            return;
        }

        grid = DeserializeGrid(doc!.GridDataJson);
        isEditing = false;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(titleInput))
        {
            errorMessage = "Informe um título.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        var gridJson = JsonSerializer.Serialize(grid);

        await using var db = await DbFactory.CreateDbContextAsync();

        if (isCreating)
        {
            var newDoc = new DocPage
            {
                Id = Guid.NewGuid(),
                WorkspaceId = WorkspaceId,
                Title = titleInput.Trim(),
                Type = DocPageType.Spreadsheet,
                GridDataJson = gridJson,
                CreatedByUserId = userId,
                CreatedAtUtc = DateTime.UtcNow
            };
            db.DocPages.Add(newDoc);
            await db.SaveChangesAsync();

            NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/spreadsheets/{newDoc.Id}");
            return;
        }

        await db.DocPages
            .Where(d => d.Id == doc!.Id)
            .ExecuteUpdateAsync(s => s
                .SetProperty(d => d.Title, titleInput.Trim())
                .SetProperty(d => d.GridDataJson, gridJson)
                .SetProperty(d => d.UpdatedByUserId, userId)
                .SetProperty(d => d.UpdatedAtUtc, DateTime.UtcNow));

        isSaving = false;
        isEditing = false;

        doc = await db.DocPages.FirstOrDefaultAsync(d => d.Id == doc!.Id);
    }

    private async Task HandleDelete()
    {
        if (!canDelete || doc is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.DocPages.Where(d => d.Id == doc.Id).ExecuteDeleteAsync();
        NavigationManager.NavigateTo($"/workspaces/{WorkspaceId}/docs");
    }
}
