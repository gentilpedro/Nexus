@page "/convite/{Token}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Web.Services
@inject WorkspaceInviteService InviteService
@inject NavigationManager NavigationManager

<PageTitle>Convite para workspace · Nexus</PageTitle>

<div class="page-container centered-page">
    @if (invite is null)
    {
        <EmptyState Icon="mail" Title="Convite não encontrado"
                    Description="O link pode estar incompleto. Peça para quem te convidou enviar um novo." />
    }
    else if (invite.AcceptedAtUtc is not null)
    {
        <EmptyState Icon="check-circle" Title="Este convite já foi usado"
                    Description="Se foi você quem aceitou, é só entrar na sua conta.">
            <a class="btn" href="/Account/Login" data-enhance-nav="false">Entrar</a>
        </EmptyState>
    }
    else if (invite.ExpiresAtUtc <= DateTime.UtcNow)
    {
        <EmptyState Icon="clock" Title="Este convite expirou"
                    Description="Convites valem por tempo limitado. Peça para quem te convidou enviar um novo." />
    }
    else if (emailMismatch is not null)
    {
        <div class="card invite-card">
            <span class="dialog-icon is-danger" aria-hidden="true"><Icon Name="alert" /></span>
            <h1 class="invite-title">Este convite é para outro e-mail</h1>
            <p class="invite-text">
                O convite foi enviado para <strong>@invite.Email</strong>, mas você está conectado como <strong>@emailMismatch</strong>.
                Saia desta conta e entre — ou crie uma conta — com o e-mail convidado.
            </p>
        </div>
    }
    else
    {
        <div class="card invite-card">
            <Avatar Name="@invite.Workspace.Name" Color="@invite.Workspace.Color" Size="xl" Square="true" />
            <h1 class="invite-title">Entrar em <span>@invite.Workspace.Name</span></h1>
            <p class="invite-text">Você foi convidado para participar deste workspace no Nexus. O convite foi enviado para <strong>@invite.Email</strong>.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
            }

            @if (isAuthenticated)
            {
                <div class="invite-actions">
                    <button type="button" class="btn btn-lg btn-block @(isAccepting ? "is-loading" : "")" disabled="@isAccepting" @onclick="HandleAccept">Aceitar e entrar no workspace</button>
                    <a class="btn btn-ghost btn-block" href="/workspaces">Agora não</a>
                </div>
            }
            else
            {
                <div class="invite-actions">
                    <a class="btn btn-lg btn-block" href="@RegisterUrl" data-enhance-nav="false">Criar conta e entrar</a>
                    <a class="btn btn-secondary btn-block" href="@LoginUrl" data-enhance-nav="false">Já tenho conta</a>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string Token { get; set; } = "";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private WorkspaceInvite? invite;
    private string? emailMismatch;
    private string? errorMessage;
    private bool isAuthenticated;
    private bool isAccepting;

    private string ReturnUrl => $"/convite/{Token}";
    private string LoginUrl => NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl });
    // InviteToken (not the e-mail itself) so Register resolves the address server-side: a plain
    // ?email= parameter would let anyone sign up under an address they were never invited to.
    private string RegisterUrl => NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl, ["InviteToken"] = Token });

    protected override async Task OnInitializedAsync()
    {
        invite = await InviteService.GetAsync(Token);
        if (invite is null || invite.AcceptedAtUtc is not null || invite.ExpiresAtUtc <= DateTime.UtcNow)
        {
            return;
        }

        var authState = await AuthStateTask!;
        if (!(authState.User.Identity?.IsAuthenticated ?? false))
        {
            return;
        }

        isAuthenticated = true;

        // Being logged in is not consent — the membership is only created by HandleAccept below.
        // The mismatch check runs on load anyway so the person is told immediately that they are
        // signed in as the wrong account, instead of only after clicking Accept.
        var userEmail = authState.User.FindFirstValue(ClaimTypes.Email) ?? "";
        if (!string.Equals(invite.Email, userEmail, StringComparison.OrdinalIgnoreCase))
        {
            emailMismatch = userEmail;
        }
    }

    private async Task HandleAccept()
    {
        if (isAccepting)
        {
            return;
        }

        isAccepting = true;
        errorMessage = null;

        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
        var userEmail = authState.User.FindFirstValue(ClaimTypes.Email) ?? "";

        var result = await InviteService.AcceptAsync(Token, userId, userEmail);
        switch (result)
        {
            case InviteAcceptResult.Accepted:
                NavigationManager.NavigateTo($"/workspaces/{invite!.WorkspaceId}");
                return;
            case InviteAcceptResult.EmailMismatch:
                emailMismatch = userEmail;
                break;
            case InviteAcceptResult.Expired:
                errorMessage = "Este convite não é mais válido. Peça um novo para quem te convidou.";
                break;
            case InviteAcceptResult.NotFound:
                errorMessage = "Convite não encontrado.";
                break;
        }

        isAccepting = false;
    }
}
