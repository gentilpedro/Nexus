@page "/lists/{ListId:guid}/list"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>@(taskList?.Name ?? "Lista")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Lista não encontrada ou você não tem acesso a ela.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (taskList is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{workspaceId}")">@workspaceName</a> /
            <a href="@($"/workspaces/{workspaceId}/spaces/{taskList.SpaceId}")">@spaceName</a> /
            @taskList.Name
        </div>

        <div class="page-header">
            <h1>@taskList.Name</h1>
            <div class="form-actions">
                @if (canManageFields)
                {
                    <a class="btn btn-secondary" href="@($"/lists/{ListId}/fields")">Campos customizados</a>
                    <a class="btn btn-secondary" href="@($"/lists/{ListId}/workflow")">Workflow</a>
                    <a class="btn btn-secondary" href="@($"/lists/{ListId}/labels")">Labels</a>
                }
                <button class="btn" @onclick="OpenCreate">+ Nova task</button>
            </div>
        </div>

        <ViewSwitcher ListId="ListId" ActiveView="list" />

        @if (workItems is null)
        {
            <p>Carregando tasks...</p>
        }
        else if (workItems.Count == 0)
        {
            <div class="empty-state">
                <p>Nenhuma task criada ainda.</p>
            </div>
        }
        else
        {
            <div class="pill-tabs">
                <button type="button" class="@(rowFilter == "all" ? "active" : "")" @onclick='() => rowFilter = "all"'>Todas <span class="tab-count">@workItems.Count</span></button>
                <button type="button" class="@(rowFilter == "mine" ? "active" : "")" @onclick='() => rowFilter = "mine"'>Minhas <span class="tab-count">@workItems.Count(w => w.AssigneeId == currentUserId)</span></button>
                <button type="button" class="@(rowFilter == "urgent" ? "active" : "")" @onclick='() => rowFilter = "urgent"'>Urgentes <span class="tab-count">@workItems.Count(w => w.Priority is WorkItemPriority.High or WorkItemPriority.Highest)</span></button>
                <button type="button" class="@(rowFilter == "done" ? "active" : "")" @onclick='() => rowFilter = "done"'>Concluídas <span class="tab-count">@workItems.Count(w => w.Status.Category == StatusCategory.Done)</span></button>
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Título</th>
                            <th>Status</th>
                            <th>Prioridade</th>
                            <th>Responsável</th>
                            <th>Prazo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredWorkItems)
                        {
                            <tr class="data-table-row" @onclick="() => OpenEdit(item)">
                                <td><WorkItemTypeIcon Type="item.Type" /></td>
                                <td>@item.Title</td>
                                <td><StatusBadge Name="@item.Status.Name" Category="item.Status.Category" /></td>
                                <td><PriorityBadge Priority="item.Priority" /></td>
                                <td>@(item.Assignee?.DisplayName is { Length: > 0 } dn ? dn : (item.Assignee?.Email ?? "—"))</td>
                                <td>@(item.DueDateUtc?.ToString("dd/MM/yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="stat-grid" style="margin-top:1.25rem;">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Concluídas</span>
                        <span class="stat-card-value">@workItems.Count(w => w.Status.Category == StatusCategory.Done)</span>
                    </div>
                    <span class="stat-card-icon is-success">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Atrasadas</span>
                        <span class="stat-card-value">@workItems.Count(w => w.Status.Category != StatusCategory.Done && w.DueDateUtc is not null && w.DueDateUtc.Value.Date < DateTime.UtcNow.Date)</span>
                    </div>
                    <span class="stat-card-icon is-danger">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Em andamento</span>
                        <span class="stat-card-value">@workItems.Count(w => w.Status.Category == StatusCategory.InProgress)</span>
                    </div>
                    <span class="stat-card-icon is-warning">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                    </span>
                </div>
            </div>
        }

        <TaskDetailPanel @ref="panel"
                          TaskListId="ListId"
                          Statuses="statuses ?? []"
                          AssigneeOptions="assigneeOptions ?? []"
                          EpicOptions="epics ?? []"
                          CustomFieldDefinitions="customFieldDefinitions ?? []"
                          StatusTransitions="statusTransitions ?? []"
                          Labels="labels ?? []"
                          OnSaved="ReloadWorkItemsAsync" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<WorkItem>? workItems;
    private List<TaskStatusDefinition>? statuses;
    private List<(string UserId, string DisplayName)>? assigneeOptions;
    private List<WorkItem>? epics;
    private List<CustomFieldDefinition>? customFieldDefinitions;
    private List<StatusTransition>? statusTransitions;
    private List<Label>? labels;
    private bool notFound;
    private bool canManageFields;
    private TaskDetailPanel? panel;
    private Guid? loadedListId;
    private string rowFilter = "all";
    private string? currentUserId;

    private List<WorkItem> FilteredWorkItems => rowFilter switch
    {
        "mine" => workItems!.Where(w => w.AssigneeId == currentUserId).ToList(),
        "urgent" => workItems!.Where(w => w.Priority is WorkItemPriority.High or WorkItemPriority.Highest).ToList(),
        "done" => workItems!.Where(w => w.Status.Category == StatusCategory.Done).ToList(),
        _ => workItems!
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId) return;
        loadedListId = ListId;

        var authStateForUser = await AuthStateTask!;
        currentUserId = authStateForUser.User.FindFirstValue(ClaimTypes.NameIdentifier);

        notFound = false;
        taskList = null;
        workItems = null;
        statuses = null;
        assigneeOptions = null;
        epics = null;
        customFieldDefinitions = null;
        statusTransitions = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManageFields = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        statuses = await QueryService.GetStatusesForListAsync(ListId);
        assigneeOptions = await QueryService.GetWorkspaceMemberOptionsAsync(workspaceId);
        epics = await QueryService.GetEpicsForListAsync(ListId);
        customFieldDefinitions = await QueryService.GetCustomFieldDefinitionsForListAsync(ListId);
        statusTransitions = await QueryService.GetStatusTransitionsForListAsync(ListId);
        labels = await QueryService.GetLabelsForListAsync(ListId);
        await ReloadWorkItemsAsync();
    }

    private async Task ReloadWorkItemsAsync()
    {
        workItems = await QueryService.GetWorkItemsForListAsync(ListId);
        // Refresh in case a new Epic was just created via the panel — it should be
        // selectable immediately, not only after a full page reload.
        epics = await QueryService.GetEpicsForListAsync(ListId);
    }

    private void OpenCreate() => panel?.OpenForCreate();

    private async Task OpenEdit(WorkItem item)
    {
        if (panel is not null)
        {
            await panel.OpenForEdit(item);
        }
    }
}
