@page "/lists/{ListId:guid}/list"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Nexus.Web.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject WorkItemQueryService QueryService
@inject ListViewLoader ListLoader
@inject NavigationContextService NavContext

<PageTitle>@(taskList?.Name ?? "Lista")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Lista não encontrada"
                    Description="Ela pode ter sido excluída, ou você não tem mais acesso ao workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando a lista…" />
    }
    else
    {
        <ListPageHeader ListId="ListId" ListName="@taskList.Name"
                        WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                        SpaceId="taskList.SpaceId" SpaceName="@spaceName"
                        ActiveView="list" CanManage="canManageFields"
                        OnCreate="OpenCreate" />

        @if (workItems is null)
        {
            <Skeleton Count="8" Label="Carregando tarefas…" />
        }
        else if (workItems.Count == 0)
        {
            <EmptyState Icon="tasks" Title="Nenhuma tarefa nesta lista ainda"
                        Description="Crie a primeira tarefa. Depois você pode vê-la aqui, no Kanban, no calendário ou no Gantt.">
                <button type="button" class="btn" @onclick="OpenCreate"><Icon Name="plus" /> Nova tarefa</button>
            </EmptyState>
        }
        else
        {
            @if (itemsTruncated)
            {
                <div class="alert alert-warning" role="status">
                    <Icon Name="alert" />
                    <span>Esta lista tem mais de @WorkItemQueryService.MaxItemsPerView tarefas. Mostrando as @WorkItemQueryService.MaxItemsPerView primeiras — divida a lista para ver todas.</span>
                </div>
            }

            <div class="list-toolbar">
                <div class="pill-tabs" role="group" aria-label="Filtrar tarefas">
                    <button type="button" aria-pressed="@(rowFilter == "all" ? "true" : "false")" class="@(rowFilter == "all" ? "active" : "")" @onclick='() => rowFilter = "all"'>Todas <span class="tab-count">@workItems.Count</span></button>
                    <button type="button" aria-pressed="@(rowFilter == "mine" ? "true" : "false")" class="@(rowFilter == "mine" ? "active" : "")" @onclick='() => rowFilter = "mine"'>Minhas <span class="tab-count">@workItems.Count(w => w.AssigneeId == currentUserId)</span></button>
                    <button type="button" aria-pressed="@(rowFilter == "urgent" ? "true" : "false")" class="@(rowFilter == "urgent" ? "active" : "")" @onclick='() => rowFilter = "urgent"'>Urgentes <span class="tab-count">@workItems.Count(w => w.Priority is WorkItemPriority.High or WorkItemPriority.Highest)</span></button>
                    <button type="button" aria-pressed="@(rowFilter == "done" ? "true" : "false")" class="@(rowFilter == "done" ? "active" : "")" @onclick='() => rowFilter = "done"'>Concluídas <span class="tab-count">@workItems.Count(w => w.Status.Category == StatusCategory.Done)</span></button>
                </div>
                <p class="list-summary">
                    <span><strong>@workItems.Count(w => w.Status.Category == StatusCategory.InProgress)</strong> em andamento</span>
                    <span class="@(OverdueCount > 0 ? "text-danger" : "")"><strong>@OverdueCount</strong> atrasada@(OverdueCount == 1 ? "" : "s")</span>
                    <span><strong>@workItems.Count(w => w.Status.Category == StatusCategory.Done)</strong> concluída@(workItems.Count(w => w.Status.Category == StatusCategory.Done) == 1 ? "" : "s")</span>
                </p>
            </div>

            @if (FilteredWorkItems.Count == 0)
            {
                <div class="card">
                    <EmptyState Compact="true" Title="Nenhuma tarefa neste filtro">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick='() => rowFilter = "all"'>Ver todas</button>
                    </EmptyState>
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table task-table">
                        <thead>
                            <tr>
                                <th class="col-type"><span class="sr-only">Tipo</span></th>
                                <th>Título</th>
                                <th>Status</th>
                                <th>Prioridade</th>
                                <th>Responsável</th>
                                <th>Prazo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Virtualize instead of a plain foreach: rendering every row put 10.3 MB of
                               HTML on the wire for a large list and kept the entire DOM alive in the
                               circuit. Virtualize renders only the rows in view. ItemSize matches the
                               row height in views-tasks.css (.task-table td) so the scrollbar is proportioned
                               correctly. *@
                            <Virtualize Items="FilteredWorkItems" Context="item" ItemSize="48">
                                <tr class="data-table-row @(item.Status.Category == StatusCategory.Done ? "is-done" : "")" @onclick="() => OpenEdit(item)">
                                    <td class="col-type"><WorkItemTypeIcon Type="item.Type" /></td>
                                    <td class="cell-title">
                                        <button type="button" class="row-link" @onclick="() => OpenEdit(item)" @onclick:stopPropagation="true">@item.Title</button>
                                    </td>
                                    <td><StatusBadge Name="@item.Status.Name" Category="item.Status.Category" Color="@item.Status.Color" /></td>
                                    <td><PriorityBadge Priority="item.Priority" /></td>
                                    <td>
                                        @if (item.Assignee is null)
                                        {
                                            <span class="cell-muted">—</span>
                                        }
                                        else
                                        {
                                            var assigneeName = item.Assignee.DisplayName is { Length: > 0 } dn ? dn : (item.Assignee.Email ?? "");
                                            <span class="cell-person"><Avatar Name="@assigneeName" Size="xs" /> @assigneeName</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.DueDateUtc is DateTime due)
                                        {
                                            var overdue = item.Status.Category != StatusCategory.Done && DueDateLabel.IsOverdue(due);
                                            <span class="@(overdue ? "text-danger" : "")" title="@DueDateLabel.Describe(due, item.Status.Category == StatusCategory.Done)">@due.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="cell-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            }
        }

        <TaskDetailPanel @ref="panel"
                          TaskListId="ListId"
                          Statuses="statuses ?? []"
                          AssigneeOptions="assigneeOptions ?? []"
                          EpicOptions="epics ?? []"
                          CustomFieldDefinitions="customFieldDefinitions ?? []"
                          StatusTransitions="statusTransitions ?? []"
                          Labels="labels ?? []"
                          OnSaved="ReloadWorkItemsAsync" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    // Link direto para uma tarefa: /lists/{id}/list?tarefa={workItemId} abre o painel dela
    // (usado pelo dashboard, busca e notificações).
    [SupplyParameterFromQuery(Name = "tarefa")]
    public Guid? TaskIdToOpen { get; set; }

    private Guid? pendingOpenTaskId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<WorkItem>? workItems;
    // True when the list holds more work items than WorkItemQueryService.MaxItemsPerView, so the
    // user is told they are looking at a partial list instead of silently seeing the first N.
    private bool itemsTruncated;
    private List<TaskStatusDefinition>? statuses;
    private List<(string UserId, string DisplayName)>? assigneeOptions;
    private List<WorkItem>? epics;
    private List<CustomFieldDefinition>? customFieldDefinitions;
    private List<StatusTransition>? statusTransitions;
    private List<Label>? labels;
    private bool notFound;
    private bool canManageFields;
    private TaskDetailPanel? panel;
    private Guid? loadedListId;
    private string rowFilter = "all";
    private string? currentUserId;

    private int OverdueCount => workItems?.Count(w => w.Status.Category != StatusCategory.Done && w.DueDateUtc is DateTime d && DueDateLabel.IsOverdue(d)) ?? 0;

    private List<WorkItem> FilteredWorkItems => rowFilter switch
    {
        "mine" => workItems!.Where(w => w.AssigneeId == currentUserId).ToList(),
        "urgent" => workItems!.Where(w => w.Priority is WorkItemPriority.High or WorkItemPriority.Highest).ToList(),
        "done" => workItems!.Where(w => w.Status.Category == StatusCategory.Done).ToList(),
        _ => workItems!
    };

    protected override async Task OnParametersSetAsync()
    {
        if (TaskIdToOpen is Guid requested)
        {
            pendingOpenTaskId = requested;
        }

        if (loadedListId == ListId) return;
        loadedListId = ListId;

        var authStateForUser = await AuthStateTask!;
        currentUserId = authStateForUser.User.FindFirstValue(ClaimTypes.NameIdentifier);

        notFound = false;
        taskList = null;
        workItems = null;
        statuses = null;
        assigneeOptions = null;
        epics = null;
        customFieldDefinitions = null;
        statusTransitions = null;

        var shell = await ListLoader.LoadAsync(ListId, authStateForUser.User, ReloadWorkItemsAsync);
        if (shell is null)
        {
            notFound = true;
            return;
        }

        taskList = shell.TaskList;
        workspaceId = shell.WorkspaceId;
        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;
        canManageFields = shell.CanManage;
        statuses = shell.Statuses;
        assigneeOptions = shell.AssigneeOptions;
        customFieldDefinitions = shell.CustomFieldDefinitions;
        statusTransitions = shell.StatusTransitions;
        labels = shell.Labels;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);
    }

    private async Task ReloadWorkItemsAsync()
    {
        // Refresh in case a new Epic was just created via the panel — it should be
        // selectable immediately, not only after a full page reload.
        var itemsTask = QueryService.GetWorkItemsForListAsync(ListId);
        var epicsTask = QueryService.GetEpicsForListAsync(ListId);
        await Task.WhenAll(itemsTask, epicsTask);
        workItems = itemsTask.Result.Items;
        itemsTruncated = itemsTask.Result.IsTruncated;
        epics = epicsTask.Result;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingOpenTaskId is Guid taskId && panel is not null && workItems is not null)
        {
            pendingOpenTaskId = null;
            var item = workItems.FirstOrDefault(w => w.Id == taskId);
            if (item is not null)
            {
                await panel.OpenForEdit(item);
            }
        }
    }

    private void OpenCreate() => panel?.OpenForCreate();

    private async Task OpenEdit(WorkItem item)
    {
        if (panel is not null)
        {
            await panel.OpenForEdit(item);
        }
    }
}
