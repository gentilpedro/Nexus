@page "/lists/{ListId:guid}/board"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>@(taskList?.Name ?? "Board")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Lista não encontrada ou você não tem acesso a ela.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (taskList is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{workspaceId}")">@workspaceName</a> /
            <a href="@($"/workspaces/{workspaceId}/spaces/{taskList.SpaceId}")">@spaceName</a> /
            @taskList.Name
        </div>

        <div class="page-header">
            <h1>@taskList.Name</h1>
            <div class="form-actions">
                @if (canManageFields)
                {
                    <a class="btn btn-secondary" href="@($"/lists/{ListId}/fields")">Campos customizados</a>
                    <a class="btn btn-secondary" href="@($"/lists/{ListId}/workflow")">Workflow</a>
                    <a class="btn btn-secondary" href="@($"/lists/{ListId}/labels")">Labels</a>
                }
                <button class="btn" @onclick="OpenCreate">+ Nova task</button>
            </div>
        </div>

        <ViewSwitcher ListId="ListId" ActiveView="board" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (statuses is null || workItems is null)
        {
            <p>Carregando board...</p>
        }
        else
        {
            <div class="board">
                @foreach (var status in statuses)
                {
                    <BoardColumn Status="status"
                                 Items="workItems.Where(w => w.StatusId == status.Id).ToList()"
                                 OnCardClick="OpenEdit"
                                 OnCardMoved="HandleCardMoved"
                                 CanManage="canManageFields"
                                 OnRename="HandleRenameStatus"
                                 OnDelete="HandleDeleteStatus" />
                }
                @if (canManageFields)
                {
                    <div class="board-add-column">
                        @if (showAddColumnForm)
                        {
                            <div class="board-add-column-form">
                                <label style="font-size:0.75rem;font-weight:600;color:var(--color-text-muted);">Nome da coluna (escreva o que quiser)</label>
                                <input type="text" placeholder="Ex: Revisão, Bloqueado, Aguardando cliente..." @bind="newColumnName" @bind:event="oninput" />
                                <label style="font-size:0.75rem;font-weight:600;color:var(--color-text-muted);">Cor da coluna</label>
                                <div class="color-swatch-row">
                                    @foreach (var color in ColumnColors)
                                    {
                                        <button type="button" class="color-swatch @(newColumnColor == color ? "is-selected" : "")"
                                                style="background:@color;" @onclick="() => newColumnColor = color"
                                                aria-label="Selecionar cor @color"></button>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(columnErrorMessage))
                                {
                                    <div class="alert alert-danger" style="padding:0.4rem 0.6rem;font-size:0.8rem;">@columnErrorMessage</div>
                                }
                                <div class="form-actions" style="margin-top:0;">
                                    <button type="button" class="btn" style="flex:1;" @onclick="HandleCreateColumn">Adicionar</button>
                                    <button type="button" class="btn btn-secondary" @onclick="ToggleAddColumnForm">Cancelar</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="board-add-column-btn" @onclick="ToggleAddColumnForm">+ Nova coluna</button>
                        }
                    </div>
                }
            </div>

            <div class="stat-grid" style="margin-top:1.25rem;">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Concluídas</span>
                        <span class="stat-card-value">@workItems.Count(w => w.Status.Category == StatusCategory.Done)</span>
                    </div>
                    <span class="stat-card-icon is-success">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Atrasadas</span>
                        <span class="stat-card-value">@workItems.Count(w => w.Status.Category != StatusCategory.Done && w.DueDateUtc is not null && w.DueDateUtc.Value.Date < DateTime.UtcNow.Date)</span>
                    </div>
                    <span class="stat-card-icon is-danger">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Em andamento</span>
                        <span class="stat-card-value">@workItems.Count(w => w.Status.Category == StatusCategory.InProgress)</span>
                    </div>
                    <span class="stat-card-icon is-warning">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                    </span>
                </div>
            </div>
        }

        <TaskDetailPanel @ref="panel"
                          TaskListId="ListId"
                          Statuses="statuses ?? []"
                          AssigneeOptions="assigneeOptions ?? []"
                          EpicOptions="epics ?? []"
                          CustomFieldDefinitions="customFieldDefinitions ?? []"
                          StatusTransitions="statusTransitions ?? []"
                          Labels="labels ?? []"
                          OnSaved="ReloadWorkItemsAsync" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<WorkItem>? workItems;
    private List<TaskStatusDefinition>? statuses;
    private List<(string UserId, string DisplayName)>? assigneeOptions;
    private List<WorkItem>? epics;
    private List<CustomFieldDefinition>? customFieldDefinitions;
    private List<StatusTransition>? statusTransitions;
    private List<Label>? labels;
    private bool notFound;
    private bool canManageFields;
    private string? errorMessage;
    private TaskDetailPanel? panel;
    private Guid? loadedListId;
    private bool showAddColumnForm;
    private string newColumnName = "";
    private string newColumnColor = ColumnColors[0];
    private string? columnErrorMessage;
    private static readonly string[] ColumnColors = ["#2563EB", "#16A34A", "#7C3AED", "#DC2626", "#EA580C", "#0D9488"];

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId) return;
        loadedListId = ListId;

        notFound = false;
        taskList = null;
        workItems = null;
        statuses = null;
        assigneeOptions = null;
        epics = null;
        customFieldDefinitions = null;
        statusTransitions = null;
        errorMessage = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManageFields = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        statuses = await QueryService.GetStatusesForListAsync(ListId);
        assigneeOptions = await QueryService.GetWorkspaceMemberOptionsAsync(workspaceId);
        epics = await QueryService.GetEpicsForListAsync(ListId);
        customFieldDefinitions = await QueryService.GetCustomFieldDefinitionsForListAsync(ListId);
        statusTransitions = await QueryService.GetStatusTransitionsForListAsync(ListId);
        labels = await QueryService.GetLabelsForListAsync(ListId);
        await ReloadWorkItemsAsync();
    }

    private async Task ReloadWorkItemsAsync()
    {
        workItems = await QueryService.GetWorkItemsForListAsync(ListId);
        epics = await QueryService.GetEpicsForListAsync(ListId);
    }

    private void OpenCreate() => panel?.OpenForCreate();

    private async Task OpenEdit(WorkItem item)
    {
        if (panel is not null)
        {
            await panel.OpenForEdit(item);
        }
    }

    private void ToggleAddColumnForm()
    {
        showAddColumnForm = !showAddColumnForm;
        newColumnName = "";
        newColumnColor = ColumnColors[0];
        columnErrorMessage = null;
    }

    private async Task ReloadStatusesAsync()
    {
        statuses = await QueryService.GetStatusesForListAsync(ListId);
    }

    private async Task HandleCreateColumn()
    {
        if (string.IsNullOrWhiteSpace(newColumnName))
        {
            columnErrorMessage = "Informe um nome.";
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var maxSortOrder = await db.TaskStatusDefinitions
                .Where(s => s.TaskListId == ListId)
                .Select(s => (int?)s.SortOrder)
                .MaxAsync() ?? -1;

            db.TaskStatusDefinitions.Add(new TaskStatusDefinition
            {
                Id = Guid.NewGuid(),
                TaskListId = ListId,
                Name = newColumnName.Trim(),
                Color = newColumnColor,
                Category = StatusCategory.ToDo,
                SortOrder = maxSortOrder + 1,
                IsDefault = false
            });
            await db.SaveChangesAsync();
        }

        ToggleAddColumnForm();
        await ReloadStatusesAsync();
    }

    private async Task HandleRenameStatus((Guid StatusId, string NewName) req)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.TaskStatusDefinitions
            .Where(s => s.Id == req.StatusId)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.Name, req.NewName));
        await ReloadStatusesAsync();
    }

    private async Task HandleDeleteStatus(Guid statusId)
    {
        errorMessage = null;
        await using var db = await DbFactory.CreateDbContextAsync();

        // StatusTransition's FKs to TaskStatusDefinition are Restrict — clear any transitions
        // referencing this column first, or the delete below fails.
        await db.StatusTransitions
            .Where(t => t.FromStatusId == statusId || t.ToStatusId == statusId)
            .ExecuteDeleteAsync();

        try
        {
            await db.TaskStatusDefinitions.Where(s => s.Id == statusId).ExecuteDeleteAsync();
        }
        catch (System.Data.Common.DbException)
        {
            // Restrict FK violation — a task still uses this column.
            errorMessage = "Mova as tarefas dessa coluna pra outra antes de excluí-la.";
            return;
        }

        await ReloadStatusesAsync();
        await ReloadWorkItemsAsync();
    }

    private async Task<bool> HandleCardMoved((Guid WorkItemId, Guid NewStatusId, int NewIndex) move)
    {
        var allowed = await QueryService.UpdateWorkItemStatusAsync(ListId, move.WorkItemId, move.NewStatusId, move.NewIndex);
        errorMessage = allowed ? null : "Essa mudança de status não é permitida pelo workflow da lista.";
        await ReloadWorkItemsAsync();
        StateHasChanged();
        return allowed;
    }
}
