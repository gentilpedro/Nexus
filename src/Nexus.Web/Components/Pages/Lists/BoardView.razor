@page "/lists/{ListId:guid}/board"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject ListViewLoader ListLoader
@inject NavigationContextService NavContext
@inject ToastService Toasts

<PageTitle>@(taskList?.Name ?? "Board")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Lista não encontrada"
                    Description="Ela pode ter sido excluída, ou você não tem mais acesso ao workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando a lista…" />
    }
    else
    {
        <ListPageHeader ListId="ListId" ListName="@taskList.Name"
                        WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                        SpaceId="taskList.SpaceId" SpaceName="@spaceName"
                        ActiveView="board" CanManage="canManageFields"
                        OnCreate="OpenCreate" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
        }

        @if (statuses is null || workItems is null)
        {
            <Skeleton Variant="card" Count="4" Label="Carregando o quadro…" />
        }
        else
        {
            @if (itemsTruncated)
            {
                <div class="alert alert-warning" role="status">
                    <Icon Name="alert" />
                    <span>Esta lista tem mais de @WorkItemQueryService.MaxItemsPerView tarefas. O quadro mostra as @WorkItemQueryService.MaxItemsPerView primeiras.</span>
                </div>
            }

            <p class="list-summary list-summary--board">
                <span><strong>@workItems.Count(w => w.Status.Category == StatusCategory.InProgress)</strong> em andamento</span>
                <span class="@(OverdueCount > 0 ? "text-danger" : "")"><strong>@OverdueCount</strong> atrasada@(OverdueCount == 1 ? "" : "s")</span>
                <span><strong>@workItems.Count(w => w.Status.Category == StatusCategory.Done)</strong> concluída@(workItems.Count(w => w.Status.Category == StatusCategory.Done) == 1 ? "" : "s")</span>
                <span class="list-summary-hint">Arraste os cards entre as colunas para mudar o status.</span>
            </p>

            <div class="board" role="region" aria-label="Quadro Kanban" tabindex="0">
                @foreach (var status in statuses)
                {
                    <BoardColumn Status="status"
                                 Items="workItems.Where(w => w.StatusId == status.Id).ToList()"
                                 OnCardClick="OpenEdit"
                                 OnCardMoved="HandleCardMoved"
                                 CanManage="canManageFields"
                                 OnRename="HandleRenameStatus"
                                 OnDelete="HandleDeleteStatus" />
                }
                @if (canManageFields)
                {
                    <div class="board-add-column">
                        @if (showAddColumnForm)
                        {
                            <form class="board-add-column-form" @onsubmit="HandleCreateColumn" @onsubmit:preventDefault="true">
                                <div class="form-field">
                                    <label for="new-column-name">Nome da coluna</label>
                                    <input id="new-column-name" type="text" placeholder="Ex.: Revisão, Bloqueado…" @bind="newColumnName" @bind:event="oninput" autofocus />
                                </div>
                                <fieldset class="form-fieldset">
                                    <legend class="field-label">Cor</legend>
                                    <div class="color-swatch-row">
                                        @foreach (var (color, colorName) in ColumnColors)
                                        {
                                            <button type="button" class="color-swatch @(newColumnColor == color ? "is-selected" : "")"
                                                    style="background:@color;" @onclick="() => newColumnColor = color"
                                                    aria-pressed="@(newColumnColor == color ? "true" : "false")"
                                                    aria-label="@colorName"></button>
                                        }
                                    </div>
                                </fieldset>
                                @if (!string.IsNullOrEmpty(columnErrorMessage))
                                {
                                    <p class="validation-message" role="alert">@columnErrorMessage</p>
                                }
                                <div class="button-row">
                                    <button type="submit" class="btn btn-sm">Adicionar coluna</button>
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleAddColumnForm">Cancelar</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="board-add-column-btn" @onclick="ToggleAddColumnForm">
                                <Icon Name="plus" /> Nova coluna
                            </button>
                        }
                    </div>
                }
            </div>
        }

        <ConfirmDialog @ref="confirm" />

        <TaskDetailPanel @ref="panel"
                          TaskListId="ListId"
                          Statuses="statuses ?? []"
                          AssigneeOptions="assigneeOptions ?? []"
                          EpicOptions="epics ?? []"
                          CustomFieldDefinitions="customFieldDefinitions ?? []"
                          StatusTransitions="statusTransitions ?? []"
                          Labels="labels ?? []"
                          OnSaved="ReloadWorkItemsAsync" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<WorkItem>? workItems;
    // True when the list holds more work items than WorkItemQueryService.MaxItemsPerView, so the
    // user is told they are looking at a partial list instead of silently seeing the first N.
    private bool itemsTruncated;
    private List<TaskStatusDefinition>? statuses;
    private List<(string UserId, string DisplayName)>? assigneeOptions;
    private List<WorkItem>? epics;
    private List<CustomFieldDefinition>? customFieldDefinitions;
    private List<StatusTransition>? statusTransitions;
    private List<Label>? labels;
    private bool notFound;
    private bool canManageFields;
    private string? errorMessage;
    private TaskDetailPanel? panel;
    private Guid? loadedListId;
    private bool showAddColumnForm;
    private string newColumnName = "";
    private string newColumnColor = ColumnColors[0].Hex;
    private string? columnErrorMessage;
    // Mesma família de cores de status do docs/design/paleta-de-cores.md (Kanban), com nome para o leitor de tela.
    private static readonly (string Hex, string Name)[] ColumnColors =
    [
        ("#5B5CEB", "Índigo"),
        ("#3B82F6", "Azul"),
        ("#A855F7", "Roxo"),
        ("#F59E0B", "Âmbar"),
        ("#22C55E", "Verde"),
        ("#EF4444", "Vermelho"),
        ("#94A3B8", "Cinza")
    ];

    private ConfirmDialog? confirm;

    private int OverdueCount => workItems?.Count(w => w.Status.Category != StatusCategory.Done && w.DueDateUtc is DateTime d && d.Date < DateTime.UtcNow.Date) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId) return;
        loadedListId = ListId;

        notFound = false;
        taskList = null;
        workItems = null;
        statuses = null;
        assigneeOptions = null;
        epics = null;
        customFieldDefinitions = null;
        statusTransitions = null;
        errorMessage = null;

        var authState = await AuthStateTask!;
        var shell = await ListLoader.LoadAsync(ListId, authState.User, ReloadWorkItemsAsync);
        if (shell is null)
        {
            notFound = true;
            return;
        }

        taskList = shell.TaskList;
        workspaceId = shell.WorkspaceId;
        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;
        canManageFields = shell.CanManage;
        statuses = shell.Statuses;
        assigneeOptions = shell.AssigneeOptions;
        customFieldDefinitions = shell.CustomFieldDefinitions;
        statusTransitions = shell.StatusTransitions;
        labels = shell.Labels;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);
    }

    private async Task ReloadWorkItemsAsync()
    {
        var itemsTask = QueryService.GetWorkItemsForListAsync(ListId);
        var epicsTask = QueryService.GetEpicsForListAsync(ListId);
        await Task.WhenAll(itemsTask, epicsTask);
        workItems = itemsTask.Result.Items;
        itemsTruncated = itemsTask.Result.IsTruncated;
        epics = epicsTask.Result;
    }

    private void OpenCreate() => panel?.OpenForCreate();

    private async Task OpenEdit(WorkItem item)
    {
        if (panel is not null)
        {
            await panel.OpenForEdit(item);
        }
    }

    private void ToggleAddColumnForm()
    {
        showAddColumnForm = !showAddColumnForm;
        newColumnName = "";
        newColumnColor = ColumnColors[0].Hex;
        columnErrorMessage = null;
    }

    private async Task ReloadStatusesAsync()
    {
        statuses = await QueryService.GetStatusesForListAsync(ListId);
    }

    private async Task HandleCreateColumn()
    {
        if (string.IsNullOrWhiteSpace(newColumnName))
        {
            columnErrorMessage = "Informe um nome.";
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var maxSortOrder = await db.TaskStatusDefinitions
                .Where(s => s.TaskListId == ListId)
                .Select(s => (int?)s.SortOrder)
                .MaxAsync() ?? -1;

            db.TaskStatusDefinitions.Add(new TaskStatusDefinition
            {
                Id = Guid.NewGuid(),
                TaskListId = ListId,
                Name = newColumnName.Trim(),
                Color = newColumnColor,
                Category = StatusCategory.ToDo,
                SortOrder = maxSortOrder + 1,
                IsDefault = false
            });
            await db.SaveChangesAsync();
        }

        ToggleAddColumnForm();
        await ReloadStatusesAsync();
    }

    private async Task HandleRenameStatus((Guid StatusId, string NewName) req)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.TaskStatusDefinitions
            .Where(s => s.Id == req.StatusId)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.Name, req.NewName));
        await ReloadStatusesAsync();
    }

    private async Task HandleDeleteStatus(Guid statusId)
    {
        errorMessage = null;
        await using var db = await DbFactory.CreateDbContextAsync();

        // Checa antes de apagar qualquer coisa: antes, as transições do fluxo eram excluídas e só
        // depois a exclusão da coluna falhava (por ainda ter tarefas), deixando o fluxo mutilado.
        if (await db.WorkItems.AnyAsync(w => w.StatusId == statusId))
        {
            errorMessage = "Mova as tarefas dessa coluna para outra antes de excluí-la.";
            return;
        }

        var statusName = statuses?.FirstOrDefault(st => st.Id == statusId)?.Name;
        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("coluna", statusName,
                "As regras do fluxo de status que usam essa coluna também serão removidas.")))
        {
            return;
        }

        // StatusTransition's FKs to TaskStatusDefinition are Restrict — clear any transitions
        // referencing this column first, or the delete below fails.
        await db.StatusTransitions
            .Where(t => t.FromStatusId == statusId || t.ToStatusId == statusId)
            .ExecuteDeleteAsync();

        try
        {
            await db.TaskStatusDefinitions.Where(s => s.Id == statusId).ExecuteDeleteAsync();
        }
        catch (System.Data.Common.DbException)
        {
            // Restrict FK violation — a task still uses this column.
            errorMessage = "Mova as tarefas dessa coluna para outra antes de excluí-la.";
            return;
        }

        Toasts.Show("Coluna excluída");
        await ReloadStatusesAsync();
        await ReloadWorkItemsAsync();
    }

    private async Task<bool> HandleCardMoved((Guid WorkItemId, Guid NewStatusId, int NewIndex) move)
    {
        var allowed = await QueryService.UpdateWorkItemStatusAsync(ListId, move.WorkItemId, move.NewStatusId, move.NewIndex);
        errorMessage = allowed ? null : "Essa mudança de status não é permitida pelo workflow da lista.";
        await ReloadWorkItemsAsync();
        StateHasChanged();
        return allowed;
    }
}
