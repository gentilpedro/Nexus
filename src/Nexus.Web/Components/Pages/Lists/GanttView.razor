@page "/lists/{ListId:guid}/gantt"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>@(taskList?.Name ?? "Gantt")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Lista não encontrada"
                    Description="Ela pode ter sido excluída, ou você não tem mais acesso ao workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando a lista…" />
    }
    else
    {
        <ListPageHeader ListId="ListId" ListName="@taskList.Name"
                        WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                        SpaceId="taskList.SpaceId" SpaceName="@spaceName"
                        ActiveView="gantt" CanManage="canManageFields"
                        OnCreate="OpenCreate" />

        @if (workItems is null)
        {
            <Skeleton Count="8" Label="Carregando o cronograma…" />
        }
        else
        {
            @if (itemsTruncated)
            {
                <div class="alert alert-warning" role="status">
                    <Icon Name="alert" />
                    <span>Esta lista tem mais de @WorkItemQueryService.MaxItemsPerView tarefas. O cronograma mostra as @WorkItemQueryService.MaxItemsPerView primeiras.</span>
                </div>
            }

            var items = GanttItems;
            @if (items.Count == 0)
            {
                <EmptyState Icon="gantt" Title="Nenhuma tarefa com prazo ainda"
                            Description="O Gantt desenha cada tarefa da data de início até o prazo. Defina um prazo em uma tarefa para ela aparecer aqui.">
                    <button type="button" class="btn" @onclick="OpenCreate"><Icon Name="plus" /> Nova tarefa</button>
                </EmptyState>
            }
            else
            {
                var ticks = GetTicks();
                var todayPct = TodayLeftPct;
                var overdueCount = items.Count(i => i.WorkItem.Status.Category != StatusCategory.Done && i.WorkItem.DueDateUtc!.Value.Date < DateTime.UtcNow.Date);

                <div class="list-toolbar">
                    <p class="list-summary">
                        <span><Icon Name="calendar" Class="icon--sm" /> @rangeStart.ToString("dd/MM/yyyy") a @rangeEnd.ToString("dd/MM/yyyy")</span>
                        <span><strong>@items.Count</strong> com prazo</span>
                        <span><strong>@OnTrackPercent(items)%</strong> em dia</span>
                        <span class="@(overdueCount > 0 ? "text-danger" : "")"><strong>@overdueCount</strong> atrasada@(overdueCount == 1 ? "" : "s")</span>
                    </p>
                    <div class="toolbar-field">
                        <label for="gantt-group">Agrupar por</label>
                        <select id="gantt-group" @bind="groupBy">
                            <option value="none">Nada</option>
                            <option value="assignee">Responsável</option>
                        </select>
                    </div>
                </div>

                <div class="gantt-chart" role="region" aria-label="Cronograma das tarefas" tabindex="0">
                    <div class="gantt-inner">
                        <div class="gantt-header-row" aria-hidden="true">
                            <div class="gantt-header-label">Tarefa</div>
                            <div class="gantt-header-track">
                                @foreach (var tick in ticks)
                                {
                                    <span class="gantt-tick-label" style="left: @(tick.LeftPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%">@tick.Date.ToString("dd/MM")</span>
                                }
                            </div>
                        </div>
                        <div class="gantt-body">
                            @foreach (var tick in ticks)
                            {
                                <div class="gantt-gridline" style="--x: @(tick.LeftPct.ToString(System.Globalization.CultureInfo.InvariantCulture))"></div>
                            }
                            @if (todayPct is { } pct)
                            {
                                <div class="gantt-today-line" style="--x: @(pct.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                    <span class="gantt-today-label">Hoje</span>
                                </div>
                            }
                            @foreach (var group in GroupItems(items))
                            {
                                @if (!string.IsNullOrEmpty(group.Label))
                                {
                                    <div class="gantt-group-header">@group.Label <span class="tab-count">@group.Items.Count</span></div>
                                }
                                @foreach (var item in group.Items)
                                {
                                    var wi = item.WorkItem;
                                    var category = wi.Status.Category.ToString().ToLowerInvariant();
                                    var late = wi.Status.Category != StatusCategory.Done && wi.DueDateUtc!.Value.Date < DateTime.UtcNow.Date;
                                    <div class="gantt-row">
                                        <button type="button" class="gantt-row-label" @onclick="() => OpenEdit(wi)">
                                            <WorkItemTypeIcon Type="wi.Type" />
                                            <span class="gantt-row-title">@wi.Title</span>
                                            @if (wi.Assignee is not null)
                                            {
                                                <Avatar Name="@AssigneeLabel(wi)" Size="xs" />
                                            }
                                        </button>
                                        <div class="gantt-row-track">
                                            <button type="button" class="gantt-bar gantt-bar--@category @(late ? "is-late" : "")"
                                                    style="left: @(item.LeftPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%; width: @(item.WidthPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"
                                                    aria-label="@($"{wi.Title}: {(wi.StartDateUtc ?? wi.DueDateUtc)!.Value:dd/MM} a {wi.DueDateUtc!.Value:dd/MM}, {wi.Status.Name}{(late ? ", atrasada" : "")}")"
                                                    title="@($"{wi.Title} · {wi.Status.Name}")"
                                                    tabindex="-1"
                                                    @onclick="() => OpenEdit(wi)">
                                                <span class="gantt-bar-label">@wi.Title</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="priority-legend" aria-label="Legenda">
                    <span class="priority-legend-title">Status</span>
                    <span class="priority-legend-item"><span class="priority-legend-dot" style="background:var(--status-todo);"></span>A fazer</span>
                    <span class="priority-legend-item"><span class="priority-legend-dot" style="background:var(--status-inprogress);"></span>Em andamento</span>
                    <span class="priority-legend-item"><span class="priority-legend-dot" style="background:var(--status-done);"></span>Concluída</span>
                    <span class="priority-legend-item"><span class="priority-legend-dot is-late-dot"></span>Atrasada</span>
                </div>
            }
        }

        <TaskDetailPanel @ref="panel"
                          TaskListId="ListId"
                          Statuses="statuses ?? []"
                          AssigneeOptions="assigneeOptions ?? []"
                          EpicOptions="epics ?? []"
                          CustomFieldDefinitions="customFieldDefinitions ?? []"
                          StatusTransitions="statusTransitions ?? []"
                          Labels="labels ?? []"
                          OnSaved="ReloadWorkItemsAsync" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<WorkItem>? workItems;
    // True when the list holds more work items than WorkItemQueryService.MaxItemsPerView, so the
    // user is told they are looking at a partial list instead of silently seeing the first N.
    private bool itemsTruncated;
    private List<TaskStatusDefinition>? statuses;
    private List<(string UserId, string DisplayName)>? assigneeOptions;
    private List<WorkItem>? epics;
    private List<CustomFieldDefinition>? customFieldDefinitions;
    private List<StatusTransition>? statusTransitions;
    private List<Label>? labels;
    private bool notFound;
    private bool canManageFields;
    private TaskDetailPanel? panel;
    private Guid? loadedListId;
    private DateTime rangeStart;
    private DateTime rangeEnd;
    private int totalDays;
    private string groupBy = "none";

    private class GanttItem
    {
        public WorkItem WorkItem { get; set; } = null!;
        public double LeftPct { get; set; }
        public double WidthPct { get; set; }
    }

    private List<GanttItem> GanttItems
    {
        get
        {
            if (workItems is null)
            {
                return [];
            }

            var withDue = workItems.Where(w => w.DueDateUtc.HasValue).ToList();
            if (withDue.Count == 0)
            {
                rangeStart = DateTime.UtcNow.Date;
                rangeEnd = DateTime.UtcNow.Date;
                totalDays = 1;
                return [];
            }

            rangeStart = withDue.Min(w => (w.StartDateUtc ?? w.DueDateUtc)!.Value.Date).AddDays(-1);
            rangeEnd = withDue.Max(w => w.DueDateUtc!.Value.Date).AddDays(1);
            totalDays = Math.Max((rangeEnd - rangeStart).Days, 1);

            return withDue
                .OrderBy(w => w.StartDateUtc ?? w.DueDateUtc)
                .Select(w =>
                {
                    var barStart = (w.StartDateUtc ?? w.DueDateUtc)!.Value.Date;
                    var barEnd = w.DueDateUtc!.Value.Date;
                    var left = (barStart - rangeStart).Days / (double)totalDays * 100;
                    var width = Math.Max((barEnd - barStart).Days / (double)totalDays * 100, 1.5);
                    return new GanttItem { WorkItem = w, LeftPct = left, WidthPct = width };
                })
                .ToList();
        }
    }

    // Adaptive tick interval so the header/gridlines don't get crowded on long periods.
    private List<(DateTime Date, double LeftPct)> GetTicks()
    {
        if (totalDays <= 0)
        {
            return [];
        }

        var stepDays = totalDays switch
        {
            <= 14 => 1,
            <= 60 => 7,
            <= 180 => 14,
            _ => 30
        };

        var ticks = new List<(DateTime, double)>();
        for (var d = rangeStart; d <= rangeEnd; d = d.AddDays(stepDays))
        {
            var pct = (d - rangeStart).Days / (double)totalDays * 100;
            ticks.Add((d, pct));
        }
        return ticks;
    }

    private double? TodayLeftPct
    {
        get
        {
            var today = DateTime.UtcNow.Date;
            if (today < rangeStart || today > rangeEnd || totalDays <= 0)
            {
                return null;
            }
            return (today - rangeStart).Days / (double)totalDays * 100;
        }
    }

    private List<(string Label, List<GanttItem> Items)> GroupItems(List<GanttItem> items)
    {
        if (groupBy != "assignee")
        {
            return [("", items)];
        }

        return items
            .GroupBy(i => AssigneeLabel(i.WorkItem))
            .OrderBy(g => g.Key == "Sem responsável" ? 1 : 0)
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.OrderBy(i => i.WorkItem.StartDateUtc ?? i.WorkItem.DueDateUtc).ToList()))
            .ToList();
    }

    private static int OnTrackPercent(List<GanttItem> items)
    {
        if (items.Count == 0)
        {
            return 100;
        }

        var today = DateTime.UtcNow.Date;
        var onTrack = items.Count(i => i.WorkItem.Status.Category == StatusCategory.Done || i.WorkItem.DueDateUtc!.Value.Date >= today);
        return (int)Math.Round(onTrack * 100.0 / items.Count);
    }

    private static string AssigneeLabel(WorkItem item) =>
        item.Assignee is null
            ? "Sem responsável"
            : (string.IsNullOrEmpty(item.Assignee.DisplayName) ? item.Assignee.Email ?? "" : item.Assignee.DisplayName);

    private static string AssigneeInitial(WorkItem item)
    {
        if (item.Assignee is null)
        {
            return "?";
        }

        var name = string.IsNullOrEmpty(item.Assignee.DisplayName) ? item.Assignee.Email : item.Assignee.DisplayName;
        return string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId) return;
        loadedListId = ListId;

        notFound = false;
        taskList = null;
        workItems = null;
        statuses = null;
        assigneeOptions = null;
        epics = null;
        customFieldDefinitions = null;
        statusTransitions = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManageFields = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        statuses = await QueryService.GetStatusesForListAsync(ListId);
        assigneeOptions = await QueryService.GetWorkspaceMemberOptionsAsync(workspaceId);
        epics = await QueryService.GetEpicsForListAsync(ListId);
        customFieldDefinitions = await QueryService.GetCustomFieldDefinitionsForListAsync(ListId);
        statusTransitions = await QueryService.GetStatusTransitionsForListAsync(ListId);
        labels = await QueryService.GetLabelsForListAsync(ListId);
        await ReloadWorkItemsAsync();
    }

    private async Task ReloadWorkItemsAsync()
    {
        var itemsPage = await QueryService.GetWorkItemsForListAsync(ListId);
        workItems = itemsPage.Items;
        itemsTruncated = itemsPage.IsTruncated;
        epics = await QueryService.GetEpicsForListAsync(ListId);
    }

    private void OpenCreate() => panel?.OpenForCreate();

    private async Task OpenEdit(WorkItem item)
    {
        if (panel is not null)
        {
            await panel.OpenForEdit(item);
        }
    }
}
