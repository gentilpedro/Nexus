@page "/lists/{ListId:guid}/labels"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext

<PageTitle>Labels · Nexus</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Configurações indisponíveis"
                    Description="A lista não existe mais, ou você não é administrador do workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando configurações…" />
    }
    else
    {
        <ListSettingsHeader ListId="ListId" ListName="@taskList.Name"
                            WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                            SpaceId="taskList.SpaceId" SpaceName="@spaceName" Active="labels" />

        <div class="settings-split">
            <EditForm Model="createModel" OnValidSubmit="HandleCreate" class="card settings-split-form">
                <h2 class="form-section-title">Nova label</h2>
                <p class="form-section-description">Labels marcam tarefas por tema, cliente ou tipo de trabalho, e aparecem nos cards.</p>
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="label-name" class="required">Nome</label>
                    <InputText id="label-name" @bind-Value="createModel.Name" @bind-Value:after="() => createModel.Name = createModel.Name.Trim()"
                               @oninput="e => createModel.Name = e.Value?.ToString() ?? string.Empty" placeholder="Ex.: Cliente VIP, Retrabalho" />
                    <ValidationMessage For="() => createModel.Name" />
                </div>
                <div class="form-field">
                    <label for="label-description">Descrição <span class="field-hint">(opcional)</span></label>
                    <InputText id="label-description" @bind-Value="createModel.Description" placeholder="Quando usar esta label?" />
                </div>
                <fieldset class="form-fieldset">
                    <legend class="field-label">Cor</legend>
                    <div class="label-swatch-row">
                        @foreach (var (color, colorName) in Palette)
                        {
                            <button type="button"
                                    class="label-swatch @(createModel.Color == color ? "is-selected" : "")"
                                    style="background-color: @color;"
                                    aria-pressed="@(createModel.Color == color ? "true" : "false")"
                                    aria-label="@colorName"
                                    @onclick="() => createModel.Color = color">
                            </button>
                        }
                    </div>
                </fieldset>
                <div class="label-preview">
                    <span class="field-label">Prévia</span>
                    <span class="label-chip" style="@ChipStyle(createModel.Color)">@(string.IsNullOrWhiteSpace(createModel.Name) ? "Nome da label" : createModel.Name)</span>
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
                }
                <div class="form-actions form-actions--end">
                    <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving"><Icon Name="plus" /> Adicionar label</button>
                </div>
            </EditForm>

            <section class="settings-split-list" aria-labelledby="labels-title">
                <div class="section-header">
                    <h2 id="labels-title" class="section-title">Labels desta lista @if (labels is not null) { <span class="tab-count">@labels.Count</span> }</h2>
                </div>
                @if (labels is null)
                {
                    <Skeleton Count="4" />
                }
                else if (labels.Count == 0)
                {
                    <div class="card">
                        <EmptyState Compact="true" Title="Nenhuma label ainda" Description="Crie a primeira no formulário ao lado." />
                    </div>
                }
                else
                {
                    @if (labels.Count > 6)
                    {
                        <div class="input-with-icon list-toolbar-search settings-filter">
                            <Icon Name="search" />
                            <label for="label-filter" class="sr-only">Buscar labels</label>
                            <input id="label-filter" type="search" placeholder="Buscar labels" @bind="labelFilter" @bind:event="oninput" />
                        </div>
                    }
                    <ul class="card card--flush row-list settings-rows">
                        @foreach (var label in FilteredLabels)
                        {
                            var uses = usageCounts.TryGetValue(label.Id, out var c) ? c : 0;
                            <li class="settings-row">
                                <div class="settings-row-main">
                                    <span class="label-chip" style="@ChipStyle(label.Color)">@label.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(label.Description))
                                    {
                                        <span class="settings-row-sub">@label.Description</span>
                                    }
                                </div>
                                <span class="settings-row-meta">@uses tarefa@(uses == 1 ? "" : "s")</span>
                                <button type="button" class="icon-btn icon-btn--sm is-danger" @onclick="() => HandleDelete(label.Id)">
                                    <Icon Name="trash" Label="@($"Excluir label {label.Name}")" />
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ConfirmDialog? confirm;

    private static readonly (string Hex, string Name)[] Palette =
    [
        ("#61BD4F", "Verde"), ("#F2D600", "Amarelo"), ("#FFAB4A", "Laranja"), ("#EB5A46", "Vermelho"), ("#C377E0", "Lilás"),
        ("#0079BF", "Azul"), ("#00C2E0", "Ciano"), ("#FF78CB", "Rosa"), ("#4D4D4D", "Grafite")
    ];

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<Label>? labels;
    private Dictionary<Guid, int> usageCounts = new();
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private Guid? loadedListId;
    private string labelFilter = "";
    private readonly CreateLabelModel createModel = new();

    private IEnumerable<Label> FilteredLabels => labels is null
        ? []
        : labels.Where(l => string.IsNullOrWhiteSpace(labelFilter) || l.Name.Contains(labelFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId)
        {
            return;
        }

        loadedListId = ListId;
        notFound = false;
        taskList = null;
        labels = null;
        errorMessage = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        await LoadLabelsAsync();
    }

    private async Task LoadLabelsAsync()
    {
        labels = await QueryService.GetLabelsForListAsync(ListId);

        await using var db = await DbFactory.CreateDbContextAsync();
        var labelIds = labels.Select(l => l.Id).ToList();
        usageCounts = await db.WorkItemLabels
            .Where(wl => labelIds.Contains(wl.LabelId))
            .GroupBy(wl => wl.LabelId)
            .Select(g => new { LabelId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.LabelId, x => x.Count);
    }

    // Re-checks Admin at the moment of the write instead of trusting the decision made when the
    // page loaded. This circuit stays alive for as long as the tab is open — long enough for an
    // Owner to have demoted or removed this user — and every handler below performs a privileged
    // write, most of them destructive. See WorkspaceAccessGuard.
    private async Task<bool> StillAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, workspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        notFound = true;
        return false;
    }

    private async Task HandleCreate()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        var maxSortOrder = labels!.Count == 0 ? -1 : labels.Max(l => l.SortOrder);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.Labels.Add(new Label
            {
                Id = Guid.NewGuid(),
                TaskListId = ListId,
                Name = createModel.Name.Trim(),
                Description = string.IsNullOrWhiteSpace(createModel.Description) ? null : createModel.Description.Trim(),
                Color = createModel.Color,
                SortOrder = maxSortOrder + 1
            });
            await db.SaveChangesAsync();
        }

        createModel.Name = "";
        createModel.Description = "";
        createModel.Color = Palette[0].Hex;
        isSaving = false;
        await LoadLabelsAsync();
    }

    private async Task HandleDelete(Guid labelId)
    {
        var label = labels?.FirstOrDefault(l => l.Id == labelId);
        var uses = usageCounts.TryGetValue(labelId, out var count) ? count : 0;
        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("label", label?.Name,
                uses == 0 ? "Nenhuma tarefa usa esta label." : $"Ela sai de {uses} {(uses == 1 ? "tarefa" : "tarefas")}.")))
        {
            return;
        }

        if (!await StillAdminAsync())
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.WorkItemLabels.Where(l => l.LabelId == labelId).ExecuteDeleteAsync();
        await db.Labels.Where(l => l.Id == labelId).ExecuteDeleteAsync();
        await LoadLabelsAsync();
    }

    private static string ChipStyle(string hex) =>
        $"background-color: {hex}; color: {LabelColor.TextColorFor(hex)};";

    private class CreateLabelModel
    {
        [Required(ErrorMessage = "Informe um nome.")]
        [StringLength(50, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        [StringLength(200, ErrorMessage = "Descrição muito longa.")]
        public string Description { get; set; } = "";
        public string Color { get; set; } = Palette[0].Hex;
    }
}
