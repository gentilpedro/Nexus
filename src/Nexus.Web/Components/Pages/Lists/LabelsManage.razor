@page "/lists/{ListId:guid}/labels"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>Labels</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Lista não encontrada ou você não tem acesso a ela.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (taskList is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{workspaceId}")">@workspaceName</a> /
            <a href="@($"/workspaces/{workspaceId}/spaces/{taskList.SpaceId}")">@spaceName</a> /
            <a href="@($"/lists/{ListId}/list")">@taskList.Name</a> /
            Labels
        </div>

        <div class="page-header">
            <h1>Labels</h1>
        </div>

        @if (labels is not null)
        {
            <div class="stat-grid">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Total de labels</span>
                        <span class="stat-card-value">@labels.Count</span>
                    </div>
                    <span class="stat-card-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L3 3v6.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.82 0l4.6-4.6a2 2 0 0 0 0-2.82Z" /><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none" /></svg>
                    </span>
                </div>
                <div class="stat-card">
                    <div class="stat-card-body">
                        <span class="stat-card-label">Cores usadas</span>
                        <span class="stat-card-value">@labels.Select(l => l.Color).Distinct().Count()</span>
                    </div>
                    <span class="stat-card-icon is-success">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z" /></svg>
                    </span>
                </div>
            </div>
        }

        <EditForm Model="createModel" OnValidSubmit="HandleCreate" class="card" style="margin-bottom:1.5rem;">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label for="label-name">Nome</label>
                <InputText id="label-name" @bind-Value="createModel.Name" placeholder="Ex: Alta prioridade" />
                <ValidationMessage For="() => createModel.Name" />
            </div>
            <div class="form-field">
                <label for="label-description">Descrição (opcional)</label>
                <InputText id="label-description" @bind-Value="createModel.Description" placeholder="Pra que serve essa label?" />
            </div>
            <div class="form-field">
                <label>Cor</label>
                <div class="label-swatch-row">
                    @foreach (var color in Palette)
                    {
                        <button type="button"
                                class="label-swatch @(createModel.Color == color ? "is-selected" : "")"
                                style="background-color: @color;"
                                title="@color"
                                @onclick="() => createModel.Color = color">
                        </button>
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            <div class="form-actions">
                <button type="submit" class="btn" disabled="@isSaving">Adicionar label</button>
            </div>
        </EditForm>

        @if (labels is null)
        {
            <p>Carregando labels...</p>
        }
        else if (labels.Count == 0)
        {
            <div class="empty-state">
                <p>Nenhuma label criada ainda.</p>
            </div>
        }
        else
        {
            <div class="form-field" style="max-width:280px;">
                <input type="search" placeholder="Buscar labels..." @bind="labelFilter" @bind:event="oninput" />
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Label</th>
                            <th>Uso</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var label in FilteredLabels)
                        {
                            <tr>
                                <td>
                                    <span class="label-chip" style="@ChipStyle(label.Color)">@label.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(label.Description))
                                    {
                                        <div class="topnav-user" style="margin-top:0.25rem;">@label.Description</div>
                                    }
                                </td>
                                <td class="topnav-user">@(usageCounts.TryGetValue(label.Id, out var c) ? c : 0) tarefa@((usageCounts.TryGetValue(label.Id, out var c2) ? c2 : 0) == 1 ? "" : "s")</td>
                                <td><button type="button" class="btn-link" @onclick="() => HandleDelete(label.Id)">Excluir</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] Palette =
    [
        "#61BD4F", "#F2D600", "#FFAB4A", "#EB5A46", "#C377E0",
        "#0079BF", "#00C2E0", "#FF78CB", "#4D4D4D"
    ];

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<Label>? labels;
    private Dictionary<Guid, int> usageCounts = new();
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private Guid? loadedListId;
    private string labelFilter = "";
    private readonly CreateLabelModel createModel = new();

    private IEnumerable<Label> FilteredLabels => labels is null
        ? []
        : labels.Where(l => string.IsNullOrWhiteSpace(labelFilter) || l.Name.Contains(labelFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId)
        {
            return;
        }

        loadedListId = ListId;
        notFound = false;
        taskList = null;
        labels = null;
        errorMessage = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        await LoadLabelsAsync();
    }

    private async Task LoadLabelsAsync()
    {
        labels = await QueryService.GetLabelsForListAsync(ListId);

        await using var db = await DbFactory.CreateDbContextAsync();
        var labelIds = labels.Select(l => l.Id).ToList();
        usageCounts = await db.WorkItemLabels
            .Where(wl => labelIds.Contains(wl.LabelId))
            .GroupBy(wl => wl.LabelId)
            .Select(g => new { LabelId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.LabelId, x => x.Count);
    }

    private async Task HandleCreate()
    {
        isSaving = true;
        errorMessage = null;

        var maxSortOrder = labels!.Count == 0 ? -1 : labels.Max(l => l.SortOrder);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.Labels.Add(new Label
            {
                Id = Guid.NewGuid(),
                TaskListId = ListId,
                Name = createModel.Name.Trim(),
                Description = string.IsNullOrWhiteSpace(createModel.Description) ? null : createModel.Description.Trim(),
                Color = createModel.Color,
                SortOrder = maxSortOrder + 1
            });
            await db.SaveChangesAsync();
        }

        createModel.Name = "";
        createModel.Description = "";
        createModel.Color = Palette[0];
        isSaving = false;
        await LoadLabelsAsync();
    }

    private async Task HandleDelete(Guid labelId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.WorkItemLabels.Where(l => l.LabelId == labelId).ExecuteDeleteAsync();
        await db.Labels.Where(l => l.Id == labelId).ExecuteDeleteAsync();
        await LoadLabelsAsync();
    }

    private static string ChipStyle(string hex) =>
        $"background-color: {hex}; color: {LabelColor.TextColorFor(hex)};";

    private class CreateLabelModel
    {
        [Required(ErrorMessage = "Informe um nome.")]
        [StringLength(50, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        [StringLength(200, ErrorMessage = "Descrição muito longa.")]
        public string Description { get; set; } = "";
        public string Color { get; set; } = Palette[0];
    }
}
