@page "/lists/{ListId:guid}/labels"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>Labels</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <div class="empty-state">
            <p>Lista não encontrada ou você não tem acesso a ela.</p>
            <a class="btn" href="/workspaces">Voltar</a>
        </div>
    }
    else if (taskList is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="breadcrumbs">
            <a href="/workspaces">Workspaces</a> /
            <a href="@($"/workspaces/{workspaceId}")">@workspaceName</a> /
            <a href="@($"/workspaces/{workspaceId}/spaces/{taskList.SpaceId}")">@spaceName</a> /
            <a href="@($"/lists/{ListId}/list")">@taskList.Name</a> /
            Labels
        </div>

        <div class="page-header">
            <h1>Labels</h1>
        </div>

        <EditForm Model="createModel" OnValidSubmit="HandleCreate" class="card" style="margin-bottom:1.5rem;">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label for="label-name">Nome</label>
                <InputText id="label-name" @bind-Value="createModel.Name" placeholder="Ex: Alta prioridade" />
                <ValidationMessage For="() => createModel.Name" />
            </div>
            <div class="form-field">
                <label>Cor</label>
                <div class="label-swatch-row">
                    @foreach (var color in Palette)
                    {
                        <button type="button"
                                class="label-swatch @(createModel.Color == color ? "is-selected" : "")"
                                style="background-color: @color;"
                                title="@color"
                                @onclick="() => createModel.Color = color">
                        </button>
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            <div class="form-actions">
                <button type="submit" class="btn" disabled="@isSaving">Adicionar label</button>
            </div>
        </EditForm>

        @if (labels is null)
        {
            <p>Carregando labels...</p>
        }
        else if (labels.Count == 0)
        {
            <div class="empty-state">
                <p>Nenhuma label criada ainda.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Label</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var label in labels)
                        {
                            <tr>
                                <td><span class="label-chip" style="@ChipStyle(label.Color)">@label.Name</span></td>
                                <td><button type="button" class="btn-link" @onclick="() => HandleDelete(label.Id)">Excluir</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] Palette =
    [
        "#61BD4F", "#F2D600", "#FFAB4A", "#EB5A46", "#C377E0",
        "#0079BF", "#00C2E0", "#FF78CB", "#4D4D4D"
    ];

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<Label>? labels;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private Guid? loadedListId;
    private readonly CreateLabelModel createModel = new();

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId)
        {
            return;
        }

        loadedListId = ListId;
        notFound = false;
        taskList = null;
        labels = null;
        errorMessage = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        await LoadLabelsAsync();
    }

    private async Task LoadLabelsAsync()
    {
        labels = await QueryService.GetLabelsForListAsync(ListId);
    }

    private async Task HandleCreate()
    {
        isSaving = true;
        errorMessage = null;

        var maxSortOrder = labels!.Count == 0 ? -1 : labels.Max(l => l.SortOrder);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.Labels.Add(new Label
            {
                Id = Guid.NewGuid(),
                TaskListId = ListId,
                Name = createModel.Name.Trim(),
                Color = createModel.Color,
                SortOrder = maxSortOrder + 1
            });
            await db.SaveChangesAsync();
        }

        createModel.Name = "";
        createModel.Color = Palette[0];
        isSaving = false;
        await LoadLabelsAsync();
    }

    private async Task HandleDelete(Guid labelId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.WorkItemLabels.Where(l => l.LabelId == labelId).ExecuteDeleteAsync();
        await db.Labels.Where(l => l.Id == labelId).ExecuteDeleteAsync();
        await LoadLabelsAsync();
    }

    private static string ChipStyle(string hex) =>
        $"background-color: {hex}; color: {LabelColor.TextColorFor(hex)};";

    private class CreateLabelModel
    {
        [Required(ErrorMessage = "Informe um nome.")]
        [StringLength(50, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public string Color { get; set; } = Palette[0];
    }
}
