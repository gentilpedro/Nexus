@page "/lists/{ListId:guid}/calendar"
@attribute [Authorize]
@using System.Globalization
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext

<PageTitle>@(taskList?.Name ?? "Calendário")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Lista não encontrada"
                    Description="Ela pode ter sido excluída, ou você não tem mais acesso ao workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando a lista…" />
    }
    else
    {
        <ListPageHeader ListId="ListId" ListName="@taskList.Name"
                        WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                        SpaceId="taskList.SpaceId" SpaceName="@spaceName"
                        ActiveView="calendar" CanManage="canManageFields"
                        OnCreate="OpenCreate" />

        @if (workItems is null)
        {
            <Skeleton Variant="card" Count="3" Label="Carregando o calendário…" />
        }
        else
        {
            @if (itemsTruncated)
            {
                <div class="alert alert-warning" role="status">
                    <Icon Name="alert" />
                    <span>Esta lista tem mais de @WorkItemQueryService.MaxItemsPerView tarefas. O calendário mostra as @WorkItemQueryService.MaxItemsPerView primeiras.</span>
                </div>
            }

            <div class="calendar-toolbar">
                <div class="button-row">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="GoToToday" disabled="@IsCurrentMonth">Hoje</button>
                    <button type="button" class="icon-btn icon-btn--sm icon-btn--bordered" @onclick="PrevMonth"><Icon Name="chevron-left" Label="Mês anterior" /></button>
                    <button type="button" class="icon-btn icon-btn--sm icon-btn--bordered" @onclick="NextMonth"><Icon Name="chevron-right" Label="Próximo mês" /></button>
                </div>
                <h2 class="calendar-title" aria-live="polite">@MonthTitle</h2>
                @if (UndatedCount > 0)
                {
                    <p class="calendar-undated">@UndatedCount tarefa@(UndatedCount == 1 ? "" : "s") sem prazo não aparece@(UndatedCount == 1 ? "" : "m") aqui</p>
                }
            </div>

            <div class="calendar-grid" role="grid" aria-label="@MonthTitle">
                <div class="calendar-week calendar-week--head" role="row">
                    @foreach (var dayName in DayNames)
                    {
                        <div class="calendar-day-name" role="columnheader">@dayName</div>
                    }
                </div>
                @foreach (var week in CalendarDays.Chunk(7))
                {
                    <div class="calendar-week" role="row">
                        @foreach (var day in week)
                        {
                            var items = ItemsForDay(day);
                            var isToday = day.Date == DateTime.UtcNow.Date;
                            var expanded = expandedDays.Contains(day.Date);
                            var visible = expanded ? items : items.Take(MaxPillsPerDay).ToList();
                            <div class="calendar-day @(day.Month == currentMonth.Month ? "" : "is-outside") @(isToday ? "is-today" : "")" role="gridcell"
                                 aria-label="@DayLabel(day, items.Count)">
                                <span class="calendar-day-number" aria-hidden="true">@day.Day</span>
                                @foreach (var item in visible)
                                {
                                    <button type="button" class="calendar-task-pill @(item.Status.Category == StatusCategory.Done ? "is-done" : "")"
                                            style="--pill-color: var(--priority-@PriorityToken(item.Priority))"
                                            title="@item.Title" @onclick="() => OpenEdit(item)">
                                        @item.Title
                                    </button>
                                }
                                @if (items.Count > MaxPillsPerDay)
                                {
                                    <button type="button" class="calendar-more" @onclick="() => ToggleDay(day.Date)">
                                        @(expanded ? "Mostrar menos" : $"+{items.Count - MaxPillsPerDay} mais")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Celular: 7 colunas de 50px não comportam títulos — vira uma agenda do mês. *@
            <div class="calendar-agenda">
                @{
                    var daysWithItems = CalendarDays.Where(d => d.Month == currentMonth.Month && ItemsForDay(d).Count > 0).ToList();
                }
                @if (daysWithItems.Count == 0)
                {
                    <div class="card">
                        <EmptyState Compact="true" Title="@($"Nenhuma tarefa com prazo em {Culture.DateTimeFormat.GetMonthName(currentMonth.Month)}")" />
                    </div>
                }
                else
                {
                    @foreach (var day in daysWithItems)
                    {
                        <section class="calendar-agenda-day @(day.Date == DateTime.UtcNow.Date ? "is-today" : "")">
                            <h3 class="calendar-agenda-date">@Culture.TextInfo.ToTitleCase(day.ToString("dddd, d 'de' MMMM", Culture))</h3>
                            @foreach (var item in ItemsForDay(day))
                            {
                                <button type="button" class="calendar-task-pill @(item.Status.Category == StatusCategory.Done ? "is-done" : "")"
                                        style="--pill-color: var(--priority-@PriorityToken(item.Priority))" @onclick="() => OpenEdit(item)">
                                    @item.Title
                                </button>
                            }
                        </section>
                    }
                }
            </div>

            <div class="priority-legend" aria-label="Legenda de prioridade">
                <span class="priority-legend-title">Prioridade</span>
                <span class="priority-legend-item"><span class="priority-legend-dot" style="background:var(--priority-highest);"></span>@WorkItemPriority.Highest.ToDisplayLabel()</span>
                <span class="priority-legend-item"><span class="priority-legend-dot" style="background:var(--priority-high);"></span>@WorkItemPriority.High.ToDisplayLabel()</span>
                <span class="priority-legend-item"><span class="priority-legend-dot" style="background:var(--priority-medium);"></span>@WorkItemPriority.Medium.ToDisplayLabel()</span>
                <span class="priority-legend-item"><span class="priority-legend-dot" style="background:var(--priority-low);"></span>@WorkItemPriority.Low.ToDisplayLabel() e @WorkItemPriority.Lowest.ToDisplayLabel().ToLowerInvariant()</span>
            </div>
        }

        <TaskDetailPanel @ref="panel"
                          TaskListId="ListId"
                          Statuses="statuses ?? []"
                          AssigneeOptions="assigneeOptions ?? []"
                          EpicOptions="epics ?? []"
                          CustomFieldDefinitions="customFieldDefinitions ?? []"
                          StatusTransitions="statusTransitions ?? []"
                          Labels="labels ?? []"
                          OnSaved="ReloadWorkItemsAsync" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Culture = new("pt-BR");
    private static readonly string[] DayNames = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"];

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<WorkItem>? workItems;
    // True when the list holds more work items than WorkItemQueryService.MaxItemsPerView, so the
    // user is told they are looking at a partial list instead of silently seeing the first N.
    private bool itemsTruncated;
    private List<TaskStatusDefinition>? statuses;
    private List<(string UserId, string DisplayName)>? assigneeOptions;
    private List<WorkItem>? epics;
    private List<CustomFieldDefinition>? customFieldDefinitions;
    private List<StatusTransition>? statusTransitions;
    private List<Label>? labels;
    private bool notFound;
    private bool canManageFields;
    private TaskDetailPanel? panel;
    private Guid? loadedListId;
    private DateTime currentMonth = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);

    private List<DateTime> CalendarDays
    {
        get
        {
            var firstDayOfWeek = (int)currentMonth.DayOfWeek; // Sunday=0..Saturday=6
            var mondayOffset = firstDayOfWeek == 0 ? 6 : firstDayOfWeek - 1;
            var start = currentMonth.AddDays(-mondayOffset);
            return Enumerable.Range(0, 42).Select(i => start.AddDays(i)).ToList();
        }
    }

    private List<WorkItem> ItemsForDay(DateTime day) =>
        workItems?.Where(w => w.DueDateUtc?.Date == day.Date).ToList() ?? [];

    private void PrevMonth() => currentMonth = currentMonth.AddMonths(-1);
    private void NextMonth() => currentMonth = currentMonth.AddMonths(1);
    private void GoToToday() => currentMonth = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);

    private const int MaxPillsPerDay = 3;

    private static string DayLabel(DateTime day, int count) =>
        day.ToString("d 'de' MMMM", Culture) + (count == 0 ? "" : $", {count} {(count == 1 ? "tarefa" : "tarefas")}");
    private readonly HashSet<DateTime> expandedDays = new();

    private bool IsCurrentMonth => currentMonth.Year == DateTime.UtcNow.Year && currentMonth.Month == DateTime.UtcNow.Month;

    private string MonthTitle
    {
        get
        {
            var text = currentMonth.ToString("MMMM 'de' yyyy", Culture);
            return char.ToUpper(text[0], Culture) + text[1..];
        }
    }

    private int UndatedCount => workItems?.Count(w => w.DueDateUtc is null) ?? 0;

    private void ToggleDay(DateTime day)
    {
        if (!expandedDays.Remove(day))
        {
            expandedDays.Add(day);
        }
    }

    private static string PriorityToken(WorkItemPriority priority) => priority switch
    {
        WorkItemPriority.Highest => "highest",
        WorkItemPriority.High => "high",
        WorkItemPriority.Medium => "medium",
        _ => "low"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId) return;
        loadedListId = ListId;

        notFound = false;
        taskList = null;
        workItems = null;
        statuses = null;
        assigneeOptions = null;
        epics = null;
        customFieldDefinitions = null;
        statusTransitions = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManageFields = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        statuses = await QueryService.GetStatusesForListAsync(ListId);
        assigneeOptions = await QueryService.GetWorkspaceMemberOptionsAsync(workspaceId);
        epics = await QueryService.GetEpicsForListAsync(ListId);
        customFieldDefinitions = await QueryService.GetCustomFieldDefinitionsForListAsync(ListId);
        statusTransitions = await QueryService.GetStatusTransitionsForListAsync(ListId);
        labels = await QueryService.GetLabelsForListAsync(ListId);
        await ReloadWorkItemsAsync();
    }

    private async Task ReloadWorkItemsAsync()
    {
        var itemsPage = await QueryService.GetWorkItemsForListAsync(ListId);
        workItems = itemsPage.Items;
        itemsTruncated = itemsPage.IsTruncated;
        epics = await QueryService.GetEpicsForListAsync(ListId);
    }

    private void OpenCreate() => panel?.OpenForCreate();

    private async Task OpenEdit(WorkItem item)
    {
        if (panel is not null)
        {
            await panel.OpenForEdit(item);
        }
    }
}
