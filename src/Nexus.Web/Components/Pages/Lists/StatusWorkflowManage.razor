@page "/lists/{ListId:guid}/workflow"
@attribute [Authorize]
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Data.Common
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext

<PageTitle>Status e fluxo · Nexus</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Configurações indisponíveis"
                    Description="A lista não existe mais, ou você não é administrador do workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando configurações…" />
    }
    else
    {
        <ListSettingsHeader ListId="ListId" ListName="@taskList.Name"
                            WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                            SpaceId="taskList.SpaceId" SpaceName="@spaceName" Active="workflow" />

        <section class="section" aria-labelledby="statuses-title">
            <div class="section-header">
                <div>
                    <h2 id="statuses-title" class="section-title">Status</h2>
                    <p class="form-section-description">Cada status vira uma coluna do Kanban, na ordem abaixo. O status padrão é o de toda tarefa nova.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(deleteStatusErrorMessage))
            {
                <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@deleteStatusErrorMessage</span></div>
            }

            @if (statuses is null || statuses.Count == 0)
            {
                <div class="card"><EmptyState Compact="true" Title="Nenhum status ainda" /></div>
            }
            else
            {
                <ol class="card card--flush row-list settings-rows status-rows">
                    @for (var i = 0; i < statuses.Count; i++)
                    {
                        var s = statuses[i];
                        var index = i;
                        <li class="settings-row">
                            <span class="status-order" style="--column-color: @(s.Color ?? "var(--status-todo)")" aria-hidden="true">@(index + 1)</span>
                            <div class="settings-row-main">
                                <span class="settings-row-title">
                                    @s.Name
                                    @if (s.IsDefault)
                                    {
                                        <span class="badge badge--accent">Padrão</span>
                                    }
                                </span>
                            </div>
                            <label class="status-done-toggle">
                                <span class="switch">
                                    <input type="checkbox" class="switch-input" checked="@(s.Category == StatusCategory.Done)"
                                           @onchange="@(e => HandleToggleDone(s, (bool)e.Value!))" />
                                    <span class="switch-slider"></span>
                                </span>
                                <span>Conta como concluída</span>
                            </label>
                            <div class="table-row-actions">
                                <button type="button" class="icon-btn icon-btn--sm" disabled="@(index == 0)" @onclick="() => HandleMoveStatus(s, -1)">
                                    <Icon Name="arrow-up" Label="@($"Mover {s.Name} para cima")" />
                                </button>
                                <button type="button" class="icon-btn icon-btn--sm" disabled="@(index == statuses.Count - 1)" @onclick="() => HandleMoveStatus(s, 1)">
                                    <Icon Name="arrow-down" Label="@($"Mover {s.Name} para baixo")" />
                                </button>
                                @if (!s.IsDefault)
                                {
                                    <button type="button" class="btn-set-default" @onclick="() => HandleMakeDefault(s)">Tornar padrão</button>
                                }
                                <button type="button" class="icon-btn icon-btn--sm is-danger" @onclick="() => HandleDeleteStatus(s)">
                                    <Icon Name="trash" Label="@($"Excluir status {s.Name}")" />
                                </button>
                            </div>
                        </li>
                    }
                </ol>
            }

            <EditForm Model="createStatusModel" OnValidSubmit="HandleCreateStatus" class="card inline-add-form">
                <div class="form-field">
                    <label for="status-name">Novo status</label>
                    <InputText id="status-name" @bind-Value="createStatusModel.Name" placeholder="Ex.: Em revisão, Bloqueado, Aguardando cliente" />
                </div>
                <fieldset class="form-fieldset">
                    <legend class="field-label">Cor</legend>
                    <div class="color-swatch-row">
                        @foreach (var (color, colorName) in ColumnColors)
                        {
                            <button type="button" class="color-swatch @(createStatusModel.Color == color ? "is-selected" : "")"
                                    style="background:@color;" @onclick="() => createStatusModel.Color = color"
                                    aria-pressed="@(createStatusModel.Color == color ? "true" : "false")" aria-label="@colorName"></button>
                        }
                    </div>
                </fieldset>
                <button type="submit" class="btn @(isSavingStatus ? "is-loading" : "")" disabled="@isSavingStatus"><Icon Name="plus" /> Adicionar status</button>
                @if (!string.IsNullOrEmpty(statusErrorMessage))
                {
                    <p class="validation-message" role="alert">@statusErrorMessage</p>
                }
                <p class="field-hint inline-add-hint">O status novo entra como "a fazer". Ligue "Conta como concluída" se ele representar trabalho terminado — isso vale para o burndown e o progresso.</p>
            </EditForm>
        </section>

        <section class="section" aria-labelledby="transitions-title">
            <div class="section-header">
                <div>
                    <h2 id="transitions-title" class="section-title">Regras de transição</h2>
                    <p class="form-section-description">Sem regras, uma tarefa pode ir de qualquer status para qualquer outro. Com regras, só os caminhos listados são permitidos.</p>
                </div>
            </div>

            @if (transitions is null)
            {
                <Skeleton Count="3" />
            }
            else if (transitions.Count == 0)
            {
                <div class="card">
                    <EmptyState Compact="true" Title="Nenhuma regra — tudo liberado" Description="Adicione uma regra abaixo para restringir os caminhos." />
                </div>
            }
            else
            {
                <ul class="card card--flush row-list settings-rows">
                    @foreach (var t in transitions)
                    {
                        <li class="settings-row">
                            <div class="settings-row-main transition-row">
                                <StatusBadge Name="@t.FromStatus.Name" Category="t.FromStatus.Category" Color="@t.FromStatus.Color" />
                                <Icon Name="arrow-right" Class="icon--sm" />
                                <StatusBadge Name="@t.ToStatus.Name" Category="t.ToStatus.Category" Color="@t.ToStatus.Color" />
                            </div>
                            <button type="button" class="icon-btn icon-btn--sm is-danger" @onclick="() => HandleDelete(t.Id)">
                                <Icon Name="trash" Label="@($"Excluir regra de {t.FromStatus.Name} para {t.ToStatus.Name}")" />
                            </button>
                        </li>
                    }
                </ul>
            }

            <EditForm Model="createModel" OnValidSubmit="HandleCreate" class="card inline-add-form">
                <div class="form-field">
                    <label for="transition-from">De</label>
                    <InputSelect id="transition-from" @bind-Value="createModel.FromStatusId">
                        @foreach (var st in statuses ?? [])
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="transition-to">Para</label>
                    <InputSelect id="transition-to" @bind-Value="createModel.ToStatusId">
                        @foreach (var st in statuses ?? [])
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </InputSelect>
                </div>
                <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving"><Icon Name="plus" /> Adicionar regra</button>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="validation-message" role="alert">@errorMessage</p>
                }
            </EditForm>
        </section>

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<TaskStatusDefinition>? statuses;
    private List<StatusTransition>? transitions;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private Guid? loadedListId;
    private readonly CreateTransitionModel createModel = new();
    private readonly CreateStatusModel createStatusModel = new();
    private bool isSavingStatus;
    private string? statusErrorMessage;
    private string? deleteStatusErrorMessage;
    // Mesma família de cores de status do docs/design/paleta-de-cores.md (Kanban), com nome para o leitor de tela.
    private static readonly (string Hex, string Name)[] ColumnColors =
    [
        ("#5B5CEB", "Índigo"),
        ("#3B82F6", "Azul"),
        ("#A855F7", "Roxo"),
        ("#F59E0B", "Âmbar"),
        ("#22C55E", "Verde"),
        ("#EF4444", "Vermelho"),
        ("#94A3B8", "Cinza")
    ];

    private ConfirmDialog? confirm;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId)
        {
            return;
        }

        loadedListId = ListId;
        notFound = false;
        taskList = null;
        statuses = null;
        transitions = null;
        errorMessage = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        statuses = await QueryService.GetStatusesForListAsync(ListId);
        if (statuses.Count > 0)
        {
            createModel.FromStatusId = statuses[0].Id;
            createModel.ToStatusId = statuses[0].Id;
        }
        await LoadTransitionsAsync();
    }

    private async Task LoadTransitionsAsync()
    {
        transitions = await QueryService.GetStatusTransitionsForListAsync(ListId);
    }

    // Re-checks Admin at the moment of the write instead of trusting the decision made when the
    // page loaded. This circuit stays alive for as long as the tab is open — long enough for an
    // Owner to have demoted or removed this user — and every handler below performs a privileged
    // write, most of them destructive (deleting statuses, rewriting the workflow rules that gate
    // every status change in the list). See WorkspaceAccessGuard.
    private async Task<bool> StillAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, workspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        notFound = true;
        return false;
    }

    private async Task HandleCreate()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        if (createModel.FromStatusId == createModel.ToStatusId)
        {
            errorMessage = "Escolha dois status diferentes.";
            isSaving = false;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var alreadyExists = await db.StatusTransitions.AnyAsync(t =>
                t.FromStatusId == createModel.FromStatusId && t.ToStatusId == createModel.ToStatusId);

            if (alreadyExists)
            {
                errorMessage = "Essa transição já existe.";
                isSaving = false;
                return;
            }

            db.StatusTransitions.Add(new StatusTransition
            {
                Id = Guid.NewGuid(),
                FromStatusId = createModel.FromStatusId,
                ToStatusId = createModel.ToStatusId
            });
            await db.SaveChangesAsync();
        }

        isSaving = false;
        await LoadTransitionsAsync();
    }

    private async Task HandleDelete(Guid transitionId)
    {
        var rule = transitions?.FirstOrDefault(t => t.Id == transitionId);
        if (confirm is null || !await confirm.AskAsync(new ConfirmRequest(
                Title: rule is null ? "Excluir regra?" : $"Excluir a regra \"{rule.FromStatus.Name} → {rule.ToStatus.Name}\"?",
                Message: "Se esta for a última regra, qualquer mudança de status volta a ser permitida.",
                ConfirmLabel: "Excluir regra")))
        {
            return;
        }

        if (!await StillAdminAsync())
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.StatusTransitions.Where(t => t.Id == transitionId).ExecuteDeleteAsync();
        await LoadTransitionsAsync();
    }

    private async Task LoadStatusesAsync()
    {
        statuses = await QueryService.GetStatusesForListAsync(ListId);
    }

    private async Task HandleCreateStatus()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSavingStatus = true;
        statusErrorMessage = null;

        if (string.IsNullOrWhiteSpace(createStatusModel.Name))
        {
            statusErrorMessage = "Informe um nome.";
            isSavingStatus = false;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var maxSortOrder = await db.TaskStatusDefinitions
                .Where(s => s.TaskListId == ListId)
                .Select(s => (int?)s.SortOrder)
                .MaxAsync() ?? -1;

            db.TaskStatusDefinitions.Add(new TaskStatusDefinition
            {
                Id = Guid.NewGuid(),
                TaskListId = ListId,
                Name = createStatusModel.Name.Trim(),
                Color = createStatusModel.Color,
                Category = StatusCategory.ToDo,
                SortOrder = maxSortOrder + 1,
                IsDefault = false
            });
            await db.SaveChangesAsync();
        }

        createStatusModel.Name = "";
        isSavingStatus = false;
        await LoadStatusesAsync();
    }

    private async Task HandleMoveStatus(TaskStatusDefinition status, int direction)
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        if (statuses is null)
        {
            return;
        }

        var index = statuses.IndexOf(status);
        var swapIndex = index + direction;
        if (swapIndex < 0 || swapIndex >= statuses.Count)
        {
            return;
        }

        var neighbor = statuses[swapIndex];

        await using var db = await DbFactory.CreateDbContextAsync();
        (status.SortOrder, neighbor.SortOrder) = (neighbor.SortOrder, status.SortOrder);

        await db.TaskStatusDefinitions.Where(s => s.Id == status.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.SortOrder, status.SortOrder));
        await db.TaskStatusDefinitions.Where(s => s.Id == neighbor.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.SortOrder, neighbor.SortOrder));

        await LoadStatusesAsync();
    }

    private async Task HandleMakeDefault(TaskStatusDefinition status)
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.TaskStatusDefinitions.Where(s => s.TaskListId == ListId)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.IsDefault, false));
        await db.TaskStatusDefinitions.Where(s => s.Id == status.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.IsDefault, true));

        await LoadStatusesAsync();
    }

    private async Task HandleToggleDone(TaskStatusDefinition status, bool isDone)
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        var newCategory = isDone ? StatusCategory.Done : StatusCategory.ToDo;
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.TaskStatusDefinitions.Where(s => s.Id == status.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.Category, newCategory));

        status.Category = newCategory;
    }

    private async Task HandleDeleteStatus(TaskStatusDefinition status)
    {
        deleteStatusErrorMessage = null;

        if (!await StillAdminAsync())
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Checa antes de apagar qualquer coisa: antes, as regras do fluxo eram excluídas e só
        // depois a exclusão do status falhava (por ainda ter tarefas), deixando o fluxo mutilado.
        if (await db.WorkItems.AnyAsync(w => w.StatusId == status.Id))
        {
            deleteStatusErrorMessage = $"Ainda há tarefas em \"{status.Name}\". Mova-as para outro status antes de excluí-lo.";
            return;
        }

        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("status", status.Name,
                "A coluna sai do Kanban e as regras de transição que usam esse status também são removidas.")))
        {
            return;
        }

        // StatusTransition.FromStatusId/ToStatusId are both Restrict (see
        // StatusTransitionConfiguration) — clear any transitions referencing this status
        // first, or the delete below fails.
        await db.StatusTransitions
            .Where(t => t.FromStatusId == status.Id || t.ToStatusId == status.Id)
            .ExecuteDeleteAsync();

        try
        {
            await db.TaskStatusDefinitions.Where(s => s.Id == status.Id).ExecuteDeleteAsync();
        }
        catch (DbException)
        {
            // ExecuteDeleteAsync bypasses SaveChanges, so a Restrict FK violation (a WorkItem
            // still using this status) surfaces as the provider's own exception, not DbUpdateException.
            deleteStatusErrorMessage = "Mova as tarefas desse status para outro antes de excluí-lo.";
            return;
        }

        await LoadStatusesAsync();
        await LoadTransitionsAsync();
    }

    private class CreateTransitionModel
    {
        public Guid FromStatusId { get; set; }
        public Guid ToStatusId { get; set; }
    }

    private class CreateStatusModel
    {
        public string Name { get; set; } = "";
        public string Color { get; set; } = ColumnColors[0].Hex;
    }
}
