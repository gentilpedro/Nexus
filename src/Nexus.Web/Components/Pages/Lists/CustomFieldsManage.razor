@page "/lists/{ListId:guid}/fields"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Extensions
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject Nexus.Web.Authorization.WorkspaceAccessGuard AccessGuard
@inject NavigationContextService NavContext

<PageTitle>Campos customizados · Nexus</PageTitle>

<div class="page-container">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Configurações indisponíveis"
                    Description="A lista não existe mais, ou você não é administrador do workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando configurações…" />
    }
    else
    {
        <ListSettingsHeader ListId="ListId" ListName="@taskList.Name"
                            WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                            SpaceId="taskList.SpaceId" SpaceName="@spaceName" Active="fields" />

        <div class="settings-split">
            <EditForm Model="createModel" OnValidSubmit="HandleCreate" class="card settings-split-form">
                <h2 class="form-section-title">Novo campo</h2>
                <p class="form-section-description">Campos customizados guardam informações próprias do seu processo em cada tarefa desta lista — cliente, orçamento, link do protótipo…</p>
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="field-name" class="required">Nome</label>
                    <InputText id="field-name" @bind-Value="createModel.Name" placeholder="Ex.: Cliente" />
                    <ValidationMessage For="() => createModel.Name" />
                </div>
                <div class="form-field">
                    <label for="field-type">Tipo</label>
                    <InputSelect id="field-type" @bind-Value="createModel.Type">
                        @foreach (var t in Enum.GetValues<CustomFieldType>())
                        {
                            <option value="@t">@t.ToDisplayLabel()</option>
                        }
                    </InputSelect>
                </div>
                @if (createModel.Type == CustomFieldType.Select)
                {
                    <div class="form-field">
                        <label for="field-options" class="required">Opções</label>
                        <InputText id="field-options" @bind-Value="createModel.OptionsCsv" placeholder="Ex.: Baixa, Média, Alta" />
                        <span class="field-hint">Separe as opções por vírgula.</span>
                    </div>
                }
                <label class="checkbox-field">
                    <InputCheckbox @bind-Value="createModel.Required" />
                    <span>Obrigatório — a tarefa só é salva com este campo preenchido</span>
                </label>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
                }
                <div class="form-actions form-actions--end">
                    <button type="submit" class="btn @(isSaving ? "is-loading" : "")" disabled="@isSaving"><Icon Name="plus" /> Adicionar campo</button>
                </div>
            </EditForm>

            <section class="settings-split-list" aria-labelledby="fields-title">
                <div class="section-header">
                    <h2 id="fields-title" class="section-title">Campos desta lista @if (definitions is not null) { <span class="tab-count">@definitions.Count</span> }</h2>
                </div>
                @if (definitions is null)
                {
                    <Skeleton Count="4" />
                }
                else if (definitions.Count == 0)
                {
                    <div class="card">
                        <EmptyState Compact="true" Title="Nenhum campo customizado ainda" Description="As tarefas usam só os campos padrão. Crie um campo no formulário ao lado." />
                    </div>
                }
                else
                {
                    <ul class="card card--flush row-list settings-rows">
                        @foreach (var def in definitions)
                        {
                            <li class="settings-row">
                                <div class="settings-row-main">
                                    <span class="settings-row-title">
                                        @def.Name
                                        @if (def.Required)
                                        {
                                            <span class="badge badge--outline">Obrigatório</span>
                                        }
                                    </span>
                                    <span class="settings-row-sub">
                                        @def.Type.ToDisplayLabel()
                                        @if (def.Type == CustomFieldType.Select && def.Options.Count > 0)
                                        {
                                            <text> · @string.Join(", ", def.Options.Select(o => o.Label))</text>
                                        }
                                    </span>
                                </div>
                                <button type="button" class="icon-btn icon-btn--sm is-danger" @onclick="() => HandleDelete(def.Id)">
                                    <Icon Name="trash" Label="@($"Excluir campo {def.Name}")" />
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <ConfirmDialog @ref="confirm" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<CustomFieldDefinition>? definitions;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;
    private Guid? loadedListId;
    private readonly CreateFieldModel createModel = new();

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId)
        {
            return;
        }

        loadedListId = ListId;
        notFound = false;
        taskList = null;
        definitions = null;
        errorMessage = null;

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        await LoadDefinitionsAsync();
    }

    private async Task LoadDefinitionsAsync()
    {
        definitions = await QueryService.GetCustomFieldDefinitionsForListAsync(ListId);
    }

    // Re-checks Admin at the moment of the write instead of trusting the decision made when the
    // page loaded. This circuit stays alive for as long as the tab is open — long enough for an
    // Owner to have demoted or removed this user — and every handler below performs a privileged
    // write, most of them destructive. See WorkspaceAccessGuard.
    private async Task<bool> StillAdminAsync()
    {
        if (await AccessGuard.HasAccessAsync(AuthStateTask, workspaceId, WorkspaceRole.Admin))
        {
            return true;
        }

        notFound = true;
        return false;
    }

    private async Task HandleCreate()
    {
        if (!await StillAdminAsync())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        var maxSortOrder = definitions!.Count == 0 ? -1 : definitions.Max(d => d.SortOrder);

        var definition = new CustomFieldDefinition
        {
            Id = Guid.NewGuid(),
            TaskListId = ListId,
            Name = createModel.Name.Trim(),
            Type = createModel.Type,
            Required = createModel.Required,
            SortOrder = maxSortOrder + 1
        };

        if (createModel.Type == CustomFieldType.Select)
        {
            var labels = createModel.OptionsCsv
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct()
                .ToList();

            if (labels.Count == 0)
            {
                errorMessage = "Informe pelo menos uma opção separada por vírgula.";
                isSaving = false;
                return;
            }

            for (var i = 0; i < labels.Count; i++)
            {
                definition.Options.Add(new CustomFieldOption { Id = Guid.NewGuid(), Label = labels[i], SortOrder = i });
            }
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.CustomFieldDefinitions.Add(definition);
            await db.SaveChangesAsync();
        }

        createModel.Name = "";
        createModel.Type = CustomFieldType.Text;
        createModel.OptionsCsv = "";
        createModel.Required = false;
        isSaving = false;
        await LoadDefinitionsAsync();
    }

    private ConfirmDialog? confirm;

    private async Task HandleDelete(Guid definitionId)
    {
        var def = definitions?.FirstOrDefault(d => d.Id == definitionId);
        if (confirm is null || !await confirm.AskAsync(ConfirmRequest.Delete("campo", def?.Name,
                "Os valores preenchidos nesse campo, em todas as tarefas da lista, também serão apagados.")))
        {
            return;
        }

        if (!await StillAdminAsync())
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.CustomFieldValues.Where(v => v.CustomFieldDefinitionId == definitionId).ExecuteDeleteAsync();
        await db.CustomFieldDefinitions.Where(f => f.Id == definitionId).ExecuteDeleteAsync();
        await LoadDefinitionsAsync();
    }

    private class CreateFieldModel
    {
        [Required(ErrorMessage = "Informe um nome.")]
        [StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";
        public CustomFieldType Type { get; set; } = CustomFieldType.Text;
        public string OptionsCsv { get; set; } = "";
        public bool Required { get; set; }
    }
}
