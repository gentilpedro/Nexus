@page "/lists/{ListId:guid}/backlog"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Authorization
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject WorkItemQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject NavigationContextService NavContext
@inject ToastService Toasts

<PageTitle>@(taskList?.Name ?? "Backlog")</PageTitle>

<div class="page-container page-container--wide">
    @if (notFound)
    {
        <EmptyState Icon="lock" Title="Lista não encontrada"
                    Description="Ela pode ter sido excluída, ou você não tem mais acesso ao workspace dela.">
            <a class="btn btn-secondary" href="/workspaces">Ver meus workspaces</a>
        </EmptyState>
    }
    else if (taskList is null)
    {
        <Skeleton Count="6" Label="Carregando a lista…" />
    }
    else
    {
        <ListPageHeader ListId="ListId" ListName="@taskList.Name"
                        WorkspaceId="workspaceId" WorkspaceName="@workspaceName"
                        SpaceId="taskList.SpaceId" SpaceName="@spaceName"
                        ActiveView="backlog" CanManage="canManageFields"
                        OnCreate="OpenCreate" ShowCreate="canManage">
            <ExtraActions>
                @if (completedSprints is { Count: > 0 })
                {
                    <button type="button" class="btn btn-ghost" aria-pressed="@(showHistory ? "true" : "false")" @onclick="() => showHistory = !showHistory">
                        <Icon Name="clock" /> <span class="label-collapsible">Histórico</span>
                    </button>
                }
                @if (canManage)
                {
                    <button type="button" class="btn btn-secondary" @onclick="ToggleCreateSprintForm">
                        <Icon Name="zap" /> Criar sprint
                    </button>
                }
            </ExtraActions>
        </ListPageHeader>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert-circle" /> <span>@errorMessage</span></div>
        }

        @if (showCreateSprintForm)
        {
            <EditForm Model="createSprintModel" OnValidSubmit="HandleCreateSprint" class="card inline-form">
                <div class="card-header">
                    <h2 class="card-title">Nova sprint</h2>
                </div>
                <DataAnnotationsValidator />
                <div class="form-row">
                    <div class="form-field">
                        <label for="sprint-name" class="required">Nome</label>
                        <InputText id="sprint-name" @bind-Value="createSprintModel.Name" placeholder="Ex.: Sprint 12" autofocus />
                        <ValidationMessage For="() => createSprintModel.Name" />
                    </div>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="sprint-start">Início</label>
                            <InputDate id="sprint-start" @bind-Value="createSprintModel.StartDate" />
                        </div>
                        <div class="form-field">
                            <label for="sprint-end">Término</label>
                            <InputDate id="sprint-end" @bind-Value="createSprintModel.EndDate" />
                        </div>
                    </div>
                </div>
                <div class="form-field">
                    <label for="sprint-goal">Meta <span class="field-hint">(opcional)</span></label>
                    <InputTextArea id="sprint-goal" @bind-Value="createSprintModel.Goal" rows="2" placeholder="O que o time quer entregar até o fim desta sprint?" />
                </div>
                <div class="form-actions form-actions--end">
                    <button type="button" class="btn btn-ghost" @onclick="ToggleCreateSprintForm">Cancelar</button>
                    <button type="submit" class="btn @(isSavingSprint ? "is-loading" : "")" disabled="@isSavingSprint">Criar sprint</button>
                </div>
            </EditForm>
        }

        @if (sprints is null)
        {
            <Skeleton Count="6" Label="Carregando o backlog…" />
        }
        else
        {
            @if (itemsTruncated)
            {
                <div class="alert alert-warning" role="status">
                    <Icon Name="alert" />
                    <span>O backlog tem mais de @WorkItemQueryService.MaxItemsPerView tarefas. Mostrando as @WorkItemQueryService.MaxItemsPerView primeiras.</span>
                </div>
            }

            <div class="list-toolbar">
                <div class="input-with-icon list-toolbar-search">
                    <Icon Name="search" />
                    <label for="backlog-filter" class="sr-only">Filtrar tarefas do backlog</label>
                    <input id="backlog-filter" type="search" placeholder="Filtrar tarefas" @bind="filterText" @bind:event="oninput" />
                </div>
                <div class="pill-tabs" role="group" aria-label="Filtrar tarefas">
                    <button type="button" aria-pressed="@(rowFilter == "all" ? "true" : "false")" class="@(rowFilter == "all" ? "active" : "")" @onclick='() => rowFilter = "all"'>Todas <span class="tab-count">@AllItems.Count</span></button>
                    <button type="button" aria-pressed="@(rowFilter == "mine" ? "true" : "false")" class="@(rowFilter == "mine" ? "active" : "")" @onclick='() => rowFilter = "mine"'>Minhas <span class="tab-count">@AllItems.Count(w => w.AssigneeId == currentUserId)</span></button>
                    <button type="button" aria-pressed="@(rowFilter == "urgent" ? "true" : "false")" class="@(rowFilter == "urgent" ? "active" : "")" @onclick='() => rowFilter = "urgent"'>Urgentes <span class="tab-count">@AllItems.Count(w => w.Priority is WorkItemPriority.High or WorkItemPriority.Highest)</span></button>
                </div>
            </div>

            <p class="list-summary">
                <span><strong>@AllItems.Count</strong> tarefa@(AllItems.Count == 1 ? "" : "s")</span>
                <span class="@(BacklogOverdueCount > 0 ? "text-danger" : "")"><strong>@BacklogOverdueCount</strong> atrasada@(BacklogOverdueCount == 1 ? "" : "s")</span>
                <span title="Média de tarefas concluídas por sprint finalizada"><strong>@SprintVelocity</strong> de velocidade (tarefas/sprint)</span>
                <span class="list-summary-hint">Arraste tarefas entre o backlog e as sprints para planejar.</span>
            </p>

            @if (sprints.Count == 0 && canManage && !showCreateSprintForm)
            {
                <div class="callout">
                    <Icon Name="zap" />
                    <div>
                        <strong>Organize o trabalho em sprints</strong>
                        <p>Crie uma sprint, arraste para ela as tarefas das próximas semanas e acompanhe o progresso pelo burndown.</p>
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleCreateSprintForm">Criar sprint</button>
                </div>
            }

            @foreach (var sprint in sprints)
            {
                <SprintSection Sprint="sprint"
                               Items="FilteredItems(sprint.WorkItems.OrderBy(w => w.SortOrder))"
                               CanManage="canManage"
                               AnotherSprintActive="hasActiveSprint && sprint.Status != SprintStatus.Active"
                               OnCardClick="OpenEdit"
                               OnCardMoved="HandleCardMoved"
                               OnStart="HandleStart"
                               OnComplete="HandleComplete" />
            }

            <SprintSection Sprint="null"
                           Items="FilteredItems(backlogItems ?? [])"
                           CanManage="canManage"
                           OnCardClick="OpenEdit"
                           OnCardMoved="HandleCardMoved" />

            @if (showHistory && completedSprints is { Count: > 0 })
            {
                <section class="section sprint-history" aria-labelledby="sprint-history-title">
                    <h2 id="sprint-history-title" class="section-title">Sprints concluídas</h2>
                    <ul class="card card--flush row-list">
                        @foreach (var cs in completedSprints)
                        {
                            <li class="sprint-history-item">
                                <div>
                                    <strong>@cs.Name</strong>
                                    <span class="cell-muted">@cs.StartDateUtc.ToString("dd/MM/yyyy") a @cs.EndDateUtc.ToString("dd/MM/yyyy") · @cs.WorkItems.Count(w => w.Status.Category == StatusCategory.Done) concluídas</span>
                                </div>
                                <a class="btn btn-ghost btn-sm" href="@($"/sprints/{cs.Id}/burndown")"><Icon Name="trending-down" /> Burndown</a>
                            </li>
                        }
                    </ul>
                </section>
            }
        }

        <ConfirmDialog @ref="confirm" />

        <TaskDetailPanel @ref="panel"
                          TaskListId="ListId"
                          Statuses="statuses ?? []"
                          AssigneeOptions="assigneeOptions ?? []"
                          EpicOptions="epics ?? []"
                          CustomFieldDefinitions="customFieldDefinitions ?? []"
                          StatusTransitions="statusTransitions ?? []"
                          Labels="labels ?? []"
                          OnSaved="ReloadAsync" />
    }
</div>

@code {
    [Parameter]
    public Guid ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TaskList? taskList;
    private string workspaceName = "";
    private string spaceName = "";
    private Guid workspaceId;
    private List<Sprint>? sprints;
    private List<Sprint>? completedSprints;
    private List<WorkItem>? backlogItems;
    // True when the backlog holds more items than WorkItemQueryService.MaxItemsPerView.
    private bool itemsTruncated;
    private List<TaskStatusDefinition>? statuses;
    private List<(string UserId, string DisplayName)>? assigneeOptions;
    private List<WorkItem>? epics;
    private List<CustomFieldDefinition>? customFieldDefinitions;
    private List<StatusTransition>? statusTransitions;
    private List<Label>? labels;
    private bool notFound;
    private bool canManage;
    private bool canManageFields;
    private ConfirmDialog? confirm;

    private int BacklogOverdueCount => AllItems.Count(w => w.Status.Category != StatusCategory.Done && w.DueDateUtc is DateTime d && d.Date < DateTime.UtcNow.Date);
    private bool showCreateSprintForm;
    private bool isSavingSprint;
    private bool showHistory;
    private string filterText = "";
    private string rowFilter = "all";
    private string? currentUserId;
    private string? errorMessage;
    private TaskDetailPanel? panel;
    private readonly CreateSprintModel createSprintModel = new();
    private Guid? loadedListId;

    private bool hasActiveSprint => sprints?.Any(s => s.Status == SprintStatus.Active) ?? false;

    private List<WorkItem> AllItems =>
        (sprints?.SelectMany(s => s.WorkItems) ?? []).Concat(backlogItems ?? []).ToList();

    // Real, schema-backed stand-in for "sprint velocity" — there's no story-point field on
    // WorkItem, so this counts delivered tasks per completed sprint instead of story points.
    private string SprintVelocity
    {
        get
        {
            if (completedSprints is not { Count: > 0 })
            {
                return "—";
            }

            var avg = completedSprints.Average(s => s.WorkItems.Count(w => w.Status.Category == StatusCategory.Done));
            return avg.ToString("0.#");
        }
    }

    private List<WorkItem> FilteredItems(IEnumerable<WorkItem> items)
    {
        var query = items;

        if (!string.IsNullOrWhiteSpace(filterText))
        {
            query = query.Where(w => w.Title.Contains(filterText, StringComparison.OrdinalIgnoreCase));
        }

        query = rowFilter switch
        {
            "mine" => query.Where(w => w.AssigneeId == currentUserId),
            "urgent" => query.Where(w => w.Priority is WorkItemPriority.High or WorkItemPriority.Highest),
            _ => query
        };

        return query.ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedListId == ListId) return;
        loadedListId = ListId;

        notFound = false;
        taskList = null;
        sprints = null;
        completedSprints = null;
        backlogItems = null;
        statuses = null;
        assigneeOptions = null;
        epics = null;
        customFieldDefinitions = null;
        statusTransitions = null;
        showCreateSprintForm = false;
        showHistory = false;
        filterText = "";
        rowFilter = "all";
        errorMessage = null;

        var authStateForUser = await AuthStateTask!;
        currentUserId = authStateForUser.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var resolvedWorkspaceId = await QueryService.GetWorkspaceIdForListAsync(ListId);
        if (resolvedWorkspaceId is null)
        {
            notFound = true;
            return;
        }
        workspaceId = resolvedWorkspaceId.Value;

        var authState = await AuthStateTask!;
        var authResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Member));

        if (!authResult.Succeeded)
        {
            notFound = true;
            return;
        }
        canManage = true;

        var adminResult = await AuthorizationService.AuthorizeAsync(
            authState.User, workspaceId, new WorkspaceAccessRequirement(WorkspaceRole.Admin));
        canManageFields = adminResult.Succeeded;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            taskList = await db.TaskLists
                .Include(l => l.Space)
                .ThenInclude(s => s.Workspace)
                .FirstOrDefaultAsync(l => l.Id == ListId);
        }

        if (taskList is null)
        {
            notFound = true;
            return;
        }

        workspaceName = taskList.Space.Workspace.Name;
        spaceName = taskList.Space.Name;

        NavContext.SetList(workspaceId, workspaceName, taskList.SpaceId, ListId);

        statuses = await QueryService.GetStatusesForListAsync(ListId);
        assigneeOptions = await QueryService.GetWorkspaceMemberOptionsAsync(workspaceId);
        epics = await QueryService.GetEpicsForListAsync(ListId);
        customFieldDefinitions = await QueryService.GetCustomFieldDefinitionsForListAsync(ListId);
        statusTransitions = await QueryService.GetStatusTransitionsForListAsync(ListId);
        labels = await QueryService.GetLabelsForListAsync(ListId);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        sprints = await QueryService.GetSprintsForListAsync(ListId);
        completedSprints = await QueryService.GetCompletedSprintsForListAsync(ListId);
        var backlogPage = await QueryService.GetBacklogItemsAsync(ListId);
        backlogItems = backlogPage.Items;
        itemsTruncated = backlogPage.IsTruncated;
        epics = await QueryService.GetEpicsForListAsync(ListId);
        StateHasChanged();
    }

    private void OpenCreate() => panel?.OpenForCreate();

    private async Task OpenEdit(WorkItem item)
    {
        if (panel is not null)
        {
            await panel.OpenForEdit(item);
        }
    }

    private async Task<bool> HandleCardMoved((Guid WorkItemId, Guid? NewSprintId, int NewIndex) move)
    {
        var allowed = await QueryService.UpdateWorkItemSprintAsync(ListId, move.WorkItemId, move.NewSprintId, move.NewIndex);
        await ReloadAsync();
        return allowed;
    }

    private async Task HandleStart(Guid sprintId)
    {
        var started = await QueryService.StartSprintAsync(ListId, sprintId);
        errorMessage = started ? null : "Já existe um sprint ativo nessa lista. Conclua-o antes de iniciar outro.";
        await ReloadAsync();
    }

    private async Task HandleComplete(Guid sprintId)
    {
        var sprint = sprints?.FirstOrDefault(sp => sp.Id == sprintId);
        var unfinished = sprint?.WorkItems.Count(w => w.Status.Category != StatusCategory.Done) ?? 0;
        var consequence = unfinished == 0
            ? "Todas as tarefas desta sprint estão concluídas."
            : $"{unfinished} {(unfinished == 1 ? "tarefa não concluída volta" : "tarefas não concluídas voltam")} para o backlog geral.";

        if (confirm is null || !await confirm.AskAsync(new ConfirmRequest(
                Title: $"Finalizar \"{sprint?.Name}\"?",
                Message: $"{consequence} Uma sprint finalizada não pode ser reaberta.",
                ConfirmLabel: "Finalizar sprint",
                Destructive: false)))
        {
            return;
        }

        await QueryService.CompleteSprintAsync(ListId, sprintId);
        Toasts.Show("Sprint finalizada");
        await ReloadAsync();
    }

    private void ToggleCreateSprintForm()
    {
        showCreateSprintForm = !showCreateSprintForm;
        createSprintModel.Name = "";
        createSprintModel.Goal = null;
        createSprintModel.StartDate = DateTime.Today;
        createSprintModel.EndDate = DateTime.Today.AddDays(14);
    }

    private async Task HandleCreateSprint()
    {
        if (createSprintModel.EndDate <= createSprintModel.StartDate)
        {
            errorMessage = "A data de término precisa ser depois da data de início.";
            return;
        }

        isSavingSprint = true;
        errorMessage = null;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.Sprints.Add(new Sprint
            {
                Id = Guid.NewGuid(),
                TaskListId = ListId,
                Name = createSprintModel.Name.Trim(),
                Goal = string.IsNullOrWhiteSpace(createSprintModel.Goal) ? null : createSprintModel.Goal.Trim(),
                StartDateUtc = DateTime.SpecifyKind(createSprintModel.StartDate, DateTimeKind.Utc),
                EndDateUtc = DateTime.SpecifyKind(createSprintModel.EndDate, DateTimeKind.Utc),
                Status = SprintStatus.Planned,
                CreatedAtUtc = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
        }

        showCreateSprintForm = false;
        isSavingSprint = false;
        await ReloadAsync();
    }

    private class CreateSprintModel
    {
        [Required(ErrorMessage = "Informe um nome.")]
        [StringLength(200, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";

        [StringLength(1000, ErrorMessage = "Meta muito longa.")]
        public string? Goal { get; set; }

        [Required(ErrorMessage = "Informe a data de início.")]
        public DateTime StartDate { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "Informe a data de término.")]
        public DateTime EndDate { get; set; } = DateTime.Today.AddDays(14);
    }
}
