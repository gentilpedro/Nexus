@page "/notifications"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Notificações</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Notificações</h1>
        @if (notifications is { Count: > 0 } && notifications.Any(n => !n.IsRead))
        {
            <button type="button" class="btn btn-secondary" @onclick="MarkAllRead">Marcar todas como lidas</button>
        }
    </div>

    @if (notifications is null)
    {
        <p>Carregando...</p>
    }
    else if (notifications.Count == 0)
    {
        <div class="empty-state">
            <p>Nenhuma notificação ainda.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var n in notifications)
            {
                <div class="notification-item @(n.IsRead ? "" : "is-unread")" @onclick="() => OpenAsync(n)">
                    <div class="notification-message">@n.Message</div>
                    <div class="notification-time">@n.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<Notification>? notifications;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (userId is null)
        {
            notifications = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        notifications = await db.Notifications
            .Where(n => n.UserId == userId)
            .Include(n => n.WorkItem)
            .OrderByDescending(n => n.CreatedAtUtc)
            .Take(200)
            .ToListAsync();
    }

    private async Task OpenAsync(Notification notification)
    {
        if (!notification.IsRead)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Notifications.Where(n => n.Id == notification.Id).ExecuteUpdateAsync(s => s.SetProperty(x => x.IsRead, true));
            notification.IsRead = true;
        }

        if (notification.WorkItem is not null)
        {
            NavigationManager.NavigateTo($"/lists/{notification.WorkItem.TaskListId}/list");
        }
    }

    private async Task MarkAllRead()
    {
        if (userId is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Notifications.Where(n => n.UserId == userId && !n.IsRead).ExecuteUpdateAsync(s => s.SetProperty(x => x.IsRead, true));
        await LoadAsync();
    }
}
