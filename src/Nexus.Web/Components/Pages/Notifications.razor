@page "/notifications"
@attribute [Authorize]
@using System.Security.Claims
@using Nexus.Domain.Entities
@using Nexus.Infrastructure.Data
@using Nexus.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject NotificationBadgeService Badge

<PageTitle>Notificações · Nexus</PageTitle>

<div class="page-container">
    <PageHeader Title="Notificações" Description="Tarefas atribuídas a você, prazos chegando, menções e convites.">
        <Actions>
            @if (notifications is not null && notifications.Any(n => !n.IsRead))
            {
                <button type="button" class="btn btn-secondary" @onclick="MarkAllRead"><Icon Name="check" /> Marcar todas como lidas</button>
            }
        </Actions>
    </PageHeader>

    @if (notifications is null)
    {
        <Skeleton Count="6" Label="Carregando notificações…" />
    }
    else
    {
        <div class="pill-tabs" role="group" aria-label="Filtrar notificações">
            <button type="button" aria-pressed="@(filter == "all" ? "true" : "false")" class="@(filter == "all" ? "active" : "")" @onclick='() => filter = "all"'>Todas <span class="tab-count">@notifications.Count</span></button>
            <button type="button" aria-pressed="@(filter == "unread" ? "true" : "false")" class="@(filter == "unread" ? "active" : "")" @onclick='() => filter = "unread"'>Não lidas <span class="tab-count">@notifications.Count(n => !n.IsRead)</span></button>
        </div>

        @if (VisibleNotifications.Count == 0)
        {
            <EmptyState Icon="inbox"
                        Title="@(filter == "unread" ? "Tudo lido por aqui" : "Nenhuma notificação ainda")"
                        Description="@(filter == "unread" ? "Você está em dia. Novas notificações aparecem aqui assim que chegarem." : "Quando alguém te atribuir uma tarefa, te mencionar no chat ou um prazo se aproximar, você fica sabendo aqui.")" />
        }
        else
        {
            @foreach (var group in VisibleNotifications.GroupBy(n => GroupLabel(n.CreatedAtUtc)))
            {
                <section class="notification-group" aria-label="@group.Key">
                    <h2 class="task-group-title">@group.Key</h2>
                    <ul class="card card--flush notification-list">
                        @foreach (var n in group)
                        {
                            <li>
                                <button type="button" class="notification-item @(n.IsRead ? "" : "is-unread")" @onclick="() => OpenAsync(n)">
                                    <span class="notification-icon notification-icon--@n.Type.ToString().ToLowerInvariant()" aria-hidden="true">
                                        <Icon Name="@IconFor(n.Type)" />
                                    </span>
                                    <span class="notification-body">
                                        <span class="notification-message">@n.Message</span>
                                        <span class="notification-meta">
                                            @if (n.Workspace is not null)
                                            {
                                                <span>@n.Workspace.Name</span>
                                                <span aria-hidden="true">·</span>
                                            }
                                            <time datetime="@n.CreatedAtUtc.ToString("o")" title="@n.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")">@TimeLabel(n.CreatedAtUtc)</time>
                                        </span>
                                    </span>
                                    @if (!n.IsRead)
                                    {
                                        <span class="notification-unread-dot"><span class="sr-only">Não lida</span></span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<Notification>? notifications;
    private string? userId;
    private string filter = "all";

    private static string IconFor(NotificationType type) => type switch
    {
        NotificationType.TaskAssigned => "user-plus",
        NotificationType.DueDateApproaching => "clock",
        NotificationType.ChatMention => "message-circle",
        NotificationType.ChatMessage => "chat",
        NotificationType.WorkspaceInvite => "mail",
        _ => "bell"
    };

    private static string GroupLabel(DateTime utc)
    {
        var day = utc.ToLocalTime().Date;
        var today = DateTime.Now.Date;
        if (day == today) return "Hoje";
        if (day == today.AddDays(-1)) return "Ontem";
        if (day > today.AddDays(-7)) return "Nesta semana";
        return "Anteriores";
    }

    private static string TimeLabel(DateTime utc)
    {
        var delta = DateTime.UtcNow - utc;
        if (delta.TotalMinutes < 1) return "agora";
        if (delta.TotalMinutes < 60) return $"há {(int)delta.TotalMinutes} min";
        if (delta.TotalHours < 24) return $"há {(int)delta.TotalHours} h";
        return utc.ToLocalTime().ToString("dd/MM 'às' HH:mm");
    }

    private List<Notification> VisibleNotifications =>
        (filter == "unread" ? notifications!.Where(n => !n.IsRead) : notifications!).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (userId is null)
        {
            notifications = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        notifications = await db.Notifications
            .Where(n => n.UserId == userId)
            .Include(n => n.WorkItem)
            .Include(n => n.Workspace)
            .OrderByDescending(n => n.CreatedAtUtc)
            .Take(200)
            .ToListAsync();
    }

    private async Task OpenAsync(Notification notification)
    {
        if (!notification.IsRead)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // Scoped by UserId as well as Id. The notification here comes from an
            // already-user-filtered list, so this is not currently exploitable — but an ownership
            // check that lives only in the caller is one refactor away from being lost, and this
            // is the statement that actually writes.
            await db.Notifications
                .Where(n => n.Id == notification.Id && n.UserId == userId)
                .ExecuteUpdateAsync(s => s.SetProperty(x => x.IsRead, true));
            notification.IsRead = true;
            Badge.SetUnreadCount(notifications!.Count(n => !n.IsRead));
        }

        // LinkUrl wins: a workspace-invite notification has to land on /convite/{token}, and its
        // recipient is not a member of the workspace yet, so any workspace-derived link would 404.
        if (!string.IsNullOrEmpty(notification.LinkUrl))
        {
            NavigationManager.NavigateTo(notification.LinkUrl);
        }
        else if (notification.WorkItem is not null)
        {
            // Abre a lista já com o painel da tarefa (ListView lê ?tarefa=).
            NavigationManager.NavigateTo($"/lists/{notification.WorkItem.TaskListId}/list?tarefa={notification.WorkItem.Id}");
        }
        else if (notification.WorkspaceId is not null)
        {
            NavigationManager.NavigateTo($"/workspaces/{notification.WorkspaceId}/chat");
        }
    }

    private async Task MarkAllRead()
    {
        if (userId is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Notifications.Where(n => n.UserId == userId && !n.IsRead).ExecuteUpdateAsync(s => s.SetProperty(x => x.IsRead, true));
        await LoadAsync();
        Badge.SetUnreadCount(0);
    }
}
