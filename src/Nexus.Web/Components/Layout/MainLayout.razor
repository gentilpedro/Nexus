@inherits LayoutComponentBase
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@inject NavigationManager NavigationManager
@inject NavigationContextService NavContext
@inject IJSRuntime JS
@implements IDisposable

<nav class="topnav">
    <div class="topnav-left">
        @if (NavContext.WorkspaceId is not null)
        {
            <button type="button" class="app-sidebar-toggle" @onclick="ToggleSidebar" aria-label="Abrir menu">☰</button>
        }
        <a class="topnav-brand" href="/workspaces">Nexus</a>
    </div>
    <div class="topnav-links">
        <ThemeSwitch IsDark="isDark" OnToggle="ToggleTheme" />
        <AuthorizeView>
            <Authorized>
                <a class="topnav-user" href="Account/Manage">@context.User.Identity?.Name</a>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="btn-link">Sair</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="Account/Login">Entrar</a>
                <a href="Account/Register">Criar conta</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<div class="app-shell">
    @if (NavContext.WorkspaceId is not null)
    {
        @if (sidebarOpen)
        {
            <div class="app-sidebar-backdrop" @onclick="CloseSidebar"></div>
        }
        <WorkspaceSidebar IsOpen="sidebarOpen" />
    }
    <div class="app-main">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? currentUrl;
    private bool isDark;
    private bool sidebarOpen;
    private IJSObjectReference? module;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavContext.Changed += OnContextChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/theme.js");
            var current = await module.InvokeAsync<string>("getTheme");
            isDark = current == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        if (module is null)
        {
            return;
        }

        var next = await module.InvokeAsync<string>("toggleTheme");
        isDark = next == "dark";
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }

    private void OnContextChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Navigating (e.g. tapping a sidebar link on mobile) should close the overlay.
        if (sidebarOpen)
        {
            sidebarOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        NavContext.Changed -= OnContextChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
