@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Nexus.Infrastructure.Data
@using Nexus.Web.Components.Shared
@inject NavigationManager NavigationManager
@inject IDbContextFactory<AppDbContext> DbFactory
@implements IDisposable

<nav class="topnav">
    <div class="topnav-left">
        <AuthorizeView>
            <Authorized>
                <button type="button" class="app-sidebar-toggle" @onclick="ToggleSidebar" aria-label="Abrir menu">☰</button>
            </Authorized>
        </AuthorizeView>
        <a class="topnav-brand" href="/">Nexus</a>
    </div>
    <div class="topnav-links">
        <ThemeSwitch />
        <AuthorizeView>
            <Authorized>
                <a class="topnav-user topnav-search" href="/search"><img src="@Assets["lupa.png"]" alt="" class="topnav-search-icon" /></a>
                <a class="topnav-user topnav-notifications" href="/notifications"> <img src="@Assets["notificacao.png"]" alt="" class="topnav-notifications-icon" /> @(unreadCount > 0 ? $" ({unreadCount})" : "")</a>
                <a class="topnav-user" href="Account/Manage" data-enhance-nav="false">@context.User.Identity?.Name</a>
                <form action="Account/Logout" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="btn-link topnav-logout" title="Sair">
                        <img src="@Assets["sair.png"]" alt="Sair" class="topnav-logout-icon" />
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/Account/Login" class="btn" data-enhance-nav="false">
                    Entrar
                </NavLink>
                <NavLink href="Account/Register" class="btn" data-enhance-nav="false">
                    Criar conta
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            @if (sidebarOpen)
            {
                <div class="app-sidebar-backdrop" @onclick="CloseSidebar"></div>
            }
            <WorkspaceSidebar IsOpen="sidebarOpen" />
        </Authorized>
    </AuthorizeView>
    <div class="app-main">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? currentUrl;
    private bool sidebarOpen;
    private int unreadCount;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        await RefreshUnreadCountAsync();
    }

    private async Task RefreshUnreadCountAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            unreadCount = 0;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        unreadCount = await db.Notifications.CountAsync(n => n.UserId == userId && !n.IsRead);
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Navigating (e.g. tapping a sidebar link on mobile) should close the overlay.
        if (sidebarOpen)
        {
            sidebarOpen = false;
        }

        await RefreshUnreadCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
