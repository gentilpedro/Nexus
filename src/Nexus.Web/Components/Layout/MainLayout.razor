@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Nexus.Infrastructure.Data
@using Nexus.Web.Components.Shared
@using Nexus.Web.Services
@inject NavigationManager NavigationManager
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NotificationBadgeService Badge
@implements IDisposable

<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

<header class="topnav">
    <div class="topnav-left">
        <AuthorizeView>
            <Authorized>
                <button type="button" class="icon-btn app-sidebar-toggle" @onclick="ToggleSidebar"
                        aria-expanded="@(sidebarOpen ? "true" : "false")" aria-controls="app-sidebar">
                    <Icon Name="menu" Label="Abrir menu de navegação" />
                </button>
                @* data-nexus-action instead of an inline onclick: blocked by script-src 'self'.
                   Handled by the delegated listener in theme-interop.js. *@
                <button type="button" class="icon-btn topnav-back" data-nexus-action="history-back" data-tooltip="Voltar">
                    <Icon Name="arrow-left" Label="Voltar" />
                </button>
            </Authorized>
        </AuthorizeView>
        <a class="topnav-brand-link" href="/">
            <img class="topnav-logo" src="@Assets["IconNexus.png"]" alt="" />
            <span class="topnav-wordmark">Nexus</span>
            <span class="sr-only">— Início</span>
        </a>
    </div>

    <div class="topnav-center">
        <AuthorizeView>
            <Authorized>
                <form class="topnav-search-form" role="search" @onsubmit="SubmitSearch" @onsubmit:preventDefault="true">
                    <Icon Name="search" />
                    <label for="global-search" class="sr-only">Buscar no Nexus</label>
                    <input id="global-search" type="search" placeholder="Buscar tarefas, documentos ou pessoas"
                           autocomplete="off" @bind="searchText" @bind:event="oninput" />
                    <kbd class="topnav-search-kbd" aria-hidden="true">/</kbd>
                </form>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="topnav-links">
        <AuthorizeView>
            <Authorized>
                <a class="icon-btn topnav-search-mobile" href="/search">
                    <Icon Name="search" Label="Buscar" />
                </a>
            </Authorized>
        </AuthorizeView>

        <ThemeSwitch />

        <AuthorizeView>
            <Authorized>
                <a class="icon-btn topnav-icon-btn" href="/notifications" data-tooltip="Notificações">
                    <Icon Name="bell" Label="@(Badge.UnreadCount > 0 ? $"Notificações, {Badge.UnreadCount} não lidas" : "Notificações")" />
                    @if (Badge.UnreadCount > 0)
                    {
                        <span class="topnav-icon-dot" aria-hidden="true"></span>
                    }
                </a>
                <div class="topnav-user-menu menu-anchor" @onkeydown="HandleMenuKeyDown">
                    <button type="button" class="topnav-avatar-btn" @onclick="ToggleUserMenu"
                            aria-haspopup="menu" aria-expanded="@(userMenuOpen ? "true" : "false")" aria-controls="user-menu">
                        <Avatar Name="@displayName" ImageUrl="@avatarUrl" Size="sm" />
                        <span class="topnav-avatar-name">@displayName</span>
                        <Icon Name="chevron-down" />
                        <span class="sr-only">Menu da conta</span>
                    </button>
                    @if (userMenuOpen)
                    {
                        <div class="menu-backdrop" @onclick="CloseUserMenu"></div>
                        <div id="user-menu" class="menu topnav-user-dropdown" role="menu">
                            <div class="topnav-user-summary">
                                <strong>@displayName</strong>
                                @if (!string.IsNullOrEmpty(email))
                                {
                                    <span>@email</span>
                                }
                            </div>
                            <div class="menu-separator" role="separator"></div>
                            <a href="Account/Manage" data-enhance-nav="false" role="menuitem">
                                <Icon Name="user" />
                                Minha conta
                            </a>
                            <a href="/workspaces" role="menuitem">
                                <Icon Name="workspace" />
                                Meus workspaces
                            </a>
                            <div class="menu-separator" role="separator"></div>
                            <form action="Account/Logout" method="post" data-enhance="false">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@NavigationManager.ToBaseRelativePath(NavigationManager.Uri)" />
                                <button type="submit" role="menuitem">
                                    <Icon Name="log-out" />
                                    Sair
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="topnav-guest-actions">
                    <NavLink href="/Account/Login" class="btn btn-ghost" data-enhance-nav="false">
                        Entrar
                    </NavLink>
                    <NavLink href="Account/Register" class="btn" data-enhance-nav="false">
                        Criar conta
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            @if (sidebarOpen)
            {
                <div class="app-sidebar-backdrop" @onclick="CloseSidebar"></div>
            }
            <WorkspaceSidebar IsOpen="sidebarOpen" OnClose="CloseSidebar" />
        </Authorized>
    </AuthorizeView>
    <main id="conteudo" class="app-main" tabindex="-1">
        @Body

        <footer class="app-footer">
            <a href="/privacidade" data-enhance-nav="false">Política de Privacidade</a>
            <span aria-hidden="true">·</span>
            <a href="/termos-de-uso" data-enhance-nav="false">Termos de Uso</a>
            <span aria-hidden="true">·</span>
            @* O title carrega o commit e a data da build: basta passar o mouse para saber exatamente o
               que está no ar, sem abrir /version. *@
            <span title="@AppVersion.Current.DetailedLabel">Nexus @AppVersion.Current.Version</span>
        </footer>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet role="alert">
    <div class="blazor-error-ui-inner">
        <Icon Name="alert-circle" />
        <span>Algo deu errado e esta página parou de responder.</span>
        <a href="." class="reload">Recarregar</a>
        <span class="dismiss" role="button" tabindex="0"><Icon Name="x" Label="Fechar aviso" /></span>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool sidebarOpen;
    private bool userMenuOpen;
    private string displayName = "";
    private string? email;
    private string? avatarUrl;
    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        Badge.Changed += OnBadgeChanged;
        await RefreshHeaderStateAsync();
    }

    private void OnBadgeChanged() => InvokeAsync(StateHasChanged);

    private async Task RefreshHeaderStateAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
        {
            Badge.SetUnreadCount(0);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        Badge.SetUnreadCount(await db.Notifications.CountAsync(n => n.UserId == userId && !n.IsRead));

        var user = await db.Users.Where(u => u.Id == userId).Select(u => new { u.DisplayName, u.Email, u.AvatarStoragePath }).FirstOrDefaultAsync();
        displayName = string.IsNullOrEmpty(user?.DisplayName) ? (user?.Email?.Split('@')[0] ?? "") : user.DisplayName;
        email = user?.Email;
        avatarUrl = user?.AvatarStoragePath is null
            ? null
            : $"/avatars/{userId}/download?v={Uri.EscapeDataString(Path.GetFileNameWithoutExtension(user.AvatarStoragePath))}";
    }

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;

    private void CloseSidebar() => sidebarOpen = false;

    private void ToggleUserMenu() => userMenuOpen = !userMenuOpen;

    private void CloseUserMenu() => userMenuOpen = false;

    private void HandleMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            userMenuOpen = false;
        }
    }

    private void SubmitSearch()
    {
        userMenuOpen = false;
        var target = string.IsNullOrWhiteSpace(searchText) ? "/search" : $"/search?q={Uri.EscapeDataString(searchText)}";
        NavigationManager.NavigateTo(target);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Navigating (e.g. tapping a sidebar link on mobile) should close the overlay.
        sidebarOpen = false;
        userMenuOpen = false;

        await RefreshHeaderStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Badge.Changed -= OnBadgeChanged;
    }
}
