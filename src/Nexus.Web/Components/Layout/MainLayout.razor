@inherits LayoutComponentBase
@using Nexus.Web.Components.Shared
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<nav class="topnav">
    <div class="topnav-left">
        <AuthorizeView>
            <Authorized>
                <button type="button" class="app-sidebar-toggle" @onclick="ToggleSidebar" aria-label="Abrir menu">☰</button>
            </Authorized>
        </AuthorizeView>
        <a class="topnav-brand" href="/">Nexus</a>
    </div>
    <div class="topnav-links">
        <ThemeSwitch IsDark="isDark" OnToggle="ToggleTheme" />
        <AuthorizeView>
            <Authorized>
                <a class="topnav-user" href="Account/Manage" data-enhance-nav="false">@context.User.Identity?.Name</a>
                <form action="Account/Logout" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="btn-link">Sair</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/Account/Login" class="btn" data-enhance-nav="false">
                    Entrar
                </NavLink>
                <NavLink href="Account/Register" class="btn" data-enhance-nav="false">
                    Criar conta
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            @if (sidebarOpen)
            {
                <div class="app-sidebar-backdrop" @onclick="CloseSidebar"></div>
            }
            <WorkspaceSidebar IsOpen="sidebarOpen" />
        </Authorized>
    </AuthorizeView>
    <div class="app-main">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? currentUrl;
    private bool isDark;
    private bool sidebarOpen;
    private IJSObjectReference? module;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/theme.js");
            var current = await module.InvokeAsync<string>("getTheme");
            isDark = current == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        if (module is null)
        {
            return;
        }

        var next = await module.InvokeAsync<string>("toggleTheme");
        isDark = next == "dark";
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Navigating (e.g. tapping a sidebar link on mobile) should close the overlay.
        if (sidebarOpen)
        {
            sidebarOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
