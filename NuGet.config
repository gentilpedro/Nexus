<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins this repository's restore to nuget.org over HTTPS only.

    Without <clear/>, restore also inherits whatever feeds happen to be configured on the
    machine or user profile. On at least one dev machine that included an internal feed served
    over plain HTTP (http://10.1.50.11/nugetserver/nuget) — a supply-chain risk (packages can be
    tampered with in transit) and a build-reproducibility problem, since a package resolved from
    a private feed on one machine may resolve differently on CI. Nexus consumes no internal
    packages, so nuget.org is the complete set of sources it needs.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
