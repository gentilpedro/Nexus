POSTGRES_PASSWORD=change-me-locally

# Backplane entre instancias (pub/sub do chat + contador do rate limiter do circuito).
#
# Deixe comentado para rodar em instancia unica, que e o modo normal de desenvolvimento e o que
# roda em producao hoje. Descomente junto com `docker compose --profile escala up` para subir o
# Redis e a segunda instancia em :8081 e ver o chat sincronizando entre as duas.
#
# REDIS_CONNECTION=redis:6379
