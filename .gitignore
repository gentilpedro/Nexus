.vs/
.idea/
*.user
*.suo

# Rider/VS Code
.vscode/

# OS
.DS_Store
Thumbs.db

# User secrets / local config
appsettings.*.local.json

# Local docker-compose secrets (real value on this machine — see .env.example)
.env

# Misc local files (design reference screenshots dropped in the project root)
/*.PNG
/*.png
/*.jpg
/*.jpeg

# Locally uploaded task attachments (dev storage, not committed)
src/Nexus.Web/App_Data/uploads/
Wireframes/

# Artefatos locais do Impeccable (capturas, decisões e rascunhos de sessão)
.impeccable/review/
.impeccable/decision/
.impeccable/questions/
.impeccable/hook.cache.json
.impeccable/config.local.json

# Variações locais do .env (o modelo versionado é o .env.example)
.env.*
!.env.example

# Override local do docker compose (ex.: publicar o Postgres em outra porta)
docker-compose.override.yml

# Claude Code: configuração pessoal de cada máquina (as skills do projeto são versionadas)
.claude/settings.local.json

# Dependências Node em qualquer pasta
node_modules/

# Resultados de teste e cobertura
TestResults/
coverage/
*.coverage
coverage*.xml

# Dumps e backups de banco feitos à mão (contêm dado pessoal; ver docs/backup-restore.md)
*.dump
*.backup
*.sql.gz

# Logs locais
*.log
logs/
